NULL

# The subquery groups by the enclosing group's column: one group of every b row.
# cost: 62
query II nosort
SELECT x, (SELECT count(*) FROM b GROUP BY a.x) FROM a GROUP BY x ORDER BY 1
----
1
5
2
5
4
5
NULL
5

# A membership subquery correlated to the group.
# cost: 53
query IB nosort
SELECT x, x IN (SELECT b.x FROM b WHERE b.id > a.x) FROM a GROUP BY x ORDER BY 1
----
1
true
2
NULL
4
false
NULL
false

# An aggregate's argument and the WHERE clause see the INPUT row, so any column is in reach there.
# cost: 81
query ID nosort
SELECT x, sum((SELECT count(*) FROM b WHERE b.x = a.y)) FROM a GROUP BY x ORDER BY 1
----
1
0
2
0
4
1
NULL
0

# cost: 69
query I nosort
SELECT x FROM a WHERE EXISTS (SELECT 1 FROM b WHERE b.x = a.x) GROUP BY x ORDER BY 1
----
1

# An ungrouped column of the enclosing query is 42803 wherever the subquery sits.
statement error 42803
SELECT x, count(*) FROM a GROUP BY x HAVING EXISTS (SELECT 1 FROM b WHERE b.id = a.id)

statement error 42803
SELECT x, (SELECT y) FROM a GROUP BY x

statement error 42803
SELECT (SELECT count(*) FROM b WHERE b.x = a.x) FROM a HAVING count(*) > 0

statement error 42803
SELECT x FROM a GROUP BY x ORDER BY (SELECT count(*) FROM b WHERE b.id = a.id)

# An expression key does not make its columns reachable from a subquery.
statement error 42803
SELECT x + 1 AS k, (SELECT count(*) FROM b WHERE b.x = a.x + 1) FROM a GROUP BY x + 1 ORDER BY 1
