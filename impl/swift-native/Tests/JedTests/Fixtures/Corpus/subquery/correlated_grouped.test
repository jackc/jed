# ORDER BY, as a key expression and through an alias.
# cost: 64
query I nosort
SELECT x FROM a GROUP BY x ORDER BY (SELECT count(*) FROM b WHERE b.x = a.x) DESC, x
----
1
2
4
NULL

# cost: 118
query II nosort
SELECT x, (SELECT count(*) FROM b WHERE b.x = a.x) AS n FROM a GROUP BY x ORDER BY n DESC, x
----
1
2
2
0
4
0
NULL
0

# Window keys over the grouped rows.
# cost: 73
query III nosort
SELECT x, max(y), rank() OVER (ORDER BY (SELECT count(*) FROM b WHERE b.x = a.x)) FROM a GROUP BY x ORDER BY 1
----
1
10
4
2
20
1
4
50
1
NULL
30
1

# cost: 82
query III nosort
SELECT x, max(y), sum(max(y)) OVER (PARTITION BY (SELECT count(*) FROM b WHERE b.x = a.x)) FROM a GROUP BY x ORDER BY 1
----
1
10
10
2
