# A correlated reference into a GROUPED enclosing query (spec/design/grammar.md §26,
# aggregates.md §10). A subquery in a grouped query's select list, HAVING, ORDER BY or window keys
# runs once per GROUP, over the group row — so an enclosing-query column it references must be one
# of that query's grouping columns (or functionally dependent on its grouped primary key) and reads
# the group's value; any other column is 42803, PostgreSQL's "subquery uses ungrouped column".
# A subquery in WHERE, or inside an aggregate's argument, still sees the input row. Results
# verified against PostgreSQL 18.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.where_eq, query.comparison_order, query.order_by, query.order_by_expr, query.order_by_alias, query.qualified_column, query.table_alias, query.distinct, query.aggregates, query.group_by, query.group_by_expr, query.group_by_functional_dependency, query.grouping_sets, query.having, query.window, query.window_ranking, query.window_aggregate, query.window_grouped, query.window_expr_keys, expr.arithmetic, query.subquery_scalar, query.subquery_in, query.subquery_exists, query.subquery_correlated, query.group_by_correlated, types.i32, null.three_valued, resource.cost_metering

statement ok
CREATE TABLE a (id i32 PRIMARY KEY, x i32, y i32)

statement ok
CREATE TABLE b (id i32 PRIMARY KEY, x i32)

statement ok
INSERT INTO a VALUES (1, 1, 10), (2, 2, 20), (3, NULL, 30), (4, 4, 40), (5, 4, 50)

statement ok
INSERT INTO b VALUES (1, 1), (2, 1), (3, NULL), (5, 5), (6, 40)

# HAVING: the EXISTS runs per group over the group's x.
# cost: 62
query II nosort
SELECT x, count(*) FROM a GROUP BY x HAVING EXISTS (SELECT 1 FROM b WHERE b.x = a.x) ORDER BY 1
----
1
1

# The select list, beside and without an aggregate.
# cost: 69
query III nosort
SELECT x, max(y), (SELECT count(*) FROM b WHERE b.x = a.x) FROM a GROUP BY x ORDER BY 1
----
1
10
2
2
20
0
4
50
0
NULL
