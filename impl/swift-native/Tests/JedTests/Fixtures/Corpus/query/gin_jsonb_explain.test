# GIN over a jsonb column (jsonb_ops) — the selected plan (jed-only: EXPLAIN is jed's own rendering,
# never oracle-imported). Pins that a jsonb GIN index bounds `@>` (either spelling), `?`, `?|`, `?&`,
# a mutation's target-row scan, and a sibling index-nested-loop (spec/design/gin.md §2.1/§6/§6.1);
# that `doc = Q` (no jsonb_ops strategy) and a non-column spelling stay full scans; and that a
# term-less `@> '{}'` still takes the bound, whose gather falls back to the full scan at execution.
# The rows themselves are oracle-checked in query/gin_jsonb.test.
# Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.gin_index, query.gin_scan, query.gin_mutation, query.gin_jsonb_ops, query.gin_index_nested_loop, query.index_nested_loop, query.join_inner, query.qualified_column, query.explain, dml.insert, dml.insert_multi_row, dml.update, dml.delete, query.select, types.i32, types.text, types.jsonb, func.jsonb_contains, cast.operator

statement ok
CREATE TABLE d (id i32 PRIMARY KEY, doc jsonb, n i32)

statement ok
CREATE INDEX d_doc_gin ON d USING gin (doc)

statement ok
INSERT INTO d VALUES
  (1, '{"a": 1, "tags": ["red"]}', 1),
  (2, '{"a": 2}', 2),
  (3, '["red", "x"]', 3),
  (4, '"red"', 4),
  (5, '{}', 5),
  (6, NULL, 6),
  (7, '{"b": true}', 7),
  (8, '[1, 2]', 8)

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc @> '{"a": 1}'
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

# the commuted spelling resolves to the same containment node
query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE '{"a": 1}' <@ doc
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc ? 'a'
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc ?| '{a,b}'
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc ?& '{a,tags}'
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

# a term-less query is still a GIN candidate; its gather falls back to the full scan
query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc @> '{}'
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

# jsonb_ops has no = strategy (an array GIN's = bound never applies to jsonb)
query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc = '{"a": 1}'
----
0
Filter
conjuncts=1
1
Scan d
Full scan; touched=2

# the indexed operand must be the bare column
query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc::text::jsonb @> '{"a": 1}'
----
0
Filter
conjuncts=1
1
Scan d
Full scan; touched=2

query ITT nosort
EXPLAIN (COSTS false) UPDATE d SET n = 0 WHERE doc ? 'b'
----
0
Update d
sets=1
1
Filter
conjuncts=1
2
Scan d
GIN bound: using d_doc_gin; touched=1

query ITT nosort
EXPLAIN (COSTS false) DELETE FROM d WHERE doc @> '["red"]'
----
0
Delete d
-
1
Filter
conjuncts=1
2
Scan d
GIN bound: using d_doc_gin; touched=1

statement ok
CREATE TABLE p (id i32 PRIMARY KEY, q jsonb)

statement ok
INSERT INTO p VALUES (1, '{"a": 1}'), (2, '["red"]')

# an earlier sibling's bare column is the per-outer-row query document
query ITT nosort
EXPLAIN (COSTS false) SELECT p.id, d.id FROM p JOIN d ON d.doc @> p.q
----
0
Nested Loop
inner; on:conjuncts=1
1
Scan p
Full scan; touched=2
1
Scan d
Index-nested-loop GIN bound: using d_doc_gin; touched=2
