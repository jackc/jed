# EXPLAIN of SELECT DISTINCT ON (spec/design/explain.md §4, grammar.md §11.1): the dedup runs after
# the sort, so Distinct (detail on=N, the dedup key count) renders above the Sort, and below Limit.
# The sort is never elided and LIMIT never stops the scan early (planner.md §4), even when the
# primary-key order would serve the ORDER BY.
# requires: ddl.create_table, ddl.primary_key, dml.insert_multi_row, query.select, query.distinct, query.distinct_on, query.order_by, query.limit, query.explain, query.explain_analyze, types.i32

statement ok
CREATE TABLE ke (id i32 PRIMARY KEY, g i32, v i32)

statement ok
INSERT INTO ke VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40), (5, 3, 50)

