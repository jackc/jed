# A view reference IS the equivalent derived table `( <definition> ) AS <label> ( <columns> )`
# (spec/design/views.md §4): the same rows, cost, plan, and EXPLAIN. Each view query below is paired
# with its derived-table spelling (the stored definition as the body), and both must carry the same
# `# cost:` and the same EXPLAIN rows. Predicate pushdown reaches into a view body exactly as into a
# derived table (the PK bound below). jed-specific (cost and EXPLAIN), so CROSS-CORE-checked, NOT
# PostgreSQL-oracle-checked. The NoREC generator (scripts/norec_gen.rb `view`) sweeps the same
# relation over generated data.
# requires: ddl.view, ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_star, query.where_eq, query.join_inner, query.aggregates, query.derived_table, query.derived_pushdown, query.index_nested_loop, query.explain, resource.cost_metering, types.i32, types.text

statement ok
CREATE TABLE t (a i32 PRIMARY KEY, b text, c i32)

statement ok
INSERT INTO t VALUES (1, 'x', 10), (2, 'y', 20), (3, 'z', NULL)

statement ok
CREATE VIEW v AS SELECT * FROM t WHERE c > 5

statement ok
CREATE VIEW v2 (p, q) AS SELECT a, b FROM t

# --- a WHERE on the view is pushed into the body and bounds t's primary key -------------------------

# cost: 7
query ITI nosort
SELECT * FROM v WHERE a = 2
----
2
y
20

# cost: 7
query ITI nosort
SELECT * FROM (SELECT "t"."a", "t"."b", "t"."c" FROM t WHERE c > 5) AS v (a, b, c) WHERE a = 2
----
2
y
20

query ITTII nosort
EXPLAIN SELECT * FROM v WHERE a = 2
----
