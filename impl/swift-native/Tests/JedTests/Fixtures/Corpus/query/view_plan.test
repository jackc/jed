# --- a join against the view chooses the same physical plan --------------------------------------

# cost: 20
query I nosort
SELECT count(*) FROM v2 JOIN t ON v2.p = t.a
----
3

# cost: 20
query I nosort
SELECT count(*) FROM (SELECT a, b FROM t) AS v2 (p, q) JOIN t ON v2.p = t.a
----
3

query ITTII nosort
EXPLAIN SELECT count(*) FROM v2 JOIN t ON v2.p = t.a
