# --- an alias and a column alias list on the reference relabel it like a derived table ------------

# cost: 9
query I nosort
SELECT x.p FROM v2 AS x WHERE x.q = 'z'
----
3

# cost: 9
query I nosort
SELECT x.p FROM (SELECT a, b FROM t) AS x (p, q) WHERE x.q = 'z'
----
3

