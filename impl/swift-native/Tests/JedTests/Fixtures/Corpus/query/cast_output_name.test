# The output name of an un-aliased cast (spec/design/grammar.md §8): a cast takes its operand's name
# when the operand has one, as PostgreSQL does — `a::text` is named `a`, `sum(a)::text` is named
# `sum` — so a trailing ORDER BY of that name sorts the cast's OUTPUT, not the column. Every record
# here is PostgreSQL-oracle-checked. (A cast of an unnamed operand keeps `?column?`, where PostgreSQL
# uses the type's name: a ledgered divergence, so it is not pinned here.)
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.column_alias, query.order_by, query.order_by_alias, query.aggregates, cast.explicit, cast.operator, cast.scalar_text, types.i32, types.text

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a i32, b text)

statement ok
INSERT INTO t VALUES (1, 9, '30'), (2, 10, '4'), (3, 100, '200')

# names: a
query T nosort
SELECT a::text FROM t ORDER BY id
----
9
10
100

# names: a
query T nosort
SELECT CAST(a AS text) FROM t ORDER BY id
----
9
10
100

# a cast of a cast keeps the innermost name
# names: b
query T nosort
SELECT b::i32::text FROM t ORDER BY id
----
30
4
200

# an aggregate's name passes through a cast
# names: sum
query T nosort
SELECT sum(a)::text FROM t
----
119

# ORDER BY the name sorts the cast's output (text order), not the integer column
# names: a
query T nosort
SELECT a::text FROM t ORDER BY a
----
10
100
9

# names: b
query I nosort
SELECT b::i32 FROM t ORDER BY b
----
4
30
200

# an alias still wins, and then the bare name is the column again
# names: s
query T nosort
SELECT a::text AS s FROM t ORDER BY a
----
9
10
100
