# enough rows for many leaves: bulk load, aggregate, group, update and delete
statement ok
CREATE TABLE big (id i32 PRIMARY KEY, grp i32, amt numeric(12,2), pct numeric(4,2), cnt numeric(9,0))

statement ok
INSERT INTO big SELECT g, g % 7, (g * 7919 % 1000000)::numeric / 100 - 5000, (g % 199)::numeric / 2, g * 3 FROM generate_series(1, 3000) AS g

# statistics over fixed-width columns: the analyzed facts are values, not slots
statement ok
ANALYZE big

