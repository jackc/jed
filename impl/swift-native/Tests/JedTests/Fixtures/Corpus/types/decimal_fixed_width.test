# a fixed-width decimal as a primary key, under a unique constraint and in an index: keys keep the
# value-based decimal encoding, so 1.5 and 1.50 are one key
statement ok
CREATE TABLE k (p numeric(10,2) PRIMARY KEY, q numeric(6,3) UNIQUE, r numeric(4,1))

statement ok
CREATE INDEX k_r ON k (r)

statement ok
INSERT INTO k VALUES (1.5, 0.001, 10), (-2.25, 0.002, -10), (0, NULL, NULL), (12345678.9, 999.999, 999.9)

