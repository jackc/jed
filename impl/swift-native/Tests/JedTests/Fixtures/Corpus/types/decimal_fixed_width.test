# numeric(p,s) columns across the stored column classes (spec/fileformat/format.md v51,
# spec/design/decimal.md §6a): a column with p <= 18 is a fixed-width leaf slot of 2 (p <= 4), 4
# (p <= 9), or 8 (p <= 18) bytes; a wider or unconstrained column keeps the variable-width codec.
# The stored form is invisible to SQL, so every record here is PostgreSQL-oracle-checked: values
# round-trip at the declared scale, the typmod checks are unchanged, and ALTER COLUMN TYPE moves a
# column between the classes with its values intact.
# requires: ddl.create_table, ddl.primary_key, ddl.alter_table, ddl.column_default, ddl.unique, ddl.secondary_index, dml.insert, dml.insert_multi_row, dml.insert_select, dml.update, dml.delete, query.select, query.where_eq, query.comparison_order, query.is_null, query.order_by, query.aggregates, query.group_by, query.set_returning, query.point_lookup, cast.explicit, expr.arithmetic, types.i32, types.decimal, maintenance.analyze

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a numeric(4,2), b numeric(9,0), c numeric(18,6), w numeric(19,2), u numeric)

# each column's extremes, zero, the smallest step, and NULLs
statement ok
INSERT INTO t VALUES (1, 99.99, 999999999, 999999999999.999999, 99999999999999999.99, 1.5), (2, -99.99, -999999999, -999999999999.999999, -99999999999999999.99, -1.50), (3, 0, 0, 0, 0, 0), (4, 0.01, 1, 0.000001, 0.01, 0.000000001), (5, NULL, NULL, NULL, NULL, NULL), (6, -0.5, -42, -1.5, NULL, 7)

