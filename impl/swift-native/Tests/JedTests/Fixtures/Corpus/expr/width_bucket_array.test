# width_bucket(operand, thresholds) — the array-threshold variant (spec/design/array-functions.md §14),
# PostgreSQL's width_bucket(anycompatible, anycompatiblearray) → integer. A binary search over a
# thresholds array ASSUMED sorted ascending (not checked): the result is the number of thresholds <=
# the operand (0 below the first, the element count at/above the last). Comparison is by the element
# type's total order (NaN above every float, text by its collation). STRICT: a NULL operand or array →
# NULL. A multidimensional array is 2202E, a NULL element 22004. The operand pairs with the element type
# like a quantified comparison (int × decimal compares by value; a non-array second argument or an
# incomparable pair is 42883). Each binary-search step charges one operator_eval plus the comparison's
# size-scaled work (decimal_work / varlen_compare / collate), like GREATEST/LEAST (cost.md §3).
# PostgreSQL-oracle-verified (postgres:18).
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_no_from, query.order_by, types.array, types.array_multidim, types.i32, types.i64, types.decimal, types.f64, types.text, types.date, types.timestamp, types.interval, types.boolean, types.range, types.jsonb, types.jsonb_compare, func.array, func.array_quantified, cast.explicit, resource.cost_metering

# --- the PostgreSQL documentation example ----------------------------------------------------
query I nosort
SELECT width_bucket(5, ARRAY[1, 3, 4, 6, 7])
----
3

# --- bucket boundaries: below the first → 0, equal to a threshold → its bucket, at/above the last
# → the element count; equal thresholds count the rightmost one --------------------------------
query IIIIII nosort
SELECT width_bucket(0, ARRAY[1, 3, 5]), width_bucket(1, ARRAY[1, 3, 5]), width_bucket(2, ARRAY[1, 3, 5]), width_bucket(3, ARRAY[1, 3, 5]), width_bucket(5, ARRAY[1, 3, 5]), width_bucket(99, ARRAY[1, 3, 5])
----
0
1
1
2
3
3

query II nosort
SELECT width_bucket(3, ARRAY[1, 3, 3, 3, 5]), width_bucket(2, ARRAY[3, 3, 3])
----
4
0

# --- a single threshold and the empty array ----------------------------------------------------
query III nosort
SELECT width_bucket(4, ARRAY[5]), width_bucket(5, ARRAY[5]), width_bucket(5, '{}'::i32[])
----
0
1
0

# --- the array is assumed sorted: an unsorted one yields whatever the binary search lands on ------
query II nosort
SELECT width_bucket(5, ARRAY[9, 1, 3]), width_bucket(2, ARRAY[10, 1, 5, 3, 8])
----
3
2

# --- an int operand against decimal thresholds (and the reverse) compares by value ---------------
query III nosort
SELECT width_bucket(5, ARRAY[1.5, 3.0]), width_bucket(2.5, ARRAY[1, 2, 3]), width_bucket(3.000, ARRAY[1, 3])
----
2
2
2

query I nosort
SELECT width_bucket(0.123456789012345678901234567890, ARRAY[0.1234567890123456789012345678, 0.12345678901234567890123456789012])
----
1

# jed's float family is a strict island (float.md §6): a TYPED integer operand against float
# thresholds is 42883, where PostgreSQL unifies both to double precision (a bare literal adapts, above)
statement error 42883
SELECT width_bucket(5::i64, ARRAY[1.5, 2.5]::f64[])

query I nosort
SELECT width_bucket(5, ARRAY[1.5, 2.5]::f64[])
----
2

# --- floats: NaN sorts above every number (and equals NaN), -Infinity below ----------------------
query IIIII nosort
SELECT width_bucket('NaN'::f64, ARRAY[1, 2]::f64[]), width_bucket(1::f64, '{1,NaN}'::f64[]), width_bucket('NaN'::f64, '{1,NaN}'::f64[]), width_bucket('-Infinity'::f64, '{-Infinity,0}'::f64[]), width_bucket(-0.0::f64, ARRAY[0]::f64[])
----
2
1
2
1
1

query I nosort
SELECT width_bucket(2.5::f64, ARRAY[1.5, 2.5, 3.5]::f64[])
----
2

# --- text (the C collation: byte / code-point order) ---------------------------------------------
query IIII nosort
SELECT width_bucket('b', ARRAY['a', 'c']), width_bucket('B', ARRAY['a', 'c']), width_bucket('c', ARRAY['a', 'c']), width_bucket('', ARRAY['a'])
----
1
0
2
0

# --- datetime and interval thresholds -----------------------------------------------------------
query II nosort
SELECT width_bucket('2021-06-15'::date, '{2020-01-01,2021-01-01,2022-01-01}'::date[]), width_bucket('2021-01-01 00:00:00'::timestamp, '{2020-01-01 00:00:00,2021-01-01 00:00:00}'::timestamp[])
----
2
2

query I nosort
SELECT width_bucket('36 hours'::interval, '{1 day,2 days,1 month}'::interval[])
----
1

# --- any orderable element type: boolean, range (range_cmp), jsonb (its btree order) -------------
query III nosort
SELECT width_bucket(true, ARRAY[false, true]), width_bucket('[2,3)'::int4range, ARRAY['[1,2)'::int4range, '[2,5)'::int4range]), width_bucket('{"a":1}'::jsonb, ARRAY['1'::jsonb, '{"b":1}'::jsonb])
----
2
1
1

# json has no ordering → 42883
statement error 42883
SELECT width_bucket('1'::json, ARRAY['1'::json])

# --- custom lower bounds do not matter (the bucket counts elements, not subscripts) ---------------
query I nosort
SELECT width_bucket(5, '[3:5]={1,5,9}'::i32[])
----
2

# --- over table columns ---------------------------------------------------------------------------
statement ok
CREATE TABLE wb (id i32 PRIMARY KEY, x i32, th i32[])

statement ok
INSERT INTO wb VALUES
  (1, 0, ARRAY[10, 20, 30]),
  (2, 10, ARRAY[10, 20, 30]),
  (3, 25, ARRAY[10, 20, 30]),
  (4, 30, ARRAY[10, 20, 30]),
  (5, NULL, ARRAY[10, 20, 30]),
  (6, 15, NULL),
  (7, 15, '{}')

query II nosort
SELECT id, width_bucket(x, th) FROM wb ORDER BY id
----
1
0
2
1
3
2
4
3
5
NULL
6
NULL
7
0

# a constant threshold array against a column operand (the ARRAY[…] adapts to the column's i32)
query II nosort
SELECT id, width_bucket(x, ARRAY[5, 15, 25]) FROM wb WHERE x IS NOT NULL ORDER BY id
----
1
0
2
1
3
3
4
3
6
2
7
2

# --- NULL arguments ----------------------------------------------------------------------------
query II nosort
SELECT width_bucket(NULL, ARRAY[1, 2]), width_bucket(5, NULL)
----
NULL
NULL

# a NULL operand does not look at the thresholds (no 22004 for a NULL element)
query I nosort
SELECT width_bucket(NULL::i32, ARRAY[1, NULL])
----
NULL

# --- errors --------------------------------------------------------------------------------------
# a NULL threshold → 22004
statement error 22004
SELECT width_bucket(5, ARRAY[1, NULL, 3])

# a multidimensional thresholds array → 2202E (checked before the NULL elements)
statement error 2202E
SELECT width_bucket(5, ARRAY[ARRAY[1, 2], ARRAY[3, 4]])

statement error 2202E
SELECT width_bucket(5, '{{1,NULL},{3,4}}'::i32[])

# a non-array second argument → 42883 (no width_bucket(integer, integer))
statement error 42883
SELECT width_bucket(5, 1)

# an operand incomparable with the element type → 42883
statement error 42883
SELECT width_bucket(5, ARRAY['a', 'c'])

statement error 42883
SELECT width_bucket('a'::text, ARRAY[1, 2])

# --- cost: 1 (the ARRAY[…] constructor) + 1 (the width_bucket node) + 3 (one operator_eval per search
# step over 5 thresholds: mid 2, 4, 3) + 1 (the produced row) = 6 --------------------------------
# cost: 6
query I nosort
SELECT width_bucket(5, ARRAY[1, 3, 4, 6, 7])
----
3

# a long decimal pair adds its size-scaled decimal_work per search step (cost.md §3)
# cost: 19
query I nosort
SELECT width_bucket(0.123456789012345678901234567890, ARRAY[0.1234567890123456789012345678, 0.12345678901234567890123456789012])
----
1

# a text pair adds varlen_compare per search step (the shorter operand's code points − 1, cost.md §3)
# cost: 19
query I nosort
SELECT width_bucket('abcdefgh', ARRAY['abcdefga', 'abcdefgz'])
----
1

# the empty array searches nothing: 1 (the node; the constant '{}' literal is free) + 1 (the row)
# cost: 2
query I nosort
SELECT width_bucket(5, '{}'::i32[])
----
0
