# the date's time and timezone fields stay 0A000 over an infinite date
statement error 0A000
SELECT EXTRACT(hour FROM DATE 'infinity')

statement error 0A000
SELECT EXTRACT(timezone FROM DATE '-infinity')

statement error 22023
SELECT EXTRACT(nosuch FROM DATE 'infinity')

statement error 0A000
SELECT EXTRACT(now FROM TIMESTAMP 'infinity')

# --- a column mixing finite and infinite values ---------------------------------------
statement ok
CREATE TABLE d (id integer PRIMARY KEY, v date)

statement ok
INSERT INTO d VALUES (1, DATE '2024-06-09'), (2, DATE 'infinity'), (3, DATE '-infinity'), (4, NULL)

query IDDRR nosort
SELECT id, EXTRACT(month FROM v), EXTRACT(dow FROM v), date_part('month', v), date_part('year', v) FROM d ORDER BY id
----
1
6
0
6
2024
2
NULL
NULL
NULL
Infinity
3
NULL
NULL
NULL
-Infinity
4
NULL
NULL
NULL
NULL

query I nosort
SELECT count(*) FROM d WHERE EXTRACT(day FROM v) IS NULL
----
3

query IR nosort
SELECT id, date_part('isoyear', v) FROM d ORDER BY date_part('isoyear', v), id
----
3
-Infinity
