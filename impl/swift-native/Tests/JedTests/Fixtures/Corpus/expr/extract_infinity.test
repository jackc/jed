# date_part and EXTRACT over a ±infinity date / timestamp / timestamptz (spec/design/timezones.md
# §9.2), ported from PostgreSQL 18's timestamp.c NonFiniteTimestampTzPart and date.c extract_date.
# The unit is decoded first, so an unrecognized unit is still 22023 and a recognized-but-unsupported
# one 0A000. Then a monotonically-increasing field (year, decade, century, millennium, julian,
# isoyear, epoch) of an infinite source is ±Infinity with the source's sign, and every other
# (oscillating) field is NULL — for a timestamp/timestamptz every unit is one or the other, even
# timezone of a timestamp; for a date the time and timezone fields stay 0A000. date_part (float8)
# returns both answers; its date overload widens to an infinite timestamp, so the timestamp matrix
# applies. EXTRACT (numeric) returns the NULLs here; its ±Infinity results trap 22003 instead (jed's
# decimal is finite-only — a per-core divergence test, not here: the oracle corpus is PG-clean), as
# does EXTRACT(timezone FROM an infinite timestamp), which jed rejects at resolve like every
# EXTRACT field the type does not support (PG returns NULL). Oracle-checked against postgres:18.
# Format + the `requires` gate: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_no_from, query.derived_table, query.order_by, types.i32, types.f64, types.date, types.timestamp, types.timestamptz, types.text, expr.extract, func.date_part, session.timezone
# load-timezone: Asia/Kolkata

statement ok
CREATE TABLE fields (id integer PRIMARY KEY, f text)

statement ok
INSERT INTO fields VALUES (1, 'microseconds'), (2, 'milliseconds'), (3, 'second'), (4, 'minute'), (5, 'hour'), (6, 'day'), (7, 'week'), (8, 'month'), (9, 'quarter'), (10, 'year'), (11, 'decade'), (12, 'century'), (13, 'millennium'), (14, 'dow'), (15, 'isodow'), (16, 'doy'), (17, 'isoyear'), (18, 'epoch'), (19, 'julian'), (20, 'timezone'), (21, 'timezone_hour'), (22, 'timezone_minute'), (23, 'JD'), (24, 'Hours'), (25, 'y'), (26, 'mons'), (27, 'msec'), (28, 'Epoch')

