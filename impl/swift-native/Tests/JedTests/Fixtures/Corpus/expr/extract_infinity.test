# the session zone is never consulted for an infinite timestamptz
# timezone: Asia/Kolkata
query RRRR nosort
SELECT date_part('timezone', TIMESTAMPTZ 'infinity'), date_part('hour', TIMESTAMPTZ '-infinity'), date_part('epoch', TIMESTAMPTZ 'infinity'), date_part('julian', TIMESTAMPTZ '-infinity')
----
NULL
NULL
Infinity
-Infinity

# --- the unit is decoded before the infinity check -------------------------------
# an unrecognized unit is 22023
statement error 22023
SELECT date_part('nosuch', TIMESTAMP 'infinity')

statement error 22023
SELECT date_part('nosuch', TIMESTAMPTZ '-infinity')

statement error 22023
SELECT date_part('nosuch', DATE 'infinity')

# a reserved word other than epoch is recognized but unsupported: 0A000
statement error 0A000
SELECT date_part('now', TIMESTAMP 'infinity')

statement error 0A000
SELECT date_part('today', TIMESTAMPTZ '-infinity')

statement error 0A000
SELECT date_part('infinity', DATE '-infinity')

# EXTRACT over infinity timestamp: every oscillating field is NULL
query DDDDDDDDDDDD nosort
SELECT EXTRACT(microseconds FROM v), EXTRACT(milliseconds FROM v), EXTRACT(second FROM v), EXTRACT(minute FROM v), EXTRACT(hour FROM v), EXTRACT(day FROM v), EXTRACT(week FROM v), EXTRACT(month FROM v), EXTRACT(quarter FROM v), EXTRACT(dow FROM v), EXTRACT(isodow FROM v), EXTRACT(doy FROM v) FROM (SELECT TIMESTAMP 'infinity' AS v) AS s
----
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL

