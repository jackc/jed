# timestamptz ± interval in the SESSION zone — PostgreSQL's timestamptz_pl_interval
# (spec/design/interval.md §5, timezones.md §6): the months step converts the instant to its wall
# clock in the session zone, adds the months with day-of-month clamping, and re-resolves the wall
# clock through the zone (a DST gap/overlap as for input); the days step does the same with
# calendar days — so `+ 1 day` across a DST change keeps the wall-clock time where `+ 24 hours`
# shifts the instant by exactly 24 h; the micros are then added on the instant. Each calendar step
# a finite timestamptz performs charges one `timezone` cost unit (cost.md); a pure time-of-day
# interval charges none. A zoneless timestamp (or date) operand never consults a zone. An index
# expression over timestamptz ± interval depends on the session zone (42P17) unless the interval is
# a constant with no calendar field (index-dependencies.md). `timestamp[tz] + 'lit'` adapts the
# string literal to interval, as PostgreSQL resolves the unknown literal (types.md §6).
# Oracle-checked against postgres:18.
#
# Format + the `requires` gate: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.secondary_index, ddl.index_expr, dml.insert, query.select, query.select_no_from, types.i32, types.timestamp, types.timestamptz, types.interval, expr.timestamp_arithmetic, session.timezone, resource.cost_metering

# load-timezone: America/New_York

# ============================================================================================
# the spring-forward day (2024-03-10 02:00 EST -> 03:00 EDT) and the fall-back day (2024-11-03)
# ============================================================================================

# + 1 day keeps the wall clock (12:00 -> 12:00), the instant moving by 23 h
# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-03-09 12:00:00' + interval '1 day'
----
2024-03-10 12:00:00-04

# + 24 hours moves the instant by exactly 24 h: no zone step, no timezone unit
# timezone: America/New_York
# cost: 2
query T nosort
SELECT timestamptz '2024-03-09 12:00:00' + interval '24 hours'
----
2024-03-10 13:00:00-04

# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-11-02 12:00:00' + interval '1 day'
----
2024-11-03 12:00:00-05

# a wall clock landing in the fall-back overlap (01:30 is doubled) resolves as input does: EST
# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-11-02 01:30:00' + interval '1 day'
----
2024-11-03 01:30:00-05

# a wall clock landing in the spring-forward gap (02:30 does not exist) resolves as input does:
# the earlier offset (EST), so it reads 03:30 EDT
# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-03-09 02:30:00' + interval '1 day'
----
2024-03-10 03:30:00-04

# the months step: the same gap/overlap rules, with day-of-month clamping
# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-02-10 02:30:00' + interval '1 month'
----
2024-03-10 03:30:00-04

# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-10-03 01:30:00' + interval '1 month'
----
2024-11-03 01:30:00-05

# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-01-31 00:00:00' + interval '1 month'
----
2024-02-29 00:00:00-05

# subtraction negates the interval
# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-03-10 12:00:00' - interval '1 day'
----
2024-03-09 12:00:00-05

# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-03-11 02:30:00' - interval '1 day'
----
2024-03-10 03:30:00-04

# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-11-03 01:30:00-05' - interval '1 day'
----
2024-11-02 01:30:00-04

# months, then days, then the time: each calendar step is one zone consult (two timezone units)
# timezone: America/New_York
# cost: 4
query T nosort
SELECT timestamptz '2024-03-09 12:00:00' + interval '1 month 1 day 1 hour'
----
2024-04-10 13:00:00-04

# timezone: America/New_York
# cost: 4
query T nosort
SELECT timestamptz '2024-03-09 23:30:00' + interval '1 month 1 day 1 hour'
----
2024-04-11 00:30:00-04

# interval + timestamptz commutes
# timezone: America/New_York
# cost: 3
query T nosort
SELECT interval '1 day' + timestamptz '2024-03-09 12:00:00'
----
2024-03-10 12:00:00-04

# ±infinity is unchanged and consults no zone
# timezone: America/New_York
# cost: 2
query T nosort
SELECT timestamptz 'infinity' + interval '1 day'
----
infinity

# a zero interval performs no step
# timezone: America/New_York
# cost: 2
query T nosort
SELECT timestamptz '2024-03-09 12:00:00' + interval '0'
----
2024-03-09 12:00:00-05

# a 30-minute DST zone
# timezone: Australia/Lord_Howe
# cost: 3
query T nosort
SELECT timestamptz '2024-04-06 12:00:00' + interval '1 day'
----
2024-04-07 12:00:00+10:30

# timezone: Australia/Lord_Howe
# cost: 3
query T nosort
SELECT timestamptz '2024-04-07 01:45:00' - interval '1 day'
----
2024-04-06 01:45:00+11

# under UTC a day is 24 h, as before
# cost: 3
query T nosort
SELECT timestamptz '2024-03-09 12:00:00+00' + interval '1 day'
----
2024-03-10 12:00:00+00

# a zoneless timestamp or date never consults the session zone (a day is 24 h)
# timezone: America/New_York
# cost: 2
query T nosort
SELECT timestamp '2024-03-09 12:00:00' + interval '1 day'
----
2024-03-10 12:00:00

# timezone: America/New_York
# cost: 2
query T nosort
SELECT date '2024-03-09' + interval '1 day'
----
2024-03-10 00:00:00

# ============================================================================================
# a string literal beside `+ timestamp[tz]` adapts to interval (PG: the only `timestamp + x`)
# ============================================================================================

# timezone: America/New_York
# cost: 3
query T nosort
SELECT timestamptz '2024-03-09 12:00:00' + '1 day'
----
2024-03-10 12:00:00-04

# cost: 2
query T nosort
SELECT timestamp '2024-01-01 00:00:00' + '1 day'
----
2024-01-02 00:00:00

# cost: 2
query T nosort
SELECT '1 day' + timestamp '2024-01-01 00:00:00'
----
2024-01-02 00:00:00

# a literal that is not an interval is the interval parser's 22007
statement error 22007
SELECT timestamp '2024-01-01 00:00:00' + 'x'

# `-` keeps the sibling's type: timestamp - timestamp
# cost: 2
query T nosort
SELECT timestamp '2024-01-01 00:00:00' - '2023-01-01 00:00:00'
----
365 days

# ============================================================================================
# index admission (index-dependencies.md): the session zone is a dependency unless the interval
# is a constant pure time-of-day span
# ============================================================================================

statement ok
CREATE TABLE ev (id i32 PRIMARY KEY, at timestamptz, local timestamp)

statement ok
INSERT INTO ev VALUES (1, timestamptz '2024-03-09 12:00:00+00', timestamp '2024-03-09 12:00:00')

statement error 42P17
CREATE INDEX ev_day ON ev ((at + interval '1 day'))

statement error 42P17
CREATE INDEX ev_month ON ev ((at - interval '1 month'))

# a zoneless timestamp shifts without the session zone
statement ok
CREATE INDEX ev_local_day ON ev ((local + interval '1 day'))

# a constant pure time-of-day interval never consults the zone: admitted (PostgreSQL rejects it as
# STABLE — a documented jed refinement, index-dependencies.md; ledgered in oracle_overrides.toml)
statement ok
CREATE INDEX ev_hour ON ev ((at + interval '1 hour'))

statement ok
CREATE INDEX ev_hour2 ON ev ((interval '90 minutes' + at))
