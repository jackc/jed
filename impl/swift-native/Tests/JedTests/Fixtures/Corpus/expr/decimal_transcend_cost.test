# Exact decimal transcendental step charges (cost.md §8). Values are PG-comparable; cost is jed-specific.
# requires: query.select, query.select_no_from, types.decimal, expr.numeric_transcendental, func.mixed_numeric_args, resource.cost_metering

# cost: 1097
query D nosort
SELECT sqrt(4.0)
----
2.000000000000000

# cost: 17909
query D nosort
SELECT exp(1.0)
----
2.7182818284590452

# cost: 77477
query D nosort
SELECT ln(2.0)
----
0.6931471805599453

# cost: 292138
query D nosort
SELECT log(100.0)
----
2.0000000000000000

# cost: 292138
query D nosort
SELECT log10(100.0)
----
2.0000000000000000

# cost: 242473
query D nosort
SELECT log(2.0, 8.0)
----
3.0000000000000000

# cost: 234498
query D nosort
SELECT power(2.0, 3.0)
----
8.0000000000000000

# cost: 234498
query D nosort
SELECT pow(2.0, -3.0)
----
0.1250000000000000

# cost: 149250
query D nosort
SELECT power(2.0, 0.5)
----
1.4142135623730950

# cost: 83
query D nosort
SELECT sqrt(0.0)
----
0.000000000000000

# cost: 1276
query D nosort
SELECT ln(1.0)
----
0.0000000000000000

# cost: 397585
query D nosort
SELECT exp(-1000.0)
----
0.

# A promoted integer argument (functions.md §9.2) is converted inside the kernel at scale 0, so the
# call charges the kernel's work over the converted value, and no cast — one less than the explicit
# log(2::numeric, 8.0), whose cast is its own expression.
# cost: 242454
query D nosort
SELECT log(2, 8.0)
----
3.0000000000000000

# cost: 242455
query D nosort
SELECT log(2::numeric, 8.0)
----
3.0000000000000000

# cost: 209148
query D nosort
SELECT power(2.5, 2)
----
6.2500000000000000
