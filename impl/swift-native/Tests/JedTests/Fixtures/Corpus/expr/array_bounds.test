# Array subscript bounds stay in the i32 domain (spec/design/array.md §7, array-functions.md §3.2),
# matching PostgreSQL's ReadArrayDimensions / ArrayCheckBounds / array_append / array_prepend: a
# literal's declared bound outside the i32 domain, an upper bound of exactly 2147483647, or a
# dimension length that overflows an i32 is 54000; array_append / array_cat keep `lb + len` within
# an i32 (54000 "array lower bound is too large") and an appended/prepended subscript that would
# leave the i32 domain is 22003; array_prepend keeps its lower bound and, as in PG, runs no bounds
# check after it. Subscript arithmetic (array_upper/array_position/element access) is exact at the
# extremes. Also array_cat's compatibility rule compares the inner LOWER BOUNDS as well as the inner
# lengths (2202E on a mismatch), and the lower-dimensional operand's outer lower bound is irrelevant.
# Oracle-pinned vs postgres:18. Format: ../../../design/conformance.md.
# requires: query.select, types.array, types.array_multidim, types.i32, func.array, resource.cost_metering

# --- literal dimension prefixes ---

statement error 54000
SELECT '[2147483647:2147483648]={1,2}'::i32[]

statement error 54000
SELECT '[2147483646:2147483647]={1,2}'::i32[]

# cost: 1
query T nosort
SELECT '[2147483645:2147483646]={1,2}'::i32[]
----
[2147483645:2147483646]={1,2}

statement error 54000
SELECT '[-2147483649:-2147483648]={1,2}'::i32[]

# cost: 1
query T nosort
SELECT '[-2147483648:-2147483647]={1,2}'::i32[]
----
[-2147483648:-2147483647]={1,2}

# A dimension length u-l+1 that overflows an i32.
statement error 54000
SELECT '[-2147483648:0]={1}'::i32[]

# A bound too long for any integer is the same out-of-range bound.
statement error 54000
SELECT '[1:99999999999999999999]={1}'::i32[]

# An inverted bound stays 2202E (checked before the limits).
statement error 2202E
SELECT '[1:0]={}'::i32[]

# --- subscript arithmetic at the extremes ---

# cost: 6
query TIIIT nosort
SELECT array_dims('[2147483645:2147483646]={1,2}'::i32[]), array_lower('[2147483645:2147483646]={1,2}'::i32[], 1), array_upper('[2147483645:2147483646]={1,2}'::i32[], 1), array_position('[2147483645:2147483646]={1,2}'::i32[], 2), array_positions('[2147483645:2147483646]={1,2}'::i32[], 2)
----
[2147483645:2147483646]
2147483645
2147483646
2147483646
{2147483646}

# cost: 3
query II nosort
SELECT ('[2147483645:2147483646]={1,2}'::i32[])[2147483646], ('[-2147483648:-2147483647]={1,2}'::i32[])[-2147483648]
----
2
1

# --- growth: array_append / || element ---

# The grown array would need lb + len = 2147483648.
statement error 54000
SELECT array_append('[2147483645:2147483646]={1,2}'::i32[], 3)

# cost: 2
query T nosort
SELECT array_append('[2147483645:2147483645]={1}'::i32[], 3)
----
[2147483645:2147483646]={1,3}

statement error 54000
SELECT '[2147483645:2147483646]={1,2}'::i32[] || 3

# cost: 2
query T nosort
SELECT '[2147483645:2147483645]={1}'::i32[] || 3
----
[2147483645:2147483646]={1,3}

# --- growth: array_prepend / element || ---

# The prepended element's provisional subscript lb - 1 leaves the i32 domain.
statement error 22003
SELECT array_prepend(0, '[-2147483648:-2147483648]={1}'::i32[])

statement error 22003
SELECT 0 || '[-2147483648:-2147483648]={1}'::i32[]

# The lower bound is preserved (PG readjusts it back to the input's).
# cost: 2
query T nosort
SELECT array_prepend(0, '[-2147483647:-2147483647]={1}'::i32[])
----
[-2147483647:-2147483646]={0,1}

# As in PG, no bounds check runs after that readjustment, so a prepend may reach an upper bound of
# exactly 2147483647 — and an append to the result is then 22003.
# cost: 2
query T nosort
SELECT array_prepend(0, '[2147483645:2147483646]={1,2}'::i32[])
----
[2147483645:2147483647]={0,1,2}

statement error 22003
SELECT array_append(array_prepend(0, '[2147483645:2147483646]={1,2}'::i32[]), 9)

# --- growth: array_cat / array || array ---

statement error 54000
SELECT '[2147483640:2147483645]={1,2,3,4,5,6}'::i32[] || '{1,2}'::i32[]

# cost: 2
query T nosort
SELECT '[2147483640:2147483645]={1,2,3,4,5,6}'::i32[] || '{1}'::i32[]
----
[2147483640:2147483646]={1,2,3,4,5,6,1}

# Stacking a 2-D [lb 2147483646] with one more outer slice needs lb + 2.
statement error 54000
SELECT '[2147483646:2147483646][1:2]={{1,2}}'::i32[] || '[1:2]={3,4}'::i32[]

# --- array_cat compatibility: inner lower bounds must match too ---

# A 1-D slice [1:2] cannot join a 2-D array whose inner lower bound is 5.
statement error 2202E
SELECT '[0:0][5:6]={{1,2}}'::i32[] || '[1:2]={3,4}'::i32[]

statement error 2202E
SELECT '[1:2]={3,4}'::i32[] || '[0:0][5:6]={{1,2}}'::i32[]

# A 1-D operand whose lower bound differs from a 1-D array's inner bound, in the 2-D form.
statement error 2202E
SELECT '[2147483645:2147483646]={1,2}'::i32[] || '[1:1][1:2]={{1,2}}'::i32[]

# Same dimensionality, differing inner lower bounds.
statement error 2202E
SELECT '[0:0][5:6]={{1,2}}'::i32[] || '[0:0][1:2]={{3,4}}'::i32[]

statement error 2202E
SELECT array_cat('[0:0][5:6]={{1,2}}'::i32[], '[0:0][1:2]={{3,4}}'::i32[])

# Matching inner bounds concatenate; the result lower bounds are the higher-dimensional operand's.
# cost: 2
query T nosort
SELECT '[0:0][5:6]={{1,2}}'::i32[] || '[5:6]={3,4}'::i32[]
----
[0:1][5:6]={{1,2},{3,4}}

# cost: 2
query T nosort
SELECT '[5:6]={3,4}'::i32[] || '[0:0][5:6]={{1,2}}'::i32[]
----
[0:1][5:6]={{3,4},{1,2}}

# The outer lower bounds of two same-dimensional operands may differ freely.
# cost: 2
query T nosort
SELECT '[0:0][5:6]={{1,2}}'::i32[] || '[7:7][5:6]={{3,4}}'::i32[]
----
[0:1][5:6]={{1,2},{3,4}}

# 3-D: the 2-D operand's bounds must equal the 3-D operand's inner two.
# cost: 2
query T nosort
SELECT '[0:0][1:1][5:6]={{{1,2}}}'::i32[] || '[1:1][5:6]={{3,4}}'::i32[]
----
[0:1][1:1][5:6]={{{1,2}},{{3,4}}}

statement error 2202E
SELECT '[0:0][1:1][5:6]={{{1,2}}}'::i32[] || '[2:2][5:6]={{3,4}}'::i32[]

# cost: 2
query T nosort
SELECT '[0:0][1:1][5:6]={{{1,2}}}'::i32[] || '[0:0][1:1][5:6]={{{3,4}}}'::i32[]
----
[0:1][1:1][5:6]={{{1,2}},{{3,4}}}

statement error 2202E
SELECT '[0:0][1:1][5:6]={{{1,2}}}'::i32[] || '[0:0][2:2][5:6]={{{3,4}}}'::i32[]
