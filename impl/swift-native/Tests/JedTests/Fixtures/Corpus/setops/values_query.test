# A VALUES list as a query (spec/design/grammar.md §25): a statement `VALUES (…), (…)` with a
# trailing ORDER BY / LIMIT / OFFSET, a set-operation operand, a WITH main query, a CTE / view /
# derived-table / scalar / IN / EXISTS / ANY subquery body, and an operand of an INSERT query source.
# It is the query SELECT * FROM (VALUES …) over a VALUES relation PostgreSQL labels *VALUES*: columns
# column1, column2, …, typed by the VALUES body's per-column unification (an all-NULL or all-string
# column is text), so it combines with a SELECT under the ordinary set-operation rules. A plain
# INSERT … VALUES list — also parenthesized — stays the INSERT VALUES source (DEFAULT slots,
# per-column typing); a bare DEFAULT in any other VALUES list is 42601. Rows verified against the
# live PostgreSQL 18 oracle; cost assertions are jed's deterministic cross-core contract
# (spec/design/cost.md §3).
# requires: query.values_query, query.values, query.values_order_by, query.union, query.intersect, query.except, query.setop_parenthesized, query.derived_table, query.lateral, query.cross_join, query.subquery_scalar, query.subquery_in, query.subquery_exists, query.subquery_quantified, query.cte, query.cte_nested, query.cte_recursive, query.cte_data_modifying, ddl.view, dml.view_write, ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, dml.insert_column_list, dml.insert_select, dml.insert_select_setop, dml.insert_on_conflict, dml.returning, query.select, query.select_star, query.select_no_from, query.where_eq, query.comparison_order, query.order_by, query.order_by_ordinal, query.order_by_expr, query.limit, query.offset, query.qualified_column, expr.arithmetic, types.i32, types.decimal, types.text, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a i32)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)

# --- a top-level VALUES query -----------------------------------------------------------------

# Columns are named column1, column2, …; each row is produced once by the VALUES relation and once
# by the wrapping query's scan.
# names: column1, column2
# types: i64, text
# cost: 4
query IT nosort
VALUES (1, 'a'), (2, 'b')
----
1
a
2
b

# A trailing ORDER BY names a column, an ordinal, or an expression over the columns.
# cost: 6
query IT nosort
VALUES (1, 'a'), (2, 'b'), (3, 'c') ORDER BY column1 DESC
----
3
c
2
b
1
a

# Per-row keys add 3 (cost.md §3 "sort_key / hash_key"): 5 before them.
# cost: 8
query IT nosort
VALUES (1, 'a'), (2, 'b'), (3, 'c') ORDER BY 2 DESC LIMIT 2 OFFSET 1
----
2
b
1
a

query I nosort
VALUES (3), (1), (2) ORDER BY column1 * -1
----
3
2
1

# A key may qualify the column with PostgreSQL's relation name for a VALUES list.
query I nosort
VALUES (3), (1) ORDER BY "*VALUES*".column1
----
1
3

query I nosort
VALUES (3), (1) LIMIT 1
----
3

statement error 42703
VALUES (1, 2) ORDER BY column3

statement error 42P10
VALUES (1, 2) ORDER BY 3

# Column types unify across rows exactly as a VALUES body's: int widens to decimal, NULL takes the
# other rows' type, an all-NULL column is text.
# types: decimal
query D nosort
VALUES (1), (2.5) ORDER BY 1
----
1
2.5

# types: i64, text
query IT nosort
VALUES (NULL, NULL), (1, NULL)
----
NULL
NULL
1
NULL

statement error 42804
VALUES (1), ('x'::text)

statement error 42601
VALUES (1), (1, 2)

# A value is a general expression, including a scalar subquery.
query IIT nosort
VALUES (1 + 1, (SELECT max(a) FROM t), upper('x'))
----
2
30
X

# A column reference has no FROM row to name.
statement error 42703
VALUES (a)

# DEFAULT is allowed only in an INSERT's own VALUES list.
statement error 42601
VALUES (DEFAULT)

statement error 42601
VALUES (1, DEFAULT)

statement error 42601
SELECT * FROM (VALUES (DEFAULT)) AS v

# A parenthesized VALUES query is the same query; its trailing clauses fold onto it.
query I nosort
(VALUES (3), (1), (2)) ORDER BY 1 LIMIT 2
----
1
2

statement error 42601
(VALUES (3), (1) ORDER BY 1) ORDER BY 1

# --- as a set-operation operand ----------------------------------------------------------------

# A SELECT and a VALUES list combine under the set-operation rules; the left operand names the
# columns.
# names: id
# cost: 11
query I rowsort
SELECT id FROM t UNION VALUES (2), (4)
----
1
2
3
4

# names: column1
query I rowsort
VALUES (2), (4) EXCEPT SELECT id FROM t
----
4

query I rowsort
VALUES (1), (1), (2) INTERSECT ALL SELECT id FROM t
----
1
2

# names: column1, column2
# cost: 4
query IT rowsort
VALUES (1, 'a') UNION ALL VALUES (2, 'b')
----
1
a
2
b

# The combined result's ORDER BY / LIMIT names the left operand's columns.
query I nosort
VALUES (1) UNION VALUES (3) UNION SELECT a FROM t ORDER BY column1 DESC LIMIT 3
----
30
20
10

# INTERSECT binds tighter: 1 UNION (2 INTERSECT 3) -> just 1.
query I rowsort
VALUES (1) UNION VALUES (2) INTERSECT VALUES (3)
----
1

# Parenthesized operands, one with its own ORDER BY / LIMIT.
query I nosort
(VALUES (1)) UNION (VALUES (3), (2) ORDER BY 1 LIMIT 1) ORDER BY column1
----
1
2

# Types unify across operands: integer with decimal is decimal.
# types: decimal
query D rowsort
VALUES (1) UNION ALL SELECT 2.5
----
1
2.5

# A VALUES list's all-NULL or string column is already text, so it does not meet an integer
# (PostgreSQL: UNION types integer and text cannot be matched).
statement error 42804
SELECT 1 UNION VALUES (NULL)

statement error 42804
VALUES ('1') UNION SELECT 1

# types: text
query T rowsort
VALUES (NULL) UNION SELECT 'x'
----
NULL
x

statement error 42601
VALUES (1) UNION VALUES (1, 2)

# The combined result has no relation scope: *VALUES* names nothing there.
statement error 42P01
VALUES (1) UNION VALUES (2) ORDER BY "*VALUES*".column1

# An operand takes no trailing clause of its own without parentheses.
statement error 42601
VALUES (1) ORDER BY 1 UNION VALUES (2)

statement error 42601
SELECT 1 UNION VALUES (DEFAULT)

# --- in WITH, derived tables, subqueries, and views ---------------------------------------------

# cost: 6
query I nosort
WITH v AS (VALUES (1), (2)) SELECT * FROM v ORDER BY 1
----
1
2

# names: x, column2
query IT nosort
WITH v (x) AS (VALUES (1, 'a'), (2, 'b')) SELECT * FROM v ORDER BY x DESC
----
2
b
1
a

# A VALUES main query under WITH.
query I nosort
WITH w AS (SELECT max(a) AS m FROM t) VALUES ((SELECT m FROM w)), (0) ORDER BY 1
----
0
30

# A recursive CTE's non-recursive term.
query I nosort
WITH RECURSIVE r (n) AS (VALUES (1) UNION ALL SELECT n + 1 FROM r WHERE n < 3) SELECT n FROM r ORDER BY n
----
1
2
3

# A derived table whose body is a set operation over VALUES lists.
# cost: 6
query I rowsort
SELECT * FROM (VALUES (1) UNION ALL VALUES (2)) AS v
----
1
2

query I rowsort
SELECT x FROM (VALUES (1), (2) EXCEPT SELECT id FROM t WHERE id = 1) AS v (x)
----
2

# A LATERAL body over a set operation sees the earlier FROM relation.
query II rowsort
SELECT t.id, v.x FROM t, LATERAL (VALUES (t.a) UNION ALL VALUES (t.a + 1)) AS v (x) WHERE t.id = 1
----
1
10
1
11

# Scalar, IN, EXISTS, and ANY subqueries.
# cost: 3
query I nosort
SELECT (VALUES (5))
----
5

query I nosort
SELECT (VALUES (3), (1) ORDER BY 1 LIMIT 1)
----
1

query I rowsort
SELECT id FROM t WHERE id IN (VALUES (1), (3))
----
1
3

query I rowsort
SELECT id FROM t WHERE id NOT IN (VALUES (1) UNION VALUES (3))
----
2

query I rowsort
SELECT id FROM t WHERE EXISTS (VALUES (1))
----
1
2
3

query I rowsort
SELECT id FROM t WHERE a > ALL (VALUES (10), (15))
----
2
3

# A correlated VALUES subquery.
query II rowsort
SELECT id, (VALUES (a * 2)) FROM t
----
1
20
2
40
3
60

statement error 21000
SELECT (VALUES (1), (2))

# A view defined by a VALUES list.
statement ok
CREATE VIEW vv AS VALUES (1, 'a'), (2, 'b')

# names: column1, column2
query IT nosort
SELECT * FROM vv ORDER BY column1 DESC
----
2
b
1
a

# It has no base relation to write through.
statement error 55000
INSERT INTO vv VALUES (3, 'c')

statement ok
CREATE VIEW vu (n) AS SELECT id FROM t UNION VALUES (9)

query I rowsort
SELECT n FROM vu
----
1
2
3
9

# --- as an INSERT source -----------------------------------------------------------------------

statement ok
CREATE TABLE u (id i32 PRIMARY KEY, s text DEFAULT 'dflt')

# A plain VALUES list, also parenthesized, is the INSERT's own VALUES source: DEFAULT slots work.
statement ok
INSERT INTO u (VALUES (1, DEFAULT))

statement ok
INSERT INTO u ((VALUES (2, 'b'), (3, DEFAULT)))

statement ok
INSERT INTO u (id) (VALUES (4))

query IT nosort
SELECT * FROM u ORDER BY id
----
1
dflt
2
b
3
dflt
4
dflt

statement ok
DELETE FROM u

# A set operator or a trailing ORDER BY / LIMIT makes the source a query whose operand is a VALUES
# list.
# cost: 3
statement ok
INSERT INTO u VALUES (1, 'a') UNION ALL SELECT 2, 'b'

query IT rowsort
INSERT INTO u VALUES (5, 'e'), (4, 'd') ORDER BY 1 LIMIT 1 RETURNING *
----
4
d

query IT rowsort
INSERT INTO u (VALUES (6, 'f')) UNION (VALUES (7, 'g')) RETURNING *
----
6
f
7
g

query IT rowsort
INSERT INTO u (VALUES (9, 'i'), (8, 'h') ORDER BY 1 LIMIT 1) RETURNING id, s
----
8
h

query IT rowsort
INSERT INTO u (id) VALUES (10) UNION ALL VALUES (11) RETURNING *
----
10
dflt
11
dflt

query IT nosort
SELECT * FROM u ORDER BY id
----
1
a
2
b
4
d
6
f
7
g
8
h
10
dflt
11
dflt

# Such a VALUES list takes no DEFAULT.
statement error 42601
INSERT INTO u VALUES (12, DEFAULT) UNION SELECT 13, 'm'

statement error 42601
INSERT INTO u VALUES (12, DEFAULT) ORDER BY 1

# Its column types are the VALUES list's own: a string or all-NULL column is text, which an integer
# target does not take (PostgreSQL agrees).
statement error 42804
INSERT INTO t VALUES (4, '40') UNION ALL VALUES (5, '50')

statement error 42804
INSERT INTO t VALUES (4, NULL) UNION ALL SELECT 5, NULL

# ON CONFLICT and a WITH-prefixed source.
query IT rowsort
INSERT INTO u VALUES (1, 'x') UNION ALL VALUES (12, 'l') ON CONFLICT (id) DO UPDATE SET s = excluded.s RETURNING *
----
1
x
12
l

query IT rowsort
INSERT INTO u WITH w AS (SELECT 13 AS k) VALUES ((SELECT k FROM w), 'm') RETURNING *
----
13
m

# A VALUES operand in a writable CTE's INSERT source.
query I rowsort
WITH ins AS (INSERT INTO u VALUES (14, 'n') UNION ALL VALUES (15, 'o') RETURNING id) SELECT id FROM ins
----
14
15

query I nosort
SELECT count(*) FROM u
----
12

# An INSERT's own VALUES list inside a writable CTE keeps its DEFAULT slots, also right before the
# CTE's closing parenthesis.
statement ok
WITH ins AS (INSERT INTO u VALUES (16, DEFAULT)) SELECT 1

query T nosort
SELECT s FROM u WHERE id = 16
----
dflt

query IT rowsort
WITH ins AS (INSERT INTO u (VALUES (17, DEFAULT)) RETURNING *) SELECT * FROM ins
----
17
dflt
