# The parameter-time LIKE pattern proof (spec/design/planner.md §3.5, estimator.md §6.1). A LIKE moves
# to its relation only when its pattern provably cannot trap: a plan-time literal that is NULL or has
# no unpaired trailing escape. A parameter pattern is read through the custom-plan frame, so the probe
# plan marks the statement parameter-sensitive and each execution plans with its binding: bound to a
# safe pattern the conjunct moves, exactly as its literal twin does; bound to a pattern ending in a
# lone escape it stays in the residual, where the trap is raised as joined rows reach it. EXPLAIN
# still renders the parameter symbolically. The plans and costs are jed-owned, so this file is
# cross-core checked, not oracle-checked.
# requires: harness.params, ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.where_eq, query.qualified_column, query.join_inner, query.join_pushdown, query.hash_join, query.index_nested_loop, query.where_pushdown, query.safe_conjunct_gate, query.explain, query.order_by, expr.like, expr.ilike, null.three_valued, types.i32, types.text, resource.cost_metering

statement ok
CREATE TABLE a (id i32 PRIMARY KEY, s text)

statement ok
CREATE TABLE b (id i32 PRIMARY KEY, aid i32, w i32)

statement ok
INSERT INTO a VALUES (1, 'alpha'), (2, 'Beta'), (3, 'ab'), (4, NULL), (5, 'abcde'), (6, 'a\b')

statement ok
INSERT INTO b VALUES (10, 1, 100), (11, 2, 200), (12, 3, 300), (13, 5, 500), (14, 5, 501), (15, 7, 700), (16, 4, 4000), (17, 6, 60)

# A safe binding: the LIKE runs on a's Scan, exactly as the literal twin below.
# params: 'ab%'
query ITTII nosort
EXPLAIN SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE a.s LIKE $1
----
0
Nested Loop
inner; on:conjuncts=1
1
31
1
Scan a
Full scan; touched=2; filter:conjuncts=1
1
13
1
Scan b
Full scan; touched=2
8
9

