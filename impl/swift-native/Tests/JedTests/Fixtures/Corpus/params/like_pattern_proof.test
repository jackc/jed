# A NULL pattern never matches and never traps, so it moves too: a's scan rejects every row.
# params: NULL
# cost: 22
query II nosort
SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE a.s ILIKE $1 ORDER BY b.w
----

# A binding ending in a lone escape is not proven: the LIKE stays in the residual ...
# params: 'ab\'
query ITTII nosort
EXPLAIN SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE a.s LIKE $1
----
0
Filter
conjuncts=1
1
42
1
Nested Loop
inner; on:conjuncts=1
8
33
2
Scan b
Full scan; touched=2
8
9
2
Scan a
Index-nested-loop PK bound: id = join; touched=2
8
16

# ... where it traps as the joined rows reach it, as the literal spelling does.
# params: 'ab\'
statement error 22025
SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE a.s LIKE $1

statement error 22025
SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE a.s LIKE 'ab\'

# An escape that pairs with the next character is safe: 'a\\b' matches the literal 'a\b'.
# params: 'a\\b'
# cost: 31
query II nosort
SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE a.s LIKE $1 ORDER BY b.w
----
6
60
