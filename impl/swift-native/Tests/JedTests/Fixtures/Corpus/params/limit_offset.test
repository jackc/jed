# A bind parameter as the LIMIT / OFFSET count (spec/design/grammar.md §9): `LIMIT $1 OFFSET $2`.
# The parameter is typed i64 and read from its bound value when the statement is planned — every
# execution takes its custom plan (estimator.md §6.1) — so a bound record's rows and cost equal its
# literal twin's (the plans and EXPLAIN's Limit node are pinned in custom_plans.test). As in
# PostgreSQL, a NULL count is no limit (LIMIT ALL) / no offset (OFFSET 0), and a negative bound
# count is 2201W (LIMIT) / 2201X (OFFSET), raised before any row is read.
# Format + the `requires` directive: ../../../design/conformance.md.
# requires: harness.params, query.limit_param, ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.where_eq, query.comparison_order, query.order_by, query.order_by_keys, query.limit, query.offset, query.limit_short_circuit, query.order_by_pk_scan, query.subquery_in, query.subquery_scalar, query.derived_table, query.cte, query.union, types.i32, types.i64, types.text, null.three_valued, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, val i32)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30), (4, 40), (5, 50), (6, 60)

# --- the bound record and its literal twin read, plan and cost the same --------------------------

# params: 2, 1
# cost: 6
query II nosort
SELECT id, val FROM t ORDER BY id LIMIT $1 OFFSET $2
----
2
20
3
30

# cost: 6
query II nosort
SELECT id, val FROM t ORDER BY id LIMIT 2 OFFSET 1
----
2
20
3
30

# Either order, and each clause alone.
# params: 3, 2
query I nosort
SELECT id FROM t ORDER BY id OFFSET $1 LIMIT $2
----
4
5

# params: 4
query I nosort
SELECT id FROM t ORDER BY id OFFSET $1
----
5
6

# params: 0
query I nosort
SELECT id FROM t ORDER BY id LIMIT $1
----

# One parameter may be both counts.
# params: 2
query I nosort
SELECT id FROM t ORDER BY id LIMIT $1 OFFSET $1
----
3
4

# A count parameter shares its index with a WHERE parameter: the i32 context and the count's i64
# unify to i64.
# params: 3
query I nosort
SELECT id FROM t WHERE id > $1 ORDER BY id LIMIT $1
----
4
5
6

# A count past the end is the whole (or empty) remainder.
# params: 100, 4
query I nosort
SELECT id FROM t ORDER BY id LIMIT $1 OFFSET $2
----
5
6

# params: 1, 100
query I nosort
SELECT id FROM t ORDER BY id LIMIT $1 OFFSET $2
----

# --- NULL is no limit / no offset ------------------------------------------------------------------

# params: NULL, 4
query I nosort
SELECT id FROM t ORDER BY id LIMIT $1 OFFSET $2
----
5
6

# params: 2, NULL
query I nosort
SELECT id FROM t ORDER BY id LIMIT $1 OFFSET $2
----
1
2

# params: NULL, NULL
query I nosort
SELECT id FROM t ORDER BY id LIMIT $1 OFFSET $2
----
1
2
3
4
5
6

# --- a negative count is a data error ---------------------------------------------------------------

# params: -1
statement error 2201W
SELECT id FROM t LIMIT $1

# params: -1
statement error 2201X
SELECT id FROM t OFFSET $1

# A count binds as i64: a text value is the wrong family.
# params: 'two'
statement error 42804
SELECT id FROM t LIMIT $1

# A parameter index with no binding is the count mismatch.
statement error 42601
SELECT id FROM t LIMIT $1

# --- inner queries --------------------------------------------------------------------------------

# A derived table.
# params: 2
query I rowsort
SELECT id FROM (SELECT id FROM t ORDER BY id DESC LIMIT $1) AS d
----
5
6

# A CTE.
# params: 1, 2
query I rowsort
WITH c AS (SELECT id FROM t ORDER BY id LIMIT $1 OFFSET $2) SELECT id FROM c
----
3

# A scalar subquery.
# params: 3
query I nosort
SELECT (SELECT val FROM t ORDER BY id OFFSET $1 LIMIT 1)
----
40

# An IN subquery.
# params: 2
query I rowsort
SELECT id FROM t WHERE id IN (SELECT id FROM t ORDER BY val DESC LIMIT $1)
----
5
6

# A set operation's trailing clauses.
# params: 2, 1
query I nosort
SELECT id FROM t WHERE id < 3 UNION SELECT id FROM t WHERE id > 4 ORDER BY 1 LIMIT $1 OFFSET $2
----
2
5

# A view body has no parameters.
statement error 42P02
CREATE VIEW v AS SELECT id FROM t LIMIT $1
