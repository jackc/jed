# jed_columns.identity_generation (spec/design/introspection.md §5) and its reflection of ALTER
# TABLE identity management (spec/design/alter.md §2.8): ALWAYS / BY DEFAULT for an identity
# column, NULL otherwise (a serial column included). jed-specific, so CROSS-CORE-checked, NOT
# PostgreSQL-oracle-checked.
# requires: introspect.columns, ddl.alter_identity, ddl.alter_table, ddl.identity, ddl.serial, ddl.create_table, query.select, query.where_eq, query.order_by, types.i16, types.i32, types.i64, types.text

statement ok
CREATE TABLE seqd (s serial, g i64 GENERATED ALWAYS AS IDENTITY, b i16 GENERATED BY DEFAULT AS IDENTITY)

# identity_generation names an identity column's ALWAYS / BY DEFAULT; NULL otherwise (serial included)
query TT nosort
SELECT name, identity_generation FROM jed_columns WHERE table_name = 'seqd' ORDER BY ordinal
----
s
NULL
g
ALWAYS
b
BY DEFAULT

# ALTER TABLE identity management is reflected (alter.md §2.8)
statement ok
ALTER TABLE seqd ALTER g SET GENERATED BY DEFAULT, ALTER b DROP IDENTITY

query TTT nosort
SELECT name, column_default, identity_generation FROM jed_columns WHERE table_name = 'seqd' ORDER BY ordinal
----
s
nextval ( 'seqd_s_seq' )
NULL
g
nextval ( 'seqd_g_seq' )
BY DEFAULT
b
NULL
NULL

statement ok
ALTER TABLE seqd ALTER b ADD GENERATED ALWAYS AS IDENTITY (SEQUENCE NAME "Seqd B")

query TTT nosort
SELECT name, column_default, identity_generation FROM jed_columns WHERE table_name = 'seqd' AND name = 'b'
----
b
nextval ( '"Seqd B"' )
ALWAYS
