# Aggregate covar_samp(Y, X) (spec/design/aggregates.md §23): the sample covariance of the (Y, X) pairs whose arguments are both non-NULL, NULL over fewer than two pairs. Like PostgreSQL, which defines it
# only over float8, it takes any two numeric arguments, widens each to f64 as a cast to float8 does,
# and computes PostgreSQL's float8 algorithm with an f64 result. A pair with a NULL is skipped. Output
# name `covar_samp`.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.aggregates, query.group_by, query.aggregate_distinct, query.aggregate_filter, query.window_aggregate, types.i32, types.decimal, types.f32, types.f64, resource.cost_metering, func.covar_samp, func.covar_pop

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, g i32, y i32, x i32, dy numeric(6,2), dx numeric(6,1), fy f64, fx f64, ry f32, rx f32)

statement ok
INSERT INTO t VALUES (1, 1, 1, 2, 1.50, 2.0, 1, 2, 1, 2), (2, 1, 3, 5, 2.25, 5.5, 3, 5, 3, 5), (3, 1, 4, 4, NULL, 4.5, 4, 4, 4, 4), (4, 1, 8, 9, 8.00, 9.0, 8, 9, 8, 9), (5, 2, NULL, 1, 1.00, NULL, NULL, 1, NULL, 1), (6, 2, 2, 3, 2.00, 3.0, 2, 3, 2, 3)

# The arguments travel as one row: 6 rows read + 1 leaf page read + 6 row packs + 6 accumulated + 1
# produced.
# names: covar_samp
# cost: 20
query R nosort
SELECT covar_samp(fy, fx) FROM t
----
7.05

# f32 arguments widen to f64.
# names: covar_samp
query R nosort
SELECT covar_samp(ry, rx) FROM t
----
7.05

# names: g, covar_samp
query IR rowsort
SELECT g, covar_samp(fy, fx) FROM t GROUP BY g
----
1
8.333333333333334
2
NULL

# One pair, and none (a pair with a NULL is skipped).
# names: covar_samp
query R nosort
SELECT covar_samp(fy, fx) FROM t WHERE id = 6
----
NULL

# names: covar_samp
query R nosort
SELECT covar_samp(fy, fx) FROM t WHERE id = 5
----
NULL

# names: covar_samp
query R nosort
SELECT covar_samp(fy, fx * 2) FILTER (WHERE id > 1) FROM t
----
13.166666666666666

# names: id, covar_samp
query IR nosort
SELECT id, covar_samp(fy, fx) OVER (ORDER BY id) FROM t ORDER BY id
----
1
NULL
2
3
3
1.8333333333333333
4
8.333333333333334
5
8.333333333333334
6
7.05

# names: covar_samp
query R nosort
SELECT covar_samp(y, x) FROM (VALUES (1.0::f64, 'Infinity'::f64), (2.0::f64, 3.0::f64)) v(y, x)
----
NaN

statement error 22003
SELECT covar_samp(y, x) FROM (VALUES (1e308::f64, 1.0::f64), (-1e308::f64, 2.0::f64)) v(y, x)

# Integer and decimal arguments widen to f64, in any mix with each other and with floats.
# names: covar_samp
# cost: 20
query R nosort
SELECT covar_samp(y, x) FROM t
----
7.05

# names: covar_samp, covar_samp, covar_samp
query RRR nosort
SELECT covar_samp(dy, dx), covar_samp(y, dx), covar_samp(fy, x) FROM t
----
8.78125
7.025
7.05

# names: g, covar_samp
query IR rowsort
SELECT g, covar_samp(dy, x) FROM t GROUP BY g
----
1
11.791666666666666
2
1

# names: covar_samp
query R nosort
SELECT covar_samp(DISTINCT y, y) FROM t
----
7.300000000000001

# Wide decimals widen like any other: no decimal arithmetic is charged.
statement ok
CREATE TABLE big (id i32 PRIMARY KEY, y numeric, x numeric)

statement ok
INSERT INTO big VALUES (1, 123456789012.123456789, 5), (2, -987654321098.987654321, 6.25), (3, 5, 31415926535.8979)

# names: covar_samp
# cost: 11
query R nosort
SELECT covar_samp(y, x) FROM big
----
4.5249276956524843e+21

statement error 42883
SELECT covar_samp(y, s) FROM (VALUES (1, 'a')) v(y, s)

statement error 42883
SELECT covar_samp(y) FROM t
