# Aggregate variance(x) (spec/design/aggregates.md §23): PostgreSQL's historical alias for var_samp —
# exact over integer or decimal input (a decimal result), f64 over float input. Output name
# `variance`.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.aggregates, query.group_by, query.window_aggregate, types.i32, types.decimal, types.f64, resource.cost_metering, func.variance, func.var_samp

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, g i32, a i32, d numeric(6,1), f f64)

statement ok
INSERT INTO t VALUES (1, 1, 2, 0.5, 2.0), (2, 1, 4, 1.5, 4.0), (3, 1, 9, NULL, 9.0), (4, 2, 5, 2.5, 5.0)

# names: variance
# cost: 10
query D nosort
SELECT variance(a) FROM t
----
8.6666666666666667

# names: g, variance, var_samp
query IDD rowsort
SELECT g, variance(d), var_samp(d) FROM t GROUP BY g
----
1
0.50000000000000000000
0.50000000000000000000
2
NULL
NULL

# names: variance
query R nosort
SELECT variance(f) FROM t
----
8.666666666666666

# names: id, variance
query IR nosort
SELECT id, variance(f) OVER (ORDER BY id) FROM t ORDER BY id
----
1
NULL
2
2
3
13
4
8.666666666666666

statement error 42883
SELECT variance(id::text) FROM t
