# JSON_SCALAR(expr) of every value type (spec/design/json-sql-functions.md §5.2). PostgreSQL's
# JSCTOR_JSON_SCALAR converts its argument with datum_to_json, so JSON_SCALAR is to_json's JSON image
# (§2.2): date/timestamp/timestamptz are ISO 8601 strings (a timestamptz in the session zone);
# interval/uuid/bytea/range/jsonpath are the string of their text output; an array nests, a composite
# is an object, a json value embeds verbatim, a jsonb value its spaced canonical text. A bare string
# literal is text. Output matches the postgres:18 oracle.
# Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.secondary_index, ddl.index_expr, dml.insert, query.select, query.select_no_from, query.order_by, types.composite, types.array, types.json, types.jsonb, types.jsonpath, types.i16, types.i32, types.i64, types.text, types.boolean, types.decimal, types.f64, types.date, types.timestamp, types.timestamptz, types.interval, types.uuid, types.bytea, types.range, func.range_constructors, cast.explicit, cast.operator, session.timezone, func.json_ctor, expr.is_json

# load-timezone: Asia/Kolkata
# load-timezone: America/New_York

# --- the scalar sources ---

# Numbers stay exact, text is an escaped string, a bare string literal is text.
query TTTTT nosort
SELECT JSON_SCALAR(1::i16), JSON_SCALAR(9223372036854775807), JSON_SCALAR('-0.000'::decimal), JSON_SCALAR(chr(1) || ' tab' || chr(9) || ' "q"'), JSON_SCALAR('hi')
----
1
9223372036854775807
0.000
"\u0001 tab\t \"q\""
"hi"

# Datetimes: ISO 8601 strings — a T separator, a trimmed fraction, ±infinity as words, a BC suffix.
query TTTTT nosort
SELECT JSON_SCALAR(date '2024-01-15'), JSON_SCALAR(timestamp '2024-01-15 10:30:00.5'), JSON_SCALAR(date 'infinity'), JSON_SCALAR(timestamptz '-infinity'), JSON_SCALAR(timestamp '0044-03-15 10:00:00 BC')
----
"2024-01-15"
"2024-01-15T10:30:00.5"
"infinity"
"-infinity"
"0044-03-15T10:00:00 BC"

query T nosort
SELECT JSON_SCALAR(date '0044-03-15 BC')
----
"0044-03-15 BC"

# A timestamptz renders in the session zone, with an offset of at least hours and minutes.
query T nosort
SELECT JSON_SCALAR(timestamptz '2024-01-15 12:00:00.25+00')
----
"2024-01-15T12:00:00.25+00:00"

# timezone: Asia/Kolkata
query T nosort
SELECT JSON_SCALAR(timestamptz '2024-01-15 12:00:00+00')
----
"2024-01-15T17:30:00+05:30"

# timezone: America/New_York
query TTT nosort
SELECT JSON_SCALAR(timestamptz '1880-01-01 00:00:00+00'), JSON_SCALAR(tstzrange('2024-01-01 00:00+00', '2024-01-02 00:00+00')), JSON_SCALAR(ARRAY[timestamptz '2024-01-15 12:00+00'])
----
"1879-12-31T19:03:58-04:56:02"
"[\"2023-12-31 19:00:00-05\",\"2024-01-01 19:00:00-05\")"
["2024-01-15T07:00:00-05:00"]

# Every other type is the JSON string of its text output.
query TTTTT nosort
SELECT JSON_SCALAR(interval '1 day 02:00:00'), JSON_SCALAR(uuid 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'), JSON_SCALAR('\x0102'::bytea), JSON_SCALAR(int4range(1, 5)), JSON_SCALAR('$.a[*] ? (@ > 1)'::jsonpath)
----
"1 day 02:00:00"
"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
"\\x0102"
"[1,5)"
"$.\"a\"[*]?(@ > 1)"

# --- the non-scalar sources: PostgreSQL does not restrict JSON_SCALAR to scalars ---

# Arrays nest (lower bounds dropped; an empty array is []); a json element stays verbatim, a jsonb
# element renders spaced.
query TTTTT nosort
SELECT JSON_SCALAR('{{1,2},{3,4}}'::i32[]), JSON_SCALAR('[2:3]={5,6}'::i32[]), JSON_SCALAR('{}'::i32[]), JSON_SCALAR(ARRAY['{"a" :1}'::json]), JSON_SCALAR(ARRAY['{"a":1}'::jsonb])
----
[[1,2],[3,4]]
[5,6]
[]
[{"a" :1}]
[{"a": 1}]

# A composite is an object in declaration order; an anonymous ROW names its fields f1, f2, ….
statement ok
CREATE TYPE pair AS (zz i32, a text)

query TTT nosort
SELECT JSON_SCALAR('(5,b)'::pair), JSON_SCALAR(ROW(NULL, ARRAY[1])), JSON_SCALAR(ROW())
----
{"zz":5,"a":"b"}
{"f1":null,"f2":[1]}
{}

# A json value embeds verbatim, a jsonb value its canonical spaced text.
query TT nosort
SELECT JSON_SCALAR('{"a" :1}'::json), JSON_SCALAR('{"b":1, "a":2}'::jsonb)
----
{"a" :1}
{"a": 2, "b": 1}

# The result is json: IS JSON SCALAR holds for a scalar source, not for an array source.
query BBB nosort
SELECT JSON_SCALAR(date '2024-01-15') IS JSON SCALAR, JSON_SCALAR(uuid 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11') IS JSON SCALAR, JSON_SCALAR(ARRAY[1]) IS JSON SCALAR
----
true
true
false

# --- over stored columns ---

statement ok
CREATE TABLE ev (id i32 PRIMARY KEY, d date, at timestamptz, u uuid, b bytea, iv interval, r int4range, p pair, tags text[])

statement ok
INSERT INTO ev VALUES (1, '2024-01-15', '2024-01-15 12:00:00+00', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', '\xdead', '1 year 2 mons', '[1,10)', '(1,x)'::pair, ARRAY['a', NULL])

statement ok
INSERT INTO ev (id) VALUES (2)

query ITTTTTTTT nosort
SELECT id, JSON_SCALAR(d), JSON_SCALAR(at), JSON_SCALAR(u), JSON_SCALAR(b), JSON_SCALAR(iv), JSON_SCALAR(r), JSON_SCALAR(p), JSON_SCALAR(tags) FROM ev ORDER BY id
----
1
"2024-01-15"
"2024-01-15T12:00:00+00:00"
"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
"\\xdead"
"1 year 2 mons"
"[1,10)"
{"zz":1,"a":"x"}
["a",null]
2
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL

# --- session zone ---

# A JSON_SCALAR that renders a timestamptz follows the session zone, so it cannot be an index
# expression; one over a number can.
statement ok
CREATE TABLE stamps (id i32 PRIMARY KEY, at timestamptz, ats timestamptz[], rs tstzrange, n decimal)

statement error 42P17
CREATE INDEX stamps_at ON stamps ((JSON_SCALAR(at)::text))

statement error 42P17
CREATE INDEX stamps_ats ON stamps ((JSON_SCALAR(ats)::text))

statement error 42P17
CREATE INDEX stamps_rs ON stamps ((JSON_SCALAR(rs)::text))

statement ok
CREATE INDEX stamps_n ON stamps ((JSON_SCALAR(n)::text))

# A float source, and every other float conversion to JSON, is in float_sources.test.
