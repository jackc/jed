# jsonpath item-method edge cases (spec/design/jsonpath.md §2-§5), oracle-imported: .keyvalue() ids
# through filters, wildcards and nested pairs; lax/strict unwrapping of methods; methods in filter
# operands (an operand error is unknown); existence tests stopping at the first item; the silent
# @? / @@ operators; the SQL/JSON functions over method results; strict subscripts; literal
# primaries and number-literal parsing; the method render. Output matches the postgres:18 oracle.
# Format: ../../../design/conformance.md.
# requires: query.select, types.jsonpath, func.jsonb_path, expr.jsonpath_filter, expr.jsonpath_match, expr.jsonpath_methods, expr.json_query_fns

query T nosort
SELECT jsonb_path_query_array('{"a": {"b": {"c": 1}}}', '$.a.keyvalue().value.keyvalue()')
----
[{"id": 20000000052, "key": "c", "value": 1}]

query T nosort
SELECT jsonb_path_query_array('{"a": {"b": {"c": 1}}}', '$.*.keyvalue()')
----
[{"id": 16, "key": "b", "value": {"c": 1}}]

query T nosort
SELECT jsonb_path_query_array('{"a": {"b": {"c": 1}}}', '$.a ? (@.b.c == 1).keyvalue()')
----
[{"id": 16, "key": "b", "value": {"c": 1}}]

statement error 2203C
SELECT jsonb_path_query_array('{"a": [{"x": 1}, {"y": [2, {"z": 3}]}]}', '$.a[*].keyvalue().value[*].keyvalue()')

query T nosort
SELECT jsonb_path_query_array('{"a": [{"x": 1}, {"y": [2, {"z": 3}]}]}', '$.a[1].y[1].keyvalue()')
----
[{"id": 88, "key": "z", "value": 3}]

query T nosort
SELECT jsonb_path_query_array('{"aaaa": "bbbbbbb", "a": [1, 2.5, -3e5, true, null, "str"], "zz": {"q": {}}}', '$.zz.keyvalue()')
----
[{"id": 96, "key": "q", "value": {}}]

query T nosort
SELECT jsonb_path_query_array('{"aaaa": "bbbbbbb", "a": [1, 2.5, -3e5, true, null, "str"], "zz": {"q": {}}}', '$.zz.q.keyvalue()')
----
[]

query T nosort
SELECT jsonb_path_query_array('{"aaaa": "bbbbbbb", "a": [1, 2.5, -3e5, true, null, "str"], "zz": {"q": {"r": 1}}}', '$.zz.q.keyvalue()')
----
[{"id": 112, "key": "r", "value": 1}]

query T nosort
SELECT jsonb_path_query_array('{"k": {"x": 1}}', '$.keyvalue().keyvalue().keyvalue()')
----
[{"id": 30000000000, "key": "id", "value": 20000000000}, {"id": 30000000000, "key": "key", "value": "id"}, {"id": 30000000000, "key": "value", "value": 0}, {"id": 70000000000, "key": "id", "value": 20000000000}, {"id": 70000000000, "key": "key", "value": "key"}, {"id": 70000000000, "key": "value", "value": "k"}, {"id": 110000000000, "key": "id", "value": 20000000000}, {"id": 110000000000, "key": "key", "value": "value"}, {"id": 110000000000, "key": "value", "value": {"x": 1}}]

statement error 2203C
SELECT jsonb_path_query_array('{"k": {"x": 1}, "longerkey": {"y": {"z": 2}}}', '$.keyvalue().value.keyvalue().value.keyvalue()')

