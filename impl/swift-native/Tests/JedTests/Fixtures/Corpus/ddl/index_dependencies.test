# Indexed and forced full-scan results agree across a DST transition.
query I nosort
SELECT id FROM events WHERE (closed AT TIME ZONE 'America/New_York')::date >= DATE '2024-01-01' AND account = 7 ORDER BY id
----
1
4

query I nosort
SELECT id FROM events WHERE CASE WHEN (closed AT TIME ZONE 'America/New_York')::date >= DATE '2024-01-01' AND account = 7 THEN true ELSE false END ORDER BY id
----
1
4

