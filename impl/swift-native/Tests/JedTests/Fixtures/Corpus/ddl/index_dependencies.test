statement ok
CREATE INDEX safe_0 ON events (account) WHERE closed IS NOT NULL

statement ok
CREATE INDEX safe_1 ON events (account) WHERE closed > TIMESTAMPTZ '2024-01-01 00:00:00+00'

statement ok
CREATE INDEX safe_2 ON events (account) WHERE closed IS DISTINCT FROM TIMESTAMPTZ '2024-01-01 00:00:00+00'

statement ok
CREATE INDEX safe_3 ON events (account) WHERE COALESCE(closed, TIMESTAMPTZ '2024-01-01 00:00:00+00') >= TIMESTAMPTZ '2024-01-01 00:00:00+00'

statement ok
CREATE INDEX safe_4 ON events (account) WHERE CASE WHEN account = 7 THEN closed IS NULL ELSE closed IS NOT NULL END

statement ok
