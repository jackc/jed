# ALTER TABLE identity management where jed deliberately differs from PostgreSQL (spec/design/alter.md
# §2.8/§7). jed applies a comma-separated action list strictly left to right, so an identity
# action sees every earlier action of the statement; PostgreSQL instead runs the actions in fixed
# passes (all DROP forms first, ADD IDENTITY after ADD COLUMN, SET last) and resolves an ADD
# IDENTITY's column before any action runs. Repeated identity options are a parse error in jed even
# on a column that is not an identity column (PostgreSQL reports 55000 there first). Not
# oracle-checked.
# requires: ddl.alter_identity, ddl.alter_table, ddl.identity, func.sequence, ddl.create_table, dml.insert, dml.insert_column_list, query.select, query.order_by, types.i16, types.i32

statement ok
CREATE TABLE lr (id i32 NOT NULL)

# ADD then DROP in one statement: PostgreSQL runs the DROP first (55000); jed leaves no sequence.
statement ok
ALTER TABLE lr ALTER id ADD GENERATED ALWAYS AS IDENTITY, ALTER id DROP IDENTITY

statement error 42P01
SELECT nextval('lr_id_seq')

statement ok
INSERT INTO lr VALUES (3)

# A column added earlier in the statement can become an identity column (PostgreSQL: 42703).
statement ok
ALTER TABLE lr ADD COLUMN n i16 NOT NULL DEFAULT 0, ALTER n DROP DEFAULT, ALTER n ADD GENERATED BY DEFAULT AS IDENTITY (START 10)

statement ok
INSERT INTO lr (id) VALUES (4)

query II nosort
SELECT id, n FROM lr ORDER BY id
----
3
0
4
10

# The pending owned sequence follows its column when an earlier column is dropped later in the
# statement, and a later SET edits it.
statement ok
CREATE TABLE lr2 (a i32, b i32 NOT NULL)

statement ok
ALTER TABLE lr2 ALTER b ADD GENERATED ALWAYS AS IDENTITY, DROP COLUMN a, ALTER b RESTART WITH 70

statement ok
INSERT INTO lr2 VALUES (DEFAULT)

query I nosort
SELECT b FROM lr2
----
70

# Repeats are rejected while parsing, before the column is examined.
statement error 42601
ALTER TABLE lr ALTER id SET GENERATED ALWAYS SET GENERATED ALWAYS

statement error 42601
ALTER TABLE lr ALTER id SET MAXVALUE 5 SET NO MAXVALUE
