# REINDEX of the backing indexes of partial and btree EXCLUDE constraints (spec/design/indexes.md §10,
# gist.md §7.1/§7.2): the rebuild keeps each predicate — a partial backing index holds only the rows
# its predicate admits — and the constraints keep enforcing exactly as before, through the rebuilt
# indexes. Reads that the partial btree backing index can serve (a WHERE implying its predicate)
# answer exactly as a scan does. Every record is oracle-probed.
# Format: ../../../design/conformance.md.
# requires: ddl.reindex, ddl.create_table, ddl.primary_key, ddl.exclusion_constraint, ddl.exclusion_btree, ddl.exclusion_partial, ddl.gist_index, dml.insert, dml.insert_multi_row, dml.update, query.select, query.where_eq, query.order_by, types.i32, types.text, types.range, types.boolean, types.boolean_storable

statement ok
CREATE TABLE ri (id i32 PRIMARY KEY, code text, live boolean, span int4range, EXCLUDE (code WITH =) WHERE (live), EXCLUDE USING gist (span WITH &&) WHERE (live))

statement ok
CREATE TABLE rb (id i32 PRIMARY KEY, k i32, EXCLUDE USING btree (k WITH =))

statement ok
INSERT INTO ri VALUES (1, 'a', true, '[1,5)'), (2, 'a', false, '[1,5)'), (3, 'b', true, '[10,20)')

statement ok
INSERT INTO rb VALUES (1, 1), (2, 2), (3, NULL), (4, NULL)

statement ok
REINDEX TABLE ri

statement ok
REINDEX INDEX ri_code_excl

statement ok
REINDEX INDEX ri_span_excl

statement ok
REINDEX TABLE rb

# The partial btree exclusion still rejects a second live 'a'.
statement error 23P01
INSERT INTO ri VALUES (4, 'a', true, '[30,40)')

# The partial GiST exclusion still rejects a live overlap — and holds no non-live row.
statement error 23P01
INSERT INTO ri VALUES (5, 'c', true, '[2,3)')

statement ok
INSERT INTO ri VALUES (6, 'a', false, '[2,3)'), (7, 'c', true, '[50,60)')

statement error 23P01
UPDATE ri SET live = true WHERE id = 2

statement error 23P01
INSERT INTO rb VALUES (5, 2)

statement ok
INSERT INTO rb VALUES (6, NULL), (7, 7)

query I nosort
SELECT id FROM ri WHERE live AND code = 'a' ORDER BY id
----
1

query I nosort
SELECT id FROM ri WHERE code = 'a' ORDER BY id
----
1
2
6

query I nosort
SELECT id FROM ri WHERE live ORDER BY id
----
1
3
7

query I nosort
SELECT id FROM rb WHERE k = 2
----
2

query I nosort
SELECT id FROM rb WHERE k IS NULL ORDER BY id
----
3
4
6
