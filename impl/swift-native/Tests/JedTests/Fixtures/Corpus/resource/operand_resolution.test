# An aggregate in a re-resolved operand is collected once: `sum(c) - 1` evaluates one sum, costing the
# same as `sum(c) + 1`.
statement ok
INSERT INTO t VALUES (2, 2), (3, 3)

# cost: 9
query I
SELECT sum(c) + 1 FROM t
----
7

# cost: 9
query I
SELECT sum(c) - 1 FROM t
----
5
