# Two-pass operand resolution must stay linear in the nesting depth (CLAUDE.md §13; spec/design/cost.md
# §7). Several operators resolve an operand once with no type hint to learn its type, then again with
# the element type its sibling fixed: `-` (peeking for the jsonb delete operator), `||` (array, jsonb,
# bytea, text), the containment operators, `x = ANY(ARRAY[…])`, and the polymorphic array functions.
# Re-resolving the whole operand would resolve every nested two-pass operand twice per level, so a
# chain like `1 - 1 - … - 1` would take 2^depth before any cost is metered: neither `max_cost` nor the
# depth limit (256) could stop it. Each core resolves an operand once and re-resolves only the literals
# and parameters the hint reaches. Every statement below nests far enough (up to ~200 levels, under
# MAX_EXPR_DEPTH) that the exponential form would not finish; each must run promptly.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.aggregates, expr.arithmetic, expr.text_concat, types.i32, types.text, types.bytea, types.jsonb, types.array, func.array, func.array_containment, func.array_quantified, func.jsonb_mutate, resource.depth_limit, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, c i32)

statement ok
INSERT INTO t VALUES (1, 1)

