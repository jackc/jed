# --- views that reference the previous view twice: v_k expands to 2^(k+1) - 1 views ---------------

statement ok
CREATE VIEW v0 AS SELECT a FROM t WHERE a = 1

statement ok
CREATE VIEW v1 AS SELECT a FROM v0 UNION ALL SELECT a FROM v0

statement ok
CREATE VIEW v2 AS SELECT a FROM v1 UNION ALL SELECT a FROM v1

statement ok
CREATE VIEW v3 AS SELECT a FROM v2 UNION ALL SELECT a FROM v2

statement ok
CREATE VIEW v4 AS SELECT a FROM v3 UNION ALL SELECT a FROM v3

statement ok
CREATE VIEW v5 AS SELECT a FROM v4 UNION ALL SELECT a FROM v4

statement ok
CREATE VIEW v6 AS SELECT a FROM v5 UNION ALL SELECT a FROM v5

statement ok
CREATE VIEW v7 AS SELECT a FROM v6 UNION ALL SELECT a FROM v6

statement ok
CREATE VIEW v8 AS SELECT a FROM v7 UNION ALL SELECT a FROM v7

statement ok
CREATE VIEW v9 AS SELECT a FROM v8 UNION ALL SELECT a FROM v8

statement ok
CREATE VIEW v10 AS SELECT a FROM v9 UNION ALL SELECT a FROM v9

# v9 expands to 1023 views, within the limit.
query I nosort
SELECT count(*) FROM v9
----
512

# Creating v10 planned two references to v9, each 1023 views. Reading v10 expands to 2047.
statement error 54001
SELECT count(*) FROM v10

# Each written reference is counted on its own.
query I nosort
SELECT count(*) FROM v9 x, v0 y
----
512

# Exactly at the limit: w1024 and the 1023 views of v9.
statement ok
CREATE VIEW w1024 AS SELECT a FROM v9

query I nosort
SELECT count(*) FROM w1024
----
512

# A pushed-down WHERE plans bodies again, but each view is counted once.
query I nosort
SELECT count(*) FROM w1024 WHERE a = 1
----
512

# One past the limit.
statement ok
CREATE VIEW w1025 AS SELECT a FROM v9 UNION ALL SELECT a FROM v0

statement error 54001
SELECT count(*) FROM w1025

# Inside a derived table the view reference is still written outside any view body.
statement error 54001
SELECT count(*) FROM (SELECT a FROM w1025) d WHERE a = 1

query I nosort
SELECT count(*) FROM (SELECT a FROM w1024) d WHERE a = 1
----
512

# A view whose definition holds an over-limit reference cannot be created.
statement error 54001
CREATE VIEW too_big AS SELECT a FROM w1025
