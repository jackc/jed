# Bounded planning for nested views and derived tables (spec/design/planner.md §3.2,
# spec/design/views.md §4.1, spec/design/cost.md §7e). Planning is unmetered, so its work must be
# bounded structurally:
#
# - Predicate pushdown plans a derived body again with the pushed conjuncts. Each body is first
#   planned only as a shape (its outputs and pushability), so a chain of `d` bodies that each push
#   into the next costs O(d²) plannings. Before this, each level planned its body twice in full, and
#   the chains below took 2^d plannings and never finished.
# - A view expands like a macro, so views that each reference the previous view twice expand to
#   2^d views. One view reference written outside any view body may expand to at most
#   MAX_VIEW_EXPANSIONS = 1024 views, itself included, or the statement is 54001
#   (statement_too_complex). The count is of the full expansion, however often a body is planned.
#
# jed-specific (PostgreSQL has no such limit), so cross-core-checked, not oracle-checked.
# requires: ddl.view, ddl.create_table, ddl.primary_key, dml.insert, query.select, query.select_star, query.where_eq, query.union, query.aggregates, query.derived_table, query.derived_pushdown, types.i32, resource.view_expansion_limit

statement ok
CREATE TABLE t (a i32 PRIMARY KEY, b i32)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20)

# --- a chain of 60 views, each with a WHERE that pushes into the next -----------------------------

statement ok
CREATE VIEW c0 AS SELECT * FROM t WHERE b > 0

statement ok
CREATE VIEW c1 AS SELECT * FROM c0 WHERE a > -1

statement ok
CREATE VIEW c2 AS SELECT * FROM c1 WHERE a > -2

statement ok
