    "repetitions": 5,
    "validation_iterations": 32,
    "workloads": [
      {
        "name": "scalar",
        "sql": "SELECT abs($1::i64) + 7",
        "iterations": 2000,
        "warmup": 300,
        "offset": -999,
        "step": 17,
        "span": 2000
      },
      {
        "name": "aggregate",
        "sql": "SELECT sum(score) FROM items WHERE bucket = $1",
        "iterations": 30,
        "warmup": 20,
        "offset": 0,
        "step": 1,
        "span": 10
      },
      {
        "name": "group",
        "sql": "SELECT bucket, count(*), sum(score) FROM items GROUP BY bucket ORDER BY bucket",
        "iterations": 15,
        "warmup": 10,
        "offset": 0,
        "step": 0,
        "span": 0
      },
      {
        "name": "aggregate_argument",
        "sql": "SELECT sum((score * 3 + bucket) / (bucket + 1)) FROM items WHERE bucket >= $1",
        "iterations": 50,
        "warmup": 100,
        "offset": 0,
        "step": 1,
        "span": 5
      },
      {
        "name": "aggregate_multi",
        "sql": "SELECT count(*), count(score), min(score), max(score), sum(score), bit_xor(score) FROM items",
        "iterations": 50,
        "warmup": 100,
        "offset": 0,
        "step": 0,
        "span": 0
      },
      {
        "name": "aggregate_filter",
        "sql": "SELECT sum(CASE WHEN bucket = 0 THEN NULL ELSE score END) FILTER (WHERE bucket >= $1), min(CASE WHEN bucket = 0 THEN NULL ELSE score END) FILTER (WHERE bucket >= $1) FROM items",
        "iterations": 50,
        "warmup": 100,
        "offset": 0,
        "step": 1,
        "span": 5
      },
      {
        "name": "aggregate_bool_bits",
        "sql": "SELECT CASE WHEN bool_and(score >= 0) THEN 1 ELSE 0 END, CASE WHEN bool_or(score > 5000) THEN 1 ELSE 0 END, bit_and(score), bit_or(score), bit_xor(score) FROM items WHERE bucket >= $1",
        "iterations": 50,
        "warmup": 100,
        "offset": 0,
        "step": 1,
        "span": 5
      },
      {
        "name": "aggregate_many_groups",
        "sql": "SELECT score % 100, count(*), sum(score) FROM items GROUP BY score % 100 ORDER BY 1",
        "iterations": 50,
        "warmup": 100,
        "offset": 0,
        "step": 0,
        "span": 0
      },
      {
        "name": "aggregate_distinct",
        "sql": "SELECT count(DISTINCT bucket), sum(DISTINCT bucket) FROM items",
        "iterations": 50,
        "warmup": 100,
        "offset": 0,
        "step": 0,
        "span": 0
      }
    ]
  },
