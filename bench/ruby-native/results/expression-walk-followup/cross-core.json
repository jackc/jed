:100,"offset":0,"step":17,"span":1000},{"iterations":20,"warmup":100,"offset":0,"step":17,"span":1000,"name":"three_table_join","sql":"SELECT a.id, b.score, c.label FROM items a JOIN items b ON b.id = a.id JOIN items c ON c.id = b.id WHERE a.id = $1 AND b.id = $1 AND c.id = $1 ORDER BY a.id"},{"iterations":20,"warmup":100,"offset":1000,"step":17,"span":1000,"name":"three_table_join_miss","sql":"SELECT a.id, b.score, c.label FROM items a JOIN items b ON b.id = a.id JOIN items c ON c.id = b.id WHERE a.id = $1 AND b.id = $1 AND c.id = $1 ORDER BY a.id"},{"iterations":20,"warmup":100,"offset":0,"step":17,"span":101,"name":"three_table_join_range","sql":"SELECT a.id, b.score, c.label FROM items a JOIN items b ON b.id = a.id JOIN items c ON c.id = b.id WHERE a.id < $1 AND b.id < $1 AND c.id < $1 ORDER BY a.id"},{"iterations":20,"warmup":100,"offset":0,"step":17,"span":1000,"name":"three_table_computed_key","sql":"SELECT a.id, b.score, c.label FROM items a JOIN items b ON b.id = a.id % 10 JOIN items c ON c.id = b.id WHERE a.id = $1 AND b.id < 10 AND c.id < 10 ORDER BY a.id"},{"iterations":20,"warmup":100,"offset":0,"step":17,"span":1000,"name":"four_table_join","sql":"SELECT a.id, b.score, c.label, d.bucket FROM items a JOIN items b ON b.id = a.id JOIN items c ON c.id = b.id JOIN items d ON d.id = c.id WHERE a.id = $1 AND b.id = $1 AND c.id = $1 AND d.id = $1 ORDER BY a.id"},{"iterations":20,"warmup":100,"offset":0,"step":17,"span":1000,"name":"three_table_left_fence","sql":"SELECT a.id, b.score, c.label FROM items a JOIN items b ON b.id = a.id LEFT JOIN items c ON c.id = b.id AND c.bucket <> 3 WHERE a.id = $1 AND b.id = $1 ORDER BY a.id"}]},"ruby_source":"/home/jack/.codex/worktrees/b8e6/jed/impl/ruby-native","statuses":{"go":{"status":"ready","detail":""},"rust":{"status":"ready","detail":"    Finished `release` profile [optimized] target(s) in 0.00s\n"},"ruby-yjit":{"status":"ready","detail":"ruby 4.0.7 (2026-09-15 revision 229531a6cf) +YJIT +PRISM [x86_64-linux]\n"},"t