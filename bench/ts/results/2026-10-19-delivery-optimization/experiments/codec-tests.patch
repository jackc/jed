+test("decoded byte values own exact independent buffers across fields and rows", () => {
+  const backing = Uint8Array.from({ length: 40 }, (_, i) => i + 1);
+  const row: Value[] = [
+    { kind: "bool", value: true },
+    { kind: "bytea", bytes: backing.subarray(3, 7) },
+    { kind: "bytea", bytes: new Uint8Array(0) },
+    { kind: "uuid", bytes: backing.subarray(5, 21) },
+    { kind: "bytea", bytes: backing.subarray(1, 34) },
+  ];
+  const packet = pack([row, row]);
+  const decoded = decodePackedRows(packet).rows;
+  assert.deepEqual(decoded, [row, row]);
+  const buffers = new Set<ArrayBufferLike>();
+  for (const values of decoded) {
+    for (const value of values) {
+      if (value.kind !== "bytea" && value.kind !== "uuid") continue;
+      assert.equal(value.bytes.byteOffset, 0);
+      assert.equal(value.bytes.buffer.byteLength, value.bytes.byteLength);
+      assert.notEqual(value.bytes.buffer, packet.data);
+      assert.ok(!buffers.has(value.bytes.buffer));
+      buffers.add(value.bytes.buffer);
+    }
+  }
+  const first = decoded[0][1];
+  assert.equal(first.kind, "bytea");
+  if (first.kind !== "bytea") throw new Error("bytea expected");
+  first.bytes.fill(0);
+  assert.deepEqual(decoded[1], row);
+  new Uint8Array(packet.data).fill(0);
+  assert.deepEqual(decoded[1], row);
+});
