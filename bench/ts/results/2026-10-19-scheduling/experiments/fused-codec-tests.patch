+test("decoder reserves each value before construction and rejects truncated containers", () => {
+  const row: Value[] = [{ kind: "decimal", dec: decimal }];
+  const packet = pack([row, row]);
+  const budget = new WireBudget(measureValues(row) + 40);
+  const original = Decimal.fromParts;
+  let allocations = 0;
+  Decimal.fromParts = (...args) => {
+    allocations++;
+    assert.ok(budget.used <= budget.maxBytes);
+    return original(...args);
+  };
+  try {
+    assert.throws(() => decodePackedRows(packet, budget), oversized);
+  } finally {
+    Decimal.fromParts = original;
+  }
+  assert.equal(allocations, 1); // The second decimal cannot allocate before its reservation.
+  assert.ok(budget.used <= budget.maxBytes);
+
+  // These counts fit the logical allowance but do not fit the encoded input. No iteration or
+  // allocation should trust them just because a caller chose a very generous byte allowance.
+  for (const bytes of [
+    [1, 0, 0, 0, 255, 255, 255, 127],
+    [...ROW_ONE, 15, 255, 255, 255, 127],
+    [...ROW_ONE, 18, 4, 255, 255, 255, 127],
+    [...ROW_ONE, 18, 5, 255, 255, 255, 127],
+  ])
+    assert.throws(
+      () => decodePackedRows(raw(bytes), new WireBudget(Number.MAX_SAFE_INTEGER)),
