diff --git b/impl/go/specialization_composition.go b/impl/go/specialization_composition.go
new file mode 100644
index 0000000..42fbd82
--- /dev/null
+++ b/impl/go/specialization_composition.go
@@ -0,0 +1,179 @@
+//go:build jed_specialization
+
+package jed
+
+// Limits are checked before constructing any descriptor/closure. Children of a
+// rejected root are never executed. No source node or execution state is retained.
+const (
+	specializationMaxNodes = 192
+	specializationMaxDepth = 32
+)
+
+type kernelFunc func(storedRow, *evalEnv, *costMeter, bool) (Value, error)
+
+func boundedKernelShape(e *rExpr, depth int, nodes *int) bool {
+	if e == nil || depth > specializationMaxDepth || *nodes >= specializationMaxNodes {
+		return false
+	}
+	*nodes++
+	child := func(c *rExpr) bool { return boundedKernelShape(c, depth+1, nodes) }
+	switch e.kind {
+	case reColumn, reParam, reConstInt, reConstBool, reConstNull:
+		return true
+	case reArith, reCompare, reAnd, reOr:
+		return child(e.lhs) && child(e.rhs)
+	case reNot, reIsNull:
+		return child(e.operand)
+	case reCase:
+		return !e.caseDecimal && len(e.caseArms) == 1 && child(e.caseArms[0].cond) && child(e.caseArms[0].result) && child(e.caseEls)
+	case reCoalesce:
+		return !e.caseDecimal && len(e.sargs) == 2 && child(e.sargs[0]) && child(e.sargs[1])
+	}
+	return false
+}
+
+func bindScalarKernel(e *rExpr, columns []catColumn, params []colType) *scalarKernel {
+	nodes := 0
+	if !boundedKernelShape(e, 1, &nodes) {
+		return nil
+	}
+	k, _ := bindComposedKernel(e, columns, params)
+	if k != nil && specializationClosures {
+		// The closure build retains only closures, not a second descriptor graph.
+		run := closeKernel(k)
+		return &scalarKernel{run: run}
+	}
+	return k
+}
+
+func bindComposedKernel(e *rExpr, columns []catColumn, params []colType) (*scalarKernel, rtKind) {
+	if k := bindStaticKernel(e, columns, params); k != nil {
+		if e.kind == reArith {
+			return k, rtInt
+		}
+		return k, rtBool
+	}
+	if leaf, ty, ok := bindKernelLeaf(e, columns, params); ok {
+		return &scalarKernel{leaf: true, left: kernelOperand{left: leaf}}, ty
+	}
+	var source [3]*rExpr
+	k := &scalarKernel{kind: e.kind, negated: e.negated, charge: costs.OperatorEval}
+	switch e.kind {
+	case reAnd, reOr:
+		source[0], source[1] = e.lhs, e.rhs
+		if e.kind == reAnd {
+			k.charge = operatorCost("and")
+		} else {
+			k.charge = operatorCost("or")
+		}
+	case reNot, reIsNull:
+		source[0] = e.operand
+		if e.kind == reNot {
+			k.charge = operatorCost("not")
+		}
+	case reCase:
+		source[0], source[1], source[2] = e.caseArms[0].cond, e.caseArms[0].result, e.caseEls
+	case reCoalesce:
+		source[0], source[1] = e.sargs[0], e.sargs[1]
+	default:
+		return nil, rtNull
+	}
+	var types [3]rtKind
+	for i, child := range source {
+		if child == nil {
+			continue
+		}
+		k.children[i], types[i] = bindComposedKernel(child, columns, params)
+		if k.children[i] == nil {
+			return nil, rtNull
+		}
+	}
+	boolean := func(t rtKind) bool { return t == rtBool || t == rtNull }
+	switch e.kind {
+	case reAnd, reOr:
+		if !boolean(types[0]) || !boolean(types[1]) {
+			return nil, rtNull
+		}
+		return k, rtBool
+	case reNot:
+		if !boolean(types[0]) {
+			return nil, rtNull
+		}
+		return k, rtBool
+	case reIsNull:
+		return k, rtBool
+	case reCase:
+		if !boolean(types[0]) {
+			return nil, rtNull
+		}
+		types[0], types[1] = types[1], types[2]
+	}
+	// CASE/COALESCE have no coercion on the admitted integer/boolean surface.
+	if types[0] == rtNull {
+		return k, types[1]
+	}
+	if types[1] == rtNull || types[0] == types[1] {
+		return k, types[0]
+	}
+	return nil, rtNull
+}
+
+func (k *scalarKernel) evalFilter(row storedRow, env *evalEnv, m *costMeter) (bool, error) {
+	specializationInvoked()
+	v, err := k.evalMode(row, env, m, true)
+	return v.IsTrue(), err
+}
+
+func (k *scalarKernel) evalComposition(row storedRow, env *evalEnv, m *costMeter, filter bool) (Value, error) {
+	if err := m.Guard(); err != nil {
+		return Value{}, err
+	}
+	m.Charge(k.charge)
+	// Only an AND in filter context propagates that context to its children.
+	childFilter := filter && k.kind == reAnd
+	a, err := k.children[0].evalMode(row, env, m, childFilter)
+	if err != nil {
+		return Value{}, err
+	}
+	switch k.kind {
+	case reAnd:
+		if childFilter && !a.IsTrue() {
+			return BoolValue(false), nil
+		}
+		if to3(a) == False {
+			return a, nil
+		}
+		b, err := k.children[1].evalMode(row, env, m, childFilter)
+		if err != nil {
+			return Value{}, err
+		}
+		if childFilter {
+			return BoolValue(b.IsTrue()), nil
+		}
+		return boolAnd(a, b), nil
+	case reOr:
+		if to3(a) == True {
+			return a, nil
+		}
+		b, err := k.children[1].evalMode(row, env, m, false)
+		if err != nil {
+			return Value{}, err
+		}
+		return boolOr(a, b), nil
+	case reNot:
+		return boolNot(a), nil
+	case reIsNull:
+		return BoolValue(a.IsNull() != k.negated), nil
+	case reCase:
+		if a.IsTrue() {
+			return k.children[1].evalMode(row, env, m, false)
+		}
+		return k.children[2].evalMode(row, env, m, false)
+	case reCoalesce:
+		if !a.IsNull() {
+			return a, nil
+		}
+		return k.children[1].evalMode(row, env, m, false)
+	}
+	panic("invalid composition")
+}
diff --git b/impl/go/specialization_composition_test.go b/impl/go/specialization_composition_test.go
new file mode 100644
index 0000000..d022c48
--- /dev/null
+++ b/impl/go/specialization_composition_test.go
@@ -0,0 +1,119 @@
+//go:build jed_specialization
+
+package jed
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestSpecializationCompositionPrefixes(t *testing.T) {
+	cols := []catColumn{{Type: dataType{Scalar: scalarBool}}, {Type: dataType{Scalar: scalarBool}}, {Type: dataType{Scalar: scalarInt32}}}
+	col := func(i int) *rExpr { return &rExpr{kind: reColumn, index: i} }
+	null := &rExpr{kind: reConstNull}
+	trap := &rExpr{kind: reArith, op: opDiv, result: scalarInt32, lhs: &rExpr{kind: reConstInt, cInt: 1}, rhs: col(2)}
+	cmp := &rExpr{kind: reCompare, op: opGt, lhs: trap, rhs: &rExpr{kind: reConstInt}}
+	and := &rExpr{kind: reAnd, lhs: col(0), rhs: col(1)}
+	or := &rExpr{kind: reOr, lhs: col(0), rhs: cmp}
+	roots := []*rExpr{
+		and, or,
+		{kind: reNot, operand: and},
+		{kind: reIsNull, operand: or},
+		{kind: reAnd, lhs: col(0), rhs: cmp},
+		{kind: reAnd, lhs: and, rhs: or},
+		{kind: reCase, caseArms: []rCaseArm{{cond: and, result: trap}}, caseEls: col(2)},
+		{kind: reCase, caseArms: []rCaseArm{{cond: or, result: col(0)}}, caseEls: col(1)},
+		{kind: reCoalesce, sargs: []*rExpr{col(2), trap}},
+		{kind: reCoalesce, sargs: []*rExpr{null, trap}},
+		{kind: reCoalesce, sargs: []*rExpr{and, or}},
+	}
+	for _, e := range roots {
+		_, ty := bindComposedKernel(e, cols, nil)
+		k := bindScalarKernel(e, cols, nil)
+		if k == nil {
+			t.Fatal("composition rejected", e.kind)
+		}
+		for _, a := range []Value{NullValue(), BoolValue(false), BoolValue(true)} {
+			for _, b := range []Value{NullValue(), BoolValue(false), BoolValue(true)} {
+				for _, n := range []Value{NullValue(), IntValue(0), IntValue(1), IntValue(-1)} {
+					for limit := int64(0); limit <= 12; limit++ {
+						for lifeLimit := int64(0); lifeLimit <= 15; lifeLimit++ {
+							for _, filter := range []bool{false, true} {
+								// Integer roots are values only. Filter context would not be resolved.
+								if filter && ty != rtBool {
+									continue
+								}
+								life1, life2 := int64(3), int64(3)
+								m1, m2 := newMeterWithLimit(limit), newMeterWithLimit(limit)
+								m1.lifetimeTotal, m2.lifetimeTotal = &life1, &life2
+								m1.lifetimeLimit, m2.lifetimeLimit = lifeLimit, lifeLimit
+								row := storedRow{a, b, n}
+								env := &evalEnv{}
+								var v1, v2 Value
+								var err1, err2 error
+								if filter {
+									var b1, b2 bool
+									b1, err1 = e.evalFilter(row, env, m1)
+									b2, err2 = k.evalFilter(row, env, m2)
+									v1, v2 = BoolValue(b1), BoolValue(b2)
+								} else {
+									v1, err1 = e.eval(row, env, m1)
+									v2, err2 = k.eval(row, env, m2)
+								}
+								if !reflect.DeepEqual(v1, v2) || !reflect.DeepEqual(err1, err2) || m1.Accrued != m2.Accrued || life1 != life2 || m1.ceilingHit != m2.ceilingHit {
+									t.Fatalf("kind=%v filter=%v row=%v limit=%d/%d: %v/%v %v/%v costs=%d/%d", e.kind, filter, row, limit, lifeLimit, v1, v2, err1, err2, m1.Accrued, m2.Accrued)
+								}
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestSpecializationCompositionBounds(t *testing.T) {
+	leaf := func() *rExpr { return &rExpr{kind: reConstBool, cBool: true} }
+	e := leaf()
+	for depth := 1; depth <= specializationMaxDepth+1; depth++ {
+		k := bindScalarKernel(e, nil, nil)
+		if (k != nil) != (depth <= specializationMaxDepth) {
+			t.Fatalf("depth %d", depth)
+		}
+		if k != nil {
+			v, err := k.eval(nil, &evalEnv{}, newMeter())
+			if err != nil || v.Kind != ValBool {
+				t.Fatal(v, err)
+			}
+		}
+		e = &rExpr{kind: reNot, operand: e}
+	}
+	var tree func(int) *rExpr
+	tree = func(nodes int) *rExpr {
+		if nodes == 1 {
+			return leaf()
+		}
+		if nodes%2 == 0 {
+			return &rExpr{kind: reNot, operand: tree(nodes - 1)}
+		}
+		left := (nodes - 1) / 2
+		return &rExpr{kind: reAnd, lhs: tree(left), rhs: tree(nodes - 1 - left)}
+	}
+	for _, nodes := range []int{191, 192, 193, 1537} {
+		e := tree(nodes)
+		k := bindScalarKernel(e, nil, nil)
+		if (k != nil) != (nodes <= specializationMaxNodes) {
+			t.Fatalf("nodes %d", nodes)
+		}
+		if k == nil {
+			if got := testing.AllocsPerRun(10, func() { bindScalarKernel(e, nil, nil) }); got != 0 {
+				t.Fatalf("oversize allocates %g", got)
+			}
+		} else {
+			env, m := &evalEnv{}, newMeter()
+			if got := testing.AllocsPerRun(10, func() { _, _ = k.eval(nil, env, m) }); got != 0 {
+				t.Fatalf("composition allocates %g per row", got)
+			}
+		}
+	}
+}
