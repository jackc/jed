#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Run every corpus walk concurrently: plain, forced-spill, query-memory (and --checked Rust)"
#MISE depends=["ts:lock_build"]
#USAGE flag "--checked" help="Also walk with the Rust `checked` profile (debug assertions + overflow checks)"
#USAGE arg "[filter]" help="Run only corpus files whose path contains this substring"

# A WALK is one run of a core's conformance runner over the shared corpus in one configuration (core
# x storage mode x harness settings). This task runs the walks of `conformance`, `conformance:spill`,
# `conformance:query_memory`, and with --checked `conformance:rust:checked`, all at once. Each walk is
# an independent single-threaded process, so on a many-core machine the whole set takes about as
# long as its slowest walk. Those tasks remain for running one family on its own.
#
# Each walk's output goes to its own log and is printed in the order the walks are declared below,
# as soon as that walk and every walk before it have finished, so output never interleaves. A
# passing walk prints only its summary; a failing one prints everything but its PASS lines. Every
# failure is collected before the task exits. JED_CONFORMANCE_JOBS caps how many walks run at once
# (default: the number of CPUs; 1 runs them one at a time).

require "etc"
require "tmpdir"
require_relative "../../scripts/lib/parallel"
require_relative "../../scripts/lib/tasks"
require_relative "../../scripts/lib/query_memory_peaks"
include Tasks

$stdout.sync = true # keep stdout in order with the abort message on stderr

CHECKED = ENV["usage_checked"] == "true"
JOBS = [Integer(ENV.fetch("JED_CONFORMANCE_JOBS", Etc.nprocessors.to_s)), 1].max
EXE = Gem.win_platform? ? ".exe" : ""

started = Parallel.now

# Build each runner once and run the binaries directly: concurrent `cargo run`s queue on cargo's
# build lock, and every `go run` relinks.
sh "cargo", "build", "--release", "--quiet", "--bin", "conformance", "--manifest-path", RUST_MANIFEST
sh "cargo", "build", "--profile", "checked", "--quiet", "--bin", "conformance", "--manifest-path", RUST_MANIFEST if CHECKED
go_bin = File.join(GO_DIR, "bin", "conformance#{EXE}")
sh "go", "build", "-o", go_bin, "./cmd/conformance", chdir: GO_DIR
rust_target = File.expand_path(ENV.fetch("CARGO_TARGET_DIR", "impl/rust/target"), ROOT)

# core => [argv, working directory], matching the per-core tasks in mise.toml.
CORES = {
  "rust" => [[File.join(rust_target, "release", "conformance#{EXE}")], ROOT],
  "go" => [[go_bin], GO_DIR],
  "ts" => [%w[node src/bin/conformance.ts], TS_DIR],
}.freeze

common_env = ENV["usage_filter"] ? { "JED_CONFORMANCE_FILTER" => ENV["usage_filter"] } : {}
Dir.mktmpdir("jed-conformance-all") do |dir|
  walks = []
  add = lambda do |name, core, args, env = {}|
    argv, chdir = CORES.fetch(core)
    walks << Parallel::Job.new(name: name, argv: argv + args, env: common_env.merge(env), chdir: chdir)
  end

  # `conformance`: both storage modes.
  CORES.each_key do |core|
    add.("conformance #{core} memory", core, [])
    add.("conformance #{core} disk", core, ["disk"])
  end
  # `conformance:rust:checked`: the corpus's debug-assertion / overflow-check pass.
  if CHECKED
    checked = [File.join(rust_target, "checked", "conformance#{EXE}")]
    walks << Parallel::Job.new(name: "checked rust memory", argv: checked, env: common_env, chdir: ROOT)
    walks << Parallel::Job.new(name: "checked rust disk", argv: checked + ["disk"], env: common_env, chdir: ROOT)
  end
  # `conformance:spill`: every spill-capable operator on disk, then the temp-table files in memory
  # with every temp domain spilling (spec/design/conformance.md §1).
  CORES.each_key do |core|
    add.("spill #{core} operators", core, ["disk"], "JED_CONFORMANCE_WORK_MEM" => "256")
    add.("spill #{core} temp tables", core, [], "JED_CONFORMANCE_TEMP_BUFFERS" => "1")
  end
  # `conformance:query_memory`: accounting active in every mode, each core writing its peaks.
  peaks = Hash.new { |hash, mode| hash[mode] = {} }
  QueryMemoryPeaks::MODES.each do |mode, (args, mode_env)|
    CORES.each_key do |core|
      peaks[mode][core] = File.join(dir, "peaks-#{mode}-#{core}.tsv")
      add.("query_memory #{core} #{mode}", core, args,
           mode_env.merge("JED_CONFORMANCE_QUERY_MEMORY" => QueryMemoryPeaks::DEFAULT_BUDGET,
                          "JED_CONFORMANCE_QUERY_MEMORY_PEAKS" => peaks[mode][core]))
    end
  end

  $stdout.puts "running #{walks.size} walks, #{[JOBS, walks.size].min} at a time"
  $stdout.flush
  # Start the TS walks first: they are the slowest, so they decide when the set finishes.
  Parallel.run(walks, dir: dir, limit: JOBS, rank: ->(walk) { walk.name.include?(" ts ") ? 0 : 1 }) do |walk|
    puts format("%-4s %-34s %6.2fs", walk.status ? "ok" : "FAIL", walk.name, walk.seconds)
    File.foreach(walk.log) do |line|
      next if line.start_with?("PASS ") || (walk.status && line.start_with?("SKIP "))
      next if walk.status && line.strip.empty?

      puts "     #{line}"
    end
    $stdout.flush
  end

  failures = walks.reject(&:status).map(&:name)
  peaks.each do |mode, paths|
    next unless walks.select { |walk| walk.name.start_with?("query_memory ") && walk.name.end_with?(" #{mode}") }.all?(&:status)

    mismatches = QueryMemoryPeaks.mismatches(mode, paths)
    next if mismatches.empty?

    warn mismatches.first(50).join("\n")
    failures << "query-memory peaks disagree across cores on #{mismatches.size} #{mode} record(s)"
  end

  elapsed = Parallel.now - started
  walk_time = walks.sum(&:seconds)
  puts format("\n%d walks in %.1fs (%.1fs of walk time)", walks.size, elapsed, walk_time)
  abort "conformance failed:\n  #{failures.join("\n  ")}" unless failures.empty?
  puts "query-memory peaks: all cores agree"
end
