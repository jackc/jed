#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Run the shared SQL corpus on all cores with forced file spill"
#USAGE arg "[bytes]" help="work_mem in bytes (default 256)"
#USAGE arg "[filter]" help="Run only corpus files whose path contains this substring"

# Disk storage mode with a tiny work_mem, so every spill-capable operator spills
# (spec/design/spill.md). Results, errors, and costs must be unchanged.

require_relative "../../scripts/lib/tasks"
include Tasks

env = { "JED_CONFORMANCE_WORK_MEM" => ENV["usage_bytes"] || "256" }
env["JED_CONFORMANCE_FILTER"] = ENV["usage_filter"] if ENV["usage_filter"]
sh "cargo", "run", "--release", "--quiet", "--bin", "conformance", "--manifest-path", RUST_MANIFEST, "--", "disk", env: env
sh "go", "run", "./cmd/conformance", "disk", env: env, chdir: GO_DIR
sh "node", "src/bin/conformance.ts", "disk", env: env, chdir: TS_DIR
