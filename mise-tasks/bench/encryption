#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Measure an encrypted database against a plaintext one (commits, cold scans, cold and hot lookups)"
#USAGE arg "[rows]" default="200000" help="Rows in the benchmark table"
#USAGE arg "[rounds]" default="3" help="Alternating plain/encrypted rounds"

# Integrated performance of encryption at rest (spec/design/encryption.md §9): each core's worker
# builds the same table plaintext and encrypted and times four phases (bench/rust/src/bin/encryption.rs
# describes them; bench/go/cmd/encryption and bench/ts/src/encryption.ts mirror it). Rounds alternate plain/encrypted
# (benchmarks.md: alternate base and after), and the report gives each phase's median in milliseconds
# and the encrypted/plain ratio. Every phase's checksum must agree between the variants. Wall-clock,
# never conformance; outside `ci`.

require "open3"
require "tmpdir"
require_relative "../../scripts/lib/tasks"
include Tasks

rows = Integer(ENV.fetch("usage_rows", "200000"))
rounds = Integer(ENV.fetch("usage_rounds", "3"))
sh "cargo", "build", "--release", "--quiet", "--bin", "encryption", "--manifest-path", File.join(ROOT, "bench/rust/Cargo.toml")
target = File.expand_path(ENV.fetch("CARGO_TARGET_DIR", "bench/rust/target"), ROOT)
sh "go", "build", "-buildvcs=false", "-o", "bin/encryption", "./cmd/encryption", env: { "CGO_ENABLED" => "0" }, chdir: File.join(ROOT, "bench/go")
workers = {
  "rust" => [File.join(target, "release", "encryption")],
  "go" => [File.join(ROOT, "bench/go/bin/encryption")],
  # The TS core runs by Node's native type-stripping: no build step.
  "ts" => ["node", File.join(ROOT, "bench/ts/src/encryption.ts")],
}

workers.each do |core, argv|
  samples = Hash.new { |h, k| h[k] = Hash.new { |hh, kk| hh[kk] = [] } }
  checksums = Hash.new { |h, k| h[k] = {} }
  Dir.mktmpdir("jed-bench-encryption") do |dir|
    rounds.times do
      %w[plain encrypted].each do |variant|
        out, status = Open3.capture2(*argv, variant, dir, rows.to_s)
        abort "#{core} #{variant} worker failed" unless status.success?
        out.each_line do |line|
          phase, ms, checksum = line.chomp.split("\t")
          samples[phase][variant] << Float(ms)
          checksums[phase][variant] = checksum
        end
      end
    end
  end
  puts "#{core}: #{rows} rows, #{rounds} rounds (median ms)"
  puts format("  %-26s %12s %12s %8s", "phase", "plain", "encrypted", "ratio")
  samples.each do |phase, by|
    median = ->(xs) { xs.sort[xs.size / 2] }
    if phase == "file_bytes"
      plain, enc = checksums[phase].values_at("plain", "encrypted").map { Integer(_1) }
      puts format("  %-26s %12d %12d %7.2fx", "file bytes", plain, enc, enc.to_f / plain)
      next
    end
    unless checksums[phase]["plain"] == checksums[phase]["encrypted"]
      abort "#{core} #{phase}: checksums differ (#{checksums[phase]})"
    end
    plain, enc = median.(by["plain"]), median.(by["encrypted"])
    puts format("  %-26s %12.1f %12.1f %7.2fx", phase, plain, enc, enc / plain)
  end
end
