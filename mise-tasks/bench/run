#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Run every benchmark binary sequentially; results to bench/results/<stamp>/ + report"
#MISE depends=["bench:build"]
#USAGE arg "[filter]" help="Run only benchmarks whose name contains this substring"

require_relative "../../scripts/lib/bench"
include Tasks

dir = Bench.results_dir
filter = [ENV["usage_filter"]].compact
args = ->(file) { ["bench/corpus", "bench/data", File.join(dir, file), *filter] }

Bench::GO_BINS.each { |bin| sh "bench/go/bin/#{bin}", *args.("go-#{bin}.jsonl") }
Bench::RUST_BINS.each { |bin| sh "bench/rust/target/release/#{bin}", *args.("rust-#{bin}.jsonl") }
Bench::TS_BINS.each { |bin| sh "node", "bench/ts/src/#{bin}.ts", *args.("ts-#{bin}.jsonl") }
sh "node", "bench/ts/src/bench-node-rust.ts", *args.("node-rust-bench-jed.jsonl")
# The Ruby gem bench (jed/ruby/wrap) — its delta vs jed/rust/core is the binding overhead
# (benchmarks.md §7). It needs Ruby's bundled `bigdecimal`, so it must not run under bundler; this
# task does not load bundler.
ruby "bench/ruby/bench_jed.rb", *args.("ruby-bench-jed.jsonl")
# The wasm wrap (jed/wasm/wrap) — the Rust core compiled to wasm32-wasip1, driven from Node over
# WebAssembly + node:wasi (the --experimental flag enables the preview1 host). Its delta vs
# jed/ts/core is the wasm-vs-native-JS comparison; vs jed/rust/core, the wasm sandbox tax.
sh "node", "--experimental-wasi-unstable-preview1", "bench/ts/src/bench-wasm.ts", *args.("wasm-bench-jed.jsonl")

Bench.report(dir, "scripts/bench_html.rb")
