#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Test and measure experimental Rust durability protocols (no production format changes)"

# Output goes to $JED_DURABILITY_DIR (default bench/results/durability-<stamp>-<pid>)/run.log.

require_relative "../../scripts/lib/tasks"
include Tasks

dir = ENV.fetch("JED_DURABILITY_DIR") { File.expand_path("bench/results/durability-#{stamp}-#{Process.pid}") }
FileUtils.mkdir_p(dir)
env = { "JED_DURABILITY_DIR" => dir }
cmd = %w[cargo test --release --manifest-path impl/rust/Cargo.toml --lib durability_experiment]
sh(*cmd, env: env)
File.open(File.join(dir, "run.log"), "w") do |log|
  IO.popen(env, [*cmd, "--", "--ignored", "--nocapture"], err: %i[child out]) do |pipe|
    pipe.each_line { |line| $stdout.print(line); log.write(line); log.flush }
  end
end
abort "durability benchmark failed; see #{dir}/run.log" unless $?.success?
puts "Durability experiment output: #{dir}/run.log"
