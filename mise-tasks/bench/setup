#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Generate/refresh the benchmark databases (fingerprint-gated; --force to override)"
#USAGE flag "--force" help="Regenerate even when the fingerprints match"

require_relative "../../scripts/lib/tasks"
include Tasks

sh "go", "build", "-o", "bin/", "./cmd/bench-setup", env: { "CGO_ENABLED" => "0" }, chdir: "bench/go"
cmd = %w[bench/go/bin/bench-setup bench/corpus bench/data]
cmd << "--force" if ENV["usage_force"] == "true"
sh(*cmd)
