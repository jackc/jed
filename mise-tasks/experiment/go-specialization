#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Go kernel research: test, verify, corpus, race, diagnostics, norec, escape, bench, recheck, profile, report, format"

require "fileutils"
require "json"
require "open3"
require "digest"
require "tmpdir"
root = File.expand_path("../..", __dir__)
Dir.chdir(root)
mode = ARGV.shift || "test"
tags = ENV.fetch("JED_SPECIALIZATION_TAGS", "jed_specialization")
out = File.expand_path(ENV.fetch("JED_SPECIALIZATION_RESULTS", "bench/results/go-specialization"))
FileUtils.mkdir_p(out)
def run(*args, **options)
  system(*args, **options, exception: true)
end
case mode
when "format"
  run("gofumpt", "-w", *Dir["impl/go/specialization*.go"], "impl/go/exec_scan.go", "impl/go/rexpr.go")
when "test", "race"
  args = ["go", "test", "-tags", tags]
  args << "-race" if mode == "race"
  args += ["-run", ARGV.shift] unless ARGV.empty?
  run(*args, "./...", chdir: "impl/go")
when "escape"
  stdout, stderr, status = Open3.capture3("go", "test", "-tags", tags, "-gcflags=-m=2", "-run", "^$", ".", chdir: "impl/go")
  File.write("#{out}/escape.txt", stderr.lines.grep(/specialization(?:_off)?\.go:/).join + stdout)
  abort "escape analysis build failed" unless status.success?
when "norec"
  run("ruby", "scripts/norec_gen.rb", "--seeds", "1,2", "--cores", ENV.fetch("JED_SPECIALIZATION_CORES", "go"))
when "verify"
  %w[ordinary forced selective].each do |variant|
    variant_tags = "jed_specialization"
    variant_tags += ",jed_specialization_#{variant}" unless variant == "selective"
    log = "#{out}/conformance-#{variant}.txt"
    File.open(log, "w") do |io|
      run({"JED_SPECIALIZATION_TAGS" => variant_tags}, "mise", "run", "experiment:go-specialization", "corpus", out: io, err: io)
    end
    puts "#{variant}: #{File.readlines(log).grep(/^\[(memory|disk)\]/).map(&:strip).join('; ')}"
  end
when "corpus"
  run("go", "build", "-tags", tags, "-o", "#{out}/conformance", "./cmd/conformance", chdir: "impl/go")
  %w[memory disk].each do |storage|
    run("#{out}/conformance", *(storage == "disk" ? ["disk"] : []))
  end
when "diagnostics"
  run("go", "test", "-tags", "#{tags},jed_specialization_diagnostics", "-run", "Specialization", "-v", ".", chdir: "impl/go")
when "profile"
  argv = ["#{out}/selective.test", "-test.run=^$", "-test.bench=^BenchmarkSpecialization$/memory/arithmetic$", "-test.benchtime=100ms", "-test.memprofile=#{out}/alloc.pprof", "-test.cpuprofile=#{out}/cpu.pprof"]
  stdout, stderr, status = Open3.capture3(*argv, chdir: "#{root}/impl/go")
  File.write("#{out}/profile-run.txt", stdout + stderr)
  abort "profile failed" unless status.success?
  %w[alloc cpu].each do |kind|
    options = kind == "alloc" ? ["-alloc_space"] : []
    stdout, stderr, status = Open3.capture3("go", "tool", "pprof", "-top", *options, "#{out}/selective.test", "#{out}/#{kind}.pprof")
    File.write("#{out}/#{kind}-top.txt", stdout + stderr)
    abort "pprof failed" unless status.success?
  end
when "recheck"

  # Only noisy controls from the final matrix; reuse exactly those binaries.
  dest = "#{out}/recheck"
  FileUtils.mkdir_p(dest)
  commands = []
  3.times do |pair|
    names = %w[clean disabled ordinary selective]
    names.reverse! if pair.odd?
    names.each do |name|
      argv = ["#{out}/#{name}.test", "-test.run=^$", "-test.bench=^BenchmarkSpecialization$/(memory|file)/(columnar|scalar|first_call|point_miss|adhoc)$", "-test.benchmem", "-test.benchtime=250ms", "-test.count=1"]
      commands << argv
      stdout, stderr, status = Open3.capture3(*argv, chdir: "#{root}/impl/go")
      File.write("#{dest}/#{name}-#{pair}.txt", stdout + stderr)
      abort "#{name}: #{stdout}\n#{stderr}" unless status.success?
      puts "control recheck #{pair+1}/3 #{name} finished"
    end
  end
  File.write("#{dest}/commands.json", JSON.pretty_generate(commands) + "\n")
  run("ruby", "scripts/go_specialization_report.rb", dest)
when "report"
  run("ruby", "scripts/go_specialization_report.rb", out)
when "bench"
  # Builds are finished before any timed worker starts. The clean control uses
  # the pinned production engine, with only this experiment's benchmark source copied in.
  baseline = Dir.mktmpdir("baseline-", out)
  baseline_ref = ENV.fetch("JED_SPECIALIZATION_BASELINE", "dfb0699f18e7c5bb120bc0f885f257791b19e2b9")
  archive, status = Open3.capture2("git", "archive", baseline_ref, "impl/go")
  abort "git archive failed" unless status.success?
  Open3.popen3("tar", "-x", "-C", baseline) do |input, output, errors, child|
    input.binmode; input.write(archive); input.close
    abort errors.read unless child.value.success?
  end
  FileUtils.cp("impl/go/specialization_bench_test.go", "#{baseline}/impl/go/")
  variants = {"clean" => ["#{baseline}/impl/go", ""], "disabled" => ["#{root}/impl/go", ""], "ordinary" => ["#{root}/impl/go", "jed_specialization,jed_specialization_ordinary"], "selective" => ["#{root}/impl/go", "jed_specialization"]}
  variants.each do |name, (dir, build_tags)|
    run("go", "test", "-c", "-tags", build_tags, "-o", "#{out}/#{name}.test", ".", chdir: dir)
  end
  FileUtils.remove_entry(baseline)
  commands = []
  5.times do |pair|
    names = variants.keys
    names = names.reverse if pair.odd?
    names.each do |name|
      argv = ["#{out}/#{name}.test", "-test.run=^$", "-test.bench=^BenchmarkSpecialization$", "-test.benchmem", "-test.benchtime=100ms", "-test.count=1"]
      commands << argv
      stdout, stderr, status = Open3.capture3(*argv, chdir: "#{root}/impl/go")
      File.write("#{out}/#{name}-#{pair}.txt", stdout + stderr)
      abort "#{name}: #{stdout}\n#{stderr}" unless status.success?
      puts "pair #{pair + 1}/5 #{name} finished"
    end
  end
  File.write("#{out}/environment.json", JSON.pretty_generate({
    revision: `git rev-parse HEAD`.strip, baseline: baseline_ref, go: `go version`.strip,
    cpu: File.read("/proc/cpuinfo")[/^model name\s*:\s*(.+)$/, 1],
    commands: commands, env: ENV.select { |k,_| %w[GOFLAGS GOMAXPROCS GOGC GOMEMLIMIT].include?(k) },
    sources: (Dir["impl/go/specialization*.go"] + %w[impl/go/exec_scan.go impl/go/rexpr.go mise-tasks/experiment/go-specialization]).to_h { |p| [p, Digest::SHA256.file(p).hexdigest] }
  }) + "\n")
else
  abort "unknown command #{mode}"
end
