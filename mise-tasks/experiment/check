#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Check expression-experiment core formatting, TypeScript types, and tooling syntax"
#USAGE flag "--fix" help="Apply core formatting before checking"

require_relative "../../scripts/lib/tasks"
include Tasks

if ENV["usage_fix"] == "true"
  sh("cargo", "fmt", "--manifest-path", RUST_MANIFEST)
  sh("gofumpt", "-w", GO_DIR)
  sh("biome", "format", "--write", TS_DIR)
end
sh("cargo", "fmt", "--check", "--manifest-path", RUST_MANIFEST)
unformatted, status = capture("gofumpt", "-l", GO_DIR)
abort "gofumpt failed" unless status
abort "Go files need formatting:\n#{unformatted}" unless unformatted.empty?
sh("biome", "format", TS_DIR)
sh("biome", "lint", TS_DIR)
sh("npm", "run", "--silent", "--prefix", TS_DIR, "typecheck")
sh("ruby", "-c", File.join(__dir__, "bench"))
puts "Expression experiment formatting and types passed."
