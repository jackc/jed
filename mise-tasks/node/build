#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Build the experimental native Node/Rust package"

# An EXPERIMENTAL native Node-API host artifact wrapping the safe Rust core. Not a fourth core: it
# measures the product choice between shipping the independent TypeScript core and shipping a
# Node package backed by Rust (spec/design/benchmarks.md §7.3). The checked-in TS façade has no npm
# dependencies; exact-pinned napi-rs crates build the local .node module.

require_relative "../../scripts/lib/tasks"
include Tasks

sh "cargo", "build", "--release", "--manifest-path", NODE_WRAP_MANIFEST
FileUtils.cp(NODE_WRAP_ARTIFACT, NODE_WRAP_MODULE)
