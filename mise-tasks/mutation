#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Mutation-test the Go core: inject bugs, check the conformance corpus catches them (OUTSIDE mise run ci)"
#USAGE arg "[files]" help="Scope to these Go source files (comma-separated); default: the standard targets, sampled"
#USAGE arg "[n]" help="Maximum number of mutants"
#USAGE arg "[seed]" help="Sample seed"

# Mutation-testing of the Go core (spec/design/mutation-testing.md). Inject deliberate bugs into the
# core's source and check the conformance corpus catches each one; a SURVIVING mutant is untested
# logic, located precisely. Like bench/stress, a slow ANALYSIS tool, deliberately OUTSIDE
# `mise run ci`:
#   mise run mutation                    # default targets (executor/operators/value/decimal/encoding), 300 sampled
#   mise run mutation value.go           # scope to one file, full sweep of that file
#   mise run mutation value.go 500 7     # file, max mutants, sample seed
# A non-zero exit (survivors present) is not a task failure — the printed report + JSONL are the
# deliverable.

require_relative "../scripts/lib/tasks"
include Tasks

dir = File.join(ROOT, "bench/results/mutation", stamp)
FileUtils.mkdir_p(dir)
flags = { "files" => "-files", "n" => "-n", "seed" => "-seed" }.flat_map do |arg, flag|
  ENV["usage_#{arg}"] ? [flag, ENV["usage_#{arg}"]] : []
end
puts "go: mutate the Go core; the conformance corpus is the oracle"
sh? "go", "run", "./cmd/mutate", "-json", File.join(dir, "go.jsonl"), *flags, chdir: GO_DIR
