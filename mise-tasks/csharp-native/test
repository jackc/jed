#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Explicit opt-in: C# host/invariant tests and scalar shared corpus"
#USAGE flag "-c --configuration <configuration>" default="Release" help="Debug or Release"
#USAGE flag "--runtime-async" help="Compile with .NET 11 runtime-native async enabled"
#USAGE flag "--no-build" help="Use the existing assembly without rebuilding"
#USAGE flag "--assembly <path>" help="Use a captured DLL or NativeAOT executable without rebuilding"
#USAGE flag "--case <name>" default="test" help="test, native-api, query-optimization, packed-overwrite, incremental-reclaim, storage-v53, encoding, maintenance, rekey, or spill-operators"
require_relative "../../impl/csharp-native/Tools/tasks"
require_relative "../../impl/csharp-native/Tools/encoding"
configuration = ENV.fetch("usage_configuration", "Release")
selection = ENV.fetch("usage_case", "test")
abort "Unknown host case" unless %w[test native-api query-optimization packed-overwrite incremental-reclaim storage-v53 encoding maintenance rekey spill-operators].include?(selection)
arguments = [selection]
arguments << CSharpNativeTasks::ROOT if %w[test storage-v53 encoding maintenance rekey].include?(selection)
if ENV["usage_assembly"]
  actor = File.expand_path(ENV.fetch("usage_assembly"))
  abort "Missing actor" unless File.file?(actor)
  exec(actor, *arguments) unless actor.end_with?(".dll")
  CSharpNativeTasks.run(actor, *arguments)
elsif ENV["usage_no_build"] == "true"
  abort "configuration must be Debug or Release" unless %w[Debug Release].include?(configuration)
  CSharpNativeTasks.run(File.join(CSharpNativeTasks::PACKAGE, "Jed.Check/bin", configuration, "net11.0/Jed.Check.dll"), *arguments)
else
  CSharpNativeEncoding.generate
  CSharpNativeTasks.check(*arguments, configuration: configuration, runtime_async: ENV["usage_runtime_async"] == "true")
end
