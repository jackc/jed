#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Explicit opt-in: publish and test the C# NativeAOT host (downloads Microsoft compiler packs)"
#USAGE flag "--runtime-async" help="Also enable .NET 11 runtime-native async"
require_relative "../../impl/csharp-native/Tools/tasks"

abort "Initial AOT acceptance targets Linux x86-64" unless RUBY_PLATFORM.include?("linux") && RUBY_PLATFORM.include?("x86_64")
output = File.join(CSharpNativeTasks::BUILD, "aot", ENV["usage_runtime_async"] == "true" ? "runtime-async" : "default")
feature = ENV["usage_runtime_async"] == "true" ? "runtime-async=on" : ""
puts "C# net11.0 NativeAOT, SDK #{CSharpNativeTasks.sdk_version}, Runtime Async #{feature.empty? ? 'default' : 'on'}"
puts "Source SHA-256: #{CSharpNativeTasks.source_digest}"
$stdout.flush
restored = system(CSharpNativeTasks.environment, CSharpNativeTasks.dotnet,
                  "restore", "Jed.Check/Jed.Check.csproj", "--runtime", "linux-x64", "-p:PublishAot=true",
                  "--source", "https://api.nuget.org/v3/index.json", chdir: CSharpNativeTasks::PACKAGE)
exit($?&.exitstatus || 1) unless restored
# A different Features value must not reuse a previous compiler invocation's IL.
clean = system(CSharpNativeTasks.environment, CSharpNativeTasks.dotnet,
               "clean", "Jed.Check/Jed.Check.csproj", "--configuration", "Release", "--runtime", "linux-x64",
               "--nologo", "--verbosity", "quiet", chdir: CSharpNativeTasks::PACKAGE)
exit($?&.exitstatus || 1) unless clean
# These are the SDK's first-party compiler/runtime packs, not engine PackageReferences.
# Ordinary builds keep all NuGet feeds disabled. Only this explicit AOT task restores
# the Microsoft toolchain from the official feed.
ok = system(CSharpNativeTasks.environment, CSharpNativeTasks.dotnet,
            "publish", "Jed.Check/Jed.Check.csproj", "--configuration", "Release", "--runtime", "linux-x64",
            "-p:PublishAot=true", "-p:Features=#{feature}", "--no-restore",
            "--output", output, chdir: CSharpNativeTasks::PACKAGE)
exit($?&.exitstatus || 1) unless ok
exec(File.join(output, "Jed.Check"), "test", CSharpNativeTasks::ROOT)
