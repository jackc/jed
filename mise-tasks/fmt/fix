#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Rewrite core, host-artifact, tooling, and web sources with the pinned formatters"

# Applies what `mise run fmt` checks (mise-tasks/fmt/check documents the pins).

require_relative "../../scripts/lib/tasks"
include Tasks

[RUST_MANIFEST, TS_LOCK_MANIFEST, CLI_MANIFEST, RUBY_EXT_MANIFEST, WASM_MANIFEST, NODE_WRAP_MANIFEST,
 MIGRATE_RUST_MANIFEST].each do |manifest|
  sh "cargo", "fmt", "--manifest-path", manifest
end
sh "gofumpt", "-w", GO_DIR, MIGRATE_GO_DIR
sh "biome", "format", "--write", "impl/ts", "impl/node", "bench/ts", "migrate/ts"
npm_ci_if_stale(WEB_DIR)
sh "npm", "run", "--silent", "--prefix", WEB_DIR, "format"
