#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Rewrite core, host-artifact, tooling, and web sources with the pinned formatters"

# Applies what `mise run fmt` checks (mise-tasks/fmt/check documents the pins).

require_relative "../../scripts/lib/tasks"
include Tasks

FMT_CARGO_CRATES.each_value { |manifest| sh "cargo", "fmt", "--manifest-path", manifest }
sh "gofumpt", "-w", *FMT_GO_DIRS
sh "biome", "format", "--write", *FMT_TS_DIRS
npm_ci_if_stale(WEB_DIR)
sh "npm", "run", "--silent", "--prefix", WEB_DIR, "format"
