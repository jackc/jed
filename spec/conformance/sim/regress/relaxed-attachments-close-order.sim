# Under synchronous = off a clean close flushes each relaxed attachment's batch. The Go core closed
# its attachments in map order, so the order of those flushes, and the storage operation log, varied
# between two runs of one trace (simulation-testing.md §8.5). Attachments now close in name order.
# Hand-written from attachments seeds 36, 98, 109 and 143, whose final close tripped it.
# format: simulation
# profile: attachments
# seed: 109
# page_size: 512
# synchronous: off
# clock: 1700000000000000
attach a1
attach a2
attach a3
open w1 write
on w1 CREATE TABLE a1.t1 (id i64 PRIMARY KEY, c1 text)
on w1 INSERT INTO a1.t1 (id, c1) SELECT g, md5(g::text) FROM generate_series(1, 20) g
commit w1
open w2 write
on w2 CREATE TABLE a2.t1 (id i64 PRIMARY KEY, c1 text)
on w2 INSERT INTO a2.t1 (id, c1) SELECT g, md5(g::text) FROM generate_series(1, 20) g
commit w2
open w3 write
on w3 CREATE TABLE a3.t1 (id i64 PRIMARY KEY, c1 text)
on w3 INSERT INTO a3.t1 (id, c1) SELECT g, md5(g::text) FROM generate_series(1, 20) g
commit w3
reopen
open w4 write
on w4 INSERT INTO a1.t1 (id, c1) SELECT g, md5(g::text) FROM generate_series(21, 30) g
commit w4
open w5 write
on w5 INSERT INTO a3.t1 (id, c1) SELECT g, md5(g::text) FROM generate_series(21, 30) g
commit w5
open w6 write
on w6 INSERT INTO a2.t1 (id, c1) SELECT g, md5(g::text) FROM generate_series(21, 30) g
commit w6
