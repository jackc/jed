# Mixed numeric arguments to the two-argument math functions power / pow / log(b, x) / atan2. A
# pair that matches no row is resolved by the argument-coercion pass (spec/design/arg-coercion.md):
# an integer facing a decimal takes the decimal overload (PostgreSQL's implicit int → numeric), and
# an integer or decimal LITERAL facing a float adapts to that float (PostgreSQL's numeric constant →
# float8). A VALUE never becomes a float (float.md §6). width_bucket's float form adapts its literal
# bounds the same way, in its own resolver. PostgreSQL-oracle-checked.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.select_no_from, query.where_eq, types.i32, types.i64, types.decimal, types.f32, types.f64, expr.numeric_transcendental, func.mixed_numeric_args, func.arg_coercion

statement ok
CREATE TABLE mn (id i32 PRIMARY KEY, i i32, b i64, d numeric, f f64)

statement ok
INSERT INTO mn VALUES (1, 3, 2, 2.5, 2.0)

# --- integer and decimal: the decimal overload -------------------------------------------------
query D nosort
SELECT power(2.0, 3)
----
8.0000000000000000

query D nosort
SELECT power(2, 3.0)
----
8.0000000000000000

query D nosort
SELECT pow(2, 0.5)
----
1.4142135623730950

query D nosort
SELECT power(-2.0, 3)
----
-8.0000000000000000

query D nosort
SELECT log(2, 8.0)
----
3.0000000000000000

query D nosort
SELECT log(2.0, 8)
----
3.0000000000000000

query D nosort
SELECT power(d, i) FROM mn WHERE id = 1
----
15.625000000000000

query D nosort
SELECT power(b, d) FROM mn WHERE id = 1
----
5.6568542494923802

query D nosort
SELECT log(b, 1024.0) FROM mn WHERE id = 1
----
10.0000000000000000

query D nosort
SELECT power(d, NULL) FROM mn WHERE id = 1
----
NULL

statement error 2201F
SELECT power(0.0, -1)

statement error 2201E
SELECT log(2, 0.0)

# --- a float and a numeric literal: the float overload -----------------------------------------
query R nosort
SELECT power(f, 3) FROM mn WHERE id = 1
----
8

query R nosort
SELECT pow(f, 0.5) FROM mn WHERE id = 1
----
1.4142135623730951

query R nosort
SELECT power(2.5::f32, 2)
----
6.25

query R nosort
SELECT atan2(1.0::f64, 1)
----
0.7853981633974483

query R nosort
SELECT atan2(1, f) FROM mn WHERE id = 1
----
0.4636476090008061

query I nosort
SELECT width_bucket(f, 0, 10, 5) FROM mn WHERE id = 1
----
2

query I nosort
SELECT width_bucket(5, 0.0::f64, 10.0, 5)
----
3

# --- still unresolved: a float VALUE never meets an integer or decimal value -------------------
statement error 42883
SELECT power(f, i) FROM mn WHERE id = 1

statement error 42883
SELECT width_bucket(f, i, 10, 5) FROM mn WHERE id = 1
