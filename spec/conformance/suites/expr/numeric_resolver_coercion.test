# types: decimal, i64, i64
query DII nosort
SELECT div(NULL, NULL), gcd(NULL, NULL), lcm(NULL, NULL)
----
NULL
NULL
NULL

# types: i32, i32, i16
query III nosort
SELECT gcd(12::i16, 18::i32), lcm(4::i16, 6::i32), gcd(12::i16, NULL)
----
6
12
NULL

# types: decimal, decimal
query DD nosort
SELECT div(9::i16, 4.0), gcd(8::i16, 3.0)
----
