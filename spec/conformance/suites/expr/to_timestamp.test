# to_timestamp(text, template) → timestamptz and to_date(text, template) → date
# (spec/design/formatting.md §5; PostgreSQL's "Data Type Formatting Functions", manual §9.8): the
# field readers, fixed-width vs FM fields, separator / space skipping, FX, the word readers, BC
# years, ISO week dates, day of year, fractional seconds (FFn rounds), the TZH / TZM / OF offsets,
# and PostgreSQL's errors. Most shapes come from PostgreSQL's horology regression test. The session
# zone is UTC unless a record says otherwise. PostgreSQL-oracle-verified (postgres:18).
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.order_by, query.select, query.select_no_from, types.i32, types.text, types.timestamptz, types.date, types.f64, session.timezone, query.set_returning, func.to_timestamp

# load-timezone: America/New_York

query T nosort
SELECT to_timestamp('0097/Feb/16 --> 08:14:30', 'YYYY/Mon/DD --> HH:MI:SS')
----
0097-02-16 08:14:30+00

query T nosort
SELECT to_timestamp('97/2/16 8:14:30', 'FMYYYY/FMMM/FMDD FMHH:FMMI:FMSS')
----
0097-02-16 08:14:30+00

query T nosort
SELECT to_timestamp('2011$03!18 23_38_15', 'YYYY-MM-DD HH24:MI:SS')
----
2011-03-18 23:38:15+00

