# === the session zone ========================================================================

# an offset-less reading is a wall clock in the session zone (DST included); an offset fixes it
# timezone: America/New_York
query T nosort
SELECT to_timestamp('2024-01-15 12:00', 'YYYY-MM-DD HH24:MI')
----
2024-01-15 12:00:00-05

# timezone: America/New_York
query T nosort
SELECT to_timestamp('2024-07-15 12:00', 'YYYY-MM-DD HH24:MI')
----
2024-07-15 12:00:00-04

# timezone: America/New_York
query T nosort
SELECT to_timestamp('2024-07-15 12:00 +02', 'YYYY-MM-DD HH24:MI TZH')
----
2024-07-15 06:00:00-04

# the spring-forward gap and the fall-back overlap resolve as PostgreSQL does
# timezone: America/New_York
query T nosort
SELECT to_timestamp('2024-03-10 02:30', 'YYYY-MM-DD HH24:MI')
----
2024-03-10 03:30:00-04

# timezone: America/New_York
query T nosort
SELECT to_timestamp('2024-11-03 01:30', 'YYYY-MM-DD HH24:MI')
----
2024-11-03 01:30:00-05

# to_date reads no zone
# timezone: America/New_York
query T nosort
SELECT to_date('2024-07-15 23:30', 'YYYY-MM-DD HH24:MI')
----
2024-07-15

# to_timestamp(seconds) is an instant, rendered in the session zone
# timezone: America/New_York
query T nosort
SELECT to_timestamp(1700000000::f64)
----
2023-11-14 17:13:20-05

# === a column template and input ===============================================================

statement ok
CREATE TABLE tt (id i32 PRIMARY KEY, s text, f text)

statement ok
INSERT INTO tt VALUES (1, '2024-03-05', 'YYYY-MM-DD'), (2, '05/03/2024', 'DD/MM/YYYY'), (3, 'March 5, 2024', 'Month DD, YYYY'), (4, NULL, 'YYYY'), (5, '2024', NULL)

