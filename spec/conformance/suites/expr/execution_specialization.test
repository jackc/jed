query I nosort
SELECT id FROM kernels WHERE a+b > 0 ORDER BY id
----
4

# LIMIT/OFFSET result windows, including an empty window.
query I nosort
SELECT a/0 FROM kernels ORDER BY id LIMIT 0
----

query I nosort
SELECT a/(id+1) FROM kernels ORDER BY id LIMIT 1 OFFSET 1
----
NULL

# Boolean / lazy roots retain their branch behavior under composition.
query BBII nosort
SELECT flag AND NULL, flag OR NULL, CASE WHEN flag THEN a ELSE b END, coalesce(a,b) FROM kernels ORDER BY id
----
NULL
true
-7
-7
NULL
NULL
2
2
false
NULL
NULL
4
NULL
true
9
9

query I nosort
SELECT CASE WHEN id > 0 THEN a ELSE b/0 END FROM kernels ORDER BY id
----
-7
NULL
4
9

# A NULL left operand does not skip a strict operator's right-hand error.
statement error 22012
SELECT a+(b/0) FROM kernels WHERE id = 2 ORDER BY id

# Qual AND skips a NULL left conjunct; value AND still visits its RHS.
query I nosort
SELECT id FROM kernels WHERE id = 2 AND flag AND b/0 = 1 ORDER BY id
----

statement error 22012
SELECT flag AND b/0 = 1 FROM kernels WHERE id = 2 ORDER BY id

statement ok
CREATE TABLE boundaries (id i32 PRIMARY KEY, lo i16, hi i32, wide i64, divisor i64)

statement ok
INSERT INTO boundaries VALUES (1, 32767, 2147483647, -9223372036854775808, -1)

statement error 22003
SELECT lo + lo FROM boundaries ORDER BY id

statement error 22003
SELECT hi + hi FROM boundaries ORDER BY id

statement error 22003
SELECT wide / divisor FROM boundaries ORDER BY id

query I nosort
SELECT wide % divisor FROM boundaries ORDER BY id
----
0

# Integer-result date arithmetic is not proof of integer input types.
statement ok
CREATE TABLE dates (id i32 PRIMARY KEY, a date, b date)

statement ok
INSERT INTO dates VALUES (1, '2020-01-03', '2020-01-01')

query I nosort
SELECT (a-b)+1 FROM dates ORDER BY id
----
3

# Composed value booleans, filtered CASE and nested COALESCE, with NULL at each
# side. Multiple-WHEN and longer COALESCE remain independent ordinary controls.
query BBII nosort
SELECT flag AND (a>b OR b IS NULL), flag OR (a<b AND b IS NOT NULL), CASE WHEN flag AND a<0 THEN a/b ELSE coalesce(a,b) END, coalesce(CASE WHEN flag THEN a+b ELSE NULL END,b) FROM kernels ORDER BY id
----
false
true
-2
-4
NULL
NULL
2
2
false
false
4
NULL
true
true
9
7

query I nosort
SELECT coalesce(a,b/0) FROM kernels WHERE a IS NOT NULL ORDER BY id
----
-7
4
9

query I nosort
SELECT CASE WHEN a IS NULL THEN b WHEN flag THEN a ELSE b END FROM kernels ORDER BY id
----
-7
2
NULL
9

query I nosort
SELECT coalesce(a,b,0) FROM kernels ORDER BY id
----
-7
2
4
9

# Preserve narrow intermediate overflow and error visitation inside lazy roots,
# even when CASE/COALESCE unifies the result to a wider integer type.
statement error 22003
SELECT CASE WHEN id=1 THEN hi+hi ELSE wide/0 END FROM boundaries ORDER BY id

statement error 22012
SELECT CASE WHEN id=0 THEN hi+hi ELSE wide/0 END FROM boundaries ORDER BY id

statement error 22003
SELECT coalesce(hi+hi,wide/0) FROM boundaries ORDER BY id
