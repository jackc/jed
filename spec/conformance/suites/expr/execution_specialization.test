# Small typed execution roots and ordinary fallback controls. Ordered scans also
# exercise the pull cursor; expressions must preserve NULL and trap visitation.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.order_by, query.limit, query.offset, query.where_eq, query.comparison_order, query.logical_connectives, expr.arithmetic, expr.comparison_value, expr.case, expr.coalesce, cast.explicit, types.i16, types.i32, types.i64, types.boolean, types.date, null.three_valued, error.overflow_trap, error.division_by_zero

statement ok
CREATE TABLE kernels (id i32 PRIMARY KEY, a i32, b i32, flag boolean)

statement ok
INSERT INTO kernels VALUES (1, -7, 3, true), (2, NULL, 2, NULL), (3, 4, NULL, false), (4, 9, -2, true)

query IIII nosort
SELECT a+b, (a+b)*(a-b), a/b, a%b FROM kernels ORDER BY id
