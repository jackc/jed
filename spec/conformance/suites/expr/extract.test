# quarter works from the signed months field, not the truncated month-of-year: a nonnegative
# months count gives (months % 12)/3 + 1 (1..4, so 12 months is quarter 1); a negative one gives
# -((-months % 12)/3 + 1) (-1..-4, so -12 months is quarter -1, not 1). In order:
# -13 -12 -11 -3 -2 -1 1 2 3 11 12 13 months
query DDDDDDDDDDDD nosort
SELECT EXTRACT(quarter FROM interval '-13 mons'), EXTRACT(quarter FROM interval '-12 mons'), EXTRACT(quarter FROM interval '-11 mons'), EXTRACT(quarter FROM interval '-3 mons'), EXTRACT(quarter FROM interval '-2 mons'), EXTRACT(quarter FROM interval '-1 mons'), EXTRACT(quarter FROM interval '1 mons'), EXTRACT(quarter FROM interval '2 mons'), EXTRACT(quarter FROM interval '3 mons'), EXTRACT(quarter FROM interval '11 mons'), EXTRACT(quarter FROM interval '12 mons'), EXTRACT(quarter FROM interval '13 mons')
----
-1
-1
-4
-2
-1
-1
1
1
2
4
1
1

# week = days/7, truncating toward zero. In order: -14 -13 -7 -6 6 7 13 14 days
query DDDDDDDD nosort
SELECT EXTRACT(week FROM interval '-14 days'), EXTRACT(week FROM interval '-13 days'), EXTRACT(week FROM interval '-7 days'), EXTRACT(week FROM interval '-6 days'), EXTRACT(week FROM interval '6 days'), EXTRACT(week FROM interval '7 days'), EXTRACT(week FROM interval '13 days'), EXTRACT(week FROM interval '14 days')
----
-2
-1
-1
0
0
1
1
2

# the date-of fields are 0A000 for an interval ("unit X not supported for type interval") —
# julian too, which PostgreSQL also rejects for an interval
statement error 0A000
SELECT EXTRACT(isodow FROM interval '3 days')

statement error 0A000
SELECT EXTRACT(doy FROM interval '3 days')

statement error 0A000
SELECT EXTRACT(isoyear FROM interval '3 days')

statement error 0A000
SELECT EXTRACT(julian FROM interval '3 days')

statement error 0A000
SELECT EXTRACT(timezone FROM interval '3 days')

statement error 0A000
SELECT EXTRACT(timezone_hour FROM interval '3 days')

statement error 0A000
SELECT EXTRACT(timezone_minute FROM interval '3 days')

# an unrecognized field is 22023 ("unit X not recognized for type interval")
statement error 22023
SELECT EXTRACT(bogus FROM interval '3 days')

# ============================================================================================
# timestamptz under a non-UTC session zone: the wall-clock fields shift; epoch is zone-independent
# (02:30 UTC on 2024-03-15 is 22:30 on the 14th in New York, EDT -04).
# ============================================================================================

# timezone: America/New_York
query DD nosort
SELECT EXTRACT(hour FROM timestamptz '2024-03-15 02:30:00+00'), EXTRACT(day FROM timestamptz '2024-03-15 02:30:00+00')
----
22
14

# epoch is the instant — independent of the session zone
# timezone: America/New_York
query D nosort
SELECT EXTRACT(epoch FROM timestamptz '2024-03-15 02:30:00+00')
----
1710469800.000000

# the timezone* fields report the session zone's offset at that instant (July -> EDT -04)
# timezone: America/New_York
query DDD nosort
SELECT EXTRACT(timezone FROM timestamptz '2024-07-15 12:00:00+00'), EXTRACT(timezone_hour FROM timestamptz '2024-07-15 12:00:00+00'), EXTRACT(timezone_minute FROM timestamptz '2024-07-15 12:00:00+00')
----
-14400
-4
0

# ============================================================================================
# Errors and NULL
# ============================================================================================

# an unrecognized field is 22023
statement error 22023
SELECT EXTRACT(bogus FROM timestamp '2024-03-15 00:00:00')

# a NULL source propagates to NULL
query D nosort
SELECT EXTRACT(hour FROM CAST(NULL AS timestamp))
----
NULL
