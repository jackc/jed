query DDDDDDDDDDDDDD nosort
SELECT EXTRACT(microseconds FROM i), EXTRACT(milliseconds FROM i), EXTRACT(second FROM i), EXTRACT(minute FROM i), EXTRACT(hour FROM i), EXTRACT(day FROM i), EXTRACT(week FROM i), EXTRACT(month FROM i), EXTRACT(quarter FROM i), EXTRACT(year FROM i), EXTRACT(decade FROM i), EXTRACT(century FROM i), EXTRACT(millennium FROM i), EXTRACT(epoch FROM i) FROM (SELECT interval '0 days' AS i) AS s
