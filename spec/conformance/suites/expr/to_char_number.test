# i16 / i32 take PostgreSQL's int4 path: EEEE through float8 (round half to even), unlike i64
query TTTT nosort
SELECT '[' || to_char(125::i32, '9.9EEEE') || ']', '[' || to_char(125::i16, '9.9EEEE') || ']', '[' || to_char(125::i64, '9.9EEEE') || ']', '[' || to_char(1234::i32, '9.99EEEE') || ']'
----
[ 1.2e+02]
[ 1.2e+02]
[ 1.3e+02]
[ 1.23e+03]

# a bare integer literal is i64 in jed (types.md §6), so it takes the int8 path
query T nosort
SELECT '[' || to_char(125, '9.9EEEE') || ']'
----
[ 1.3e+02]

query TT nosort
SELECT '[' || to_char(1234::i64, '9.99eeee') || ']', '[' || to_char(-1234::i64, '9.99eeee') || ']'
----
[ 1.23e+03]
[-1.23e+03]

query TT nosort
SELECT '[' || to_char(1234::i32, '99999V99') || ']', '[' || to_char(1234::i64, '99999V99') || ']'
----
[  123400]
[  123400]

# the V multiplier on an i32 overflows to 22003 (PostgreSQL's int4mul / dtoi4), on an i64 at int8
query TT nosort
SELECT '[' || to_char(2::i32, '9V999999999') || ']', '[' || to_char((-2)::i32, '9V999999999') || ']'
----
[ 2000000000]
[-2000000000]

statement error 22003
SELECT to_char(3::i32, '9V999999999')

query TT nosort
SELECT '[' || to_char(214748364::i32, '999999999V9') || ']', '[' || to_char(3::i64, '9V999999999') || ']'
----
[ 2147483640]
[ 3000000000]

statement error 22003
SELECT to_char((-2147483648)::i32, '9V9')

statement error 22003
SELECT to_char(1::i32, '9V9999999999')

statement error 22003
SELECT to_char(10::i64, '9V999999999999999999')

query T nosort
SELECT '[' || to_char(9::i64, '9V999999999999999999') || ']'
----
[ 9000000000000000000]

# the ordinal suffix
query TTTTTT nosort
SELECT '[' || to_char(1, '99th') || ']', '[' || to_char(2, '99TH') || ']', '[' || to_char(3, 'FM99th') || ']', '[' || to_char(11, '99th') || ']', '[' || to_char(112, '999th') || ']', '[' || to_char(-1, '99th') || ']'
----
[  1st]
[  2ND]
[3rd]
[ 11th]
[ 112th]
[ -1]

# S at the front and back; MI / PL / SG; PR's brackets
query TTTTTT nosort
SELECT '[' || to_char(-12.5, 'S99.9') || ']', '[' || to_char(12.5, '99.9S') || ']', '[' || to_char(-12.5, 'FM99.9MI') || ']', '[' || to_char(12.5, 'PL99.9') || ']', '[' || to_char(-12.5, 'SG99.9') || ']', '[' || to_char(-12.5, '99.9PR') || ']'
----
[-12.5]
[12.5+]
[12.5-]
[+ 12.5]
[-12.5]
[<12.5>]

# the '#' overflow fill
query TTTT nosort
SELECT '[' || to_char(12345, '999') || ']', '[' || to_char(12345.678, '999.99') || ']', '[' || to_char(-12345, '99') || ']', '[' || to_char(12345::f64, '99.9') || ']'
----
[ ###]
[ ###.##]
[-##]
[ ##.#]

# B blanks a zero integer part; 0 forces the digits
query TTTT nosort
SELECT '[' || to_char(0.5, '9.9') || ']', '[' || to_char(0.5, '0.9') || ']', '[' || to_char(0, 'B9') || ']', '[' || to_char(0.0, 'FM9.9') || ']'
----
[  .5]
[ 0.5]
[ 0]
[0.]

# a template with no digits
query TTT nosort
SELECT '[' || to_char(5, 'xyz') || ']', '[' || to_char(5, 'FM') || ']', '[' || to_char(5, 'L') || ']'
----
[xyz]
[]
[ ]

# an empty template is the empty string (not NULL, unlike the datetime to_char)
query T nosort
SELECT '[' || to_char(5, '') || ']'
----
[]

query TT nosort
SELECT '[' || to_char(NULL::i32, '999') || ']', '[' || to_char(5, NULL) || ']'
----
NULL
NULL

# floats keep at most DBL_DIG / FLT_DIG significant digits
query TT nosort
SELECT '[' || to_char(1.0 / 3.0, '9.999999999999999999999') || ']', '[' || to_char(1::f64 / 3, '9.999999999999999999999') || ']'
----
[  .333333333333333333330]
[  .33333333333333]

query TT nosort
SELECT '[' || to_char(0.1::f64, '9.99999999999999999999') || ']', '[' || to_char(0.1::f32, '9.99999999999999999999') || ']'
----
[  .10000000000000]
[  .10000]

# EEEE ignores the rest of the template and keeps the significand that rounds to 10
query TTT nosort
SELECT '[' || to_char(9.9996, '9.999EEEE') || ']', '[' || to_char(0.00012345, '9.99EEEE') || ']', '[' || to_char(-1.5, 'xx9.9EEEE') || ']'
----
[ 10.000e+00]
[ 1.23e-04]
[-1.5e+00]

query TT nosort
SELECT '[' || to_char(1.5::f64, '9EEEE') || ']', '[' || to_char(1.5, '9EEEE') || ']'
----
[ 2e+00]
[ 2e+00]

