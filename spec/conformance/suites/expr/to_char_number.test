# A float V multiplier is glibc's pow(10, n): the nearest double, the upper one at the exact tie of
# 10^23 (formatting.md §6.3)
query TTTT nosort
SELECT '[' || to_char(1::f64, '9V99999999999999999999999') || ']', '[' || to_char(3::f64, '9V999999999999999999999999999999999') || ']', '[' || to_char(1::f32, '9V99999999999999999999999') || ']', '[' || to_char(7::f64, '9V9999999999999999999999') || ']'
----
[ 100000000000000008388608]
[ 2999999999999999836725692961128448]
[  99999997781963083612160]
[ 70000000000000004194304]
