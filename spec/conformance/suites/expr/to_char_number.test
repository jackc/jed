# to_char over integers, decimals, and floats (spec/design/formatting.md §6; PostgreSQL's "Data
# Type Formatting Functions", manual §9.8). The digit patterns 9 / 0, the decimal point (. / D),
# grouping (, / G), the sign patterns (S / MI / PL / SG / PR), L, V, EEEE, RN, TH, FM, literals,
# and the '#' overflow fill, over the four PostgreSQL entry points: int4 (i16 / i32), int8 (i64),
# numeric (decimal), and float4 / float8 (f32 / f64). Many shapes come from PostgreSQL's own
# numeric / int8 / int4 regression tests. Results are bracketed so padding is visible.
# PostgreSQL-oracle-verified (postgres:18, lc_numeric = C).
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_no_from, query.order_by, types.i16, types.i32, types.i64, types.decimal, types.f32, types.f64, types.text, func.to_char

statement ok
CREATE TABLE nd (id i32 PRIMARY KEY, val decimal(30,10))

statement ok
INSERT INTO nd VALUES (0, 0), (2, -34338492.215397047), (3, 4.31), (4, 7799461.4119), (5, 16397.038491), (6, 93901.57763026), (7, -83028485), (8, 74881), (9, -24926804.045047420)

statement ok
CREATE TABLE i8 (id i32 PRIMARY KEY, q1 i64, q2 i64)

statement ok
INSERT INTO i8 VALUES (1, 123, 456), (2, 123, 4567890123456789), (3, 4567890123456789, 123), (4, 4567890123456789, 4567890123456789), (5, 4567890123456789, -4567890123456789)

statement ok
CREATE TABLE fl (id i32 PRIMARY KEY, d f64, r f32)

statement ok
INSERT INTO fl VALUES (1, 0, 0), (2, -4.2, -4.2), (3, 4.2e9, 4.2e9), (4, 1.2e-5, 1.2e-5), (5, 'Infinity', 'Infinity'), (6, '-Infinity', '-Infinity'), (7, 'NaN', 'NaN'), (8, 0.5, 0.5), (9, 2.5, 2.5), (10, 1234.5678, 1234.5678), (11, -0.0, -0.0), (12, 123456789.123456789, 123456789.123456789)

