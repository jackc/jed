# A filter's conjuncts run cheapest first (spec/design/planner.md §3.0): the top-level AND chain of a
# WHERE, a join's ON, or a HAVING is stable-sorted by estimated per-row cost — a conjunct without a
# correlated subquery before one with, then fewer estimated operator_eval (estimator.md §8.2) — with
# ties kept in source order. This is PostgreSQL's order_qual_clauses, so a guard written second
# still keeps a trapping conjunct off the rows it rejects. A partial index's WHERE, ON CONFLICT …
# WHERE, and a MERGE WHEN condition keep source order, as in PostgreSQL. Verified against
# PostgreSQL 18.
# Format + `requires`: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.view, dml.insert, dml.insert_multi_row, dml.update, dml.delete, dml.insert_on_conflict, dml.merge, ddl.index_partial, query.select, query.where_eq, query.comparison_order, query.order_by, query.logical_connectives, query.filter_conjunct_order, query.join_inner, query.join_left, query.table_alias, query.qualified_column, query.where_pushdown, query.derived_table, query.derived_pushdown, query.cte, query.group_by, query.having, query.aggregates, query.subquery_scalar, query.subquery_correlated, query.is_null, expr.arithmetic, error.division_by_zero, types.i32, null.three_valued, resource.cost_metering

statement ok
CREATE TABLE z (id i32 PRIMARY KEY, d i32, g i32)

statement ok
INSERT INTO z VALUES (1, 0, NULL), (2, 5, 1), (3, 20, 0), (4, NULL, 1)

# The guard written second runs first: `d <> 0` (one operator_eval) sorts before `10 / d > 1`
# (two). Row 1's FALSE guard and row 4's NULL one stop the filter before the division. The cost is
# the guard-first form's: 1 page + 4 rows + 4 `and` + 4 `<>` + 2 x 2 for `10 / d > 1` + 1 produced.
# cost: 18
query I nosort
SELECT id FROM z WHERE 10 / d > 1 AND d <> 0 ORDER BY id
----
2

# Equal estimates keep source order: `d + 0 <> 0` also costs two, so the division runs first.
statement error 22012
SELECT id FROM z WHERE 10 / d > 1 AND d + 0 <> 0 ORDER BY id

# A longer chain sorts as a whole: `d IS NOT NULL` and `d <> 0` (one each, in source order) before
# the division.
query I nosort
SELECT id FROM z WHERE 10 / d > 1 AND d IS NOT NULL AND d <> 0 ORDER BY id
----
2

# Only the top-level chain sorts: under OR the AND is a value evaluated left to right, and traps.
statement error 22012
SELECT id FROM z WHERE (10 / d > 1 AND d <> 0) OR id = 9

# A select-list AND is a value too.
statement error 22012
SELECT id, 10 / d > 1 AND d <> 0 FROM z

# A conjunct with a correlated subquery runs after every conjunct without one, whatever its
# operator count: the guard `d + 0 + 0 <> 0` (three) runs before the subquery comparison.
query I nosort
SELECT id FROM z WHERE (SELECT count(*) FROM z w WHERE w.id = z.id AND 10 / z.d > 1) > 0 AND d + 0 + 0 <> 0 ORDER BY id
----
2

# HAVING sorts its chain.
query I nosort
SELECT id FROM z GROUP BY id, g, d HAVING 10 / d > 1 AND d <> 0 ORDER BY id
----
2

# So does a join's ON, inner and outer.
query II nosort
SELECT a.id, b.id FROM z a JOIN z b ON a.id = b.id AND 10 / b.d > 1 AND b.d <> 0 ORDER BY a.id
----
2
2

query II nosort
SELECT a.id, b.id FROM z a LEFT JOIN z b ON a.id = b.id AND 10 / b.d > 1 AND b.d <> 0 ORDER BY a.id
----
1
NULL
2
2
3
NULL
4
NULL

# A WHERE inside a subquery.
query I nosort
SELECT (SELECT count(*) FROM z WHERE 10 / d > 1 AND d <> 0)
----
1

# A guard pushed into a derived table, a view, or an inlined CTE joins the body's own WHERE, and the
# combined chain sorts: the outer `d <> 0` runs before the body's division.
query II nosort
SELECT id, d FROM (SELECT * FROM z WHERE 10 / d > 1) s WHERE d <> 0
----
2
5

statement ok
CREATE VIEW zv AS SELECT * FROM z WHERE 10 / d > 1

query I nosort
SELECT id FROM zv WHERE d <> 0
----
2

query I nosort
WITH c AS (SELECT * FROM z WHERE 10 / d > 1) SELECT id FROM c WHERE d <> 0
----
2

# UPDATE and DELETE filter the same way.
statement ok
UPDATE z SET d = d WHERE 10 / d > 1 AND d <> 0

statement ok
DELETE FROM z WHERE 10 / d < 1 AND d <> 0

query I nosort
SELECT id FROM z ORDER BY id
----
1
2
4

# A partial index's WHERE keeps source order: indexing row 5 (d = 0) divides by zero.
statement ok
CREATE TABLE q (id i32 PRIMARY KEY, d i32)

statement ok
CREATE INDEX q_p ON q (id) WHERE 10 / d > 1 AND d <> 0

statement error 22012
INSERT INTO q VALUES (5, 0)

# ON CONFLICT … DO UPDATE … WHERE keeps source order.
statement ok
CREATE TABLE r (id i32 PRIMARY KEY, d i32)

statement ok
INSERT INTO r VALUES (1, 0)

statement error 22012
INSERT INTO r VALUES (1, 0) ON CONFLICT (id) DO UPDATE SET d = 9 WHERE 10 / r.d > 1 AND r.d <> 0

# A MERGE WHEN condition keeps source order.
statement error 22012
MERGE INTO r USING (SELECT 1 AS id) s ON r.id = s.id WHEN MATCHED AND 10 / r.d > 1 AND r.d <> 0 THEN UPDATE SET d = 1
