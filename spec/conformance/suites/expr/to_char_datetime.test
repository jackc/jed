[12 12 12 00 00 000 000000 0 00 000 0000 00000 000000 43200 43200]
5
[08 08 08 09 10 500 500000 5 50 500 5000 50000 500000 29350 29350]
6
[01 01 01 02 03 000 000000 0 00 000 0000 00000 000000 3723 3723]
7
[11 11 11 59 00 000 000000 0 00 000 0000 00000 000000 43140 43140]
8
