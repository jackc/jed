# to_char over timestamp, timestamptz, and interval (spec/design/formatting.md §3–§4; PostgreSQL's
# "Data Type Formatting Functions", manual §9.8). The template patterns, the FM / TM / TH / th
# modifiers, double-quoted literals and backslash escapes, BC and wide years, ISO weeks, Julian
# days, the zone patterns (TZ / tz / OF / TZH / TZM) in the session zone, and the interval rules.
# Results are bracketed so leading and trailing spaces are visible. PostgreSQL-oracle-verified
# (postgres:18, lc_time = C).
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_no_from, query.order_by, types.i32, types.text, types.timestamp, types.timestamptz, types.interval, session.timezone, func.to_char

# load-timezone: America/New_York
# load-timezone: Asia/Kolkata

statement ok
CREATE TABLE ts (id i32 PRIMARY KEY, t timestamp)

statement ok
INSERT INTO ts VALUES (1, '2024-03-05 13:04:05.123456'), (2, '1999-12-31 23:59:59'), (3, '2000-01-01 00:00:00'), (4, '0044-03-15 12:00:00 BC'), (5, '12345-06-07 08:09:10.5'), (6, '2021-01-03 01:02:03'), (7, '2020-12-31 11:59:00'), (8, NULL)

# === the field patterns ===================================================================

query IT nosort
SELECT id, '[' || to_char(t, 'YYYY-MM-DD HH24:MI:SS.US') || ']' FROM ts ORDER BY id
----
1
[2024-03-05 13:04:05.123456]
2
[1999-12-31 23:59:59.000000]
3
[2000-01-01 00:00:00.000000]
4
[0044-03-15 12:00:00.000000]
5
[12345-06-07 08:09:10.500000]
6
[2021-01-03 01:02:03.000000]
7
[2020-12-31 11:59:00.000000]
8
NULL

