# every Roman numeral round-trips through to_char and to_number
query B nosort
SELECT bool_and(to_number(to_char(i::i32, 'RN'), 'RN') = i) FROM generate_series(1, 3999) AS g(i)
----
true

query I nosort
SELECT count(*) FROM generate_series(1, 3999) AS g(i) WHERE to_number(to_char(i::i32, 'FMrn'), 'rn') <> i
----
0
