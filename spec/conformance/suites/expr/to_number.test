# to_number(text, template) → decimal (spec/design/formatting.md §7; PostgreSQL's "Data Type
# Formatting Functions", manual §9.8): digits read under 9 / 0 / . / D, grouping skipped under
# , / G, signs before or after the digits (S / MI / PL / SG / PR), L, TH, RN, V, and the result
# as numeric(precision, scale) of the digits read. Most shapes come from PostgreSQL's numeric
# regression test. PostgreSQL-oracle-verified (postgres:18, lc_numeric = C).
# requires: query.select, query.select_no_from, query.set_returning, query.aggregates, types.i32, types.text, types.decimal, func.to_char, func.to_number

query D nosort
SELECT to_number('-34,338,492', '99G999G999')
----
-34338492

query D nosort
SELECT to_number('-34,338,492.654,878', '99G999G999D999G999')
----
-34338492.654878

query D nosort
SELECT to_number('<564646.654564>', '999999.999999PR')
----
-564646.654564

query D nosort
SELECT to_number('0.00001-', '9.999999S')
----
-0.00001

query D nosort
SELECT to_number('5.01-', 'FM9.999999S')
----
-5.01

query D nosort
SELECT to_number('5.01-', 'FM9.999999MI')
----
-5.01

query D nosort
SELECT to_number('5 4 4 4 4 8 . 7 8', '9 9 9 9 9 9 . 9 9')
----
544448.78

query D nosort
