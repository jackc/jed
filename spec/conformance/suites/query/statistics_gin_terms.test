# GIN term statistics (spec/design/statistics.md §4.5/§6.1): ANALYZE counts each array / jsonb
# column's GIN terms by lossy counting and keeps the 100 most common, and the planner prices a GIN
# predicate with a literal operand from them — the predicate's logical rows and the GIN candidate's
# scan rows, gin_entry reads, and index pages. These deterministic integer estimates, plan choices,
# and ANALYZE costs are jed-owned and cross-core checked; NoREC relation gin_stats checks the rows.
# requires: maintenance.analyze, maintenance.analyze_gin_terms, introspect.statistics, ddl.create_table, ddl.primary_key, ddl.secondary_index, ddl.gin_index, query.gin_scan, query.gin_any_eq, query.gin_jsonb_ops, dml.insert, dml.insert_multi_row, dml.insert_select, query.select, query.set_returning, query.explain, query.order_by, query.aggregates, func.array_containment, func.array_quantified, func.array, func.jsonb_contains, func.json_builders, func.jsonb_mutate, expr.arithmetic, expr.case, cast.operator, types.i32, types.i64, types.text, types.array, types.jsonb, resource.cost_metering

# --- a skewed array and document column beside an ordered index ------------------------------

statement ok
CREATE TABLE gt (id i32 PRIMARY KEY, tags i32[], n i32, doc jsonb)

statement ok
INSERT INTO gt SELECT g::i32, ARRAY[0::i32, (g % 10)::i32, (1000 + g)::i32], (g % 10)::i32,
  jsonb_build_object('k', g % 4, 'all', true) || CASE WHEN g % 50 = 0 THEN '{"rare": 1}'::jsonb ELSE '{}'::jsonb END
FROM generate_series(1, 1000) AS g

statement ok
CREATE INDEX gt_tags ON gt USING gin (tags)

statement ok
CREATE INDEX gt_n ON gt (n)

statement ok
CREATE INDEX gt_doc ON gt USING gin (doc)

# Without statistics every GIN strategy takes the `matching` default (1/100) and the ordered
# equality (1/200) wins.
query ITTII nosort
EXPLAIN SELECT id FROM gt WHERE tags @> '{1005}'::i32[] AND n = 5
----
0
Filter
conjuncts=2
2
34
1
Scan gt
Index bound: using gt_n; touched=3
5
17

query ITTII nosort
EXPLAIN SELECT id FROM gt WHERE tags @> '{0}'::i32[]
----
0
Filter
conjuncts=1
10
62
1
Scan gt
GIN bound: using gt_tags; touched=2
10
42

query ITTII nosort
EXPLAIN SELECT id FROM gt WHERE doc ? 'all'
----
0
Filter
conjuncts=1
10
62
1
Scan gt
GIN bound: using gt_doc; touched=2
10
42

# The cost pins each row's term extraction (statistics_value per term byte) cross-core.
# cost: 82560
statement ok
ANALYZE gt (tags, n, doc)

# tags has 1011 distinct terms (truncated to 100); doc's keys and values fit (complete); n has none.
query TI nosort
SELECT column_name, term_count FROM jed_statistics ORDER BY column_name
----
doc
8
n
NULL
tags
100

# 1005 is in one row and n = 5 in 100: the GIN bound now wins.
query ITTII nosort
EXPLAIN SELECT id FROM gt WHERE tags @> '{1005}'::i32[] AND n = 5
----
0
Filter
conjuncts=2
1
10
1
Scan gt
GIN bound: using gt_tags; touched=3
1
6

# 0 is in every row: a full scan beats 1000 posting entries plus 1000 point fetches.
query ITTII nosort
EXPLAIN SELECT id FROM gt WHERE tags @> '{0}'::i32[]
----
0
Filter
conjuncts=1
1000
3010
1
Scan gt
Full scan; touched=2
1000
1010

query ITTII nosort
EXPLAIN SELECT id FROM gt WHERE 5 = ANY(tags)
----
0
Filter
conjuncts=1
100
602
1
Scan gt
GIN bound: using gt_tags; touched=2
100
402

# ANY sums its terms' rows.
query ITTII nosort
EXPLAIN SELECT id FROM gt WHERE tags && '{3,4}'::i32[]
