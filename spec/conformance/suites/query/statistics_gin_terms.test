# --- a complete list proves absence only while fresh -----------------------------------------

statement ok
CREATE TABLE gs (id i32 PRIMARY KEY, tags i32[])

statement ok
INSERT INTO gs SELECT g::i32, ARRAY[(g % 3)::i32] FROM generate_series(1, 20) AS g

statement ok
CREATE INDEX gs_tags ON gs USING gin (tags)

statement ok
ANALYZE gs

query ITTII nosort
EXPLAIN SELECT id FROM gs WHERE 9 = ANY(tags)
----
0
Filter
conjuncts=1
0
0
1
Scan gs
GIN bound: using gs_tags; touched=2
0
0

statement ok
INSERT INTO gs VALUES (21, '{9}')

query TB nosort
SELECT column_name, is_stale FROM jed_statistics WHERE table_name = 'gs' ORDER BY column_name
----
id
true
tags
true

# Stale: an unlisted term gets one row.
query ITTII nosort
EXPLAIN SELECT id FROM gs WHERE 9 = ANY(tags)
----
0
Filter
conjuncts=1
1
6
1
Scan gs
GIN bound: using gs_tags; touched=2
1
4

# --- lossy counting prunes: 30,000 term occurrences, every term but 0 seen once -------------

statement ok
CREATE TABLE gp (id i32 PRIMARY KEY, tags i32[])

statement ok
INSERT INTO gp SELECT g::i32, ARRAY[0::i32, g::i32, (g + 20000)::i32] FROM generate_series(1, 10000) AS g

statement ok
CREATE INDEX gp_tags ON gp USING gin (tags)

# Each bucket of 10,000 occurrences ends by dropping every term seen once, so only 0 survives
# and the untracked bound is ceil(30000 / 10000) = 3.
# cost: 400100
statement ok
ANALYZE gp

query TI nosort
SELECT column_name, term_count FROM jed_statistics WHERE table_name = 'gp' ORDER BY column_name
----
id
NULL
tags
1

# An unlisted term gets ceil(3 / 2) = 2 rows.
query ITTII nosort
EXPLAIN SELECT id FROM gp WHERE 5 = ANY(tags)
----
0
Filter
conjuncts=1
2
14
1
Scan gp
GIN bound: using gp_tags; touched=2
2
10

query ITTII nosort
EXPLAIN SELECT id FROM gp WHERE 0 = ANY(tags)
----
0
Filter
conjuncts=1
10000
30050
1
Scan gp
Full scan; touched=2
10000
10050
