# Partial indexes on the remaining ordered-index access paths (spec/design/indexes.md §9.3): the
# OR / IN interval set and the exact-order index walk when the WHERE implies the predicate, and the
# index-nested-loop inner when the join's ON implies it (or the ON with the WHERE implies a
# NULL-rejecting predicate). Rows never change; the `# cost:` lines pin the narrower paths, and the
# LEFT JOIN cases pin that a predicate the WHERE alone implies — which a NULL-extended row can
# satisfy — does not let the index drop inner rows. Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.secondary_index, ddl.index_partial, dml.insert, dml.insert_multi_row, dml.insert_select, query.select, query.where_eq, query.comparison_order, query.logical_connectives, expr.in_list, query.order_by, query.limit, query.set_returning, query.join_inner, query.join_left, query.or_in_point_lookup, query.index_nested_loop, query.order_by_index_scan, query.index_partial, query.index_partial_implication, query.index_partial_access_paths, types.i32, types.text, null.three_valued, resource.cost_metering

statement ok
CREATE TABLE pa (id i32 PRIMARY KEY, status text, amt i32, tag i32)

statement ok
INSERT INTO pa SELECT g, CASE WHEN g % 10 = 0 THEN 'active' ELSE 'old' END, g % 37, CASE WHEN g % 3 = 0 THEN NULL ELSE g % 5 END FROM generate_series(1, 400) AS g

statement ok
CREATE INDEX pa_amt_active ON pa (amt) WHERE status = 'active'

# --- OR / IN interval set over a partial index -----------------------------------------------------

# cost: 43
query II rowsort
SELECT id, amt FROM pa WHERE status = 'active' AND amt IN (3, 20)
----
20
20
390
20
40
3

# cost: 522
query II rowsort
SELECT id, amt FROM pa WHERE status = 'active' AND (amt < 2 OR amt > 35)
----
110
36
260
1
370
0

# --- the exact-order walk with a bound on the same partial index -----------------------------------

# cost: 37
query II nosort
SELECT amt, id FROM pa WHERE status = 'active' AND amt > 30 ORDER BY amt LIMIT 3
----
31
290
32
180
33
70

# --- index-nested-loop over a partial inner --------------------------------------------------------

statement ok
CREATE TABLE po (k i32 PRIMARY KEY, want i32)

statement ok
INSERT INTO po VALUES (1, 3), (2, 20), (3, 36), (4, 99)

# the ON implies the predicate
# cost: 53
query II rowsort
SELECT po.k, pa.id FROM po JOIN pa ON pa.amt = po.want AND pa.status = 'active'
----
1
40
2
20
2
390
3
110

# the WHERE implies `status = 'active'`, which is NULL-rejecting, so an inner join may probe the
# partial index per outer row
# cost: 53
query II rowsort
SELECT po.k, pa.id FROM po JOIN pa ON pa.amt = po.want WHERE pa.status = 'active'
----
1
40
2
20
2
390
3
110

# a LEFT JOIN whose ON implies the predicate: unmatched outer rows are NULL-extended as usual
# cost: 54
query II rowsort
SELECT po.k, pa.id FROM po LEFT JOIN pa ON pa.amt = po.want AND pa.status = 'active'
----
1
40
2
20
2
390
3
110
4
NULL

# --- a predicate a NULL-extended row satisfies ----------------------------------------------------

statement ok
INSERT INTO pa VALUES (401, 'old', 500, 1), (402, 'old', 500, 2)

statement ok
INSERT INTO po VALUES (5, 500)

statement ok
CREATE INDEX pa_amt_untagged ON pa (amt) WHERE tag IS NULL

# Only the WHERE implies `tag IS NULL`, which a NULL-extended row also satisfies: probing the
# partial index would miss the tagged matches and NULL-extend outer rows that do have matches. The
# answer keeps only outer rows with no match at all (k = 4) plus genuinely untagged matches; k = 5
# has only tagged matches, so it must not appear.
query II rowsort
SELECT po.k, pa.id FROM po LEFT JOIN pa ON pa.amt = po.want WHERE pa.tag IS NULL
----
1
114
1
225
1
3
1
336
2
168
2
279
2
390
2
57
3
