# A leading text range union steps over its own slot the same way.
# cost: 6849
query TII rowsort
SELECT region, day, seq FROM ev WHERE (region < 'f' OR region > 'v') AND day = 3 AND seq = 4
----
east
3
4
west
3
4

# --- the probe cap ---------------------------------------------------------------------------------

# Three 40-element sets give 40 × 40 × 40 = 64,000 probes, within MAX_KEY_SET_PROBES (65,536), so all
# three columns are consumed; under each `(a, b)` prefix the consecutive `c` points 101..139 merge,
# leaving 3,200 ranges. With 41 elements, 41 × 41 × 41 = 68,921 is over the cap, so `c` is not
# consumed (its array stays residual) and the 1,681 `(a, b)` prefixes are scanned instead, merging
# into 82 ranges. The rows are the same.
statement ok
CREATE TABLE wide (id i64 PRIMARY KEY, a i32, b i32, c i32)

statement ok
INSERT INTO wide SELECT (x - 1) * 100 + (y - 1) * 10 + z, x, y, z FROM generate_series(1, 10) AS x, generate_series(1, 10) AS y, generate_series(1, 10) AS z

statement ok
CREATE INDEX wide_abc ON wide (a, b, c)

# cost: 6412
query I nosort
SELECT id FROM wide WHERE a = ANY('{1,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139}'::i32[]) AND b = ANY('{1,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139}'::i32[]) AND c = ANY('{1,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139}'::i32[])
----
1

# cost: 635
query I nosort
SELECT id FROM wide WHERE a = ANY('{1,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140}'::i32[]) AND b = ANY('{1,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140}'::i32[]) AND c = ANY('{1,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140}'::i32[])
----
1
