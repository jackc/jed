# Multi-column GIN scans (spec/design/gin.md §4.4/§6). Every entry of a multi-column GIN index is
# column_tag ‖ term ‖ storage key, so a query on ANY key column gathers through the index: the bound
# takes the first key column, in key order, with an accelerable conjunct (then the first with an
# accelerable OR, §6.3) and prefixes its query terms with that column's tag. The same term in two
# columns never mixes (a jsonb key "1" and an array element 1 differ anyway; a repeated column's two
# tags hold the same terms). The whole WHERE stays the residual filter, so the rows are the full
# scan's, across INSERT/UPDATE/DELETE maintenance — the oracle agrees. The `# cost:` assertions pin
# that the bound is taken, cross-core identical; query/gin_multi_column_explain.test pins the plans.
# Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.gin_index, ddl.gin_multi_column, query.gin_scan, query.gin_any_eq, query.gin_mutation, query.gin_jsonb_ops, query.gin_disjunction, query.logical_connectives, dml.insert, dml.insert_multi_row, dml.update, dml.delete, query.select, query.order_by, types.i32, types.text, types.array, types.jsonb, func.array_containment, func.array_quantified, func.jsonb_contains, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, tags i32[], doc jsonb, words text[])

statement ok
CREATE INDEX t_multi ON t USING gin (tags, doc, words)

statement ok
INSERT INTO t VALUES
  (1, ARRAY[1,2], '{"a": 1, "k": "x"}', ARRAY['red']),
  (2, ARRAY[2,3], '{"a": 2}', ARRAY['red', 'blue']),
  (3, NULL, '["a", "k"]', ARRAY['green']),
  (4, '{}', NULL, NULL),
  (5, ARRAY[3], '{"k": "y"}', '{}'),
  (6, ARRAY[1,3], '{}', ARRAY['blue'])

# ---- the first key column ---------------------------------------------------------------------

# cost: 19
query I nosort
SELECT id FROM t WHERE tags @> ARRAY[3] ORDER BY id
----
2
5
6

# cost: 13
query I nosort
SELECT id FROM t WHERE 1 = ANY(tags) ORDER BY id
----
1
6

# ---- a later key column -----------------------------------------------------------------------

# cost: 16
query I nosort
SELECT id FROM t WHERE doc ? 'k' ORDER BY id
----
1
3
5

# cost: 13
query I nosort
SELECT id FROM t WHERE doc @> '{"a": 1}' ORDER BY id
----
1

# cost: 20
query I nosort
SELECT id FROM t WHERE words && ARRAY['blue', 'green'] ORDER BY id
----
2
3
6

# ---- conjuncts on two columns: the first key column's bound, the other conjunct filters --------

# cost: 17
query I nosort
SELECT id FROM t WHERE doc ? 'a' AND tags @> ARRAY[2] ORDER BY id
----
1
2

# ---- an OR on one column ---------------------------------------------------------------------

# cost: 34
query I nosort
SELECT id FROM t WHERE doc ? 'k' OR doc @> '{"a": 2}' ORDER BY id
----
1
2
3
5

# an OR across two columns of the index is not one GIN bound: a full scan
# cost: 33
query I nosort
SELECT id FROM t WHERE tags @> ARRAY[1] OR doc ? 'k' ORDER BY id
----
1
3
5
6

# ---- maintenance --------------------------------------------------------------------------------

# cost: 7
statement ok
UPDATE t SET doc = '{"k": "z"}', tags = ARRAY[9] WHERE words @> ARRAY['green']

query I nosort
SELECT id FROM t WHERE doc ? 'k' ORDER BY id
----
1
3
5

query I nosort
SELECT id FROM t WHERE 9 = ANY(tags) ORDER BY id
----
3

query I nosort
SELECT id FROM t WHERE words @> ARRAY['green'] ORDER BY id
----
3

# cost: 10
statement ok
DELETE FROM t WHERE doc @> '{"a": 2}'

query I nosort
SELECT id FROM t WHERE words @> ARRAY['red'] ORDER BY id
----
1

query I nosort
SELECT id FROM t WHERE tags && ARRAY[2,3] ORDER BY id
----
1
5
6

# ---- a repeated column ------------------------------------------------------------------------

statement ok
CREATE TABLE r (id i32 PRIMARY KEY, a i32[])

statement ok
CREATE INDEX r_twice ON r USING gin (a, a)

statement ok
INSERT INTO r VALUES (1, ARRAY[1,2]), (2, ARRAY[2]), (3, NULL)

# cost: 13
query I nosort
SELECT id FROM r WHERE a @> ARRAY[2] ORDER BY id
----
1
2

statement ok
DELETE FROM r WHERE id = 1

query I nosort
SELECT id FROM r WHERE a @> ARRAY[2] ORDER BY id
----
2
