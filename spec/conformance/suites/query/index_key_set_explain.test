# A unique index whose every column is a point: the estimate is the smaller of the members' AND and
# the probe count.
statement ok
CREATE TABLE uq (id i64 PRIMARY KEY, a i32, b i32, v i32)

statement ok
INSERT INTO uq SELECT g, (g - 1) / 400 + 1, (g - 1) % 400 + 1, g FROM generate_series(1, 1200) AS g

statement ok
CREATE UNIQUE INDEX uq_ab ON uq (a, b)

query ITTII nosort
EXPLAIN SELECT v FROM uq WHERE a IN (1, 3) AND b IN (10, 20)
----
0
Filter
conjuncts=2
2
24
1
Scan uq
Index interval set: using uq_ab (a, b); intervals=4; touched=3
2
8

# A text point column before the first later set.
statement ok
CREATE TABLE tm (id i64 PRIMARY KEY, a i32, s text, c i32)

statement ok
INSERT INTO tm SELECT row_number() OVER (ORDER BY a, s, c), a, s, c FROM generate_series(1, 3) AS a, (VALUES ('x'), ('y'), ('z')) AS t(s), generate_series(1, 100) AS c

statement ok
CREATE INDEX tm_asc ON tm (a, s, c)

statement ok
ANALYZE tm

query ITTII nosort
EXPLAIN SELECT a, c, id FROM tm WHERE a = 2 AND s = 'y' AND c IN (7, 70)
----
0
Filter
conjuncts=3
2
24
1
Scan tm
Index interval set: using tm_asc (a, s, c); intervals=2; touched=4
2
8

# A set on the text column leaves the index no tuple set, and its plain `a = 2` bound would fetch a
# third of the table: a full scan is cheaper.
query ITTII nosort
EXPLAIN SELECT a, c, id FROM tm WHERE a = 2 AND s IN ('x', 'y') AND c = 7
----
0
