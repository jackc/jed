# EXPLAIN of multi-column secondary-index tuple interval sets (spec/design/cost.md §3 "Multi-column
# secondary indexes", explain.md §5): a set that consumes more than the index's leading column names
# the consumed key columns in key order after the index, `intervals=` sums every member's set
# disjuncts, and `arrays=` counts the `= ANY` arrays among them. Rows and costs are pinned in
# index_key_set.test. The plans are jed-owned, so this file is cross-core checked, not oracle-checked.
# Format + `requires`: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.secondary_index, ddl.unique, dml.insert, dml.insert_select, dml.update, dml.delete, query.select, query.where_eq, query.point_lookup, query.index_range, query.index_mutation, query.or_in_point_lookup, query.interval_set, query.any_array_point_lookup, query.composite_key_set, query.logical_connectives, query.order_by, query.limit, query.explain, query.set_returning, maintenance.analyze, func.array_quantified, types.array, cast.array, types.i32, types.i64, types.text

statement ok
CREATE TABLE ix (id i64 PRIMARY KEY, a i32, b i64, v i64)

statement ok
INSERT INTO ix SELECT (t - 1) * 400 + i, t, i, t * 1000 + i FROM generate_series(1, 3) AS t, generate_series(1, 400) AS i

statement ok
CREATE INDEX ix_ab ON ix (a, b)

# An equality column then an array column: both consumed, one array.
query ITTII nosort
EXPLAIN SELECT v FROM ix WHERE a = 1 AND b = ANY(ARRAY[2, 4, 900])
----
0
Filter
conjuncts=2
3
26
1
Scan ix
Index interval set: using ix_ab (a, b); intervals=1; arrays=1; touched=3
3
11

# The IN spelling counts its disjuncts.
query ITTII nosort
EXPLAIN SELECT v FROM ix WHERE a = 1 AND b IN (2, 4, 900)
----
0
Filter
conjuncts=2
3
35
1
Scan ix
Index interval set: using ix_ab (a, b); intervals=3; touched=3
3
11

# Sets on both columns.
query ITTII nosort
EXPLAIN SELECT v FROM ix WHERE a = ANY(ARRAY[1, 2]) AND b IN (2, 9)
----
