# EXPLAIN of `key = ANY(array)` point sets (spec/design/cost.md §3 "OR / IN-list", explain.md §5): the
# array is one disjunct of the PK / index interval set, counted among its `intervals=` and named by
# `arrays=`, since its point count is known only at execution. The estimator reads a readable array as
# the IN-list of its elements (estimator.md §7); a bound array is read in its custom plan (§6.1).
# Rows and costs are pinned in any_array_point_lookup.test. The plans are jed-owned, so this file is
# cross-core checked, not oracle-checked.
# Format + `requires`: ../../../design/conformance.md.
# requires: harness.params, ddl.create_table, ddl.primary_key, ddl.secondary_index, dml.insert, dml.insert_multi_row, query.select, query.where_eq, query.point_lookup, query.or_in_point_lookup, query.interval_set, query.any_array_point_lookup, query.logical_connectives, query.explain, func.array_quantified, types.array, cast.array, types.i32, types.i64, types.decimal, types.f64, types.f32, maintenance.analyze, dml.insert_select, query.set_returning, expr.case, cast.explicit

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a i32)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30), (4, 40), (5, 50), (6, 60)

# An array disjunct is counted among the set's intervals and named by `arrays=`; its point count is
# known only at execution.
query ITTII nosort
EXPLAIN SELECT a FROM t WHERE id = ANY(ARRAY[1, 3, 5])
----
0
Filter
conjuncts=1
3
22
1
Scan t
PK interval set: id; intervals=1; arrays=1; touched=2
3
4

# params: ARRAY[1, 6]
query ITTII nosort
EXPLAIN SELECT a FROM t WHERE id = ANY($1)
----
0
Filter
conjuncts=1
2
11
1
Scan t
PK interval set: id; intervals=1; arrays=1; touched=2
2
3

# The ANY may be one disjunct of a same-key OR.
query ITTII nosort
EXPLAIN SELECT a FROM t WHERE id = ANY(ARRAY[1, 2]) OR id = 6
----
0
Filter
conjuncts=1
3
25
1
Scan t
PK interval set: id; intervals=2; arrays=1; touched=2
3
4

# ALL does not lower. `<> ALL` estimates as the complement of `= ANY` over the same elements: each of
# the four equalities is one of six rows (rounded up), leaving two. The Filter's cost counts one
# operator_eval per element the residual compares.
query ITTII nosort
EXPLAIN SELECT id FROM t WHERE id <> ALL(ARRAY[1, 2, 3, 4])
----
0
Filter
conjuncts=1
2
45
1
Scan t
Full scan; touched=1
6
7

statement ok
CREATE TABLE big (id i64 PRIMARY KEY, a i32)

statement ok
INSERT INTO big VALUES (1, 10), (2, 20), (3, 30)

# An i32[] against an i64 key is promoted, but each element converts exactly to the key's type, so
# it bounds the key; the estimator reads the converted elements.
query ITTII nosort
EXPLAIN SELECT a FROM big WHERE id = ANY('{1,3}'::i32[])
----
0
Filter
conjuncts=1
2
11
1
Scan big
PK interval set: id; intervals=1; arrays=1; touched=2
2
3

# An element no key can equal estimates zero rows: 2.5 is not an integer.
query ITTII nosort
EXPLAIN SELECT a FROM big WHERE id = ANY('{2.5}'::decimal[])
----
0
Filter
conjuncts=1
0
0
1
Scan big
PK interval set: id; intervals=1; arrays=1; touched=2
0
0

# A promoted ARRAY[...] is not readable as a value, so it does not bound.
query ITTII nosort
EXPLAIN SELECT a FROM big WHERE id = ANY(ARRAY[1::i32, 3::i32])
----
0
Filter
conjuncts=1
1
23
1
Scan big
Full scan; touched=2
3
4

statement ok
CREATE TABLE fl (id f64 PRIMARY KEY, a i32)

statement ok
INSERT INTO fl VALUES (1, 10), (2, 20)

# Floats are not among the promoted element types: an f32[] against an f64 key does not bound.
query ITTII nosort
EXPLAIN SELECT a FROM fl WHERE id = ANY('{1}'::f32[])
----
0
Filter
conjuncts=1
1
8
1
Scan fl
Full scan; touched=2
2
3

# An ARRAY[...] of literals adapts to the key's type, so it does bound.
query ITTII nosort
EXPLAIN SELECT a FROM big WHERE id = ANY(ARRAY[1, 3])
----
0
Filter
conjuncts=1
2
13
1
Scan big
PK interval set: id; intervals=1; arrays=1; touched=2
2
3

statement ok
CREATE TABLE s (id i32 PRIMARY KEY, x i32)

statement ok
INSERT INTO s VALUES (1, 10), (2, 20), (3, 30), (4, 40), (5, 10)

statement ok
CREATE INDEX sx ON s (x)

# A secondary index's leading column takes the same set.
query ITTII nosort
EXPLAIN SELECT id FROM s WHERE x = ANY(ARRAY[30, 10])
----
0
Filter
conjuncts=1
2
15
1
Scan s
Index interval set: using sx; intervals=1; arrays=1; touched=2
2
5

# --- statistics read the converted elements -----------------------------------------------------------

# cat is 1 for nine rows in ten (a most-common value) and unique otherwise.
statement ok
CREATE TABLE items (id i32 PRIMARY KEY, cat i32)

statement ok
INSERT INTO items SELECT CAST(g AS i32), CAST(CASE WHEN g % 10 = 0 THEN g ELSE 1 END AS i32) FROM generate_series(1, 1000) AS g

statement ok
CREATE INDEX items_cat ON items (cat)

statement ok
ANALYZE items

# A decimal element converts to the i32 value 1, the most-common value: the full scan stays cheaper.
query ITTII nosort
EXPLAIN SELECT id FROM items WHERE cat = ANY('{1.0}'::decimal[])
----
0
Filter
conjuncts=1
900
3903
1
Scan items
Full scan; touched=2
1000
1003

# 70.0 is the rare value 70 and 1.5 equals no i32, so the elements estimate one row: the index wins.
query ITTII nosort
EXPLAIN SELECT id FROM items WHERE cat = ANY('{70.0,1.5}'::decimal[])
----
0
Filter
conjuncts=1
1
9
1
Scan items
Index interval set: using items_cat; intervals=1; arrays=1; touched=2
1
5

# --- `<> ALL` (NOT IN) complements ---------------------------------------------------------------

# Statistics count the rows each element matches: `cat <> ALL('{1}')` keeps the hundred rows that are
# not the most-common value.
query ITTII nosort
EXPLAIN SELECT id FROM items WHERE cat <> ALL('{1}'::i32[])
----
0
Filter
conjuncts=1
100
3103
1
Scan items
Full scan; touched=2
1000
1003

# A NULL element proves no row true: `x <> ALL` is never TRUE once an element is NULL.
query ITTII nosort
EXPLAIN SELECT id FROM items WHERE cat <> ALL(ARRAY[70, NULL])
----
0
Filter
conjuncts=1
0
5003
1
Scan items
Full scan; touched=2
1000
1003

# A NULL array proves no row true; an empty array keeps every row.
query ITTII nosort
EXPLAIN SELECT id FROM t WHERE id <> ALL(NULL::i32[])
----
0
Filter
conjuncts=1
0
13
1
Scan t
Full scan; touched=1
6
7

query ITTII nosort
EXPLAIN SELECT id FROM t WHERE id <> ALL('{}'::i32[])
----
0
Filter
conjuncts=1
6
19
1
Scan t
Full scan; touched=1
6
7

# Without statistics the complement uses the structural equality fraction per element.
query ITTII nosort
EXPLAIN SELECT a FROM big WHERE a <> ALL(ARRAY[10, 20])
----
0
Filter
conjuncts=1
1
17
1
Scan big
Full scan; touched=1
3
4
