n74
75
n75

# cost: 24
query IT rowsort
SELECT id, name FROM k WHERE name = ANY (ARRAY['n5', 'n50', 'n9', NULL])
----
5
n5
50
n50
9
n9

# cost: 16
query IT nosort
SELECT id, name FROM k ORDER BY name DESC NULLS LAST LIMIT 5
----
90
n90
9
n9
89
n89
87
n87
86
n86

# --- a partial DESC index -------------------------------------------------------------------------

# the WHERE implies the predicate: the full partial walk serves ORDER BY score DESC; 39, 39, 38, 38
# are the top four (no tie crosses the LIMIT)
# cost: 17
query II rowsort
SELECT id, score FROM k WHERE score > 10 ORDER BY score DESC LIMIT 4
----
38
38
39
39
78
38
79
39

# a range inside the partial index's predicate
# cost: 31
query II rowsort
SELECT id, score FROM k WHERE score > 25 AND score < 29
----
26
26
27
27
66
26
67
27
68
28

# an index-bounded UPDATE through the partial DESC index (moves 31 -> 32 and 32 -> 33)
# cost: 25
statement ok
UPDATE k SET score = score + 1 WHERE score > 30 AND score < 33

# cost: 37
query II rowsort
SELECT id, score FROM k WHERE score >= 31 AND score <= 33
----
31
32
32
33
33
33
71
32
72
33
73
33

# an index-bounded DELETE through the DESC text element
# cost: 11
statement ok
DELETE FROM k WHERE g = 1 AND name > 'n8' AND name < 'n85'

# --- REINDEX rebuilds the ordered indexes with their options --------------------------------------

statement ok
REINDEX INDEX k_name

statement ok
REINDEX TABLE k

