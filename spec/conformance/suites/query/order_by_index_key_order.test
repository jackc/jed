# Planning over ordered index keys (spec/design/indexes.md §11, cost.md §3 "ORDER BY satisfied by
# secondary-index order", encoding.md §2.16). A DESC / NULLS FIRST key stores its entries in the
# declared order, so:
#   - an ORDER BY whose every key matches the index element's direction AND effective NULL placement
#     (ASC -> NULLS LAST, DESC -> NULLS FIRST unless written) is served by the FORWARD index walk,
#     with the LIMIT early-out; ties are broken by the PK suffix, exactly as the eager stable sort.
#     A mismatched NULL placement or direction keeps the blocking sort (a backward walk of an ASC
#     index for a DESC order stays a follow-on: it would break ties PK-descending);
#   - equality prefixes, trailing ranges (endpoints swapped under DESC, NULL slot excluded), key-set
#     probes (IN / = ANY, emitted in physical order), UPDATE / DELETE targets, and index-nested-loop
#     seeks all bound an ordered index exactly as an ASC one.
# Rows agree with the PostgreSQL oracle; the plans (EXPLAIN) and costs are jed-owned and cross-core
# checked.
# requires: ddl.index_key_order, ddl.create_table, ddl.primary_key, ddl.secondary_index, dml.insert, dml.insert_select, dml.update, dml.delete, query.select, query.where_eq, query.comparison_order, query.logical_connectives, query.point_lookup, query.index_range, query.index_prefix, query.index_mutation, query.or_in_point_lookup, query.interval_set, query.any_array_point_lookup, query.composite_key_set, query.order_by, query.order_by_keys, query.order_by_index_scan, query.bounded_limit_streaming, query.order_by_topk, query.limit, query.offset, query.join_inner, query.index_nested_loop, query.explain, query.set_returning, query.is_null, expr.between, expr.in_list, func.array_quantified, types.array, types.i32, types.text, resource.cost_metering

statement ok
CREATE TABLE o (id i32 PRIMARY KEY, a i32, b i32, pad text)

# 600 rows: a in 0..49 (NULL every 97th row), b in 0..12 (NULL every 31st row).
statement ok
INSERT INTO o SELECT i, CASE WHEN i % 97 = 0 THEN NULL ELSE i % 50 END, CASE WHEN i % 31 = 0 THEN NULL ELSE i % 13 END, 'p' FROM generate_series(1, 600) AS i

statement ok
CREATE INDEX o_a_desc ON o (a DESC)

statement ok
CREATE INDEX o_ab ON o (a NULLS FIRST, b DESC)

# --- ORDER BY served by the forward walk of a matching ordered index -----------------------------

# DESC defaults to NULLS FIRST: the index's first entries are the NULL a's (ids 97, 194, ... in PK
# order), then a = 49 ascending by id.
# cost: 33
query II nosort
SELECT id, a FROM o ORDER BY a DESC LIMIT 8
----
97
NULL
194
NULL
291
NULL
388
NULL
485
NULL
582
NULL
49
49
99
49

# OFFSET composes with the walk.
# cost: 31
query II nosort
SELECT id, a FROM o ORDER BY a DESC LIMIT 3 OFFSET 6
----
49
49
99
49
149
49

# A mismatched NULL placement is a different order: the blocking top-k sort serves it (made total by
# the id key, since a top-k sort's ties are not the oracle's).
# cost: 607
query II nosort
SELECT id, a FROM o ORDER BY a DESC NULLS LAST, id LIMIT 3
----
49
49
99
49
149
49

# Two ordered keys: a ASC NULLS FIRST, b DESC (NULLS FIRST by default) — the o_ab walk.
# cost: 39
query III nosort
SELECT id, a, b FROM o ORDER BY a NULLS FIRST, b DESC LIMIT 9
----
194
NULL
12
388
NULL
11
582
NULL
10
97
NULL
6
291
NULL
5
485
NULL
4
350
0
12
50
0
11
400
0
10

# --- access bounds over a DESC column -------------------------------------------------------------

# Equality on the DESC column seeks one prefix.
# cost: 61
query I rowsort
SELECT id FROM o WHERE a = 7
----
107
157
207
257
307
357
407
457
507
557
57
7

