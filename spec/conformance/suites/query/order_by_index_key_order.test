# Equality prefix then a range on the DESC second key (o_ab: a NULLS FIRST, b DESC): the NULL b's
# sort first in the b slot and are excluded.
# cost: 23
query II rowsort
SELECT id, b FROM o WHERE a = 7 AND b > 8
----
207
12
257
10
557
11

# The bound composes with the walk of the same index: a = 7 ORDER BY a NULLS FIRST, b DESC.
# cost: 53
query II nosort
SELECT id, b FROM o WHERE a = 7 ORDER BY a NULLS FIRST, b DESC LIMIT 4
----
207
12
557
11
257
10
307
8

# A NULL-equality is never true: provably empty, nothing read.
# cost: 0
query I rowsort
SELECT id FROM o WHERE a = NULL
----

# --- key-set probes over a DESC column ------------------------------------------------------------

# cost: 181
query I rowsort
SELECT id FROM o WHERE a IN (3, 47) AND id < 200
----
103
147
153
197
3
47
53

# A set on the leading column, then an equality on the DESC b.
# cost: 14
query III rowsort
SELECT id, a, b FROM o WHERE a = ANY(ARRAY[7, 9]) AND b = 9
----
9
9
9

# The probes come out in physical (DESC) order, so a set over a DESC index still streams its ORDER BY
# (k is unique, so the order is total).
statement ok
CREATE TABLE w (id i32 PRIMARY KEY, k i32)

statement ok
INSERT INTO w SELECT i, (i * 37) % 1000 FROM generate_series(1, 400) AS i

statement ok
CREATE INDEX w_k ON w (k DESC)

# cost: 43
query II nosort
SELECT id, k FROM w WHERE k IN (37, 74, 999, 111, 500) ORDER BY k DESC LIMIT 10
----
27
999
3
111
2
74
1
37

# --- UPDATE / DELETE targets through a DESC bound -------------------------------------------------

statement ok
UPDATE o SET pad = 'q' WHERE a >= 49

query I nosort
SELECT count(*) FROM o WHERE pad = 'q'
----
12

statement ok
DELETE FROM o WHERE a = 0 AND b > 10

query I nosort
SELECT count(*) FROM o
----
598

# --- index-nested-loop seek into a DESC index -----------------------------------------------------

statement ok
