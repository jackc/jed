# EXPLAIN of membership-subquery point sets (spec/design/cost.md §3 "OR / IN-list", explain.md §5):
# an uncorrelated `key IN (SELECT …)` / `key = ANY(SELECT …)` is one disjunct of the key's interval
# set, counted among its `arrays=` since its values are known only after the fold; the estimator reads
# default_array_elements values of unknown value (estimator.md §7). Rows and costs are pinned in
# subquery_point_set.test. The plans are jed-owned, so this file is cross-core checked, not
# oracle-checked.
# Format + `requires`: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.composite_primary_key, ddl.secondary_index, dml.insert, dml.insert_multi_row, dml.insert_select, dml.delete, query.select, query.where_eq, query.point_lookup, query.or_in_point_lookup, query.interval_set, query.any_array_point_lookup, query.composite_key_set, query.subquery_in, query.subquery_quantified, query.subquery_correlated, query.explain, query.set_returning, func.array_quantified, types.i32, types.i64, types.decimal

statement ok
CREATE TABLE big (id i64 PRIMARY KEY, v i64)

statement ok
INSERT INTO big SELECT g, g * 10 FROM generate_series(1, 2000) AS g

statement ok
CREATE TABLE pick (k i64, ki i32, kd decimal)

statement ok
INSERT INTO pick VALUES (7, 7, 7.0), (1500, 1500, 1500.5), (42, 42, 42), (NULL, NULL, NULL), (7, 7, 7)

