# GIN jsonb_ops jsonpath strategies — the selected plan (jed-only: EXPLAIN is jed's own rendering,
# never oracle-imported). Pins that `doc @? path` and `doc @@ path` take the GIN bound when the path
# yields a term tree (spec/design/gin.md §2.2), including a disjunction of jsonpath arms (§6.3) and a
# mutation's target scan; that a path with
# nothing extractable still takes the bound, whose gather falls back to the full scan at execution;
# that the jsonpath functions are never a bound; and the term-tree estimates after ANALYZE.
# The rows are oracle-checked in query/gin_jsonb_jsonpath.test. Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.gin_index, query.gin_scan, query.gin_mutation, query.gin_jsonb_ops, query.gin_jsonb_jsonpath, query.gin_disjunction, query.logical_connectives, query.explain, dml.explain, dml.insert, dml.insert_select, dml.update, dml.delete, query.select, query.set_returning, types.i32, types.text, types.jsonb, types.jsonpath, expr.jsonpath_filter, expr.jsonpath_match, func.json_builders, cast.operator, expr.arithmetic, expr.text_concat, maintenance.analyze, maintenance.analyze_gin_terms

statement ok
CREATE TABLE d (id i32 PRIMARY KEY, doc jsonb)

statement ok
CREATE INDEX d_doc_gin ON d USING gin (doc)

statement ok
INSERT INTO d SELECT g::i32, jsonb_build_object('k', g % 9, 's', 'v' || (g % 4), 'g' || (g % 5), true) FROM generate_series(1, 200) AS g

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc @@ '$.k == 3'
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc @? '$ ? (@.s == "v1" && @.k == 2)'
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

# nothing extractable: still the bound, which falls back to the full scan at execution
query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc @? '$.k'
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE doc @@ '$.k == 3' OR doc @? '$ ? (@.s == "v2")'
----
0
Filter
conjuncts=1
1
Scan d
GIN bound: using d_doc_gin; touched=2

# the jsonpath functions are not bounds
query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM d WHERE jsonb_path_exists(doc, '$ ? (@.k == 3)')
----
0
Filter
conjuncts=1
1
Scan d
Full scan; touched=2

