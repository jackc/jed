# names: flag, missing, message
# types: boolean, i32, text
query BIT nosort
SELECT true AS flag, CAST(NULL AS i32) AS missing, 'it''s text' AS message
----
true
NULL
it's text

query BBBBBB nosort
SELECT true AND NULL, false AND NULL, true OR NULL, false OR NULL, NOT NULL, NOT false
----
NULL
false
true
NULL
NULL
true

# cost: 3
query BB nosort
SELECT false AND (1 / 0 = 0), true OR (1 / 0 = 0)
----
false
true

query BBBBBB nosort
SELECT 1 = 1, 1 <> 2, 1 != 1, 1 < 2, 2 >= 2, 2 <= 1
----
true
true
false
true
true
false

query BBBB nosort
SELECT NULL = 1, NULL IS NULL, NULL IS NOT NULL, 1 IS NOT NULL
----
NULL
true
false
true

query BBBB nosort
SELECT NULL IS DISTINCT FROM NULL, NULL IS DISTINCT FROM 1, 1 IS NOT DISTINCT FROM 1, 1 IS NOT DISTINCT FROM NULL
----
false
true
true
false

# cost: 0
query I nosort
SELECT 1 WHERE false
----

# cost: 0
query I nosort
SELECT 1 WHERE NULL
----

# cost: 2
query I nosort
SELECT 1 WHERE 1 = 1
----
1

# cost: 0
query I nosort
SELECT 1 / 0 LIMIT 0
----

# cost: 0
query I nosort
SELECT 1 / 0 OFFSET 1
----

# cost: 1
query I nosort
SELECT 9 LIMIT 1 OFFSET 0
----
9

# WHERE is evaluated before OFFSET skips the virtual row.
# cost: 1
query I nosort
SELECT 1 WHERE 2 = 2 OFFSET 1
----

# A literal FALSE conjunct lets the planner prove the relation empty.
# cost: 0
query I nosort
SELECT 1 WHERE false AND (1 / 0 = 0)
----

# NULL as a top-level filter conjunct also proves no row can survive.
# cost: 0
query I nosort
SELECT 1 WHERE NULL AND (1 / 0 = 0)
----

# Runtime NULL still short-circuits a filter's AND, without a literal rewrite.
# cost: 2
query I nosort
SELECT 1 WHERE CAST(NULL AS boolean) AND (1 / 0 = 0)
----

# UTF-8 order differs from UTF-16 ordinal order across this boundary.
query BB nosort
SELECT '😀' > '', 'é' <> 'é'
----
true
true

# cost: 4
query B nosort
SELECT 'abc' = 'abd'
----
false

query BBBB nosort
SELECT 'off'::boolean, 'tr'::boolean, CAST(0 AS boolean), CAST(3 AS boolean)
----
false
true
false
true

# types: i32, text
query IT nosort
SELECT CAST(true AS i32), CAST(-12 AS text)
----
1
-12

