# Scalar-only foundation slice, shared by every core. It isolates existing SQL
# behavior without requiring table storage or aggregates. The C# experiment uses
# this complete file as an initial slice; it does not claim every capability below.
# requires: query.select, query.select_no_from, query.column_alias, query.where_eq, query.limit, query.offset, query.logical_connectives, expr.arithmetic, expr.comparison_value, expr.parens, expr.precedence, cast.explicit, types.i16, types.i32, types.i64, types.boolean, types.text, null.three_valued, resource.cost_metering, error.overflow_trap, error.division_by_zero

# names: ?column?, answer
# types: i64, i64
# cost: 2
query II nosort
SELECT 1, 6 * 7 AS answer
----
1
42

# cost: 3
query II nosort
SELECT 6 + 4 * 2, -7
----
14
-7

query III nosort
SELECT (6 + 4) * 2, -7 / 3, -7 % 3
----
20
-2
-1

# types: i16, i32, i64
query III nosort
SELECT CAST(32767 AS i16), CAST(2147483647 AS i32), 9223372036854775807
----
32767
2147483647
9223372036854775807

# types: i16, i32, i64
query III nosort
SELECT CAST(-32768 AS i16), CAST(-2147483648 AS i32), -9223372036854775808
----
-32768
-2147483648
-9223372036854775808

# types: i16, i32, i64
query III nosort
SELECT CAST(1 AS i16) + 2, CAST(1 AS i16) + CAST(2 AS i32), CAST(1 AS i32) + CAST(2 AS i64)
----
3
3
3

