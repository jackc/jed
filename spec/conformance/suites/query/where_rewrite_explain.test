# A trapping conjunct is never pushed: `100 / b.w` stays residual and only meets joined rows, so the
# unmatched b row with w = 0 is never divided. (PostgreSQL evaluates restriction clauses at the base
# scan and raises 22012 here; jed moves only non-trapping conjuncts, so it never introduces an error.)
query ITTII nosort
EXPLAIN SELECT a.id, b.id FROM a JOIN b ON a.k = b.k WHERE 100 / b.w > 0 ORDER BY a.id, b.id
