# EXPLAIN of the planner's stage-2 WHERE rewrites (spec/design/planner.md §3; explain.md §5). A
# pushed filter runs inside its relation's scan, so it renders on that Scan (`filter:conjuncts=N`,
# VERBOSE `filter=<expr>`) and its work is part of the Scan's estimate and actual cost; the Filter
# node carries only the post-join residual and disappears when nothing is left. A contradiction keeps
# the plan shape, appends `; contradiction` to the Filter detail, and estimates and charges every
# relation subtree at zero. This rendering is jed-specific and not oracle-imported.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.where_eq, query.comparison_order, query.logical_connectives, query.order_by, query.order_by_keys, query.qualified_column, query.join_inner, query.join_left, query.cross_join, query.join_pushdown, query.hash_join, query.index_nested_loop, query.where_pushdown, query.where_contradiction, query.aggregates, query.select_no_from, query.is_null, query.explain, query.explain_analyze, maintenance.analyze, expr.arithmetic, null.three_valued, types.i32, resource.cost_metering

statement ok
CREATE TABLE a (id i32 PRIMARY KEY, k i32, v i32)

statement ok
CREATE TABLE b (id i32 PRIMARY KEY, k i32, w i32)

statement ok
INSERT INTO a VALUES (1, 1, 10), (2, 2, 20), (3, 3, NULL), (4, 9, 40)

statement ok
INSERT INTO b VALUES (11, 1, 5), (12, 2, NULL), (13, 2, 7), (14, 7, 0), (15, 8, 1)

# One pushed conjunct per side; the cross-relation conjunct is the residual Filter.
query ITTII nosort
EXPLAIN SELECT a.id, b.id FROM a JOIN b ON a.k = b.k WHERE a.v >= 20 AND b.w IS NOT NULL AND a.v > b.w ORDER BY a.id, b.id
----
0
Sort
keys=2
1
30
1
Filter
conjuncts=1
1
29
2
Nested Loop
inner; on:conjuncts=1
1
28
3
Scan a
Full scan; touched=3; filter:conjuncts=1
2
9
3
Scan b
Full scan; touched=3; filter:conjuncts=1
4
11

# VERBOSE spells each pushed filter in global column slots, left-deep in source order.
query ITTII nosort
EXPLAIN (VERBOSE) SELECT a.id, b.id FROM a JOIN b ON a.k = b.k WHERE a.v >= 20 AND b.w > 0 AND a.v < 50 AND a.v > b.w ORDER BY a.id, b.id
----
0
