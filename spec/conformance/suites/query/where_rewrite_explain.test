Nested Loop
inner; on=(#1 = #4)
1
30
3
Scan a
Full scan; touched=3; filter=((#2 >= 20) and (#2 < 50))
1
17
3
Scan b
Full scan; touched=3; filter=(#5 > 0)
2
11

# Nothing remains after the product, so there is no Filter node. The PK bound and the pushed recheck
# of the same conjunct coexist on a's Scan.
query ITTII nosort
EXPLAIN SELECT a.id, b.id FROM a CROSS JOIN b WHERE a.id <= 2 AND b.w > 4 ORDER BY a.id, b.id
