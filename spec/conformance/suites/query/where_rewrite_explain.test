# --- statistics-aware residual estimates ---------------------------------------------------
# After ANALYZE, a residual that references one relation (`a.v + 0 > 15` is arithmetic, so it is
# not pushed) still estimates with that relation's column statistics, beside a pushed conjunct and
# a cross-relation residual conjunct.
statement ok
ANALYZE a

statement ok
ANALYZE b

query ITTII nosort
EXPLAIN (VERBOSE) SELECT a.id, b.id FROM a JOIN b ON a.k = b.k WHERE b.w IS NOT NULL AND a.v + 0 > 15 AND a.v + 0 < 35 AND a.id <> b.id ORDER BY a.id, b.id
