# EXPLAIN of pushdown into grouped derived bodies and set-operation arms (spec/design/planner.md §3.2;
# explain.md §5). A conjunct moved into a grouped body is that body's WHERE, rendered below its
# Aggregate (or as its access bound); a conjunct moved into a set operation appears once in every
# SELECT of the tree, each in its own slots. A conjunct that cannot move stays in the outer Filter.
# This rendering is jed-specific and not oracle-imported.
# requires: ddl.create_table, ddl.primary_key, ddl.composite_primary_key, dml.insert, dml.insert_multi_row, query.select, query.column_alias, query.where_eq, query.comparison_order, query.logical_connectives, query.qualified_column, query.join_inner, query.aggregates, query.group_by, query.grouping_sets, query.having, query.union, query.intersect, query.derived_table, query.point_lookup, query.composite_pk_pushdown, query.join_pushdown, query.index_nested_loop, query.where_pushdown, query.derived_pushdown, query.is_null, query.explain, null.three_valued, types.i32, types.i64, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, k i32, v i32)

statement ok
CREATE TABLE u (id i32 PRIMARY KEY, w i32)

statement ok
CREATE TABLE g (a i32, b i32, c i32, PRIMARY KEY (a, b))

statement ok
CREATE TABLE n (id i64 PRIMARY KEY)

statement ok
