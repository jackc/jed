# In a join, a set-operation body takes the conjunct into its arms rather than filtering its rows.
query ITTII nosort
EXPLAIN SELECT s.id, u.w FROM (SELECT id FROM t UNION ALL SELECT id FROM u) s JOIN u ON s.id = u.id WHERE s.id >= 2
