# A conjunct over a grouping column moves below the Aggregate and bounds g's primary-key prefix.
query ITTII nosort
EXPLAIN SELECT d.a, d.s FROM (SELECT a, sum(c) AS s FROM g GROUP BY a) d WHERE d.a = 2
----
0
Subquery d
-
1
6
1
Aggregate
groups=1 aggs=1
1
5
2
Filter
conjuncts=1
1
3
3
Scan g
PK bound: a = 2; touched=2
1
2

# VERBOSE: the moved grouping-column conjunct is the body's WHERE (in body slots) under the
# Aggregate, which keeps its HAVING; the aggregate-output conjunct stays in the outer Filter.
query ITTII nosort
EXPLAIN (VERBOSE) SELECT d.k, d.s FROM (SELECT k, sum(v) AS s FROM t GROUP BY k HAVING sum(v) > 150) d WHERE d.k >= 2 AND d.s < 300
