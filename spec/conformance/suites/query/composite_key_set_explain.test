# A promoted i32[] does not bound `id`: the plain prefix bound remains.
query ITTII nosort
EXPLAIN SELECT v FROM cp WHERE tenant = 1 AND id = ANY(ARRAY[2, 4]::i32[])
----
0
Filter
conjuncts=2
2
40
1
Scan cp
PK bound: tenant = 1; touched=3
6
8

# The tuple points come out in key order, so the sort is elided and LIMIT streams.
query ITTII nosort
EXPLAIN SELECT tenant, id FROM cp WHERE tenant IN (1, 2, 3) AND id = ANY(ARRAY[3, 1]) ORDER BY tenant, id LIMIT 2
----
0
Limit
limit=2
2
26
1
Filter
conjuncts=2
2
24
2
Scan cp
PK interval set: tenant, id; intervals=4; arrays=1; touched=2; ordered: pk ordered
2
4

# Descending key order reads the points backward.
query ITTII nosort
EXPLAIN SELECT tenant, id FROM cp WHERE tenant IN (1, 2) AND id IN (1, 2) ORDER BY tenant DESC, id DESC
----
0
Filter
conjuncts=2
2
20
1
Scan cp
PK interval set: tenant, id; intervals=4; touched=2; ordered: pk ordered (reverse)
2
4

