# EXPLAIN of composite-PK tuple interval sets (spec/design/cost.md §3 "Composite primary keys",
# explain.md §5): the scan names the consumed key members in key order, `intervals=` sums every
# member's set disjuncts, and `arrays=` counts the `= ANY` arrays among them. Rows and costs are
# pinned in composite_key_set.test. The plans are jed-owned, so this file is cross-core checked, not
# oracle-checked.
# Format + `requires`: ../../../design/conformance.md.
# requires: harness.params, ddl.create_table, ddl.primary_key, ddl.composite_primary_key, dml.insert, dml.insert_select, dml.update, query.select, query.where_eq, query.point_lookup, query.composite_pk_pushdown, query.or_in_point_lookup, query.interval_set, query.any_array_point_lookup, query.composite_key_set, query.logical_connectives, query.order_by, query.limit, query.explain, query.set_returning, func.array_quantified, types.array, cast.array, types.i32, types.i64

statement ok
CREATE TABLE cp (tenant i32, id i64, v i64, PRIMARY KEY (tenant, id))

statement ok
INSERT INTO cp SELECT t, i, t * 1000 + i FROM generate_series(1, 3) AS t, generate_series(1, 400) AS i

# An equality member then an array member: both consumed, one array.
query ITTII nosort
EXPLAIN SELECT v FROM cp WHERE tenant = 1 AND id = ANY(ARRAY[2, 4, 900])
----
0
Filter
conjuncts=2
3
29
1
Scan cp
PK interval set: tenant, id; intervals=1; arrays=1; touched=3
3
5

# A bound array is read in its custom plan.
# params: 2, ARRAY[1, 3]
query ITTII nosort
EXPLAIN SELECT v FROM cp WHERE tenant = $1 AND id = ANY($2)
----
0
Filter
conjuncts=2
2
16
1
Scan cp
PK interval set: tenant, id; intervals=1; arrays=1; touched=3
2
4

# The IN spelling counts its disjuncts.
query ITTII nosort
EXPLAIN SELECT v FROM cp WHERE tenant = 1 AND id IN (2, 4, 900)
----
0
Filter
conjuncts=2
3
29
1
Scan cp
PK interval set: tenant, id; intervals=3; touched=3
3
5

# A leading-member set and a trailing equality: every member is consumed.
query ITTII nosort
EXPLAIN SELECT v FROM cp WHERE tenant IN (1, 3) AND id = 7
----
0
Filter
conjuncts=2
1
9
1
Scan cp
PK interval set: tenant, id; intervals=2; touched=3
1
3

# Sets on both members sum their disjuncts.
query ITTII nosort
EXPLAIN SELECT v FROM cp WHERE tenant = ANY(ARRAY[1, 2]) AND id IN (2, 3)
----
0
Filter
conjuncts=2
2
22
1
Scan cp
PK interval set: tenant, id; intervals=3; arrays=1; touched=3
2
4

# A leading set alone consumes only the leading member.
query ITTII nosort
EXPLAIN SELECT v FROM cp WHERE tenant IN (1, 3)
----
0
Filter
conjuncts=1
12
62
