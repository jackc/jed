Scan lists
Full scan; touched=2
4
5
1
Scan orders
Index-nested-loop PK interval set: id; intervals=1; arrays=1; touched=2; filter:conjuncts=1
8
44

# A LEFT JOIN keeps the outer rows with no match.
query ITTII nosort
EXPLAIN SELECT l.k, o.v FROM lists l LEFT JOIN orders o ON o.id = ANY(l.ids)
