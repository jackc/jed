# --- tuple-set members from a sibling --------------------------------------------------------------

statement ok
CREATE TABLE tenants (tenant i64 PRIMARY KEY, name i64)

statement ok
INSERT INTO tenants VALUES (2, 20), (3, 30)

statement ok
CREATE TABLE tp (tenant i64, id i64, w i64, PRIMARY KEY (tenant, id))

statement ok
INSERT INTO tp SELECT t, i, t * 10000 + i FROM generate_series(1, 4) AS t, generate_series(1, 2000) AS i

# The sibling tenant is each probe's leading point, then the IN list's points.
query ITTII nosort
EXPLAIN SELECT t.name, tp.w FROM tenants t JOIN tp ON tp.tenant = t.tenant AND tp.id IN (1, 5, 1999)
----
0
Nested Loop
inner; on:conjuncts=1
6
55
1
Scan tenants
Full scan; touched=2
2
3
1
Scan tp
Index-nested-loop PK interval set: tenant, id; intervals=3; touched=3; filter:conjuncts=1
6
40

# A final range member under the sibling point.
query ITTII nosort
EXPLAIN SELECT t.name, tp.w FROM tenants t JOIN tp ON tp.tenant = t.tenant AND tp.id > 1997
----
0
Nested Loop
inner; on:conjuncts=1
