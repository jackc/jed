# EXPLAIN of index-nested-loop interval and tuple sets (spec/design/cost.md §3 "JOIN", explain.md §5):
# an inner relation's PK or index set with a sibling source renders as an `Index-nested-loop` interval
# set on the inner Scan. Rows and costs are pinned in inl_key_set.test. The plans are jed-owned, so
# this file is cross-core checked, not oracle-checked.
# Format + `requires`: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.composite_primary_key, ddl.secondary_index, dml.insert, dml.insert_multi_row, dml.insert_select, query.select, query.where_eq, query.point_lookup, query.or_in_point_lookup, query.interval_set, query.any_array_point_lookup, query.composite_key_set, query.join_inner, query.join_left, query.index_nested_loop, query.logical_connectives, query.explain, query.set_returning, func.array_quantified, types.array, cast.array, types.i32, types.i64

statement ok
CREATE TABLE orders (id i64 PRIMARY KEY, v i64)

statement ok
INSERT INTO orders SELECT g, g * 10 FROM generate_series(1, 2000) AS g

statement ok
CREATE TABLE lists (k i64 PRIMARY KEY, ids i64[], ids32 i32[])

statement ok
INSERT INTO lists VALUES (1, '{5,1999,5,4000}', '{5,1999}'), (2, '{17,NULL}', '{17,NULL}'), (3, NULL, NULL), (4, '{}', '{}')

# --- an inner PK set per outer row ----------------------------------------------------------------

# Each outer row's array is a set of PK points: a duplicate, an absent key, a NULL element, a NULL
# array, and an empty array contribute nothing.
query ITTII nosort
EXPLAIN SELECT l.k, o.v FROM lists l JOIN orders o ON o.id = ANY(l.ids)
----
0
Nested Loop
inner; on:conjuncts=1
40
157
1
Scan lists
Full scan; touched=2
4
5
1
Scan orders
Index-nested-loop PK interval set: id; intervals=1; arrays=1; touched=2
40
72

# A promoted i32[] converts each element to the i64 key.
query ITTII nosort
EXPLAIN SELECT l.k, o.v FROM lists l JOIN orders o ON o.id = ANY(l.ids32)
----
0
Nested Loop
inner; on:conjuncts=1
40
157
1
Scan lists
Full scan; touched=2
4
5
1
Scan orders
Index-nested-loop PK interval set: id; intervals=1; arrays=1; touched=2
40
72

# A same-key range clips each outer row's points.
query ITTII nosort
EXPLAIN SELECT l.k, o.v FROM lists l JOIN orders o ON o.id = ANY(l.ids) AND o.id < 100
----
0
Nested Loop
inner; on:conjuncts=1
8
65
