# EXPLAIN of pushdown below a window and into inlined CTE bodies (spec/design/planner.md §3.2/§3.4;
# explain.md §5). A conjunct moved below a window is the body's WHERE, rendered below its Window node
# (or as its access bound). A CTE inlined at its reference renders its body under that reference's
# `CTE Scan` node — like a `Subquery` — and its definition under the WITH node carries no body; a
# materialized CTE (MATERIALIZED, or referenced twice) keeps its body under the WITH node. This
# rendering is jed-specific and not oracle-imported.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_star, query.column_alias, query.where_eq, query.comparison_order, query.logical_connectives, query.qualified_column, query.join_inner, query.derived_table, query.cte, query.window, query.window_ranking, query.point_lookup, query.join_pushdown, query.hash_join, query.where_pushdown, query.derived_pushdown, query.explain, query.explain_analyze, null.three_valued, types.i32, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, k i32, v i32)

statement ok
CREATE TABLE u (id i32 PRIMARY KEY, w i32)

statement ok
INSERT INTO t VALUES (1, 1, 10), (2, 2, 20), (3, 3, 30), (4, 1, 40), (5, 2, NULL), (6, 3, 60), (7, 1, 70), (8, 2, 80)

statement ok
INSERT INTO u VALUES (1, 10), (2, NULL), (3, 30)

# A partition-key conjunct renders as the body's Filter, below the Window.
query ITTII nosort
EXPLAIN SELECT d.id, d.rn FROM (SELECT id, k, row_number() OVER (PARTITION BY k ORDER BY id) AS rn FROM t) d WHERE d.k = 2
