# LEFT: the NULL-extended side's conjunct bounds b's primary key and is rechecked there; the hash
# join's residual ON is its key equality.
query ITTII nosort
EXPLAIN (VERBOSE) SELECT a.id, b.id FROM a LEFT JOIN b ON a.k = b.k AND b.id = 13
