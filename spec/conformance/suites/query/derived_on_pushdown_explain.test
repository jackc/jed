# EXPLAIN ANALYZE attributes a scan-pushed filter's work to the Subquery node and a moved conjunct's
# work to the body.
query ITTIII nosort
EXPLAIN ANALYZE SELECT d.id, b.id FROM (SELECT id, k, v + 0 AS v0 FROM a) d JOIN b ON d.k = b.k WHERE d.id >= 2 AND d.v0 > 5
