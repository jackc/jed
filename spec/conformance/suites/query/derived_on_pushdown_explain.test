# A set-returning function renders its scan-pushed filter on the SRF node.
query ITTII nosort
EXPLAIN (VERBOSE) SELECT g.g, b.id FROM generate_series(1, 5) AS g JOIN b ON g.g = b.k WHERE g.g > 1
