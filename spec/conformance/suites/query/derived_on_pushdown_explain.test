# EXPLAIN of pushdown into derived bodies, onto computed relations, and from ON clauses
# (spec/design/planner.md §3.2/§3.3; explain.md §5). A conjunct moved into a derived body appears in
# the body's own plan (its Filter, or its Scan when the body pushes it again, or as the body's access
# bound). A scan-pushed filter renders on its relation's node — `Subquery`, `CTE Scan`, `SRF`, and
# `Catalog Scan` as well as `Scan` — as `filter:conjuncts=N` (VERBOSE `filter=<expr>`). A join renders
# only its residual ON and drops the `on` part when none remains. This rendering is jed-specific and
# not oracle-imported.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_star, query.where_eq, query.comparison_order, query.logical_connectives, query.order_by, query.order_by_keys, query.qualified_column, query.join_inner, query.join_left, query.cross_join, query.join_pushdown, query.hash_join, query.index_nested_loop, query.where_pushdown, query.derived_pushdown, query.on_pushdown, query.derived_table, query.cte, query.set_returning, query.is_null, query.explain, query.explain_analyze, introspect.tables, introspect.columns, expr.arithmetic, null.three_valued, types.i32, resource.cost_metering

statement ok
CREATE TABLE a (id i32 PRIMARY KEY, k i32, v i32)

statement ok
CREATE TABLE b (id i32 PRIMARY KEY, k i32, w i32)

statement ok
INSERT INTO a VALUES (1, 1, 10), (2, 2, 20), (3, 3, NULL), (4, 9, 40)

statement ok
INSERT INTO b VALUES (11, 1, 5), (12, 2, NULL), (13, 2, 7), (14, 7, 0), (15, 8, 1)

# The moved conjunct is the body's WHERE and bounds its primary key; the outer SELECT has no Filter.
query ITTII nosort
EXPLAIN SELECT * FROM (SELECT id, v FROM a) d WHERE d.id = 2
----
0
Subquery d
-
1
5
1
Filter
conjuncts=1
1
4
2
Scan a
PK bound: id = 2; touched=2
1
2

# VERBOSE: the body's own WHERE comes first, the moved conjunct (in body slots) after it. The
# non-bare `vv` conjunct is scan-pushed onto the Subquery node, in the outer SELECT's slots.
query ITTII nosort
EXPLAIN (VERBOSE) SELECT d.id, b.id FROM (SELECT id, k, v * 2 AS vv FROM a WHERE v > 5) d JOIN b ON d.k = b.k WHERE d.id < 4 AND d.vv > 30
----
0
Hash Join
inner; keys=1; on=(#1 = #4); output=[#0, #3]
1
52
1
Subquery d
filter=(#2 > 30)
1
12
2
Filter
filter=((#2 > 5) and (#0 < 4)); output=[#0, #1, (#2 * 2)]
1
11
3
Scan a
PK bound: id < 4; touched=3
2
3
1
Scan b
Full scan; touched=2
5
6

