# ON pushdown: each side's single-relation conjunct renders on its Scan; the join keeps the residual.
query ITTII nosort
EXPLAIN SELECT a.id, b.id FROM a JOIN b ON a.k = b.k AND a.v >= 20 AND b.w IS NOT NULL
----
0
Nested Loop
inner; on:conjuncts=1
