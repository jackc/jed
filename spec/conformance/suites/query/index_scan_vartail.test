# --- bytea tail column -----------------------------------------------------------------------------

statement ok
CREATE TABLE vb (id i32 PRIMARY KEY, a i32, b bytea)

statement ok
INSERT INTO vb SELECT g, g % 3, decode(lpad(to_hex(g * 37 % 256), 2, '0') || '00' || lpad(to_hex(g), 2, '0'), 'hex') FROM generate_series(1, 30) AS g

statement ok
INSERT INTO vb VALUES (31, 1, NULL), (32, 1, '\x'), (33, 1, '\x0000')

statement ok
CREATE INDEX vb_ab ON vb (a, b)

# cost: 53
query IT rowsort
SELECT id, b FROM vb WHERE a = 1
