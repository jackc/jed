# --- interval tail column --------------------------------------------------------------------------

statement ok
CREATE TABLE vi (id i32 PRIMARY KEY, a i32, b interval)

statement ok
INSERT INTO vi SELECT g, g % 3, g * interval '7 hours' FROM generate_series(1, 30) AS g

statement ok
INSERT INTO vi VALUES (31, 1, NULL), (32, 1, '1 mon'), (33, 1, '-30 days')

statement ok
CREATE INDEX vi_ab ON vi (a, b)

# cost: 43
query IT rowsort
SELECT id, b FROM vi WHERE a = 1 AND b >= '3 days'
----
13
91:00:00
16
112:00:00
19
133:00:00
22
154:00:00
25
175:00:00
28
196:00:00
32
1 mon

# --- a variable-width element in the middle, fixed-width element after it --------------------------

statement ok
CREATE TABLE vm (id i32 PRIMARY KEY, a i32, b text, c i32)

statement ok
INSERT INTO vm SELECT g, g % 2, 'k' || (g % 5), g FROM generate_series(1, 40) AS g

statement ok
CREATE INDEX vm_abc ON vm (a, b, c)

# cost: 29
query I rowsort
SELECT id FROM vm WHERE a = 0 AND b = 'k2'
----
12
2
22
32

# cost: 57
query I rowsort
SELECT id FROM vm WHERE a = 0 AND b > 'k2'
----
14
18
24
28
34
38
4
8

# writes keep the index entries current (the bound reads only through the index)
statement ok
UPDATE vm SET b = 'k9' WHERE id = 2

statement ok
DELETE FROM vm WHERE id = 4

# cost: 57
query I rowsort
SELECT id FROM vm WHERE a = 0 AND b > 'k2'
----
14
18
2
24
28
34
38
8

# a LIMIT streams the bound in index order
# cost: 52
query IT nosort
SELECT id, b FROM vm WHERE a = 1 AND b >= 'k3' ORDER BY id LIMIT 3
----
3
k3
9
k4
13
k3
