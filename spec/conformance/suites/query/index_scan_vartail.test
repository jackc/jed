# Multi-column secondary index with a VARIABLE-WIDTH range / trailing key column
# (spec/design/indexes.md §5.1, encoding.md §2.4/§2.5/§2.6/§2.10).
#
# The index-bounded scan walks each admitted index entry and skips the key components after the
# equality prefix to recover the row's storage key. Every scalar key encoding is self-delimiting —
# a fixed width, or its own terminator (text/bytea `00 01` with `00 FF` escaping an embedded NUL,
# decimal's class byte + exponent + pair bytes + terminator, interval's 16-byte span) — so a
# variable-width element may be the RANGE element or a TRAILING element of the bound. The rows are
# identical with or without the bound; engagement is pinned the cost way (a full scan of each table
# costs strictly more) plus EXPLAIN. NULL tail slots (the one-byte 0x01 tag), an embedded NUL, and
# negative / zero decimals exercise each skip rule. This is the cross-core contract
# (Rust == Go == TS). Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.secondary_index, dml.insert, dml.insert_multi_row, dml.insert_select, dml.update, dml.delete, query.select, query.where_eq, query.comparison_order, query.order_by, query.limit, query.set_returning, query.index_range, query.index_variable_width_tail, types.i32, types.text, types.decimal, types.bytea, types.interval, null.three_valued, resource.cost_metering

# --- text tail column ------------------------------------------------------------------------------

statement ok
CREATE TABLE vt (id i32 PRIMARY KEY, a i32, b text)

statement ok
INSERT INTO vt SELECT g, g % 4, 'v' || (g * 7 % 13) FROM generate_series(1, 40) AS g

statement ok
INSERT INTO vt VALUES (41, 1, NULL), (42, 1, 'v')

statement ok
CREATE INDEX vt_ab ON vt (a, b)

# equality on the leading column: the trailing text slot is skipped by its terminator.
# cost: 49
query IT rowsort
SELECT id, b FROM vt WHERE a = 1
----
1
v7
13
v0
17
v2
21
v4
25
v6
29
v8
33
v10
37
v12
41
NULL
42
v
5
v9
9
v11

# a RANGE on the text element after the equality prefix
# cost: 31
query IT rowsort
SELECT id, b FROM vt WHERE a = 1 AND b >= 'v4' AND b < 'v8'
----
1
v7
21
v4
25
v6

# a bare range on a leading text column of a single-column index
statement ok
CREATE INDEX vt_b ON vt (b)

# cost: 16
query I rowsort
SELECT id FROM vt WHERE b > 'v8'
----
18
31
5

# --- decimal tail column ---------------------------------------------------------------------------

statement ok
CREATE TABLE vd (id i32 PRIMARY KEY, a i32, b decimal)

statement ok
INSERT INTO vd SELECT g, g % 3, (g - 20) * 1.25 FROM generate_series(1, 36) AS g

statement ok
INSERT INTO vd VALUES (37, 1, NULL), (38, 1, 0), (39, 1, -0.001), (40, 1, 123456789.000000001)

statement ok
CREATE INDEX vd_ab ON vd (a, b)

