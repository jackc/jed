# GIN over decimal[] and bytea[] — the selected plan (jed-only: EXPLAIN is jed's own rendering, never
# oracle-imported). Pins that a decimal- or bytea-element GIN index bounds `@>`, `&&`, `= ANY`, array
# `=`, and a mutation's target-row scan, and that an integer against `decimal[]` or a decimal
# against an integer array still uses the index (spec/design/gin.md §2/§3/§4.3/§6). The rows
# themselves are oracle-checked in query/gin_decimal_elements.test and query/gin_bytea_elements.test.
# Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.gin_index, query.gin_decimal_elements, query.gin_bytea_elements, query.gin_scan, query.gin_any_eq, query.gin_array_eq, query.gin_mutation, query.explain, dml.insert, dml.insert_multi_row, dml.delete, query.select, func.array_containment, func.array_quantified, cast.operator, types.decimal, types.bytea, types.i32, types.array

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, d decimal[], b bytea[], a i32[])

statement ok
CREATE INDEX t_d_gin ON t USING gin (d)

statement ok
CREATE INDEX t_b_gin ON t USING gin (b)

statement ok
CREATE INDEX t_a_gin ON t USING gin (a)

statement ok
INSERT INTO t VALUES
  (1, '{1.5,2}', ARRAY['\x61'::bytea], '{2}'),
  (2, '{1.50}', ARRAY['\x6162'::bytea], '{3}'),
  (3, '{0}', ARRAY['\x00'::bytea], '{}'),
  (4, '{}', '{}', NULL),
  (5, NULL, NULL, '{5}')

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM t WHERE d @> '{1.500}'::decimal[]
----
0
Filter
conjuncts=1
1
Scan t
GIN bound: using t_d_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM t WHERE 2 = ANY(d)
----
0
Filter
conjuncts=1
1
Scan t
GIN bound: using t_d_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM t WHERE d = '{0.00}'::decimal[]
----
0
Filter
conjuncts=1
1
Scan t
GIN bound: using t_d_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM t WHERE 2.0 = ANY(a)
----
0
Filter
conjuncts=1
1
Scan t
GIN bound: using t_a_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM t WHERE b && ARRAY['\x00'::bytea, '\x61'::bytea]
----
0
Filter
conjuncts=1
1
Scan t
GIN bound: using t_b_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) SELECT id FROM t WHERE b = ARRAY['\x6162'::bytea]
----
0
Filter
conjuncts=1
1
Scan t
GIN bound: using t_b_gin; touched=2

query ITT nosort
EXPLAIN (COSTS false) DELETE FROM t WHERE '\x00'::bytea = ANY(b)
----
0
Delete t
-
1
Filter
conjuncts=1
2
Scan t
GIN bound: using t_b_gin; touched=1
