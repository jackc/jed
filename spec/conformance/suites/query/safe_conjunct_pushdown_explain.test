# Arithmetic, a text parse, and abs (whose integer overload overflows) can trap: all stay.
query ITTII nosort
EXPLAIN (VERBOSE) SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE a.k + 0 > 1 AND CAST(a.s AS i32) = 1 AND abs(a.k) > 1
----
0
Filter
filter=((((#2 + 0) > 1) and (cast(#1 as i32) = 1)) and (abs(#2) > 1)); output=[#0, #7]
1
73
1
Nested Loop
inner; on=(#0 = #6)
1
64
2
Scan a
Full scan; touched=3
6
7
2
Scan b
Full scan; touched=2
8
9

# A function over a grouping column moves below a grouped body's Aggregate.
query ITTII nosort
EXPLAIN (VERBOSE) SELECT g.s, g.c FROM (SELECT s, count(*) AS c FROM a GROUP BY s) g WHERE lower(g.s) = 'beta'
----
0
Subquery g
output=[#0, #1]
1
22
