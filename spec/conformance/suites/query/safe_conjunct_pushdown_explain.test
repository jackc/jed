Aggregate
groups=1 aggs=1; output=[#0, #1]
1
21
2
Filter
filter=(lower(#1) = 'beta')
1
19
3
Scan a
Full scan; touched=1
6
7

# A decimal render can separate 1.5 from 1.50, which DISTINCT treats as one row: the conjunct stays
# above the DISTINCT body, ...
query ITTII nosort
EXPLAIN (VERBOSE) SELECT q.d FROM (SELECT DISTINCT d FROM a) q WHERE CAST(q.d AS text) = '1.50'
----
0
Filter
filter=(cast(#0 as text) = '1.50'); output=[#0]
1
26
1
Subquery q
-
6
13
2
Distinct
output=[#3]
6
13
3
Scan a
Full scan; touched=1
6
7

# ... which keeps the first of the equal rows, 1.5, so nothing renders as '1.50'.
query D nosort
SELECT q.d FROM (SELECT DISTINCT d FROM a) q WHERE CAST(q.d AS text) = '1.50'
----

