# `key IN (SELECT …)` / `key = ANY(SELECT …)` → point lookups (spec/design/cost.md §3 "OR / IN-list").
# An uncorrelated membership subquery is folded once before the scan runs, so its value list is a
# constant for the scan: when its single column is of the key's type (or an integer/decimal type
# whose values convert exactly to it) and the key is a single-column PK, a leading B-tree index
# column, or a member of a composite PK or multi-column index, the subquery is one disjunct of the
# key's interval set, a point per value. Its values are known only after the fold, so the plan
# estimates default_array_elements of them (estimator.md §7). NOT IN and a correlated subquery do not
# bound. The whole WHERE stays the residual filter, so the rows are unchanged and only the cost
# drops. Rows verified against the live PostgreSQL 18 oracle; the costs are jed-owned, so the
# `# cost:` lines are the cross-core pin. The plans are pinned in subquery_point_set_explain.test.
# Format + `requires`: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.composite_primary_key, ddl.secondary_index, dml.insert, dml.insert_multi_row, dml.insert_select, dml.delete, dml.update, query.select, query.where_eq, query.point_lookup, query.or_in_point_lookup, query.interval_set, query.any_array_point_lookup, query.composite_key_set, query.subquery_in, query.subquery_quantified, query.subquery_correlated, query.limit, query.order_by, query.logical_connectives, query.set_returning, func.array_quantified, types.i32, types.i64, types.decimal, null.three_valued, resource.cost_metering

statement ok
CREATE TABLE big (id i64 PRIMARY KEY, v i64)

statement ok
INSERT INTO big SELECT g, g * 10 FROM generate_series(1, 2000) AS g

statement ok
CREATE TABLE pick (k i64, ki i32, kd decimal)

statement ok
INSERT INTO pick VALUES (7, 7, 7.0), (1500, 1500, 1500.5), (42, 42, 42), (NULL, NULL, NULL), (7, 7, 7)

# --- the subquery spellings --------------------------------------------------------------------------

# IN (SELECT …) probes each value: 7, 42, 1500 (a duplicate and a NULL contribute nothing new).
# cost: 41
query II rowsort
SELECT id, v FROM big WHERE id IN (SELECT k FROM pick)
----
1500
15000
42
420
7
70

# = ANY (SELECT …) is the same set.
# cost: 32
query II rowsort
SELECT id, v FROM big WHERE id = ANY(SELECT k FROM pick)
----
1500
15000
42
420
7
70

# A promoted i32 column against the i64 key converts each value.
# cost: 41
query II rowsort
SELECT id, v FROM big WHERE id IN (SELECT ki FROM pick)
----
1500
15000
42
420
7
70

# Decimal values against the integer key: 1500.5 equals no key and is dropped.
# cost: 33
query II rowsort
SELECT id, v FROM big WHERE id IN (SELECT kd FROM pick)
----
42
420
7
70

# An empty subquery reads nothing.
# cost: 11
query II rowsort
SELECT id, v FROM big WHERE id IN (SELECT k FROM pick WHERE k > 5000)
----

# The subquery may be one disjunct of a same-key OR, and be clipped by a same-key range.
# cost: 51
query II rowsort
SELECT id, v FROM big WHERE (id IN (SELECT k FROM pick) OR id = 2000) AND id > 10
----
1500
15000
2000
20000
42
420

# A LIMIT stops after the first survivors in key order.
# cost: 31
query II nosort
SELECT id, v FROM big WHERE id IN (SELECT k FROM pick) ORDER BY id LIMIT 2
----
7
70
42
420

# NOT IN does not bound: full scan.
# cost: 14021
query I nosort
SELECT count(*) FROM big WHERE id NOT IN (SELECT k FROM pick WHERE k IS NOT NULL)
----
1997

# A correlated subquery does not bound: its values change per row.
# cost: 36018
query II rowsort
SELECT id, v FROM big WHERE id IN (SELECT k FROM pick WHERE pick.k = big.id AND big.v > 100)
----
1500
15000
42
420

# Inside a derived table body the subquery is evaluated with the body, not folded before its scan
# opens, so the set has no values when the scan reads it and widens to every key: the cost is the
# unbounded scan's, and the rows are unchanged.
# cost: 36014
query I rowsort
SELECT d.v FROM (SELECT v FROM big WHERE id IN (SELECT k FROM pick)) AS d
----
15000
420
70

# --- secondary indexes and tuple members ----------------------------------------------------------

statement ok
CREATE TABLE ix (id i64 PRIMARY KEY, x i64, w i64)

statement ok
INSERT INTO ix SELECT g, g % 500, g FROM generate_series(1, 2000) AS g

statement ok
CREATE INDEX ix_x ON ix (x)

# cost: 97
query I rowsort
SELECT id FROM ix WHERE x IN (SELECT k FROM pick)
----
1007
1042
1507
1542
42
507
542
7

statement ok
CREATE TABLE tp (tenant i64, id i64, w i64, PRIMARY KEY (tenant, id))

statement ok
INSERT INTO tp SELECT t, i, t * 10000 + i FROM generate_series(1, 4) AS t, generate_series(1, 2000) AS i

# A tuple member: tenant 2 and each subquery value.
# cost: 47
query I rowsort
SELECT w FROM tp WHERE tenant = 2 AND id IN (SELECT k FROM pick)
----
20007
20042
21500

# --- mutations ---------------------------------------------------------------------------------------

# cost: 41
statement ok
UPDATE big SET v = -v WHERE id IN (SELECT k FROM pick)

# cost: 25
statement ok
DELETE FROM big WHERE id = ANY(SELECT k FROM pick WHERE k < 100)

query II rowsort
SELECT id, v FROM big WHERE id IN (7, 42, 1500)
----
1500
-15000
