# generate_series(numeric, numeric[, numeric]) — the numeric overload of the FROM-clause series
# (spec/design/functions.md §10). Any decimal argument selects it; integer arguments promote to
# decimal, so the one column is typed decimal. PostgreSQL semantics (oracle-verified, postgres:18):
# the first element is start at its own scale and each later one is the previous plus step, so the
# scale is max(start, step) from the second element on (3, 2.25, 1.50); the series is inclusive of
# stop when it lands on it; any NULL argument → zero rows; start past stop for the step direction →
# zero rows; a zero step → 22023. A float argument is 42883 (no implicit float → numeric).
# Each element charges one generated_row; the bound compare and the step add each charge
# decimal_work × (W − 1) (spec/design/cost.md §3), which is zero for values of at most four
# aligned digits — so a small numeric series costs exactly what the integer series does. The
# EXPLAIN estimates live in query/explain_shapes.test.
# requires: query.select, query.set_returning, query.generate_series_numeric, query.order_by, query.limit, query.aggregates, types.decimal, types.f64, cast.explicit, resource.cost_metering, resource.cost_limit

# --- the TODO's motivating call: an integer start, a numeric stop ----------------------
# 3 generated_row + 3 row_produced; the literal args are leaves.
# names: generate_series
# types: decimal
# cost: 6
query D rowsort
SELECT * FROM generate_series(1, 3.5)
----
1
2
3

# start's scale carries to every element (the step 1 has scale 0).
# cost: 6
query D rowsort
SELECT * FROM generate_series(1.0, 3)
----
1.0
2.0
3.0

# A fractional step: the first element keeps start's scale 0, later ones take step's scale 1.
# cost: 10
query D rowsort
SELECT * FROM generate_series(1, 3, 0.5)
----
1
1.5
2.0
2.5
3.0

# stop is reached exactly (no float drift — the arithmetic is exact).
# cost: 6
query D rowsort
SELECT * FROM generate_series(0.10, 0.3, 0.1)
----
0.10
0.20
0.30

# --- a descending step ---------------------------------------------------------------
# cost: 6
query D rowsort
SELECT * FROM generate_series(3, 1, -0.75)
----
1.50
2.25
3

# The next element would pass stop, so the series ends before it. The cast is one operator_eval.
# cost: 3
query D nosort
SELECT * FROM generate_series(1.00::decimal(5,2), 2, 1.5)
----
1.00

# --- empty series: start past stop for the step direction, or a NULL argument ---------
# cost: 0
query D nosort
SELECT * FROM generate_series(1.5, 1, 1)
----

# cost: 0
query D nosort
SELECT * FROM generate_series(1, 2.5, -1)
----

query D nosort
SELECT * FROM generate_series(1, NULL::decimal)
----

query D nosort
SELECT * FROM generate_series(NULL::decimal, 3)
----

query D nosort
SELECT * FROM generate_series(1, 3, NULL::decimal)
----

# A NULL integer argument still selects the numeric overload when another argument is decimal.
query D nosort
SELECT * FROM generate_series(NULL::i32, 3.5)
----

# --- a zero step is invalid_parameter_value ------------------------------------------
statement error 22023
SELECT * FROM generate_series(1, 3, 0.0)

statement error 22023
SELECT * FROM generate_series(1.5, 3.5, 0)

# --- no implicit float → numeric: a float argument has no overload -------------------
statement error 42883
SELECT * FROM generate_series(1::f64, 3.0)

# --- composes like the integer series: aggregate, alias, ORDER BY + LIMIT -------------
query DI nosort
SELECT sum(g), count(*) FROM generate_series(0.5, 10, 0.5) AS g
----
105.0
20

# names: x
query D nosort
SELECT x FROM generate_series(-1, 1, 0.25) AS g(x) ORDER BY x DESC LIMIT 3
----
1.00
0.75
0.50

# --- values wider than four aligned digits charge decimal_work -----------------------
# Each element's values align to 7 digits (W = 2): 3 generated_row + 3 row_produced + 4 bound
# compares (3 in range, 1 ending the series) + 3 step adds, each decimal_work × 1.
# cost: 13
query D rowsort
SELECT * FROM generate_series(100000.5, 100002.5)
----
100000.5
100001.5
100002.5

# --- the cost ceiling bounds a runaway numeric series (jed-only, like the integer form) -
# max_cost: 100
statement error 54P01
SELECT * FROM generate_series(0, 1000000, 0.5)
