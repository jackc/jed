CREATE TABLE ex (id i32 PRIMARY KEY, k i32, gone i32)

statement ok
INSERT INTO ex SELECT g, g % 50, CASE WHEN g % 20 = 0 THEN NULL ELSE 1 END FROM generate_series(1, 200) AS g

