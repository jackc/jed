# jed_sequences under ALTER TABLE identity management (spec/design/alter.md §2.8): ADD GENERATED
# creates an owned sequence of the column type; SET edits it within that type's bounds; DROP
# IDENTITY removes it. jed-specific, so CROSS-CORE-checked, NOT PostgreSQL-oracle-checked.
# requires: introspect.sequences, ddl.alter_identity, ddl.alter_table, ddl.identity, ddl.create_table, dml.insert, query.select, query.where_eq, query.aggregates, types.i16, types.i64, types.text

statement ok
CREATE TABLE jsi (id i16 NOT NULL)

statement ok
ALTER TABLE jsi ALTER id ADD GENERATED BY DEFAULT AS IDENTITY (START 3)

query TIIIITT nosort
SELECT name, start_value, min_value, max_value, increment_by, owned_by_table, owned_by_column FROM jed_sequences WHERE owned_by_table = 'jsi'
----
jsi_id_seq
3
1
32767
