# DROP VIEW removes its rows
statement ok
DROP VIEW vsummary

query I nosort
SELECT count(*) FROM jed_columns WHERE table_name = 'vsummary'
----
0

# listing a view's columns needs SELECT on jed_columns only — not on the view or what it reads
# default_privileges: NONE
# grant: SELECT ON jed_columns
query TT nosort
SELECT name, type FROM jed_columns WHERE table_name = 'vstack' ORDER BY ordinal
----
ident
i32
following
i64

# the temp domain and an unqualified-to-temp read list no view columns (views live only in main)
query I nosort
SELECT count(*) FROM temp.jed_columns
----
0

# The cost is one generated_row per produced row, views included (the 62 table columns + the 9
# view columns), the aggregate fold over each, and 1 output row. Planning a view body is not metered.
# cost: 143
query I nosort
SELECT count(*) FROM jed_columns
----
71
