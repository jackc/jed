# PG-shorthand aliases render canonically too (int8 → i64, float4 → f32, numeric → decimal)
statement ok
CREATE TABLE aliased (x int8, y float4, z numeric(3,1))

query TT nosort
SELECT name, type FROM jed_columns WHERE table_name = 'aliased' ORDER BY ordinal
----
x
i64
y
f32
z
decimal(3,1)

# --- containers: arrays (typmod applies to the element), ranges, composites ----------------------

statement ok
CREATE TYPE addr AS (street text, zip i32)

# (a typmod on an array's ELEMENT type — varchar(5)[] — is not constructible yet, 0A000; when the
# narrowing lifts, the canonical rendering applies the typmod at the leaf: varchar(5)[].)
statement ok
CREATE TABLE containers (
  a i32[],
  b text[],
  e i32range,
  f i64range,
  g numrange,
  h tsrange,
  i tstzrange,
  j daterange,
  k addr,
  l addr[]
)

query TT nosort
SELECT name, type FROM jed_columns WHERE table_name = 'containers' ORDER BY ordinal
----
a
i32[]
b
text[]
e
i32range
f
i64range
g
numrange
h
tsrange
i
tstzrange
j
daterange
k
addr
l
addr[]

# --- not_null: declared NOT NULL or PRIMARY KEY membership; pk_ordinal is KEY order --------------

# the PK is declared (b, a) — key order differs from declaration order, and pk_ordinal follows the
# KEY: b → 1, a → 2. PK members are not_null without an explicit NOT NULL.
statement ok
CREATE TABLE keyed (a i32, b i64, c text NOT NULL, d text, PRIMARY KEY (b, a))

query TITBI nosort
SELECT name, ordinal, type, not_null, pk_ordinal FROM jed_columns WHERE table_name = 'keyed' ORDER BY ordinal
----
a
1
i32
true
2
b
2
i64
true
1
c
3
text
true
NULL
d
4
text
false
NULL

# a no-PK table: the synthetic rowid is NOT a column — only declared columns appear
statement ok
CREATE TABLE nopk (x i32, y text)

query TBI nosort
SELECT name, not_null, pk_ordinal FROM jed_columns WHERE table_name = 'nopk' ORDER BY ordinal
----
x
false
NULL
y
false
NULL

# --- ordinary composition: joins against jed_tables, aggregation over the catalog ----------------

query TI nosort
SELECT t.name, count(*) FROM jed_tables t JOIN jed_columns c ON c.table_name = t.name GROUP BY t.name ORDER BY t.name
----
aliased
3
containers
10
keyed
4
nopk
2
scalars
18

# --- read-only, like jed_tables -------------------------------------------------------------------

statement error 42809
INSERT INTO jed_columns VALUES ('t', 'c', 1, 'i32', false, NULL)

statement error 42809
DROP TABLE jed_columns

# --- cost: one generated_row per produced row (37 columns across the 5 tables), zero page_read ----

# 37 generated_row + the aggregate fold + 1 output row; the catalog is resident, so no page is read.
# cost: 75
query I nosort
SELECT count(*) FROM jed_columns
----
37

# --- column_default: the DEFAULT as canonical SQL text ---------------------------------------------
# An EXPRESSION default shows its persisted canonical token text (the CHECK form: folded words,
# single-space-joined tokens). A CONSTANT default is stored coerced to the column type and shows as a
# SQL literal of that value: integer / decimal / boolean bare, everything else quoted with ' doubled.
# DEFAULT NULL is NULL, the same as no default (PostgreSQL stores no default for it). The relation is
# zone-free: a timestamptz constant renders in UTC whatever the session time zone. A float constant
# renders quoted by the native shortest formatter (float-render-layout; 1.5 is layout-identical). A
# parenthesized literal is still a constant, so `(2)` shows `2`.
statement ok
CREATE TABLE defaults (
  a i32,
  b i32 DEFAULT 7,
  c i64 DEFAULT -5,
  d decimal(6,2) DEFAULT 1.5,
  e boolean DEFAULT true,
  f text DEFAULT 'it''s',
  g varchar(10) DEFAULT 'x',
  h bytea DEFAULT '\x6869',
  i date DEFAULT '2024-01-02',
  j timestamptz DEFAULT '2024-01-02 03:04:05+02',
  k f64 DEFAULT 1.5,
  l i32 DEFAULT NULL,
  m i32 DEFAULT 1+1,
  n uuid DEFAULT uuidv7(),
  o interval DEFAULT INTERVAL '1 day',
  p text DEFAULT upper('It''s'),
  q i32 DEFAULT (2)
)

# timezone: America/New_York
query TT nosort
SELECT name, column_default FROM jed_columns WHERE table_name = 'defaults' ORDER BY ordinal
----
a
NULL
b
7
c
-5
d
1.50
e
true
f
'it''s'
g
'x'
h
'\x6869'
i
'2024-01-02'
j
'2024-01-02 01:04:05+00'
k
'1.5'
l
NULL
m
1 + 1
n
uuidv7 ( )
o
interval '1 day'
p
upper ( 'It''s' )
q
2

# serial and identity columns show the owned-sequence default they desugar to
statement ok
CREATE TABLE seqd (s serial, g i64 GENERATED ALWAYS AS IDENTITY, b i16 GENERATED BY DEFAULT AS IDENTITY)

query TT nosort
SELECT name, column_default FROM jed_columns WHERE table_name = 'seqd' ORDER BY ordinal
----
s
nextval ( 'seqd_s_seq' )
g
nextval ( 'seqd_g_seq' )
b
nextval ( 'seqd_b_seq' )

# ALTER COLUMN SET / DROP DEFAULT are reflected
statement ok
ALTER TABLE defaults ALTER a SET DEFAULT 42, ALTER b DROP DEFAULT, ALTER e SET DEFAULT NOT false

query TT nosort
SELECT name, column_default FROM jed_columns WHERE table_name = 'defaults' AND name IN ('a', 'b', 'e') ORDER BY ordinal
----
a
42
b
NULL
e
not false
