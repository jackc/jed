# views are not tables: joining jed_tables drops them, joining jed_views keeps only them
query TI nosort
SELECT v.name, count(*) FROM jed_views v JOIN jed_columns c ON c.table_name = v.name GROUP BY v.name ORDER BY v.name
----
vagg
3
vcols
7
vstack
2

# renames are reflected (the view's stored names change; the body still plans to the same types)
statement ok
ALTER VIEW vstack RENAME COLUMN next TO following

statement ok
ALTER VIEW vagg RENAME TO vsummary

query TTT nosort
SELECT table_name, name, type FROM jed_columns WHERE table_name IN ('vstack', 'vagg', 'vsummary') ORDER BY table_name, ordinal
----
