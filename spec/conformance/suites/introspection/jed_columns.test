# --- not_null: declared NOT NULL or PRIMARY KEY membership; pk_ordinal is KEY order --------------

# the PK is declared (b, a) — key order differs from declaration order, and pk_ordinal follows the
# KEY: b → 1, a → 2. PK members are not_null without an explicit NOT NULL.
statement ok
CREATE TABLE keyed (a i32, b i64, c text NOT NULL, d text, PRIMARY KEY (b, a))

query TITBI nosort
SELECT name, ordinal, type, not_null, pk_ordinal FROM jed_columns WHERE table_name = 'keyed' ORDER BY ordinal
----
a
1
i32
true
2
b
2
i64
true
1
c
3
text
true
NULL
d
4
text
false
NULL

# a no-PK table: the synthetic rowid is NOT a column — only declared columns appear
statement ok
CREATE TABLE nopk (x i32, y text)

query TBI nosort
SELECT name, not_null, pk_ordinal FROM jed_columns WHERE table_name = 'nopk' ORDER BY ordinal
----
x
false
NULL
y
false
NULL

# --- ordinary composition: joins against jed_tables, aggregation over the catalog ----------------

query TI nosort
SELECT t.name, count(*) FROM jed_tables t JOIN jed_columns c ON c.table_name = t.name GROUP BY t.name ORDER BY t.name
----
aliased
3
containers
10
keyed
4
nopk
2
scalars
18

# --- read-only, like jed_tables -------------------------------------------------------------------

statement error 42809
INSERT INTO jed_columns VALUES ('t', 'c', 1, 'i32', false, NULL)

statement error 42809
DROP TABLE jed_columns

# --- cost: one generated_row per produced row (37 columns across the 5 tables), zero page_read ----

# 37 generated_row + the aggregate fold + 1 output row; the catalog is resident, so no page is read.
# cost: 75
query I nosort
SELECT count(*) FROM jed_columns
----
37

# --- column_default: the DEFAULT as canonical SQL text ---------------------------------------------
# An EXPRESSION default shows its persisted canonical token text (the CHECK form: folded words,
# single-space-joined tokens). A CONSTANT default is stored coerced to the column type and shows as a
# SQL literal of that value: integer / decimal / boolean bare, everything else quoted with ' doubled.
# DEFAULT NULL is NULL, the same as no default (PostgreSQL stores no default for it). The relation is
# zone-free: a timestamptz constant renders in UTC whatever the session time zone. A float constant
# renders quoted as its PostgreSQL text (float.md §9). A
# parenthesized literal is still a constant, so `(2)` shows `2`.
statement ok
CREATE TABLE defaults (
  a i32,
  b i32 DEFAULT 7,
  c i64 DEFAULT -5,
  d decimal(6,2) DEFAULT 1.5,
  e boolean DEFAULT true,
  f text DEFAULT 'it''s',
  g varchar(10) DEFAULT 'x',
  h bytea DEFAULT '\x6869',
  i date DEFAULT '2024-01-02',
  j timestamptz DEFAULT '2024-01-02 03:04:05+02',
  k f64 DEFAULT 1.5,
  l i32 DEFAULT NULL,
  m i32 DEFAULT 1+1,
  n uuid DEFAULT uuidv7(),
  o interval DEFAULT INTERVAL '1 day',
  p text DEFAULT upper('It''s'),
  q i32 DEFAULT (2)
)

# timezone: America/New_York
query TT nosort
SELECT name, column_default FROM jed_columns WHERE table_name = 'defaults' ORDER BY ordinal
----
a
NULL
b
7
c
-5
d
1.50
e
true
