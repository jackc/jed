false
NULL
NULL
3
total
decimal
false
NULL
NULL
4
doubled
i64
false
NULL
NULL
5
tags
text[]
false
NULL
NULL
6
at
addr
false
NULL
NULL
7
nothing
text
false
NULL
NULL

# a view over a view, and an aggregate body
statement ok
CREATE VIEW vstack AS SELECT ident, doubled + 1 AS next FROM vcols

statement ok
CREATE VIEW vagg AS SELECT count(*) AS n, sum(amount) AS total, max(label) AS top FROM vbase

query TTIT nosort
SELECT table_name, name, ordinal, type FROM jed_columns WHERE table_name IN ('vstack', 'vagg') ORDER BY table_name, ordinal
