# serial and identity columns show the owned-sequence default they desugar to
statement ok
CREATE TABLE seqd (s serial, g i64 GENERATED ALWAYS AS IDENTITY, b i16 GENERATED BY DEFAULT AS IDENTITY)

query TT nosort
SELECT name, column_default FROM jed_columns WHERE table_name = 'seqd' ORDER BY ordinal
----
s
nextval ( 'seqd_s_seq' )
g
nextval ( 'seqd_g_seq' )
b
nextval ( 'seqd_b_seq' )

# identity_generation names an identity column's ALWAYS / BY DEFAULT; NULL otherwise (serial included)
query TT nosort
SELECT name, identity_generation FROM jed_columns WHERE table_name = 'seqd' ORDER BY ordinal
----
s
NULL
g
ALWAYS
b
BY DEFAULT

# ALTER TABLE identity management is reflected (alter.md §2.8)
statement ok
ALTER TABLE seqd ALTER g SET GENERATED BY DEFAULT, ALTER b DROP IDENTITY

query TTT nosort
SELECT name, column_default, identity_generation FROM jed_columns WHERE table_name = 'seqd' ORDER BY ordinal
----
s
nextval ( 'seqd_s_seq' )
NULL
g
nextval ( 'seqd_g_seq' )
BY DEFAULT
b
NULL
NULL

statement ok
ALTER TABLE seqd ALTER b ADD GENERATED ALWAYS AS IDENTITY (SEQUENCE NAME "Seqd B")

query TTT nosort
SELECT name, column_default, identity_generation FROM jed_columns WHERE table_name = 'seqd' AND name = 'b'
----
b
nextval ( '"Seqd B"' )
ALWAYS

# ALTER COLUMN SET / DROP DEFAULT are reflected
statement ok
ALTER TABLE defaults ALTER a SET DEFAULT 42, ALTER b DROP DEFAULT, ALTER e SET DEFAULT NOT false

query TT nosort
SELECT name, column_default FROM jed_columns WHERE table_name = 'defaults' AND name IN ('a', 'b', 'e') ORDER BY ordinal
----
a
42
b
NULL
e
not false

# --- views: one row per output column, after the tables ------------------------------------------
# A view column's `type` is the type its planned body produces: the result-column type, which
# carries no typmod (a varchar(10) column reads as text, decimal(8,2) as decimal), and an untyped
# NULL reads as text. A view column is nullable, keyless, and has no default. Names are the view's
# stored output names, so a column list renames them.
statement ok
CREATE TABLE vbase (id i32 PRIMARY KEY, label varchar(10) NOT NULL DEFAULT 'x', amount decimal(8,2), tags text[], at addr)

statement ok
CREATE VIEW vcols (ident, label, total, doubled, tags, at, nothing) AS SELECT id, label, amount, id::i64 * 2, tags, at, NULL FROM vbase

query ITTBIT nosort
SELECT ordinal, name, type, not_null, pk_ordinal, column_default FROM jed_columns WHERE table_name = 'vcols' ORDER BY ordinal
----
1
ident
i32
false
NULL
NULL
2
label
