# Inlined CTEs in other positions.

statement ok
CREATE TABLE w (id i32 PRIMARY KEY, x i32)

statement ok
CREATE VIEW tv AS SELECT id, k, v FROM t

# A single-reference CTE read by a recursive CTE's anchor is expanded there.
# cost: 41
query II rowsort
WITH RECURSIVE a AS (SELECT id, k FROM t), r AS (SELECT id, k FROM a WHERE a.id < 3 UNION ALL SELECT r.id + 10, r.k FROM r WHERE r.id < 20) SELECT r.id, r.k FROM r
----
