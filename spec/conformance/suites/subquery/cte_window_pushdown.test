# Predicate pushdown below a window function and into inlined CTE bodies (spec/design/planner.md
# §3.2/§3.4). A pushdown-safe conjunct over a derived body with window functions moves into the body
# — below the window — when every column it references is a bare PARTITION BY key of every window
# function in that body: it keeps or drops whole partitions, so each window sees the same partitions.
# A conjunct over any other column, a window without PARTITION BY, or an expression partition key
# keeps it outside. A CTE inlined at its reference — named exactly once by a query part, not
# MATERIALIZED, uncorrelated, non-recursive — is planned at that reference like a derived table, so
# its body takes the same pushdown; a CTE referenced twice (materialized, or NOT MATERIALIZED) or
# marked MATERIALIZED does not. The rows are PostgreSQL's; the `# cost:` pins are jed's cross-core
# contract.
# requires: ddl.create_table, ddl.primary_key, ddl.composite_primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_star, query.column_alias, query.table_alias, query.where_eq, query.comparison_order, query.logical_connectives, query.order_by, query.order_by_keys, query.qualified_column, query.join_inner, query.join_left, query.aggregates, query.group_by, query.having, query.union, query.derived_table, query.subquery_scalar, query.subquery_correlated, query.cte, query.cte_nested, query.cte_recursive, query.cte_data_modifying, dml.with_clause, dml.returning, dml.insert_select, query.subquery_exists, query.subquery_in, query.distinct, query.limit, query.window_frame, ddl.view, query.window, query.window_ranking, query.window_aggregate, query.window_grouped, query.window_expr_keys, query.point_lookup, query.composite_pk_pushdown, query.join_pushdown, query.hash_join, query.index_nested_loop, query.where_pushdown, query.derived_pushdown, query.on_pushdown, query.is_null, expr.arithmetic, null.three_valued, types.i32, types.i64, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, k i32, v i32)

statement ok
CREATE TABLE u (id i32 PRIMARY KEY, w i32)

statement ok
CREATE TABLE g (a i32, b i32, c i32, PRIMARY KEY (a, b))

statement ok
INSERT INTO t VALUES (1, 1, 10), (2, 2, 20), (3, 3, 30), (4, 1, 40), (5, 2, NULL), (6, 3, 60), (7, 1, 70), (8, 2, 80), (9, 3, 90), (10, 1, 100), (11, 2, 110), (12, NULL, 120)

statement ok
INSERT INTO u VALUES (1, 10), (2, NULL), (3, 30)

statement ok
INSERT INTO g VALUES (1, 1, 5), (1, 2, 6), (2, 1, 7), (2, 2, 8), (2, 3, NULL), (3, 1, 9)

# ---------------------------------------------------------------------------------------------------
# Below a window.

# A conjunct over the PARTITION BY column moves below the window: only k = 2's partition is read and
# numbered, and its row numbers are the same as over the whole table.
# cost: 37
query III nosort
SELECT d.id, d.v, d.rn FROM (SELECT id, k, v, row_number() OVER (PARTITION BY k ORDER BY id) AS rn FROM t) d WHERE d.k = 2 ORDER BY d.id
----
2
20
1
5
NULL
2
8
80
3
11
110
4

