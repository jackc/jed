# The NULL partition: partitioning keeps NULLs together, and IS NULL judges every member alike.
# cost: 29
query III nosort
SELECT d.id, d.k, d.n FROM (SELECT id, k, count(*) OVER (PARTITION BY k) AS n FROM t) d WHERE d.k IS NULL
----
12
NULL
