# A single reference inside an IN subquery.
# cost: 65
query I rowsort
WITH c AS (SELECT id, k FROM t) SELECT t.id FROM t WHERE t.id IN (SELECT c.id FROM c WHERE c.k = 2)
----
11
2
5
