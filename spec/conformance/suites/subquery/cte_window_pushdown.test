# ---------------------------------------------------------------------------------------------------
# Into an inlined CTE body.

# A single-reference CTE is planned at its reference: the conjunct moves into the body and bounds t's
# primary key.
# cost: 5
query III nosort
WITH c AS (SELECT id, k, v FROM t) SELECT * FROM c WHERE c.id = 5
----
5
2
NULL

# The same through a join: c's conjunct moves into its body, and the hash join reads only its rows.
# cost: 29
query II nosort
WITH c AS (SELECT id, k FROM t) SELECT c.id, u.w FROM c JOIN u ON c.k = u.id WHERE c.id < 5 ORDER BY c.id
----
1
10
2
NULL
3
30
4
10

# NOT MATERIALIZED on a single reference is the same inlined CTE.
# cost: 5
query III nosort
WITH c AS NOT MATERIALIZED (SELECT id, k, v FROM t) SELECT * FROM c WHERE c.id = 5
----
5
2
NULL

# MATERIALIZED keeps the body whole: it runs once into a buffer the reference scans and filters.
# cost: 50
query III nosort
WITH c AS MATERIALIZED (SELECT id, k, v FROM t) SELECT * FROM c WHERE c.id = 5
----
5
2
NULL

# Two references materialize the CTE; each reference filters the buffer (scan pushdown only).
# cost: 108
query II nosort
WITH c AS (SELECT id, k FROM t) SELECT c1.id, c2.id FROM c c1 JOIN c c2 ON c1.k = c2.k WHERE c1.id = 3 AND c2.id > 6 ORDER BY c2.id
----
3
9

# NOT MATERIALIZED with two references runs the body at each reference, but takes no pushdown.
# cost: 109
query II nosort
WITH c AS NOT MATERIALIZED (SELECT id, k FROM t) SELECT c1.id, c2.id FROM c c1 JOIN c c2 ON c1.k = c2.k WHERE c1.id = 3 AND c2.id > 6 ORDER BY c2.id
----
3
9

# A chain: b's WHERE moves into a, and the outer conjunct moves through b into a too.
# cost: 34
query II nosort
WITH a AS (SELECT id, k, v FROM t), b AS (SELECT id, v FROM a WHERE a.k = 1) SELECT b.id, b.v FROM b WHERE b.id < 8 ORDER BY b.id
----
1
10
4
40
7
70

# A grouped CTE body: the conjunct over the grouping column moves below the grouping.
# cost: 12
query II nosort
WITH s AS (SELECT a, sum(c) AS total FROM g GROUP BY a) SELECT s.a, s.total FROM s WHERE s.a = 2
----
2
15

# A CTE whose body has a window: the partition-key conjunct moves below the window.
# cost: 36
query III nosort
WITH r AS (SELECT id, k, row_number() OVER (PARTITION BY k ORDER BY v DESC) AS rn FROM t) SELECT r.id, r.k, r.rn FROM r WHERE r.k = 3 AND r.rn <= 2 ORDER BY r.id
----
