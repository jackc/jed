# A query CTE read only by the query primary of a data-modifying WITH is expanded; the INSERT runs.
# cost: 10
query II rowsort
WITH q AS (SELECT id, v FROM t), i AS (INSERT INTO w SELECT id, v FROM t WHERE id = 1 RETURNING id) SELECT q.id, q.v FROM q WHERE q.id = 2
----
2
20

# A query CTE read from a data-modifying CTE body is never expanded (that part is planned when it
# runs): its definition runs in place.
# cost: 41
query II rowsort
WITH q AS (SELECT id, v FROM t), i AS (INSERT INTO w SELECT id, v FROM q WHERE q.id = 3 RETURNING id) SELECT i.id, 0 FROM i
----
3
0

# A CTE body reading a view: the conjunct moves through the CTE into the view's body.
# cost: 6
