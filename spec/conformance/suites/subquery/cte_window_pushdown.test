# Every window must partition by the column: here the second window partitions by (k, v), the first by
# k alone, so a conjunct on k moves (k is in both) and one on v does not.
# cost: 40
query IIII nosort
SELECT d.id, d.k, d.a, d.b FROM (SELECT id, k, v, count(*) OVER (PARTITION BY k) AS a, rank() OVER (PARTITION BY k, v ORDER BY id) AS b FROM t) d WHERE d.k = 3 ORDER BY d.id
----
