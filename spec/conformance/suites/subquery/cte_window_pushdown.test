SELECT d.id, d.k, d.run, d.tot FROM (SELECT id, k, sum(v) OVER (PARTITION BY k ORDER BY id) AS run, sum(v) OVER (PARTITION BY k) AS tot FROM t) d WHERE d.k >= 2 ORDER BY d.id
