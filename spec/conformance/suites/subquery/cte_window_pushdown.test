# A set-operation CTE body takes the conjunct into each arm.
# cost: 16
query I nosort
WITH s AS (SELECT id FROM t UNION SELECT id FROM u) SELECT s.id FROM s WHERE s.id <= 2 ORDER BY s.id
----
1
2

# The CTE's column rename list renames the outputs the conjunct references.
# cost: 5
query II nosort
WITH c(x, y) AS (SELECT id, v FROM t) SELECT c.x, c.y FROM c WHERE c.x = 9
----
9
90

# A single reference inside a scalar subquery: its conjunct moves into the body.
# cost: 35
query I nosort
WITH c AS (SELECT id, k, v FROM t) SELECT (SELECT max(c.v) FROM c WHERE c.k = 2)
----
110

# A single reference in a correlated subquery: the uncorrelated conjunct moves into the body, the
# correlated one stays, and the body runs per outer row.
# cost: 81
query II nosort
WITH c AS (SELECT id, k, v FROM t) SELECT u.id, (SELECT count(*) FROM c WHERE c.k = u.id AND c.id < 6) FROM u ORDER BY u.id
----
1
2
2
2
3
1

# A nested WITH in a derived table is inlined at its reference the same way.
# cost: 6
query II nosort
SELECT s.id, s.v FROM (WITH c AS (SELECT id, v FROM t) SELECT id, v FROM c WHERE c.id = 7) s
----
7
70

# The NULL-extended side of a LEFT JOIN keeps a WHERE conjunct outside; its ON conjunct moves in.
# cost: 32
query II nosort
WITH c AS (SELECT id, k FROM t) SELECT u.id, c.id FROM u LEFT JOIN c ON c.k = u.id AND c.id > 8 ORDER BY u.id, c.id
----
1
10
2
11
