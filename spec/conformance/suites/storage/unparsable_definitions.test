statement error XX003
INSERT INTO u VALUES (9, 9)

statement error XX003
DELETE FROM u

query TTT nosort
SELECT name, definition, columns::text FROM jed_views ORDER BY name
----
ok
select id , v from t where v > 0
{id,v}
r
select id from t where id is future syntax
{id}
u
select id , v from t where v is future syntax
{id,v}
w
select id from u
{id}

# The tables a view reads stay writable.
statement ok
INSERT INTO t VALUES (4, 4)

# Changing a table an unparsed view depends on re-plans the view (views.md §8).
statement error XX003
ALTER TABLE t ADD COLUMN z i32

statement error XX003
ALTER TABLE t RENAME COLUMN v TO v2

# Renaming u rewrites w, which reads u.
statement error XX003
ALTER VIEW u RENAME TO u2

# The persisted dependency list still guards and cascades.
statement error 2BP01
DROP VIEW u

statement error 2BP01
DROP TABLE t

statement ok
DROP VIEW u CASCADE

# Replacing an unparsed view compares only the column names and count, as for a body that no longer
# plans (views.md §1.2).
statement error 42P16
CREATE OR REPLACE VIEW r (x) AS SELECT id FROM t

statement ok
CREATE OR REPLACE VIEW r AS SELECT id FROM t WHERE v > 1

query I rowsort
SELECT id FROM r
----
2
4

query T nosort
SELECT name FROM jed_views ORDER BY name
----
ok
r

statement ok
ALTER TABLE t ADD COLUMN z i32

query III rowsort
SELECT id, v, z FROM t WHERE id = 4
----
4
4
NULL

