# Visitation follows the selected m_b order (b ascending), not storage-key order. Both matching
# rows fail below with different errors; the first visited row's error is the statement's error.
statement ok
UPDATE m SET x = 0 WHERE id = 4

statement ok
UPDATE m SET x = 1 WHERE id = 5

# id=4 has x=0 (22012 under 2147483647 / x); id=5 has x=1 (22003 after + x). m_b visits id=5 first.
statement error 22003
UPDATE m SET x = 2147483647 / x + x WHERE id > 0 AND b >= 1 AND b <= 2

# The same predicate spelled to defeat m_b scans in storage-key order and reaches id=4 first.
statement error 22012
UPDATE m SET x = 2147483647 / x + x WHERE id > 0 AND b + 0 >= 1 AND b + 0 <= 2

# Both failed statements wrote nothing.
query IIII rowsort
SELECT id, a, b, x FROM m
