# Cost-based UPDATE/DELETE access-path selection (estimator.md §9.3, planner.md §5.5). A mutation
# target estimates every legal candidate in the shared inventory with SELECT's scan-plus-residual
# estimate and takes the cheapest; an exact tie keeps the canonical kind/name order. The selected
# path's natural emission order is the phase-1 visitation order, so it decides which row's error is
# reported first and the order of per-row volatile assignments. The complete WHERE is always the
# residual filter, so the affected rows never depend on the chosen path.
# requires: ddl.create_table, ddl.primary_key, ddl.secondary_index, ddl.gin_index, ddl.gist_index, ddl.sequence, dml.insert, dml.insert_multi_row, dml.update, dml.delete, dml.returning, dml.costed_access, query.select, query.where_eq, query.comparison_order, query.logical_connectives, query.point_lookup, query.index_range, query.index_mutation, query.gin_scan, query.gist_scan, query.explain, dml.explain, func.sequence, expr.arithmetic, error.overflow_trap, error.division_by_zero, resource.cost_metering, types.i32, types.array, types.range, func.array_containment, func.range_constructors, func.range_operators

statement ok
CREATE TABLE m (id i32 PRIMARY KEY, a i32, b i32, x i32)

statement ok
CREATE INDEX m_a ON m (a)

statement ok
CREATE INDEX m_b ON m (b)

statement ok
INSERT INTO m VALUES (1, 10, 5, 0)

# One row: the full scan costs less than an index descent plus a table point fetch, so the mutation
# leaves the usable m_a bound — the former fixed policy always took any index bound.
# names: depth, node, detail, est_rows, est_cost
# types: i32, text, text, i64, i64
query ITTII nosort
EXPLAIN DELETE FROM m WHERE a = 10
----
0
Delete m
-
1
3
1
Filter
conjuncts=1
1
3
2
Scan m
Full scan; touched=1
1
2

# Full scan: page_read 1 + storage_row_read 1 + filter 1. The m_a bound would add a table fetch.
# cost: 3
statement ok
UPDATE m SET x = x WHERE a = 10

statement ok
INSERT INTO m VALUES (2, 11, 4, 1), (3, 12, 3, 2), (4, 13, 2, 3), (5, 14, 1, 4), (6, 15, 0, 5)

# A PK range competes with a paired range on m_b. The former policy always took the PK bound; the
# m_b bound's narrower paired-range estimate wins now.
query ITTII nosort
EXPLAIN UPDATE m SET x = x + 1 WHERE id > 0 AND b >= 1 AND b <= 2
----
0
Update m
sets=1
1
