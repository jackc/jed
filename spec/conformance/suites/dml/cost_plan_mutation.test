# Per-row volatile assignments follow the same visitation order: m_b reaches id=5 before id=4.
statement ok
CREATE SEQUENCE m_seq

query II rowsort
UPDATE m SET x = nextval('m_seq') WHERE id > 0 AND b >= 1 AND b <= 2 RETURNING id, x
----
4
2
5
1

