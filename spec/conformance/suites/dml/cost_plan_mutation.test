# GIN and GiST bounds compete on estimated cost; with no estimate difference the canonical order
# (GiST before GIN) breaks the tie, replacing the former mutation-only GIN-before-GiST precedence.
statement ok
CREATE TABLE g (id i32 PRIMARY KEY, tags i32[], span i32range)

statement ok
CREATE INDEX g_tags ON g USING gin (tags)

statement ok
CREATE INDEX g_span ON g USING gist (span)

statement ok
INSERT INTO g VALUES (1, '{1,2}', '[1,4)'), (2, '{2,3}', '[2,6)'), (3, '{1,3}', '[5,9)'), (4, '{4}', '[0,2)'), (5, '{1}', '[3,7)'), (6, '{2,4}', '[6,8)')

query ITTII nosort
EXPLAIN DELETE FROM g WHERE tags @> ARRAY[1] AND span && i32range(3, 4)
----
0
Delete g
-
1
