conjuncts=2
1
9
2
Scan g
GiST bound: using g_span; touched=2
1
4

# g_span gathers the three overlapping spans (ids 1, 2, 5); the residual keeps ids 1 and 5.
# cost: 25
statement ok
DELETE FROM g WHERE tags @> ARRAY[1] AND span && i32range(3, 4)

query I rowsort
SELECT id FROM g
