# General expressions in INSERT ... VALUES slots (grammar.md §16). A slot that is exactly a
# literal, a `$N`, `DEFAULT`, or a literal-field ROW(…)/ARRAY[…] keeps its contextual adaptation
# to the target column; any other slot is a general expression — arithmetic, function calls, CASE,
# casts, scalar subqueries — resolved against a column-less scope with the target column's type
# as its literal hint, then stored through the same assignment gate as INSERT ... SELECT (42804)
# and the same per-row store coercion (22003 / 22001 / 23502). Every slot is evaluated before
# any row is written, so an evaluation error stores nothing. Cost: each expression slot accrues
# its evaluated tree per row (operator_eval per node, cost.md §3); an uncorrelated subquery folds
# once. Format + the `requires` directive: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.not_null, ddl.column_default, ddl.check, dml.insert, dml.insert_multi_row, dml.insert_column_list, dml.insert_values_expr, dml.returning, dml.insert_on_conflict, query.select, query.where_eq, query.order_by, query.aggregates, query.subquery_scalar, query.cte, expr.arithmetic, expr.case, expr.decimal_arithmetic, func.abs, func.now, types.i16, types.i32, types.i64, types.text, types.varchar_length, types.decimal, types.boolean, types.date, types.array, types.range, types.composite, ddl.sequence, ddl.identity, error.overflow_trap, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a i64, s text)

# --- arithmetic, functions, CASE, casts --------------------------------------------------
statement ok
INSERT INTO t VALUES (1 + 1, 2 * 3, upper('x'))

statement ok
INSERT INTO t VALUES (3, abs(-7), CASE WHEN 1 < 2 THEN 'yes' ELSE 'no' END)

statement ok
INSERT INTO t VALUES ('4'::i32, CAST('40' AS i64), lower('ABC'))

# a parenthesized literal and a signed sum
statement ok
INSERT INTO t VALUES ((5), - 5 + 1, replace('a-b', '-', ''))

query IIT nosort
SELECT id, a, s FROM t ORDER BY id
----
2
6
X
3
7
yes
4
40
abc
5
-4
ab

# --- multi-row VALUES mixes literal and expression slots ----------------------------------
statement ok
INSERT INTO t VALUES (6, 60, 'six'), (7, 7 * 10, lower('SEVEN')), (8, DEFAULT, NULL)

query IIT nosort
SELECT id, a, s FROM t WHERE id >= 6 ORDER BY id
----
6
60
six
7
70
seven
8
NULL
NULL

# --- scalar subqueries ---------------------------------------------------------------------
# An uncorrelated subquery reads the pre-statement snapshot and folds once.
statement ok
INSERT INTO t VALUES ((SELECT max(id) FROM t) + 1, (SELECT count(*) FROM t), 'next')

query IIT nosort
SELECT id, a, s FROM t WHERE id = 9
----
9
7
next

# an empty scalar subquery is NULL
statement ok
INSERT INTO t VALUES (10, (SELECT a FROM t WHERE id = 999), 'empty')

query IT nosort
SELECT a, s FROM t WHERE id = 10
----
NULL
empty

# a CTE is visible to a VALUES subquery
statement ok
WITH c AS (SELECT 11 AS x) INSERT INTO t VALUES ((SELECT x FROM c), 110, 'cte')

query II nosort
SELECT id, a FROM t WHERE id = 11
----
11
110

# more than one row → 21000; more than one column → 42601
statement error 21000
INSERT INTO t VALUES ((SELECT id FROM t), 0, 'x')

statement error 42601
INSERT INTO t VALUES ((SELECT id, a FROM t WHERE id = 2), 0, 'x')

# --- resolution errors -----------------------------------------------------------------------
# a VALUES slot has no columns in scope
statement error 42703
INSERT INTO t VALUES (12, id, 'x')

# an aggregate outside a subquery is not allowed in VALUES
statement error 42803
INSERT INTO t VALUES (12, sum(1), 'x')

# the expression's type must be assignable to the column
statement error 42804
INSERT INTO t VALUES (12, 'a'::text, 'x')

statement error 42804
INSERT INTO t VALUES (12, 1 = 1, 'x')

# --- all-or-nothing: a later row's evaluation error stores nothing ----------------------------
statement error 22012
INSERT INTO t VALUES (12, 1, 'ok'), (13, 1 / 0, 'boom')

query I nosort
SELECT count(*) FROM t WHERE id >= 12
----
0

# --- store coercion of the evaluated value -----------------------------------------------------
statement ok
CREATE TABLE n (id i32 PRIMARY KEY, sm i16, d numeric(6,2), v varchar(3), b boolean NOT NULL DEFAULT false)

# an i32 result narrows to i16 when it fits; a numeric rounds to the column scale
statement ok
INSERT INTO n (id, sm, d, v, b) VALUES (1, 100 + 23, 1.005 * 2, lower('ABC'), 2 > 1)

query IIDTB nosort
SELECT id, sm, d, v, b FROM n
----
1
123
2.01
abc
true

statement error 22003
INSERT INTO n (id, sm) VALUES (2, 30000 + 30000)

statement error 22001
INSERT INTO n (id, v) VALUES (2, lower('ABCD'))

statement error 23502
INSERT INTO n (id, b) VALUES (2, CASE WHEN false THEN true END)

# --- dates ---------------------------------------------------------------------------------------
statement ok
CREATE TABLE dt (id i32 PRIMARY KEY, d date)

statement ok
INSERT INTO dt VALUES (1, '2024-02-28'::date + 2), (2, '2024-01-01')

query IT nosort
SELECT id, d FROM dt ORDER BY id
----
1
2024-03-01
2
2024-01-01

# --- volatile expressions evaluate per row, in row order ----------------------------------------
statement ok
CREATE SEQUENCE seq

statement ok
INSERT INTO t VALUES (nextval('seq') + 100, nextval('seq'), 'seq'), (nextval('seq') + 100, nextval('seq'), 'seq')

query II nosort
SELECT id, a FROM t WHERE s = 'seq' ORDER BY id
----
101
2
103
4

statement ok
CREATE TABLE clk (id i32 PRIMARY KEY, same boolean)

statement ok
INSERT INTO clk VALUES (1, now() = current_timestamp)

query IB nosort
SELECT id, same FROM clk
----
1
true

# --- RETURNING, ON CONFLICT, CHECK -----------------------------------------------------------------
query IIT nosort
INSERT INTO t VALUES (20, 2 * 10, lower('RET')) RETURNING id, a + 1, s
----
20
21
ret

statement ok
INSERT INTO t VALUES (20, 10 * 50, 'upd') ON CONFLICT (id) DO UPDATE SET a = excluded.a, s = excluded.s

query IT nosort
SELECT a, s FROM t WHERE id = 20
----
500
upd

# A VALUES evaluation error precedes the RETURNING subquery's (whose 21000 would fire if it ran
# first), with or without ON CONFLICT.
statement error 22012
INSERT INTO t VALUES (30, 1 / 0, 'x') RETURNING (SELECT id FROM t)

statement error 22012
INSERT INTO t VALUES (30, 1 / 0, 'x') ON CONFLICT (id) DO NOTHING RETURNING (SELECT id FROM t)

statement ok
CREATE TABLE ck (id i32 PRIMARY KEY, v i32 CHECK (v > 0))

statement error 23514
INSERT INTO ck VALUES (1, 1 - 2)

# --- GENERATED ALWAYS: an expression is an explicit value ------------------------------------------
statement ok
CREATE TABLE ga (id i64 GENERATED ALWAYS AS IDENTITY PRIMARY KEY, v i32)

statement error 428C9
INSERT INTO ga VALUES (1 + 1, 5)

statement ok
INSERT INTO ga OVERRIDING SYSTEM VALUE VALUES (1 + 1, 5)

query II nosort
SELECT id, v FROM ga
----
2
5

# --- container columns ---------------------------------------------------------------------------
statement ok
CREATE TABLE arr (id i32 PRIMARY KEY, xs i64[], r int4range)

statement ok
INSERT INTO arr VALUES (1, ARRAY[1 + 1, 3], int4range(1, 2 + 3))

statement ok
INSERT INTO arr VALUES (2, array_append(ARRAY[7], 8), NULL)

query ITT nosort
SELECT id, xs, r FROM arr ORDER BY id
----
1
{2,3}
[1,5)
2
{7,8}
NULL

statement error 42804
INSERT INTO arr VALUES (3, ARRAY['a'::text], NULL)

# --- composite columns: a value of the column's own type -----------------------------------------
statement ok
CREATE TYPE pt AS (x i32, y i32)

statement ok
CREATE TABLE cmp (id i32 PRIMARY KEY, p pt)

statement ok
INSERT INTO cmp VALUES (1, ROW(1, 2))

statement ok
INSERT INTO cmp VALUES (2, (SELECT p FROM cmp WHERE id = 1))

query IT nosort
SELECT id, p FROM cmp ORDER BY id
----
1
(1,2)
2
(1,2)

# --- cost ------------------------------------------------------------------------------------------
statement ok
CREATE TABLE c (id i32 PRIMARY KEY, a i32)

# literal slots evaluate no expression tree
# cost: 0
statement ok
INSERT INTO c VALUES (1, 10)

# cost: 2
statement ok
INSERT INTO c VALUES (2, 10 + 1), (3, 10 + 2)
