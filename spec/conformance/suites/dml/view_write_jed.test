# Writing through an updatable view — the jed-specific behavior of spec/design/views.md §15 that
# PostgreSQL cannot oracle-check: the session privilege envelope, which checks the written view like a
# table (§15.4), the recorded divergences (§12: 55000 before column errors, 0A000 before
# expression errors, 42701 for two view columns over one base column, the ON CONFLICT DO UPDATE
# primary-key narrowing, the list-less INSERT arity rule), and the plan/cost equivalence with the base
# statement (§15.5, §15.7).
# CROSS-CORE-checked, NOT PostgreSQL-oracle-checked.
# requires: ddl.view, dml.view_write, ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, dml.insert_column_list, dml.insert_on_conflict, dml.view_on_conflict, dml.update, dml.delete, dml.returning, query.select, query.where_eq, query.order_by, query.group_by, query.aggregates, query.explain, dml.explain, func.abs, expr.arithmetic, resource.cost_metering, types.i32, types.text, session.privileges

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a i32, b text)

statement ok
INSERT INTO t VALUES (1, 10, 'x'), (2, 20, 'y'), (3, 30, 'z')

statement ok
CREATE VIEW v AS SELECT id, a, a * 2 AS a2 FROM t WHERE a > 5

# --- the writer's privileges are checked on the view, never on the base table ---------------------

# default_privileges: NONE
# grant: UPDATE, SELECT ON v
query II nosort
UPDATE v SET a = a + 1 WHERE id = 1 RETURNING id, a2
----
1
22

# a bare INSERT reads nothing, so INSERT on the view is enough
# default_privileges: NONE
# grant: INSERT ON v
statement ok
INSERT INTO v (id, a) VALUES (4, 40)

# reading the view's columns (here in WHERE) also needs SELECT on the view
# default_privileges: NONE
# grant: DELETE ON v
statement error 42501
DELETE FROM v WHERE id = 4

# default_privileges: NONE
# grant: DELETE, SELECT ON v
query I nosort
DELETE FROM v WHERE id = 4 RETURNING id
----
4

# the table itself stays out of reach
# default_privileges: NONE
# grant: INSERT ON v
statement error 42501
INSERT INTO t VALUES (9, 9, 'q')

# ON CONFLICT through the view is checked on the view too, as for a table (§15.7): the conflict
# target and the RETURNING read the view's columns, so SELECT on the view is needed as well
# default_privileges: NONE
# grant: INSERT ON v
statement error 42501
INSERT INTO v (id, a) VALUES (5, 50), (1, 0) ON CONFLICT (id) DO NOTHING

# default_privileges: NONE
# grant: INSERT, SELECT ON v
query II nosort
INSERT INTO v (id, a) VALUES (5, 50), (1, 0) ON CONFLICT (id) DO NOTHING RETURNING id, a2
----
5
100

# default_privileges: NONE
# grant: INSERT ON v
statement error 42501
INSERT INTO t VALUES (5, 50, 'q') ON CONFLICT (id) DO NOTHING

statement ok
DELETE FROM t WHERE id = 5

# default_privileges: NONE
# grant: SELECT ON v
statement error 42501
UPDATE v SET a = 1

# a function in a read-only column needs the writer's EXECUTE when the write evaluates it
statement ok
CREATE VIEW vf AS SELECT id, abs(a) AS aa FROM t

# revoke: EXECUTE ON abs
statement error 42501
UPDATE vf SET id = id WHERE aa > 100

query I nosort
UPDATE vf SET id = id WHERE aa > 100 RETURNING id
----

# --- only the target view is checked, as for a table: its creator's privileges on the base table and
# the views below it in a chain do not matter (views.md §15.4) ----------------------------------------

# revoke: UPDATE ON t
statement ok
CREATE VIEW vr AS SELECT id, a FROM t

# the creator could not UPDATE t, but the writer's privilege on vr is all that is checked
query II nosort
UPDATE vr SET a = 12 WHERE id = 1 RETURNING *
----
1
12

statement ok
CREATE VIEW vr2 AS SELECT id, a FROM vr

# a chain needs the privilege on the view written to only
# default_privileges: NONE
# grant: UPDATE, SELECT ON vr2
query II nosort
UPDATE vr2 SET a = 13 WHERE id = 1 RETURNING *
----
1
13

# default_privileges: NONE
# grant: UPDATE, SELECT ON vr2
statement error 42501
UPDATE vr SET a = 14

statement ok
DROP VIEW vr2, vr, vf

# --- recorded divergences (views.md §12) ------------------------------------------------------------

statement ok
CREATE VIEW vg AS SELECT a, count(*) AS n FROM t GROUP BY a

# 55000 is reported when the target resolves, before a column error (PG reports 42703 first)
statement error 55000
INSERT INTO vg (nosuch) VALUES (1)

statement error 55000
UPDATE vg SET nosuch = 1

# a read-only column is 0A000 before the statement's expressions resolve (PG reports 42883 first)
statement error 0A000
UPDATE v SET a2 = nosuch_fn()

# two view columns over one base column assigned together are 42701 (PG: 42601)
statement ok
CREATE VIEW vdup AS SELECT id, a, a AS aa FROM t

statement error 42701
UPDATE vdup SET a = 1, aa = 2

statement error 42701
INSERT INTO vdup (id, a, aa) VALUES (9, 1, 2)

# the same for an ON CONFLICT DO UPDATE's SET targets (§15.7)
statement error 42701
INSERT INTO vdup (id, a) VALUES (9, 1) ON CONFLICT (id) DO UPDATE SET a = 1, aa = 2

# a read-only SET target is 0A000 before the SET expressions resolve (PG reports 42883 first)
statement error 0A000
INSERT INTO v (id, a) VALUES (1, 1) ON CONFLICT (id) DO UPDATE SET a2 = nosuch_fn()

# ON CONFLICT on a view that is not updatable is 55000 before a conflict-target error (PG: 42703)
statement error 55000
INSERT INTO vg VALUES (1, 1) ON CONFLICT (nosuch) DO NOTHING

# DO UPDATE cannot assign a primary-key column (upsert.md §9), through a view too (PG allows it)
statement error 0A000
INSERT INTO v (id, a) VALUES (1, 1) ON CONFLICT (id) DO UPDATE SET id = 2

# a list-less INSERT supplies every view column, as for a table (PG accepts fewer)
statement ok
CREATE VIEW vab AS SELECT id, a FROM t

statement error 42601
INSERT INTO vab VALUES (9)

statement ok
DROP VIEW vg, vdup, vab

# --- plan and cost (views.md §15.2, §15.5) -----------------------------------------------------------

statement ok
CREATE TABLE m (id i32 PRIMARY KEY, x i32, y i32)

statement ok
INSERT INTO m VALUES (1, 10, 1), (2, 20, 0), (3, 30, 1)

statement ok
CREATE VIEW mv AS SELECT id, x, x + y AS s FROM m WHERE y > 0

# The complete WHERE (the view's, then the statement's) selects the access path: a primary-key
# point lookup, as for the same statement on the table.
# names: depth, node, detail, est_rows, est_cost
# types: i32, text, text, i64, i64
query ITTII nosort
EXPLAIN UPDATE mv SET x = x + 1 WHERE id = 3
----
0
Update m
sets=1
1
5
1
Filter
conjuncts=2
1
5
2
Scan m
PK bound: id = 3; touched=3
1
2

# names: depth, node, detail, est_rows, est_cost
# types: i32, text, text, i64, i64
query ITTII nosort
EXPLAIN UPDATE m SET x = x + 1 WHERE y > 0 AND id = 3
----
0
Update m
sets=1
1
5
1
Filter
conjuncts=2
1
5
2
Scan m
PK bound: id = 3; touched=3
1
2

# The write is the base statement `UPDATE m SET x = x + 1 WHERE y > 0 AND id = 3 RETURNING id, s`,
# and costs what it does: 1 page + 1 row + the 3-node WHERE + the assignment's `+` + `x + y` for
# `s` + 1 produced = 8.
# cost: 8
query II nosort
UPDATE mv SET x = x + 1 WHERE id = 3 RETURNING id, s
----
3
32

# The view's WHERE is the first conjunct of a filter, so `x * 2 > 50` runs only where `y > 0` is
# TRUE: 1 page + 3 rows + the AND on every row (4 nodes on rows 1 and 3, 2 on row 2) + 1 produced
# = 15.
# cost: 15
query I nosort
DELETE FROM mv WHERE x * 2 > 50 RETURNING id
----
3

statement ok
INSERT INTO m VALUES (3, 31, 1)

# The hand-written base statement over the same rows costs the same.
# cost: 15
query I nosort
DELETE FROM m WHERE y > 0 AND x * 2 > 50 RETURNING id
----
3

statement ok
INSERT INTO m VALUES (3, 31, 1)

# An ON CONFLICT through the view renders its base statement (§15.7).
# names: depth, node, detail, est_rows, est_cost
# types: i32, text, text, i64, i64
query ITTII nosort
EXPLAIN INSERT INTO mv (id, x) VALUES (2, 7) ON CONFLICT (id) DO UPDATE SET x = excluded.s
----
0
Insert m
on conflict do update
1
0
1
Values
rows=1
1
0

# An ON CONFLICT through the view costs its base statement too (§15.7): `INSERT INTO m … ON CONFLICT
# (id) DO UPDATE SET x = excluded.x + (m.x + m.y) RETURNING id, x + y` — the SET's two `+` + `x + y`
# for `s` + 1 produced = 4. The view's WHERE is not part of the conflict path.
# cost: 4
query II nosort
INSERT INTO mv (id, x) VALUES (2, 7) ON CONFLICT (id) DO UPDATE SET x = excluded.x + mv.s RETURNING id, s
----
2
27

# cost: 4
query II nosort
INSERT INTO m (id, x) VALUES (2, 7) ON CONFLICT (id) DO UPDATE SET x = excluded.x + m.x + m.y RETURNING id, x + y
----
2
34

query III nosort
SELECT * FROM v ORDER BY id
----
1
13
26
2
20
40
3
30
60
