# A MERGE in a writable CTE renders below its definition.
query ITTII nosort
EXPLAIN WITH m AS (
  MERGE INTO t USING (VALUES (2)) AS s(k) ON t.id = s.k
  WHEN MATCHED THEN DELETE
  RETURNING t.id
)
SELECT id FROM m
