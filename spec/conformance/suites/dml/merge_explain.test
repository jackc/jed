# EXPLAIN MERGE (spec/design/merge.md §12, explain.md §4, estimator.md §9.4): a `Merge <table>` root
# (when=N), the matching loop as a left `Nested Loop` over the source subtree and the per-source-row
# target probe `Scan` — its bound reads the source row as `outer` — and, with a NOT MATCHED BY
# SOURCE clause, the full target `Scan`. Plain EXPLAIN writes nothing; ANALYZE runs the statement and
# attributes its cost. CROSS-CORE-checked, NOT PostgreSQL-oracle-checked (jed's EXPLAIN).
# requires: ddl.create_table, ddl.view, dml.view_write, ddl.primary_key, ddl.secondary_index, dml.insert, dml.insert_multi_row, dml.merge, dml.with_clause, query.cte_data_modifying, query.select, query.values, query.join_inner, query.explain, query.explain_analyze, dml.explain, dml.explain_analyze, types.i32, expr.arithmetic, query.set_returning, dml.insert_select

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, v i32)

statement ok
CREATE INDEX t_v ON t (v)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)

statement ok
CREATE TABLE a (k i32, x i32)

statement ok
INSERT INTO a VALUES (1, 100), (4, 400)

# A primary-key probe per source row; the estimate repeats it for each estimated source row.
query ITTII nosort
EXPLAIN MERGE INTO t USING (VALUES (1, 5), (9, 9)) AS s(k, w) ON t.id = s.k
WHEN MATCHED THEN UPDATE SET v = t.v + s.w
WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.w)
----
