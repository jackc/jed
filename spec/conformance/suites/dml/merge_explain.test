# A join condition no access path narrows, over inputs large enough that the hash form is cheaper:
# one full scan of the target builds the table each source row probes.
statement ok
CREATE TABLE hb (id i32 PRIMARY KEY, grp i32, n i32)

statement ok
INSERT INTO hb SELECT g, g % 20, 0 FROM generate_series(1, 200) AS s(g)

statement ok
CREATE TABLE hs (grp i32, d i32)

statement ok
INSERT INTO hs SELECT g % 30, g FROM generate_series(1, 60) AS s(g)

query ITTII nosort
EXPLAIN MERGE INTO hb USING hs ON hb.grp = hs.grp AND hb.id = hs.d
WHEN MATCHED THEN UPDATE SET n = hs.d
