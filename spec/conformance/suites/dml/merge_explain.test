# Into a view: the base-table statement, whose join condition leads with the view's WHERE, and
# whose not-matched-by-source scan filters by it.
statement ok
CREATE VIEW tv AS SELECT id, v FROM t WHERE v > 0

query ITTII nosort
EXPLAIN MERGE INTO tv USING (VALUES (1)) AS s(k) ON tv.id = s.k
WHEN MATCHED THEN UPDATE SET v = 0
WHEN NOT MATCHED BY SOURCE THEN DELETE
