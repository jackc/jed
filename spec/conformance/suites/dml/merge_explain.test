# NOT MATCHED BY SOURCE adds the full target scan; ANALYZE attributes the actual cost.
query ITTIII nosort
EXPLAIN ANALYZE MERGE INTO t USING (VALUES (1, 5), (9, 9)) AS s(k, w) ON t.id = s.k
WHEN MATCHED THEN UPDATE SET v = t.v + s.w
WHEN NOT MATCHED BY SOURCE AND t.id = 3 THEN DELETE
WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.w)
