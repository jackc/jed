# MERGE (spec/design/merge.md, grammar.md `merge`). A data source joined to the target: per
# joined pair the first WHEN clause whose kind fits and whose AND condition is TRUE runs —
# UPDATE / DELETE a matched target row, INSERT for an unmatched source row, UPDATE / DELETE a target
# row no source row matched (BY SOURCE), or DO NOTHING. Oracle-probed against PostgreSQL 18.
# A MERGE … RETURNING `query` changes its table, which the oracle does not replay, so each one acts
# on a table nothing reads afterwards; effects are checked after a `statement ok` MERGE instead.
# Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, dml.update, dml.delete, dml.returning, dml.merge, dml.with_clause, query.cte_data_modifying, query.select, query.order_by, query.derived_table, query.values, query.group_by, types.i32, types.text, expr.arithmetic

statement ok
CREATE TABLE tgt (id i32 PRIMARY KEY, v i32)

statement ok
CREATE TABLE src (id i32, v i32)

statement ok
INSERT INTO tgt VALUES (1, 10), (2, 20), (3, 30)

statement ok
INSERT INTO src VALUES (1, 100), (4, 400)

# The canonical upsert: update the matched row, insert the unmatched one.
statement ok
MERGE INTO tgt USING src ON tgt.id = src.id
WHEN MATCHED THEN UPDATE SET v = src.v
WHEN NOT MATCHED THEN INSERT VALUES (src.id, src.v)

query II nosort
SELECT id, v FROM tgt ORDER BY id
----
1
100
2
20
3
30
4
400

# BY SOURCE deletes every target row no source row matched; the source is a VALUES list.
statement ok
MERGE INTO tgt USING (VALUES (1), (4)) AS s(k) ON tgt.id = s.k
WHEN NOT MATCHED BY SOURCE THEN DELETE

query II nosort
SELECT id, v FROM tgt ORDER BY id
----
1
100
4
400

# BY SOURCE UPDATE; a target alias (AS optional) qualifies the target.
statement ok
MERGE INTO tgt t USING (VALUES (1)) AS s(k) ON t.id = s.k
WHEN MATCHED THEN UPDATE SET v = t.v + 1
WHEN NOT MATCHED BY SOURCE THEN UPDATE SET v = t.v * 2

query II nosort
SELECT id, v FROM tgt ORDER BY id
----
1
101
4
800

# RETURNING projects one row per action, merge_action() naming it.
query TIIII rowsort
MERGE INTO tgt t USING (VALUES (1, 7), (5, 50)) AS s(k, w) ON t.id = s.k
WHEN MATCHED THEN UPDATE SET v = t.v + s.w
WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.w)
RETURNING merge_action(), s.*, t.*
----
INSERT
5
50
5
50
UPDATE
1
7
1
108

# `*` is the source's columns, then the target's.
statement ok
CREATE TABLE star (id i32 PRIMARY KEY, v text)

query ITIT rowsort
MERGE INTO star USING (VALUES (1, 'x')) AS s(k, w) ON star.id = s.k
WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.w)
RETURNING *
----
1
x
1
x

# old / new in RETURNING: an UPDATE's pre-update and new rows, an INSERT's all-NULL old row, a
# DELETE's all-NULL new row. A BY SOURCE action has an all-NULL source row.
statement ok
CREATE TABLE ret (id i32 PRIMARY KEY, v i32)

statement ok
INSERT INTO ret VALUES (1, 10), (2, 20), (4, 40)

query TIIIIIII rowsort
MERGE INTO ret USING (VALUES (1, 0), (6, 60)) AS s(k, w) ON ret.id = s.k
WHEN MATCHED THEN UPDATE SET v = s.w
WHEN NOT MATCHED BY SOURCE AND ret.id = 4 THEN DELETE
WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.k, s.w)
RETURNING merge_action(), s.k, old.id, old.v, new.id, new.v, ret.id, ret.v
----
DELETE
NULL
4
40
NULL
NULL
4
40
INSERT
6
NULL
NULL
6
60
6
60
UPDATE
1
1
10
1
0
1
0

# Conditions: the first clause whose kind fits and whose condition is TRUE runs; a NULL condition
# is not TRUE. A pair no clause takes does nothing.
statement ok
CREATE TABLE cond (id i32 PRIMARY KEY, v i32)

statement ok
INSERT INTO cond VALUES (1, 1), (2, 2), (3, 3), (4, 4)

statement ok
MERGE INTO cond USING (VALUES (1, 10), (2, NULL), (3, 30), (4, 40), (7, 1), (8, 2), (9, 3)) AS s(k, w)
ON cond.id = s.k
WHEN MATCHED AND s.w > 35 THEN DELETE
WHEN MATCHED AND s.w > 20 THEN UPDATE SET v = -s.w
WHEN MATCHED AND cond.v = 1 THEN DO NOTHING
WHEN MATCHED THEN UPDATE SET v = 0
WHEN NOT MATCHED AND s.w = 1 THEN INSERT VALUES (s.k, 100)
WHEN NOT MATCHED AND s.w = 2 THEN DO NOTHING
WHEN NOT MATCHED THEN INSERT VALUES (s.k, 300)

query II nosort
SELECT id, v FROM cond ORDER BY id
----
1
1
2
0
3
-30
7
100
9
300

# NOT MATCHED [BY TARGET] with a column list, DEFAULT, and fewer VALUES than columns.
statement ok
CREATE TABLE dflt (id i32 PRIMARY KEY, v i32 DEFAULT 7, w text DEFAULT 'w')

statement ok
MERGE INTO dflt USING (VALUES (1), (2), (3)) AS s(k) ON dflt.id = s.k
WHEN NOT MATCHED BY TARGET AND s.k = 1 THEN INSERT (id) VALUES (s.k)
WHEN NOT MATCHED AND s.k = 2 THEN INSERT VALUES (s.k, DEFAULT, 'x')
WHEN NOT MATCHED THEN INSERT VALUES (s.k)

query IIT nosort
SELECT id, v, w FROM dflt ORDER BY id
----
1
7
w
2
7
x
3
7
w

# UPDATE SET col = DEFAULT, from a matched row and a BY SOURCE row; DEFAULT VALUES.
statement ok
MERGE INTO dflt USING (VALUES (1), (9)) AS s(k) ON dflt.id = s.k
WHEN MATCHED THEN UPDATE SET w = DEFAULT, v = 70
WHEN NOT MATCHED BY SOURCE AND dflt.id = 2 THEN UPDATE SET v = DEFAULT, w = 'bs'
WHEN NOT MATCHED THEN INSERT (id) VALUES (s.k)

query IIT nosort
SELECT id, v, w FROM dflt ORDER BY id
----
1
70
w
2
7
bs
3
7
w
9
7
w

statement ok
CREATE TABLE dv (id i32 DEFAULT 5, v text DEFAULT 'z')

statement ok
MERGE INTO dv USING (VALUES (1)) AS s(k) ON dv.id = s.k
WHEN NOT MATCHED THEN INSERT DEFAULT VALUES

query IT nosort
SELECT id, v FROM dv
----
5
z

# A target row matched by several source rows: legal while at most one acts on it.
statement ok
CREATE TABLE multi (id i32 PRIMARY KEY, v i32)

statement ok
INSERT INTO multi VALUES (1, 10), (2, 20)

statement ok
MERGE INTO multi USING (VALUES (1, 1), (1, 2), (1, 3)) AS s(k, w) ON multi.id = s.k
WHEN MATCHED AND s.w = 2 THEN UPDATE SET v = 99
WHEN MATCHED THEN DO NOTHING

query II nosort
SELECT id, v FROM multi ORDER BY id
----
1
99
2
20

# Conditions read the pre-statement target row: the second source row still sees v = 99, so
# `multi.v = 0` is false, nothing happens, and there is no 21000.
statement ok
MERGE INTO multi USING (VALUES (1, 1), (1, 2)) AS s(k, w) ON multi.id = s.k
WHEN MATCHED AND s.w = 1 THEN UPDATE SET v = 0
WHEN MATCHED AND multi.v = 0 THEN DELETE

query II nosort
SELECT id, v FROM multi ORDER BY id
----
1
0
2
20

# A second UPDATE or DELETE of the same target row is 21000.
statement error 21000
MERGE INTO multi USING (VALUES (2, 1), (2, 2)) AS s(k, w) ON multi.id = s.k
WHEN MATCHED THEN UPDATE SET v = s.w

statement error 21000
MERGE INTO multi USING (VALUES (2, 1), (2, 2)) AS s(k, w) ON multi.id = s.k
WHEN MATCHED AND s.w = 1 THEN DELETE
WHEN MATCHED THEN UPDATE SET v = 5

# Conditions evaluate against the ORIGINAL row, so the second pair also chooses UPDATE → 21000.
statement error 21000
MERGE INTO multi USING (VALUES (2, 1), (2, 2)) AS s(k, w) ON multi.id = s.k
WHEN MATCHED AND multi.v = 20 THEN UPDATE SET v = 21
WHEN MATCHED THEN DO NOTHING

# Two unmatched source rows inserting the same key → 23505 (an inserted row is never matched).
statement error 23505
MERGE INTO multi USING (VALUES (5, 1), (5, 2)) AS s(k, w) ON multi.id = s.k
WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.w)

query II nosort
SELECT id, v FROM multi ORDER BY id
----
1
0
2
20

# A NULL join key never matches.
statement ok
MERGE INTO multi USING (VALUES (NULL::i32, 5)) AS s(k, w) ON multi.id = s.k
WHEN MATCHED THEN DELETE
WHEN NOT MATCHED THEN INSERT VALUES (s.w, s.w)

query II nosort
SELECT id, v FROM multi ORDER BY id
----
1
0
2
20
5
5

# The source as a grouped subquery, a CTE, and a table; the join condition need not be an
# equality.
statement ok
CREATE TABLE ledger (acct i32 PRIMARY KEY, bal i32)

statement ok
CREATE TABLE moves (acct i32, amt i32)

statement ok
INSERT INTO ledger VALUES (1, 100), (2, 200), (3, 300)

statement ok
INSERT INTO moves VALUES (1, 5), (1, 7), (2, -200), (4, 40), (4, 2)

statement ok
MERGE INTO ledger l
USING (SELECT acct, sum(amt) AS amt FROM moves GROUP BY acct) m ON l.acct = m.acct
WHEN MATCHED AND l.bal + m.amt = 0 THEN DELETE
WHEN MATCHED THEN UPDATE SET bal = l.bal + m.amt
WHEN NOT MATCHED THEN INSERT VALUES (m.acct, m.amt)

query II nosort
SELECT acct, bal FROM ledger ORDER BY acct
----
1
112
3
300
4
42

statement ok
WITH big AS (SELECT acct FROM ledger WHERE bal > 100)
MERGE INTO ledger USING big ON ledger.acct = big.acct
WHEN MATCHED THEN UPDATE SET bal = 0

query II nosort
SELECT acct, bal FROM ledger ORDER BY acct
----
1
0
3
0
4
42

statement ok
MERGE INTO ledger USING (VALUES (10)) AS s(lim) ON ledger.bal < s.lim
WHEN MATCHED THEN UPDATE SET bal = s.lim

query II nosort
SELECT acct, bal FROM ledger ORDER BY acct
----
1
10
3
10
4
42

# A source that reads the target sees the pre-statement table.
statement ok
MERGE INTO ledger USING (SELECT acct + 100 AS a, bal FROM ledger) s ON ledger.acct = s.a
WHEN NOT MATCHED THEN INSERT VALUES (s.a, s.bal)

query II nosort
SELECT acct, bal FROM ledger ORDER BY acct
----
1
10
3
10
4
42
101
10
103
10
104
42

# No WHEN clause applies: nothing changes.
statement ok
MERGE INTO ledger USING (VALUES (1)) AS s(k) ON ledger.acct = s.k
WHEN NOT MATCHED THEN DO NOTHING

# MERGE in a writable CTE: its RETURNING rows are the CTE's rows.
statement ok
CREATE TABLE wc (id i32 PRIMARY KEY, v i32)

statement ok
INSERT INTO wc VALUES (1, 1)

query TII rowsort
WITH m AS (
  MERGE INTO wc USING (VALUES (1, 5), (2, 6)) AS s(k, w) ON wc.id = s.k
  WHEN MATCHED THEN UPDATE SET v = s.w
  WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.w)
  RETURNING merge_action() AS act, wc.id, wc.v
)
SELECT act, id, v FROM m
----
INSERT
2
6
UPDATE
1
5

# A side-effect-only MERGE CTE still runs.
statement ok
CREATE TABLE wc2 (id i32 PRIMARY KEY, v i32)

statement ok
WITH m AS (
  MERGE INTO wc2 USING (VALUES (3, 30)) AS s(k, w) ON wc2.id = s.k
  WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.w)
)
SELECT 1

query II nosort
SELECT id, v FROM wc2
----
3
30

# Re-keying: assigning a primary-key column moves the row; end-state validation lets a MERGE move a
# row onto a key another action vacates.
statement ok
CREATE TABLE rk (id i32 PRIMARY KEY, v text)

statement ok
INSERT INTO rk VALUES (1, 'a'), (2, 'b'), (3, 'c')

statement ok
MERGE INTO rk USING (VALUES (1), (2)) AS s(k) ON rk.id = s.k
WHEN MATCHED THEN UPDATE SET id = rk.id + 10

query IT nosort
SELECT id, v FROM rk ORDER BY id
----
3
c
11
a
12
b

statement ok
MERGE INTO rk USING (VALUES (3)) AS s(k) ON rk.id = s.k
WHEN MATCHED THEN UPDATE SET id = 30
WHEN NOT MATCHED BY SOURCE AND rk.id = 11 THEN DELETE

query IT nosort
SELECT id, v FROM rk ORDER BY id
----
12
b
30
c

statement error 23505
MERGE INTO rk USING (VALUES (12)) AS s(k) ON rk.id = s.k
WHEN MATCHED THEN UPDATE SET id = 30

statement error 23505
MERGE INTO rk USING (VALUES (12)) AS s(k) ON rk.id = s.k + 1
WHEN NOT MATCHED THEN INSERT VALUES (s.k, 'dup')

query IT nosort
SELECT id, v FROM rk ORDER BY id
----
12
b
30
c
