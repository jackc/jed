# INSERT ... ON CONFLICT DO UPDATE assigning a PRIMARY KEY column — re-keying the conflicting row
# (spec/design/upsert.md §3/§5), the standalone re-keying UPDATE carried onto the conflict path: the
# row's storage key is recomputed, validated against the statement end state (another row's key is
# 23505), and every secondary-index entry and foreign-key reference follows it. Also PostgreSQL's
# second-affect rule (upsert.md §4): a proposal is 21000 only when the row it conflicts with was
# inserted or updated by this statement. Every record is oracle-probed against PostgreSQL except the
# end-state key swap at the end (upsert.md §9; oracle_overrides.toml).
# Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.composite_primary_key, ddl.unique, ddl.secondary_index, ddl.foreign_key, ddl.identity, ddl.view, dml.view_write, dml.view_on_conflict, dml.insert, dml.insert_multi_row, dml.insert_column_list, dml.insert_on_conflict, dml.insert_on_conflict_default, dml.insert_on_conflict_rekey, dml.update, dml.returning, dml.returning_old_new, query.select, query.where_eq, query.order_by, expr.arithmetic, expr.case, types.i32, types.text, types.array, types.range, ddl.gin_index, query.gin_scan, ddl.gist_index, query.gist_scan

statement ok
CREATE TABLE rk (id i32 PRIMARY KEY, v i32)

statement ok
CREATE INDEX rk_v ON rk (v)

statement ok
INSERT INTO rk VALUES (1, 10), (2, 20)

# The conflicting row moves to its new key; RETURNING sees both versions.
query IIII nosort
INSERT INTO rk VALUES (1, 0) ON CONFLICT (id) DO UPDATE SET id = excluded.id + 100, v = rk.v + 1 RETURNING old.id, old.v, new.id, new.v
----
1
10
101
11

query II nosort
SELECT id, v FROM rk ORDER BY id
----
2
20
101
11

# The secondary index followed the row to its new key.
query II nosort
SELECT id, v FROM rk WHERE v = 11
----
101
11

query I nosort
SELECT id FROM rk WHERE id = 1
----

# Re-keying onto another row's key is a primary-key violation.
statement error 23505
INSERT INTO rk VALUES (2, 0) ON CONFLICT (id) DO UPDATE SET id = 101

# Assigning the key its own value is not a move.
query II nosort
INSERT INTO rk VALUES (2, 0) ON CONFLICT (id) DO UPDATE SET id = 2, v = 21 RETURNING *
----
2
21

# A proposal for a key an earlier update vacated conflicts with nothing: the row moves to 7 and a
# new row 2 is inserted.
query II rowsort
INSERT INTO rk VALUES (2, 0), (2, 5) ON CONFLICT (id) DO UPDATE SET id = 7 RETURNING *
----
2
5
7
21

# A proposal for the key an earlier update moved a row onto: that row was already affected (21000).
statement error 21000
INSERT INTO rk VALUES (7, 0), (8, 0) ON CONFLICT (id) DO UPDATE SET id = 8

# Re-keying onto the key a row this statement inserts is a primary-key violation.
statement error 23505
INSERT INTO rk VALUES (9, 0), (7, 0) ON CONFLICT (id) DO UPDATE SET id = 9

# A DO UPDATE WHERE that skips the update leaves the row unaffected, so a second proposal for it is
# evaluated again (here skipped again): no 21000.
statement ok
INSERT INTO rk VALUES (7, 0), (7, 1) ON CONFLICT (id) DO UPDATE SET v = 0 WHERE false

# ... but when the first proposal inserted the row, the second conflicts with an affected row.
statement error 21000
INSERT INTO rk VALUES (50, 0), (50, 1) ON CONFLICT (id) DO UPDATE SET v = 0 WHERE false

# Re-keying a row whose WHERE passes for the second proposal only.
query II nosort
INSERT INTO rk VALUES (7, 0), (7, 1) ON CONFLICT (id) DO UPDATE SET id = 70 WHERE excluded.v = 1 RETURNING *
----
70
21

query II nosort
SELECT id, v FROM rk ORDER BY id
----
2
5
70
21
101
11

statement ok
DROP TABLE rk

# --- a unique-index arbiter whose DO UPDATE changes the primary key -------------------------------

statement ok
CREATE TABLE ru (id i32 PRIMARY KEY, e text UNIQUE, v i32)

statement ok
INSERT INTO ru VALUES (1, 'a', 1), (2, 'b', 2)

query ITI nosort
INSERT INTO ru VALUES (9, 'a', 0) ON CONFLICT (e) DO UPDATE SET id = excluded.id RETURNING *
----
9
a
1

statement error 23505
INSERT INTO ru VALUES (2, 'a', 0) ON CONFLICT (e) DO UPDATE SET id = excluded.id

# Both rows re-keyed in one statement.
query ITI rowsort
INSERT INTO ru VALUES (0, 'a', 0), (0, 'b', 0) ON CONFLICT (e) DO UPDATE SET id = ru.id + 100 RETURNING *
----
102
b
2
109
a
1

# The unique index followed both rows.
query IT nosort
SELECT id, e FROM ru WHERE e = 'b'
----
102
b

# A re-key does not excuse a non-arbiter conflict: the new e collides with row 109's.
statement error 23505
INSERT INTO ru VALUES (0, 'b', 0) ON CONFLICT (e) DO UPDATE SET id = 5, e = 'a'

# Assigning the arbiter column moves the arbiter key: a later proposal for the new value conflicts
# with the already-affected row (21000), one for the vacated value is inserted.
statement error 21000
INSERT INTO ru VALUES (0, 'b', 0), (1, 'z', 0) ON CONFLICT (e) DO UPDATE SET e = 'z'

query ITI rowsort
INSERT INTO ru VALUES (0, 'b', 0), (1, 'b', 7) ON CONFLICT (e) DO UPDATE SET e = 'z' RETURNING *
----
1
b
7
102
z
2

statement ok
DROP TABLE ru

# --- a composite primary key, one member assigned -------------------------------------------------

statement ok
CREATE TABLE rc (a i32, b i32, v i32, PRIMARY KEY (a, b))

statement ok
INSERT INTO rc VALUES (1, 1, 10), (1, 2, 20)

query III nosort
INSERT INTO rc VALUES (1, 1, 0) ON CONFLICT (a, b) DO UPDATE SET b = 3 RETURNING *
----
1
3
10

statement error 23505
INSERT INTO rc VALUES (1, 3, 0) ON CONFLICT (b, a) DO UPDATE SET b = 2

query III nosort
SELECT a, b, v FROM rc ORDER BY a, b
----
1
2
20
1
3
10

statement ok
DROP TABLE rc

# --- foreign keys -----------------------------------------------------------------------------------

statement ok
CREATE TABLE rp (id i32 PRIMARY KEY, v i32)

statement ok
CREATE TABLE rch (cid i32 PRIMARY KEY, pid i32 REFERENCES rp (id) ON UPDATE CASCADE)

statement ok
INSERT INTO rp VALUES (1, 10), (2, 20)

statement ok
INSERT INTO rch VALUES (100, 1), (200, 2)

# A parent re-key cascades to its children.
statement ok
INSERT INTO rp VALUES (1, 0) ON CONFLICT (id) DO UPDATE SET id = 11

query II nosort
SELECT cid, pid FROM rch ORDER BY cid
----
100
11
200
2

statement ok
CREATE TABLE rna (cid i32 PRIMARY KEY, pid i32 REFERENCES rp (id))

statement ok
INSERT INTO rna VALUES (1, 11)

# NO ACTION: a re-key that would strand a child is 23503 ...
statement error 23503
INSERT INTO rp VALUES (11, 0) ON CONFLICT (id) DO UPDATE SET id = 12

# ... while an unreferenced parent moves freely.
query II nosort
INSERT INTO rp VALUES (2, 0) ON CONFLICT (id) DO UPDATE SET id = 22 RETURNING *
----
22
20

# The cascade moved the child of 2 as well.
query II nosort
SELECT cid, pid FROM rch ORDER BY cid
----
100
11
200
22

# A child whose primary key is its foreign key: re-keying it re-checks the reference.
statement ok
CREATE TABLE rself (id i32 PRIMARY KEY REFERENCES rp (id), v i32)

statement ok
INSERT INTO rself VALUES (11, 1)

statement error 23503
INSERT INTO rself VALUES (11, 0) ON CONFLICT (id) DO UPDATE SET id = 99

statement ok
INSERT INTO rself VALUES (11, 0) ON CONFLICT (id) DO UPDATE SET id = 22

query II nosort
SELECT id, v FROM rself
----
22
1

statement ok
DROP TABLE rself

statement ok
DROP TABLE rna

statement ok
DROP TABLE rch

statement ok
DROP TABLE rp

# --- SET id = DEFAULT re-keys to the identity sequence's next value ------------------------------

statement ok
CREATE TABLE rid (id i32 GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, v i32)

statement ok
INSERT INTO rid VALUES (50, 1)

query II nosort
INSERT INTO rid VALUES (50, 2) ON CONFLICT (id) DO UPDATE SET id = DEFAULT RETURNING *
----
1
1

statement ok
DROP TABLE rid

# --- through an updatable view ---------------------------------------------------------------------

statement ok
CREATE TABLE rvt (id i32 PRIMARY KEY, v i32)

statement ok
CREATE VIEW rv AS SELECT id AS vid, v AS vv FROM rvt

statement ok
INSERT INTO rvt VALUES (1, 10)

query II nosort
INSERT INTO rv VALUES (1, 0) ON CONFLICT (vid) DO UPDATE SET vid = rv.vid + 40 RETURNING *
----
41
10

query II nosort
SELECT id, v FROM rvt
----
41
10

statement ok
DROP VIEW rv

statement ok
DROP TABLE rvt

# --- GIN and GiST index entries follow a re-keyed row ---------------------------------------------

statement ok
CREATE TABLE rgi (id i32 PRIMARY KEY, tags i32[], r int4range)

statement ok
CREATE INDEX rgi_tags ON rgi USING gin (tags)

statement ok
CREATE INDEX rgi_r ON rgi USING gist (r)

statement ok
INSERT INTO rgi VALUES (1, '{1,2}', '[1,5)'), (2, '{3}', '[10,20)')

statement ok
INSERT INTO rgi VALUES (1, '{}', 'empty') ON CONFLICT (id) DO UPDATE SET id = 7

query I nosort
SELECT id FROM rgi WHERE tags @> '{2}'::i32[]
----
7

query I nosort
SELECT id FROM rgi WHERE r && '[2,3)'::int4range
----
7

query I nosort
SELECT id FROM rgi ORDER BY id
----
2
7

statement ok
DROP TABLE rgi

# --- divergence: an end-state-valid key swap (upsert.md §9; oracle_overrides.toml) ----------------

statement ok
CREATE TABLE rs (id i32 PRIMARY KEY, v i32)

statement ok
INSERT INTO rs VALUES (2, 20), (101, 1010)

# Each row moves onto the other's key. jed validates the statement's end state, which is
# collision-free; PostgreSQL's first update collides with row 101 (23505). Last record: a
# PostgreSQL-failing write must not reach the oracle's replay of later records (conformance.md §5).
query II rowsort
INSERT INTO rs VALUES (2, 0), (101, 0) ON CONFLICT (id) DO UPDATE SET id = CASE WHEN rs.id = 2 THEN 101 ELSE 2 END RETURNING *
----
101
20
2
1010
