statement error 42P01
SELECT a.x FROM c JOIN (a JOIN b USING (id)) AS g ON c.id = g.id

# A name the join carries twice is ambiguous through the alias.
statement error 42702
SELECT g.id FROM (a JOIN b ON a.id = b.id) AS g

# The inner duplicate label is still an error inside the group.
statement error 42712
SELECT * FROM (a JOIN a ON true) AS g

# ============================================================================================
# Errors.
# ============================================================================================

# An unaliased group's inner labels collide with the enclosing FROM's labels.
statement error 42712
SELECT * FROM a JOIN (a JOIN b ON true) ON true

statement error 42712
SELECT * FROM (a JOIN b ON true) JOIN (c JOIN b ON true) ON true

# The group's ON sees only the group's relations.
statement error 42P01
SELECT * FROM c JOIN (a JOIN b ON a.id = c.id) ON true

statement error 42P01
SELECT * FROM c, (a JOIN b ON a.id = c.id)

# A parenthesized FROM item must be a subquery, a VALUES list, or a join.
statement error 42601
SELECT * FROM (a)

statement error 42601
SELECT * FROM (a, b)

statement error 42601
SELECT * FROM a JOIN (b) ON true

# LATERAL precedes only a subquery or a function call.
statement error 42601
SELECT * FROM c CROSS JOIN LATERAL (a JOIN b ON true)
