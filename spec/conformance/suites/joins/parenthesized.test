# ============================================================================================
# A group on the right of a join is its own join-tree node.
# ============================================================================================

# The inner INNER join must match as a whole: c rows 2 and 5 are NULL-extended.
# names: id, x, y
# cost: 64
query III rowsort
SELECT c.id, a.x, b.y FROM c LEFT JOIN (a JOIN b ON a.id = b.id) ON c.id = a.id
