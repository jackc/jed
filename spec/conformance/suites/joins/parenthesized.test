# Parenthesized-join FROM (spec/design/grammar.md §15): a FROM item `( table_ref join+ )`, with an
# optional alias. A leading `(` in FROM not followed by SELECT/VALUES/WITH begins one.
#
# UNALIASED, the group is one join-tree node whose inner relation labels stay visible: `a.x`, `b.*`
# resolve through it, and its inner labels take part in the FROM duplicate-label check (42712). At the
# start of a FROM list (or after a comma) the parentheses change nothing — `(a JOIN b ON p) JOIN c ON
# q` is the same left-deep chain — so the group splices into the chain. On the RIGHT of a join they
# change the join tree: `c LEFT JOIN (a JOIN b ON p) ON q` NULL-extends a c row unless the whole
# inner join matches, unlike the left-deep `c LEFT JOIN a ON q JOIN b ON p`. That group is planned as
# an inline derived body that emits its `*` columns (USING/NATURAL merges first) plus the hidden
# copies a merge superseded, so `b.id` still reads b's own column.
#
# ALIASED, `(a JOIN b ON p) AS g` is exactly the derived table `(SELECT * FROM a JOIN b ON p) AS g`:
# the inner labels are hidden (42P01), `g.*` is the join's `*`, `AS g(c1, …)` renames, and a column
# name the join carries twice is ambiguous through `g` (42702).
#
# The group's ON clauses see only the group's own relations (an outer sibling there is 42P01), and
# the group must contain a join (`FROM (a)` is 42601) and no comma. Rows verified against the live
# PostgreSQL 18 oracle.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_star, query.where_eq, query.comparison_order, query.order_by, query.order_by_keys, query.aggregates, query.group_by, query.join_inner, query.cross_join, query.comma_from, query.join_left, query.join_right, query.join_full, query.join_using, query.join_natural, query.table_alias, query.qualified_column, query.qualified_star, query.subquery_scalar, query.subquery_correlated, query.derived_table, query.lateral, query.join_parenthesized, types.i32, resource.cost_metering

statement ok
CREATE TABLE a (id i32 PRIMARY KEY, x i32)

statement ok
CREATE TABLE b (id i32 PRIMARY KEY, y i32)

statement ok
CREATE TABLE c (id i32 PRIMARY KEY, z i32)

statement ok
CREATE TABLE d (id i32 PRIMARY KEY, w i32)

statement ok
INSERT INTO a VALUES (1, 10), (2, 20), (3, 30)

statement ok
INSERT INTO b VALUES (1, 100), (3, 300), (4, 400)

statement ok
INSERT INTO c VALUES (1, 1000), (2, 2000), (3, 3000), (5, 5000)

statement ok
INSERT INTO d VALUES (1, 7), (2, 8)

