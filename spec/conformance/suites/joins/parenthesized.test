# The group's merged `id` and c.id are both visible: a bare `id` is ambiguous.
statement error 42702
SELECT id FROM c LEFT JOIN (a JOIN b USING (id)) ON c.id = a.id

# A USING between two unlabeled relations binds each side's own column.
# names: id
query I rowsort
SELECT * FROM (SELECT 1 AS id) JOIN (SELECT 2 AS id) USING (id)
----

# names: id, k
query II rowsort
SELECT * FROM (SELECT 1 AS k, 5 AS id) JOIN (SELECT 1 AS id) USING (id)
----

# names: id, k, q
query III rowsort
SELECT * FROM (SELECT 1 AS k, 5 AS id) AS l JOIN ((SELECT 5 AS id) AS r1 JOIN (SELECT 6 AS q) AS r2 ON true) USING (id)
----
5
1
6

