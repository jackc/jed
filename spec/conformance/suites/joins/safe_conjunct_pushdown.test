# Widened set-operation arms: an i32 arm under an i64 output takes the conjunct as written, and seeks
# its primary key with a value beyond its own range (finding nothing).
# cost: 5
query I nosort
SELECT s.id FROM (SELECT id FROM a UNION ALL SELECT id FROM n) s WHERE s.id = 5000000000
----
5000000000

# An i32 arm under a decimal output reads its column through CAST(… AS decimal).
# cost: 49
query D nosort
SELECT s.x FROM (SELECT k AS x FROM a UNION SELECT d FROM a WHERE d <> 1.5) s WHERE s.x >= 2 ORDER BY s.x
----
2
2.50
3

# Nested: the inner set operation is i32, the outer decimal; the conversion composes.
# cost: 61
query D nosort
SELECT s.x FROM ((SELECT k AS x FROM a UNION ALL SELECT w FROM b) UNION ALL SELECT d FROM a) s WHERE s.x = 2 ORDER BY s.x
----
2
2

# An f32 arm under an f64 output reads its column through CAST(… AS f64): 1.25 widens exactly.
# cost: 51
query R nosort
SELECT s.v FROM (SELECT v FROM r UNION ALL SELECT f FROM a) s WHERE s.v > 1 AND s.v <> 1.25 ORDER BY s.v
----
1.5
2
3.5
4

# cost: 55
query R nosort
SELECT s.v FROM (SELECT v FROM r UNION SELECT f FROM a) s WHERE s.v IS NULL OR s.v < 1 ORDER BY s.v
----
-1.25
0.5
NULL

# The planner classifies only explicitly non-trapping catalog cast pairs. An identity
# cast has no such row: neither its parameter nor column form moves into a scan.
# params: 2
# cost: 46
query II nosort
SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE a.id = CAST($1 AS i32) ORDER BY b.w
----
2
200

# params: 2
# cost: 46
query II nosort
SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE CAST(a.id AS i32) = $1 ORDER BY b.w
----
2
200

# The matching literal-cast form keeps the same residual cost.
# cost: 46
query II nosort
SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE a.id = CAST(2 AS i32) ORDER BY b.w
----
2
200

# An explicitly classified widening cast still pushes and charges on each base row.
# params: 2
# cost: 37
query II nosort
SELECT a.id, b.w FROM a JOIN b ON a.id = b.aid WHERE CAST(a.id AS i64) = $1 ORDER BY b.w
----
2
200
