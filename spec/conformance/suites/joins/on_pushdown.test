# Three relations. b is NULL-extended by the earlier LEFT JOIN, so the later INNER ON's `b.w IS NULL`
# cannot move to b: filtering b first would NULL-extend a(1) and a(2), which the ON would then accept.
# It stays in the second join's ON; `c.id > 21` moves to c.
# cost: 68
query III nosort
SELECT a.id, b.id, c.id FROM a LEFT JOIN b ON a.k = b.k JOIN c ON c.k = a.k AND b.w IS NULL AND c.id > 21 ORDER BY a.id, b.id, c.id
----
2
12
22
3
NULL
23

# a is never NULL-extended, so a conjunct on it in a later INNER ON moves to a.
# cost: 49
query III nosort
SELECT a.id, b.id, c.id FROM a LEFT JOIN b ON a.k = b.k JOIN c ON c.k = a.k AND a.v IS NOT NULL ORDER BY a.id, b.id, c.id
----
1
11
21
2
12
22
2
13
22

# A pushed ON conjunct is an access-path input for its relation: `b.id = 13` bounds b's PK.
# cost: 13
query II nosort
SELECT a.id, b.id FROM a JOIN b ON a.k = b.k AND b.id = 13 ORDER BY a.id, b.id
----
2
13

# The same holds on the NULL-extended side of a LEFT JOIN: b is read at its key 13 only.
# cost: 41
query II nosort
SELECT a.id, b.id FROM a LEFT JOIN b ON a.k = b.k AND b.id = 13 ORDER BY a.id, b.id
----
1
NULL
