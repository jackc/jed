# A comma-joined relation has no ON; a later INNER ON still pushes to its own inputs.
# cost: 41
query III nosort
SELECT a.id, b.id, c.id FROM a, b JOIN c ON c.k = b.k AND c.id < 23 WHERE a.k = b.k ORDER BY a.id, b.id, c.id
----
