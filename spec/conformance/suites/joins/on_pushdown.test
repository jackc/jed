# RIGHT: `a.v > 10` filters the NULL-extended (left) side and moves to a; `b.w > 0` filters the
# preserved side and stays in the ON. Every b row survives.
# cost: 50
query II rowsort
SELECT a.id, b.id FROM a RIGHT JOIN b ON a.k = b.k AND a.v > 10 AND b.w > 0
----
2
13
NULL
11
NULL
12
NULL
14
NULL
15

# FULL: both sides are preserved, so nothing moves.
# cost: 119
query II rowsort
SELECT a.id, b.id FROM a FULL JOIN b ON a.k = b.k AND a.v > 10 AND b.w > 4
