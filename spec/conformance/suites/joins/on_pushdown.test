# Arithmetic is not pushdown-safe: `b.w + 0 > 4` stays in the ON (same rows as the pushed form above,
# which cost 28). a 1 + 4; b 1 + 5; the 4-node ON over 4 x 5 pairs = 80; 4 produced. 5 + 6 + 80 + 4 = 95.
# cost: 95
query II nosort
SELECT a.id, b.id FROM a LEFT JOIN b ON a.k = b.k AND b.w + 0 > 4 ORDER BY a.id, b.id
