NULL

# LEFT with a conjunct on the PRESERVED side: `a.v >= 20` stays in the ON. a(1) and a(3) fail it and
# are NULL-extended rather than removed.
# cost: 76
query II nosort
SELECT a.id, b.id FROM a LEFT JOIN b ON a.k = b.k AND a.v >= 20 ORDER BY a.id, b.id
