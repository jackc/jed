# A view over such a join re-plans it from its stored text.
statement ok
CREATE VIEW lv AS SELECT a.id AS aid, b.id AS bid, s.v FROM a JOIN (b JOIN LATERAL (SELECT a.x + b.y AS v) s ON true) ON true

# names: aid, bid, v
query III nosort
SELECT * FROM lv WHERE bid = 2 ORDER BY 1
----
1
2
210
2
2
220
3
2
230

statement ok
DROP VIEW lv

# A group whose LATERAL item references only an ENCLOSING query is not correlated to its left, so a
# RIGHT JOIN to it is allowed.
# names: n
query I nosort
SELECT (SELECT count(*) FROM a RIGHT JOIN (b JOIN LATERAL (SELECT t.id AS v) s ON true) ON true) AS n FROM c AS t ORDER BY 1
----
6
6

# A group whose LATERAL item correlates only within the group is allowed under a RIGHT JOIN.
# names: id, id, v
query III nosort
SELECT a.id, b.id, s.v FROM a RIGHT JOIN (b JOIN LATERAL (SELECT b.y AS v) s ON true) ON a.id = b.id ORDER BY 2
----
1
1
100
2
2
200

# ============================================================================================
# Error surface.
# ============================================================================================

# The group's ON clause sees only the group's own relations.
statement error 42P01
SELECT 1 FROM a JOIN (b JOIN c ON c.id = a.id) ON true

# ... including from a subquery inside it.
statement error 42P01
SELECT 1 FROM a JOIN (b JOIN c ON EXISTS (SELECT 1 WHERE a.id = 1)) ON true

# A non-LATERAL derived table inside the group does not see the left relation.
statement error 42P01
SELECT 1 FROM a JOIN (b JOIN (SELECT a.x) s ON true) ON true

# ... nor does a LATERAL item nested in such a derived table.
statement error 42P01
SELECT 1 FROM a JOIN (b JOIN (SELECT * FROM c CROSS JOIN LATERAL (SELECT a.x) l) d ON true) ON true

# The relations to the group's left share one FROM namespace with the group's own: a bare column
# both have is ambiguous, not shadowed by the group's relation (PostgreSQL).
statement error 42702
SELECT 1 FROM a JOIN (b JOIN LATERAL (SELECT id) s ON true) ON true

statement error 42702
SELECT 1 FROM c, (b JOIN LATERAL (SELECT id AS q) s ON true)

# ... and the outer relation comes first: on the left side of a RIGHT JOIN it is refused.
statement error 42P10
SELECT 1 FROM a RIGHT JOIN (b JOIN LATERAL (SELECT id) s ON true) ON true

# A relation to the group's RIGHT is not visible.
statement error 42P01
SELECT 1 FROM a JOIN (b JOIN LATERAL (SELECT c.z) s ON true) ON true JOIN c ON true

# The right side of a RIGHT or FULL join may not reference its left side.
statement error 42P10
SELECT a.id FROM a RIGHT JOIN (b JOIN LATERAL (SELECT a.x AS v) s ON true) ON true

statement error 42P10
SELECT a.id FROM a FULL JOIN (b JOIN LATERAL (SELECT a.x AS v) s ON true) ON true

statement error 42P10
SELECT a.id FROM a RIGHT JOIN (b CROSS JOIN generate_series(1, a.id) g) ON true

statement error 42P10
SELECT 1 FROM a JOIN (b RIGHT JOIN LATERAL (SELECT b.y AS v) s ON true) ON true

# The right side of a RIGHT or FULL join may reference a relation outside that join. Here the RIGHT
# JOIN is inside the group and its lateral item references a, to the group's left: s is evaluated once
# per evaluation of the group, which is re-evaluated once per a row.
# cost: 34
query III nosort
SELECT a.id, b.id, s.v FROM a JOIN (b RIGHT JOIN LATERAL (SELECT a.x AS v) s ON b.y = s.v * 10) ON true ORDER BY 1, 2
----
1
1
10
2
2
20
3
