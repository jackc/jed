# The group's ON may filter on the lateral item's output; the outer ON on the inner labels.
# names: id, id, v
query III nosort
SELECT a.id, b.id, s.v FROM a JOIN (b JOIN LATERAL (SELECT a.x + b.y AS v) s ON s.v > 150) ON b.id < a.id ORDER BY 1, 2
----
