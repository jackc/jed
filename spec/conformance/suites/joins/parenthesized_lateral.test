# A RIGHT JOIN to a lateral item that references the left side of the RIGHT JOIN in an enclosing
# group is refused, even through an INNER join inside the group.
statement error 42P10
SELECT 1 FROM a RIGHT JOIN (b JOIN (c JOIN LATERAL (SELECT a.x) s ON true) ON true) ON true
