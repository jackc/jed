# LATERAL inside a parenthesized join (spec/design/grammar.md §15/§44). PostgreSQL plans a
# parenthesized join in its enclosing FROM's namespace, so a LATERAL item (or a table function) inside
# it sees the relations to the join's LEFT — including through an alias, which hides the inner labels
# from the enclosing query but not the outer labels from the join. The join's ON clauses and its
# non-LATERAL items still see only the join's own relations (42P01), and a reference from the right
# side of a RIGHT/FULL join to its left side is 42P10. jed plans such a join's body against a lateral
# fence and, when the body reaches a left relation, makes the whole join a correlated lateral relation:
# it is re-evaluated once per combined left-hand row. Rows verified against the live PostgreSQL 18
# oracle.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_star, query.order_by, query.order_by_keys, query.aggregates, query.join_inner, query.cross_join, query.comma_from, query.join_left, query.join_right, query.join_full, query.table_alias, query.qualified_column, query.subquery_scalar, query.subquery_correlated, query.derived_table, query.lateral, query.set_returning, query.join_parenthesized, types.i32, resource.cost_metering

statement ok
CREATE TABLE a (id i32 PRIMARY KEY, x i32)

statement ok
CREATE TABLE b (id i32 PRIMARY KEY, y i32)

statement ok
CREATE TABLE c (id i32 PRIMARY KEY, z i32)

statement ok
INSERT INTO a VALUES (1, 10), (2, 20), (3, 30)

statement ok
INSERT INTO b VALUES (1, 100), (2, 200)

statement ok
INSERT INTO c VALUES (1, 5), (3, 6)

# ============================================================================================
# A LATERAL item inside a right-hand group sees the relations to the group's left.
# ============================================================================================

# The group is re-evaluated once per a row: each evaluation scans b and runs s once per b row.
# names: id, id, v
# cost: 37
query III nosort
SELECT a.id, b.id, s.v FROM a JOIN (b JOIN LATERAL (SELECT a.x + b.y AS v) s ON true) ON true ORDER BY 1, 2
----
1
1
110
1
2
210
2
1
120
2
2
220
3
1
130
3
2
230

# A bare column reaches the left relation too.
