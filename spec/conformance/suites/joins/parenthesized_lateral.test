# LEFT JOIN to the group: a left row the whole group cannot extend is NULL-extended.
# names: id, id, v
# cost: 26
query III nosort
SELECT a.id, b.id, s.v FROM a LEFT JOIN (b JOIN LATERAL (SELECT a.x AS v WHERE a.id = b.id) s ON true) ON true ORDER BY 1, 2
