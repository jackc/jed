# A PROMOTED key source: an index-nested-loop inner or a correlated subquery bounds a key by a
# column of the other numeric family — an integer column against a decimal key, or a decimal column
# against an integer key (the comparison widens int → decimal, compare.toml). The source value is
# converted to the key's type before it is encoded, exactly as a promoted `= ANY` element is
# (spec/design/cost.md §3 "Bounded scan / index-nested-loop"): an integer is the equal decimal (the
# decimal key encodes the value, not its scale, so 3 finds a stored 3.0); a decimal is that integer
# when it is integral and in the key's range, and otherwise equals no key — an empty equality, or a
# dropped half-bound for a range comparison (the full ON / WHERE is always the residual filter).
# Rows are PostgreSQL's (oracle-checked); the costs pin the identical plan and metered work.
# requires: ddl.create_table, ddl.primary_key, ddl.secondary_index, dml.insert, dml.insert_multi_row, query.select, query.where_eq, query.comparison_order, query.order_by, query.qualified_column, query.join_inner, query.index_nested_loop, query.join_pushdown, query.point_lookup, query.subquery_scalar, query.subquery_exists, query.subquery_correlated, query.correlated_pushdown, query.aggregates, types.i32, types.i64, types.decimal, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, n i32, d decimal, big i64)

statement ok
INSERT INTO t VALUES (1, 1, 1.5, 1), (2, 2, 2.0, 2), (3, 3, 3, 3), (4, 4, 4.25, 4)

statement ok
CREATE TABLE u (id i32 PRIMARY KEY, n i32, d decimal)

statement ok
INSERT INTO u VALUES (1, 1, 1.0), (2, 3, 3), (3, 4, 4.0), (4, 9, 9)

statement ok
CREATE INDEX u_n ON u (n)

statement ok
CREATE INDEX u_d ON u (d)

# --- decimal source, integer key ------------------------------------------------------------------

# t.d = 2.0 and 3 find u.id 2 and 3; 1.5 and 4.25 equal no integer key.
# cost: 13
query II rowsort
SELECT t.id, u.id FROM t JOIN u ON u.id = t.d
----
2
2
3
3

# cost: 11
query II rowsort
SELECT t.id, u.id FROM t JOIN u ON u.n = t.d
----
3
2

# A fractional range endpoint drops that half-bound; the residual keeps the answer exact.
# cost: 32
query II rowsort
SELECT t.id, u.id FROM t JOIN u ON u.n < t.d
----
1
1
2
1
3
1
4
1
4
2
4
3

# --- integer source, decimal key ------------------------------------------------------------------

# cost: 21
query II rowsort
SELECT t.id, u.id FROM t JOIN u ON u.d = t.n
----
1
1
3
2
4
3

# cost: 21
query II rowsort
SELECT t.id, u.id FROM t JOIN u ON u.d = t.big
----
1
1
3
2
4
3

# cost: 35
query II rowsort
SELECT t.id, u.id FROM t JOIN u ON u.d > t.n
----
1
2
1
3
1
4
2
2
2
3
2
4
3
3
3
4
4
4

# --- integer source of another width (no conversion needed) --------------------------------------

# cost: 21
query II rowsort
SELECT t.id, u.id FROM t JOIN u ON u.n = t.big
----
1
1
3
2
4
3

# --- correlated subqueries ------------------------------------------------------------------------

# cost: 19
query I nosort
SELECT id FROM t WHERE EXISTS (SELECT 1 FROM u WHERE u.id = t.d) ORDER BY id
----
2
3

# cost: 28
query I nosort
SELECT id FROM t WHERE EXISTS (SELECT 1 FROM u WHERE u.d = t.n) ORDER BY id
----
1
3
4

# cost: 57
query I nosort
SELECT id FROM t WHERE EXISTS (SELECT 1 FROM u WHERE u.n <= t.d) ORDER BY id
----
1
2
3
4

# cost: 27
query I nosort
SELECT id FROM t WHERE (SELECT count(*) FROM u WHERE u.id = t.d) > 0 ORDER BY id
----
2
3

# --- constant sources, for contrast -------------------------------------------------------------

# cost: 14
query I nosort
SELECT id FROM u WHERE d = 3::i64 ORDER BY id
----
2

# cost: 10
query I nosort
SELECT id FROM u WHERE n = 3.0 ORDER BY id
----
2

# cost: 11
query I nosort
SELECT id FROM u WHERE n < 3.5 ORDER BY id
----
1
2

# cost: 21
query I nosort
SELECT id FROM u WHERE id = ANY(ARRAY[2.0, 3.5]) ORDER BY id
----
2
