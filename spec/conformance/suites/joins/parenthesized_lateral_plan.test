# The RIGHT JOIN inside the group: s reads a, outside that join, so it is materialized once per group
# evaluation (once per a row), not once per b row.
query ITTIIII nosort
EXPLAIN ANALYZE SELECT a.id, b.id, s.v FROM a JOIN (b RIGHT JOIN LATERAL (SELECT a.x AS v) s ON b.y = s.v * 10) ON true
