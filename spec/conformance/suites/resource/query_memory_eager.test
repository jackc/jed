# Query-memory admission on the eager blocking lane (memory.md §5). On a file-backed database
# aggregates, DISTINCT, and multi-way joins take the bounded-spill lane, whose spools are operator
# state (Q2) bounded by work_mem instead — so these exact thresholds hold only in memory mode.
# skip: disk — blocking operators take the bounded-spill lane on file-backed databases, and a
# transaction cannot span the disk-mode per-record reopen
# requires: txn.explicit, txn.failed_state, query.select, ddl.create_table, dml.insert, dml.insert_multi_row, dml.insert_select, types.text, query.comma_from, query.set_returning, query.distinct, query.aggregates, query.aggregate_distinct, query.group_by, query.having, query.order_by, query.limit, resource.query_memory

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, v text, pad text)

statement ok
INSERT INTO t VALUES (1, 'a', 'xxxxxxxxxx'), (2, 'bb', 'yyyyyyyyyy'), (3, NULL, 'zzzzzzzzzz')

statement ok
CREATE TABLE u (k i32 PRIMARY KEY, w text)

statement ok
INSERT INTO u VALUES (1, 'p'), (2, 'qq')

statement ok
CREATE TABLE n (id i32 PRIMARY KEY)

statement ok
INSERT INTO n SELECT g FROM generate_series(1, 6) g

# DISTINCT keeps the first-occurrence projected rows (195) beside the post-WHERE relation (387).
# max_query_memory_bytes: 582
query T rowsort
SELECT DISTINCT v FROM t
----
NULL
a
bb

# max_query_memory_bytes: 581
statement error 54P05
SELECT DISTINCT v FROM t

# max_query_memory_bytes: 582
query T nosort
SELECT DISTINCT v FROM t ORDER BY v LIMIT 1
----
a

# max_query_memory_bytes: 581
statement error 54P05
SELECT DISTINCT v FROM t ORDER BY v LIMIT 1

# Group rows (291) are admitted before the aggregate input (387) is released.
# max_query_memory_bytes: 678
query TI rowsort
SELECT v, count(*) FROM t GROUP BY v
----
NULL
1
a
1
bb
1

# max_query_memory_bytes: 677
statement error 54P05
SELECT v, count(*) FROM t GROUP BY v

# The HAVING aggregate is a third group-row slot: 129 + 130 + 128.
# max_query_memory_bytes: 774
query TI nosort
SELECT v, count(*) FROM t GROUP BY v HAVING count(*) > 0 ORDER BY v
----
a
1
bb
1
NULL
1

# max_query_memory_bytes: 773
statement error 54P05
SELECT v, count(*) FROM t GROUP BY v HAVING count(*) > 0 ORDER BY v

# max_query_memory_bytes: 451
query I nosort
SELECT count(DISTINCT v) FROM t
----
2

