# A vectorized group table's entries are released after its last group is finalized.
# max_query_memory_bytes: 192
query II rowsort
SELECT g, sum(id) FROM n GROUP BY g
----
0
12
1
9

# max_query_memory_bytes: 191
statement error 54P05
