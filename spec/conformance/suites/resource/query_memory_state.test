# Live query-memory admission over operator state (memory.md §6, Q2): hash-join tables, group,
# DISTINCT, set-operation and recursive-CTE dedup tables, retained aggregate inputs, window partition
# tables, sort state, and columnar lanes — charged beside the Q1 row buffers of the same statement. A
# jed-specific resource contract, not a PostgreSQL limit. Each budget is the exact peak of logical
# bytes the statement holds (ENTRY 32 per table entry, memory.md §6.1); the record below it at
# budget - 1 fails 54P05. On a file-backed database aggregates, DISTINCT, and joins take the
# bounded-spill lane, whose spill structures charge their resident elements instead (§6.6) — those
# thresholds are cross-checked between cores by `rake conformance:query_memory`, so this file pins
# the in-memory lanes only.
# skip: disk — blocking operators take the bounded-spill lane on file-backed databases
# requires: query.select, ddl.create_table, dml.insert, dml.insert_multi_row, dml.insert_select, types.text, types.json, types.jsonb, func.json_agg, query.join_inner, query.hash_join, query.aggregates, query.group_by, query.ordered_set_aggregate, query.hypothetical_set_aggregate, query.window, query.window_aggregate, query.intersect, query.except, query.cte, query.cte_recursive, query.order_by, query.limit, query.order_by_topk, query.distinct, query.set_returning, resource.query_memory

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, v text, pad text)

statement ok
INSERT INTO t VALUES (1, 'a', 'xxxxxxxxxx'), (2, 'bb', 'yyyyyyyyyy'), (3, NULL, 'zzzzzzzzzz')

statement ok
CREATE TABLE u (k i32 PRIMARY KEY, w text)

statement ok
INSERT INTO u VALUES (1, 'a'), (2, 'qq'), (3, 'a')

statement ok
CREATE TABLE n (id i32 PRIMARY KEY, g i32)

statement ok
INSERT INTO n SELECT x, x % 2 FROM generate_series(1, 6) x

statement ok
CREATE TABLE h (id i32 PRIMARY KEY, g i32)

statement ok
INSERT INTO h SELECT x, x % 4 FROM generate_series(1, 40) x

# Hash join: the build side's table holds an entry per build row (ENTRY + key: 40 × 64) while the
# step's 400 combined rows are built (memory.md §6.2).
# max_query_memory_bytes: 74240
query I nosort
SELECT count(*) FROM h a JOIN h b ON b.g = a.g
----
400

# max_query_memory_bytes: 74239
statement error 54P05
SELECT count(*) FROM h a JOIN h b ON b.g = a.g

# A group table entry per group plus json_agg's retained inputs (memory.md §6.2/§6.3); each group's
# state is released as its row is admitted.
# max_query_memory_bytes: 687
query TT rowsort
SELECT v, json_agg(id) FROM t GROUP BY v
----
NULL
[3]
a
[1]
bb
[2]

# max_query_memory_bytes: 686
statement error 54P05
SELECT v, json_agg(id) FROM t GROUP BY v

# jsonb_object_agg retains each (key, value) pair.
# max_query_memory_bytes: 422
query T nosort
SELECT jsonb_object_agg(v, id) FROM t WHERE v IS NOT NULL
----
{"a": 1, "bb": 2}

# max_query_memory_bytes: 421
statement error 54P05
SELECT jsonb_object_agg(v, id) FROM t WHERE v IS NOT NULL

# Ordered-set aggregates retain each non-NULL input.
# max_query_memory_bytes: 424
query T nosort
SELECT mode() WITHIN GROUP (ORDER BY w) FROM u
----
a

# max_query_memory_bytes: 423
statement error 54P05
SELECT mode() WITHIN GROUP (ORDER BY w) FROM u

# max_query_memory_bytes: 800
query I nosort
SELECT percentile_disc(0.5) WITHIN GROUP (ORDER BY id) FROM n
----
3

# max_query_memory_bytes: 799
statement error 54P05
SELECT percentile_disc(0.5) WITHIN GROUP (ORDER BY id) FROM n

# A hypothetical-set aggregate retains each WITHIN GROUP key tuple (row_bytes).
# max_query_memory_bytes: 992
query I nosort
SELECT rank(3) WITHIN GROUP (ORDER BY id) FROM n
----
3

# max_query_memory_bytes: 991
statement error 54P05
SELECT rank(3) WITHIN GROUP (ORDER BY id) FROM n

# A window aggregate's running accumulator retains its inputs until the partition's pass ends.
# max_query_memory_bytes: 548
query IT nosort
SELECT id, json_agg(v) OVER (ORDER BY id) FROM t ORDER BY id
----
1
["a"]
2
["a", "bb"]
3
["a", "bb", null]

# max_query_memory_bytes: 547
statement error 54P05
SELECT id, json_agg(v) OVER (ORDER BY id) FROM t ORDER BY id

# A window partition table: one entry per partition (ENTRY + key).
# max_query_memory_bytes: 896
query II rowsort
SELECT id, count(*) OVER (PARTITION BY g) FROM n
----
1
3
2
3
3
3
4
3
5
3
6
3

# max_query_memory_bytes: 895
statement error 54P05
SELECT id, count(*) OVER (PARTITION BY g) FROM n

# Set operations: INTERSECT ALL counts the distinct right-arm rows; EXCEPT also dedups what it keeps.
# max_query_memory_bytes: 778
query T rowsort
SELECT w FROM u INTERSECT ALL SELECT v FROM t
----
a

# max_query_memory_bytes: 777
statement error 54P05
SELECT w FROM u INTERSECT ALL SELECT v FROM t

# max_query_memory_bytes: 778
query T rowsort
SELECT w FROM u EXCEPT SELECT v FROM t
----
qq

# max_query_memory_bytes: 777
statement error 54P05
SELECT w FROM u EXCEPT SELECT v FROM t

# A recursive CTE's UNION dedup set: an entry per kept row, released when the CTE completes.
# max_query_memory_bytes: 576
query I rowsort
WITH RECURSIVE r(x) AS (SELECT 1 UNION SELECT x % 3 + 1 FROM r) SELECT x FROM r
----
1
2
3

# max_query_memory_bytes: 575
statement error 54P05
WITH RECURSIVE r(x) AS (SELECT 1 UNION SELECT x % 3 + 1 FROM r) SELECT x FROM r

# The single-table sort lane holds its survivors as sort state (untouched slots NULL) until the
# emission completes (memory.md §6.4).
# max_query_memory_bytes: 387
query IT nosort
SELECT id, v FROM t ORDER BY v
----
1
a
2
bb
3
NULL

# max_query_memory_bytes: 386
statement error 54P05
SELECT id, v FROM t ORDER BY v

# A top-k heap holds only the rows it retains.
# max_query_memory_bytes: 129
query IT nosort
SELECT id, v FROM t ORDER BY v LIMIT 1
----
1
a

# max_query_memory_bytes: 128
statement error 54P05
SELECT id, v FROM t ORDER BY v LIMIT 1

# A streaming DISTINCT scan's dedup set: an entry per first occurrence, released when the scan ends.
# max_query_memory_bytes: 554
query T rowsort
SELECT DISTINCT w FROM u LIMIT 5
----
a
qq

# max_query_memory_bytes: 553
statement error 54P05
SELECT DISTINCT w FROM u LIMIT 5

