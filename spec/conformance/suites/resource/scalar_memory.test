# CTEs, set operations and scalar subqueries share one allocation allowance.
# max_scalar_bytes: 5
statement error 54P04
SELECT repeat('a', 3) UNION ALL SELECT repeat('b', 3)

# max_scalar_bytes: 5
statement error 54P04
SELECT repeat('a', 3), (SELECT repeat('b', 3))

# max_scalar_bytes: 5
statement error 54P04
WITH a AS MATERIALIZED (SELECT repeat('a', 3) AS v) SELECT repeat(v, 1) FROM a

# Unselected branches perform no allocation.
# max_scalar_bytes: 1
query T nosort
SELECT CASE WHEN true THEN 'ok' ELSE repeat('x', 1073741823) END
----
ok

# Shared budget also applies to legacy unreported expression-index maintenance.
statement ok
CREATE TABLE scalar_index (v text)

statement ok
CREATE INDEX scalar_idx ON scalar_index ((repeat(v, 3)))

# max_scalar_bytes: 5
statement error 54P04
INSERT INTO scalar_index VALUES ('a'), ('b')

query I nosort
SELECT count(*) FROM scalar_index
----
0
