# Scalar pre-allocation admission. This is a jed-specific resource contract, not a PG limit.
# requires: query.select, query.select_no_from, types.text, types.decimal, resource.cost_metering, resource.cost_limit, resource.scalar_memory, ddl.create_table, ddl.secondary_index, ddl.index_expr, dml.insert, dml.insert_multi_row, dml.update, query.union, query.cte, query.subquery_scalar, query.aggregates, expr.case, expr.numeric_transcendental, cast.operator, cast.explicit

# Exact UTF-8 bytes; budget equality is allowed, unlike a cost ceiling.
# max_scalar_bytes: 6
# cost: 10
query T nosort
SELECT repeat('ab', 3)
----
ababab

# max_scalar_bytes: 5
statement error 54P04
SELECT repeat('ab', 3)

# max_scalar_bytes: 5
statement error 54P04
SELECT repeat('é', 3)

# max_scalar_bytes: 11
# cost: 20
query T nosort
SELECT lpad('é', 4, '🙂x')
----
🙂x🙂é

# max_scalar_bytes: 10
statement error 54P04
SELECT rpad('é', 4, '🙂x')

# Actual result, not requested length; truncated source and empty fill.
# max_scalar_bytes: 1
# cost: 6
query T nosort
SELECT rpad('ab', 1, 'x')
----
a

# max_scalar_bytes: 2
# cost: 6
query T nosort
SELECT lpad('ab', 100, '')
----
ab

# Allocation budget is cumulative through nested calls.
# max_scalar_bytes: 14
statement error 54P04
SELECT repeat(repeat('x', 3), 4)

# max_scalar_bytes: 15
# cost: 22
query T nosort
SELECT repeat(repeat('x', 3), 4)
----
xxxxxxxxxxxx

# Also cumulative across sibling calls.
# max_scalar_bytes: 5
statement error 54P04
SELECT repeat('a', 3), repeat('b', 3)

# Cost admission precedes the allocation budget and output construction.
# max_cost: 100
statement error 54P01
SELECT repeat('x', 1073741823)

# The finite default catches the same request on a cost-unlimited handle.
statement error 54P04
SELECT repeat('x', 1073741823)

# Unicode output can exceed the structural byte cap below the character cap.
statement error 54000
SELECT lpad('x', 300000000, '🙂')

statement error 54000
SELECT repeat('xy', 2000000000)

# Non-positive/empty requests do no byte work. NULL never calls the kernel.
# max_scalar_bytes: 1
query BBT nosort
SELECT repeat('', 2000000000) = '', lpad('abc', 0, '🙂') = '', repeat(NULL::text, 2000000000)
----
true
true
NULL

# Decimal work can exhaust either independent gate before a big computation.
# max_cost: 100
statement error 54P01
SELECT exp(1000.0)

# max_scalar_bytes: 1
statement error 54P04
SELECT sqrt(4.0)

# Statement failure is atomic, including failure after an earlier row allocated.
statement ok
CREATE TABLE scalar_budget (v text)

statement ok
INSERT INTO scalar_budget VALUES ('a'), ('b')

# max_scalar_bytes: 5
statement error 54P04
UPDATE scalar_budget SET v = repeat(v, 3)

query T rowsort
SELECT v FROM scalar_budget
----
a
b

# A failed statement and the per-record setting do not leak into the next statement.
query T nosort
SELECT repeat('z', 3)
----
zzz

