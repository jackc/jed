# Pending writes (memory.md §7, Q3): every record version a transaction stages into a table or index
# reserves its stored bytes — the on-disk record plus any out-of-line payload — against the session's
# query-memory budget until the transaction commits or rolls back. The measure is net: a write that
# replaces or deletes a version the transaction staged under a budget returns that version's bytes.
# A write made with no budget is counted but not remembered, so the netting writes below run under a
# huge but active one. Each statement opens its account holding the pending bytes, takes on its own
# staged bytes after each write phase, and after each statement the pending bytes alone must fit the
# budget. A jed-specific resource contract, not a PostgreSQL limit. Here a t row stores 21 bytes with a 10-byte text value and 31 bytes
# with a 20-byte one.
# skip: disk — a transaction and the attached in-memory database cannot span the disk-mode
# per-record reopen
# attach: aux
# requires: harness.attach, attach.in_memory, query.qualified_table, txn.explicit, txn.savepoint, txn.failed_state, query.select, ddl.create_table, ddl.secondary_index, dml.insert, dml.insert_select, dml.update, dml.delete, query.aggregates, query.set_returning, types.text, types.json, func.json_agg, resource.query_memory

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, v text)

statement ok
CREATE TABLE a (id i32 PRIMARY KEY, j json)

statement ok
BEGIN

# max_query_memory_bytes: 1099511627776
statement ok
INSERT INTO t VALUES (1, 'aaaaaaaaaa')

# max_query_memory_bytes: 1099511627776
statement ok
INSERT INTO t VALUES (2, 'bbbbbbbbbbbbbbbbbbbb')

# The block holds 21 + 31 pending bytes, so SELECT 1's virtual row (32) fits only beside them.
# max_query_memory_bytes: 84
query I nosort
SELECT 1
----
1

# Rewriting a row the block staged replaces that version: the pending bytes are net, so a same-size
# rewrite leaves them at 52.
# max_query_memory_bytes: 1099511627776
statement ok
UPDATE t SET v = 'cccccccccc' WHERE id = 1

# max_query_memory_bytes: 84
query I nosort
SELECT 1
----
1

# max_query_memory_bytes: 83
statement error 54P05
SELECT 1

statement ok
ROLLBACK

