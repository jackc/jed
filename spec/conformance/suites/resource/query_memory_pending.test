# max_query_memory_bytes: 1099511627776
statement ok
INSERT INTO t VALUES (2, 'bbbbbbbbbbbbbbbbbbbb')

# max_query_memory_bytes: 1099511627776
statement ok
UPDATE t SET v = 'dddddddddddddddddddd' WHERE id = 1

# max_query_memory_bytes: 94
query I nosort
SELECT 1
----
1

# max_query_memory_bytes: 93
statement error 54P05
SELECT 1

statement ok
ROLLBACK

