# INSERT ... SELECT keeps its source rows charged until the statement ends (memory.md §5.3), and they
# are still held when its 52 staged bytes join the account: the statement needs both.
# max_query_memory_bytes: 443
statement error 54P05
INSERT INTO t SELECT id + 10, v FROM t WHERE id <= 2

# max_query_memory_bytes: 444
statement ok
INSERT INTO t SELECT id + 10, v FROM t WHERE id <= 2

statement ok
DELETE FROM t WHERE id > 10

