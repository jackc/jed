# A savepoint shares the versions staged before it, so rewriting or deleting one of them after the
# savepoint returns nothing: the frame still holds it. Versions staged after the newest savepoint
# stay net, and ROLLBACK TO restores the balance the savepoint saw (transactions.md §11).
statement ok
BEGIN

# max_query_memory_bytes: 1099511627776
statement ok
INSERT INTO t VALUES (21, 'aaaaaaaaaa')

statement ok
SAVEPOINT s

# Row 21's 21-byte version stays held by the frame: 21 + 31.
# max_query_memory_bytes: 1099511627776
statement ok
UPDATE t SET v = 'bbbbbbbbbbbbbbbbbbbb' WHERE id = 21

# max_query_memory_bytes: 1099511627776
statement ok
INSERT INTO t VALUES (22, 'cccccccccc')

# Row 22 was staged after the savepoint, so its rewrite is net: 21 + 31 + 21.
# max_query_memory_bytes: 1099511627776
statement ok
