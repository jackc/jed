# View nesting counts toward the parser's nesting-depth limit (spec/design/views.md §4.1,
# spec/design/cost.md §7). A view body is parsed once, on its own, but every use plans it inside the
# referencing statement, so the planner recurses through the whole chain of views. A statement is
# accepted exactly when it would parse with every view reference replaced by its parenthesized
# body: each view reference adds its body's nesting depth to the depth at which the reference is
# written, and past MAX_EXPR_DEPTH = 256 the statement is 54001 (statement_too_complex). Before
# this, each body counted from zero, and a chain of views with deeply nested bodies overflowed the
# native stack while planning.
#
# A query with n nested derived tables over t reaches depth n + 1 (the innermost select item is one
# level more), so `SELECT a FROM (…255 levels…)` is the deepest accepted textual form. Each view below
# is 50 nested derived tables over the previous view; its reference costs one more level for the
# view's own parentheses, so five views reach 5 × 51 + 1 = 256.
#
# jed-specific (PostgreSQL bounds this only by its runtime stack probe), so cross-core-checked, not
# oracle-checked.
# requires: ddl.view, ddl.create_table, ddl.primary_key, dml.insert, query.select, query.where_eq, query.aggregates, query.cross_join, query.subquery_scalar, query.subquery_in, query.derived_table, types.i32, resource.depth_limit, resource.view_depth_limit

statement ok
CREATE TABLE t (a i32 PRIMARY KEY)

statement ok
INSERT INTO t VALUES (1)

