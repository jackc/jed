# Cost wins: a rejected reservation consults the statement's cost guard, so a step that has
# already reached max_cost fails 54P01 rather than 54P05 — even where the charge itself is
# unguarded (EXPLAIN's per-row charge) or the generator admits right after charging its row. A
# budget that is never exceeded adds no guard: EXPLAIN's unguarded charge still completes.
# max_query_memory_bytes: 1
statement error 54P05
EXPLAIN SELECT 1

# max_cost: 1
# max_query_memory_bytes: 1
statement error 54P01
EXPLAIN SELECT 1

