# expressions: what keeps a typmod and what does not
statement ok
CREATE TABLE c2 AS SELECT 1 AS lit, 1.5 AS dec, NULL AS n, 'abc' AS s, price + 1 AS p1, price::decimal(5,1) AS pc, name::varchar(3) AS n3, price::decimal AS pd, coalesce(price, price) AS co, coalesce(price, 0) AS co0, (SELECT name FROM src WHERE id = 1) AS sq, (p).label AS pl, (p).x AS px, ARRAY[name] AS an, count(*) OVER () AS cnt, min(price) OVER () AS mn FROM src

query IT nosort
SELECT ordinal, type FROM jed_columns WHERE table_name = 'c2' ORDER BY ordinal
