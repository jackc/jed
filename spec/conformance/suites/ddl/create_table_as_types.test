c8
column2
text

# a USING join's merged column keeps its column's typmod
statement ok
CREATE TABLE c9 AS SELECT price, a.id, b.name FROM src a LEFT JOIN src b USING (price)

query TT nosort
SELECT name, type FROM jed_columns WHERE table_name = 'c9' ORDER BY ordinal
----
price
decimal(10,2)
id
i32
name
varchar(5)

# the column list renames; WITH NO DATA creates the same columns
statement ok
CREATE TABLE c10 (a, b) AS SELECT price, name, note FROM src WITH NO DATA

query TT nosort
SELECT name, type FROM jed_columns WHERE table_name = 'c10' ORDER BY ordinal
----
a
decimal(10,2)
b
varchar(5)
note
text

query I nosort
SELECT count(*) FROM c10
----
0
