# `(c).*` keeps each field's typmod
statement ok
CREATE TABLE c3 AS SELECT (p).* FROM src

query TT nosort
SELECT name, type FROM jed_columns WHERE table_name = 'c3' ORDER BY ordinal
----
label
varchar(4)
x
decimal(6,2)

# a set operation and VALUES keep the typmod their inputs agree on
statement ok
CREATE TABLE c4 AS SELECT price, name FROM src UNION ALL SELECT price, name FROM src

statement ok
CREATE TABLE c5 AS SELECT price, name FROM src UNION SELECT 1.5, 'abc'

statement ok
CREATE TABLE c6 AS SELECT price FROM src INTERSECT SELECT 1.5

statement ok
CREATE TABLE c7 AS SELECT price FROM src EXCEPT SELECT price FROM src WHERE id = 2

statement ok
CREATE TABLE c8 AS VALUES (1.5::decimal(4,1), 'a'::varchar(2)), (2.5::decimal(4,1), NULL)

query TTT nosort
SELECT table_name, name, type FROM jed_columns WHERE table_name IN ('c4', 'c5', 'c6', 'c7', 'c8') ORDER BY table_name, ordinal
----
