# The column types CREATE TABLE … AS creates (spec/design/create-table-as.md §2), read back through
# jed_columns: each column is the query output's type with the typmod the output keeps (PostgreSQL's
# exprTypmod), nullable, keyless, with no default. Two recorded divergences show here: a bare integer
# literal in a select list is i64 (types.md §6), where PostgreSQL makes an integer column, and an
# array keeps no element typmod (ARRAY[name] over a varchar(5) is text[]; array typmods are deferred,
# array.md §12). PostgreSQL's planner also reports the left input's typmod for a filled INTERSECT or
# EXCEPT column where the operands disagree; jed uses the operands' common typmod, PostgreSQL's own
# WITH NO DATA answer. jed_columns is jed-specific, so CROSS-CORE-checked, NOT PostgreSQL-oracle-
# checked; ddl/create_table_as.test observes the same typmods through PostgreSQL-checked behavior.
# requires: ddl.create_table_as, introspect.columns, ddl.create_table, ddl.primary_key, ddl.not_null, ddl.column_default, dml.insert, dml.insert_multi_row, query.select, query.where_eq, query.order_by, query.union, query.intersect, query.except, query.values_query, query.join_left, query.join_using, query.subquery_scalar, query.window, query.aggregates, expr.coalesce, expr.arithmetic, cast.explicit, types.i32, types.i64, types.decimal, types.text, types.varchar_length, types.array, types.range, types.composite

statement ok
CREATE TYPE pt AS (label varchar(4), x decimal(6,2))

statement ok
CREATE TABLE src (id i32 PRIMARY KEY, price decimal(10,2) NOT NULL DEFAULT 1, name varchar(5), note text, tags text[], r i32range, p pt)

statement ok
INSERT INTO src VALUES (1, 1.5, 'ab', 'x', ARRAY['a'], '[1,5)', ROW('one', 1.5))

statement ok
INSERT INTO src (id, price, name) VALUES (2, 2.25, 'cde')

# every column of a bare `*`: the declared types and typmods, with no NOT NULL, key, or default
statement ok
CREATE TABLE c1 AS SELECT * FROM src

