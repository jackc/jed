# GIN over a jsonb column — CREATE INDEX ... USING gin (doc) picks the jsonb_ops operator class
# (spec/design/gin.md §2.1/§3). The opclass follows from the column type; there is no opclass syntax.
# A json column has no GIN operator class (42704, as PostgreSQL); UNIQUE and multi-column stay 0A000.
# DDL costs: the build charges its scan (page_read per table node + storage_row_read per row); the
# term extraction and entry writes are unmetered (gin.md §5).
# Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.gin_index, query.gin_jsonb_ops, dml.insert, dml.insert_multi_row, types.i32, types.json, types.jsonb, types.array, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, doc jsonb, raw json, tags i32[])

# an empty table builds for free
# cost: 0
statement ok
CREATE INDEX t_doc_gin ON t USING gin (doc)

statement ok
INSERT INTO t VALUES
  (1, '{"a": 1, "b": [1, "x"]}', '{"a": 1}', '{1}'),
  (2, '"x"', '[]', '{2}'),
  (3, NULL, NULL, NULL)

# the build scan: page_read(1 node) + 3 storage_row_read
# cost: 4
statement ok
CREATE INDEX ON t USING gin (doc)

# json has no GIN operator class (PG: data type json has no default operator class for access method gin)
statement error 42704
CREATE INDEX i ON t USING gin (raw)

statement error 0A000
CREATE UNIQUE INDEX i ON t USING gin (doc)
