# A view's dependency on a sequence a column owns (spec/design/views.md §6.2): the sequence of an
# IDENTITY or serial column goes with the column, so a view depending on it blocks ALTER TABLE …
# DROP COLUMN (2BP01 unless CASCADE, which drops the view) and ALTER TABLE … ALTER COLUMN … DROP
# IDENTITY (always 2BP01: the form has no CASCADE), as in PostgreSQL. A view over a composite column
# that carries a DEFAULT inserts through the base default, and a view default of the composite type
# overrides it. Every record is PostgreSQL-oracle-checked.
# requires: ddl.view, ddl.view_dependencies, ddl.view_cascade, ddl.view_default, ddl.view_alter, dml.view_write, ddl.identity, ddl.alter_identity, ddl.serial, func.sequence, ddl.create_table, ddl.primary_key, ddl.alter_table, ddl.drop_table, ddl.composite_default, types.composite, dml.insert, query.select, query.order_by, types.i32

statement ok
CREATE TABLE ti (k i32 PRIMARY KEY, id i32 GENERATED ALWAYS AS IDENTITY, s serial)

statement ok
CREATE VIEW vs AS SELECT nextval('ti_id_seq') AS n

statement ok
CREATE VIEW vs3 AS SELECT nextval('ti_s_seq') AS n

# DROP IDENTITY drops the owned sequence: a view depending on it blocks it
statement error 2BP01
ALTER TABLE ti ALTER COLUMN id DROP IDENTITY

# so does dropping the owning column, IDENTITY or serial
statement error 2BP01
ALTER TABLE ti DROP COLUMN id

statement error 2BP01
ALTER TABLE ti DROP COLUMN s

query I nosort
SELECT n FROM vs
----
1

# CASCADE drops the view with the column and its sequence
statement ok
ALTER TABLE ti DROP COLUMN id CASCADE

statement error 42P01
SELECT n FROM vs

query I nosort
SELECT n FROM vs3
----
1

statement ok
ALTER TABLE ti DROP COLUMN s CASCADE

statement error 42P01
SELECT n FROM vs3

statement ok
INSERT INTO ti VALUES (1)

query I nosort
SELECT k FROM ti
----
1

# with the view gone, DROP IDENTITY succeeds
statement ok
CREATE TABLE ti2 (k i32 PRIMARY KEY, id i32 GENERATED BY DEFAULT AS IDENTITY)

statement ok
CREATE VIEW vs4 AS SELECT k, id FROM ti2

statement ok
ALTER TABLE ti2 ALTER COLUMN id DROP IDENTITY

statement ok
INSERT INTO vs4 VALUES (1, 5)

query II nosort
SELECT k, id FROM vs4
----
1
5

statement ok
DROP VIEW vs4

statement ok
DROP TABLE ti, ti2

# --- a view over a composite column with a DEFAULT -------------------------------------------------
statement ok
CREATE TYPE pt AS (x i32, y i32)

statement ok
CREATE TABLE tc (id i32 PRIMARY KEY, p pt DEFAULT ROW(3, 4))

statement ok
CREATE VIEW vc AS SELECT id, p FROM tc

statement ok
INSERT INTO vc (id) VALUES (1)

statement ok
ALTER VIEW vc ALTER COLUMN p SET DEFAULT ROW(5, 6)::pt

statement ok
INSERT INTO vc (id) VALUES (2)

query III nosort
SELECT id, (p).x, (p).y FROM tc ORDER BY id
----
1
3
4
2
5
6

# the type is used by a column (and a view through it): DROP TYPE is 2BP01
statement error 2BP01
DROP TYPE pt

statement ok
DROP VIEW vc

statement ok
DROP TABLE tc

statement ok
DROP TYPE pt
