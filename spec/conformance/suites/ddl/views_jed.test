# skip: disk — temp tables and transactions spanning records cannot survive the disk-mode per-record
# reopen (spec/design/conformance.md §3); views persist and reload in the other views files' disk pass.
# Views — the jed-specific behavior of spec/design/views.md that PostgreSQL cannot oracle-check:
# the IF NOT EXISTS extension, the jed_ reservation, 0A000 for the deferred forms, temp scope,
# untracked dependencies, a rolled-back CASCADE, re-validation after ALTER TABLE, CREATE OR REPLACE
# VIEW, and ALTER VIEW (§8), the cycle check and the unbounded-varchar rule of OR REPLACE (§1.2), the session
# privilege envelope (§9), and transactions.
# CROSS-CORE-checked, NOT PostgreSQL-oracle-checked.
# requires: ddl.view, ddl.view_cascade, dml.view_write, ddl.view_replace, ddl.view_alter, ddl.create_table, ddl.primary_key, ddl.drop_table, ddl.drop_table_multi, ddl.alter_table, ddl.sequence, ddl.temp_table, ddl.foreign_key, dml.insert, dml.insert_multi_row, dml.update, dml.delete, dml.insert_on_conflict, query.select, query.select_star, query.where_eq, query.order_by, query.join_inner, query.aggregates, query.subquery_scalar, query.subquery_correlated, query.derived_table, query.cte, query.cte_recursive, query.cte_data_modifying, types.i32, types.i64, types.text, types.decimal, types.varchar_length, types.composite, cast.operator, session.privileges, session.allow_ddl, session.allow_temp_ddl, txn.explicit, txn.read_only

statement ok
CREATE TABLE t (a i32 PRIMARY KEY, b text)

statement ok
INSERT INTO t VALUES (1, 'x'), (2, 'y')

statement ok
CREATE VIEW v AS SELECT a, b FROM t

# --- IF NOT EXISTS (a jed extension): a taken name is a silent no-op, decided before the body -----

statement ok
CREATE VIEW IF NOT EXISTS v AS SELECT * FROM nosuch

statement ok
CREATE VIEW IF NOT EXISTS t AS SELECT 1 AS one

statement ok
CREATE VIEW IF NOT EXISTS vn AS SELECT a FROM t WHERE a = 2

query I nosort
SELECT * FROM vn
----
2

# a lone `if` is an identifier: this creates a view named `if`
statement ok
CREATE VIEW if AS SELECT 1 AS one

query I nosort
SELECT one FROM if
----
1

statement ok
DROP VIEW if

# --- the jed_ reservation applies to views; it is not suppressed by IF NOT EXISTS ----------------

statement error 42939
CREATE VIEW jed_v AS SELECT 1 AS one

statement error 42939
CREATE VIEW IF NOT EXISTS jed_v AS SELECT 1 AS one

statement ok
CREATE VIEW "JED_v" AS SELECT 1 AS one

statement ok
DROP VIEW "JED_v"

# a view over a jed_ catalog relation is allowed (no dependency is recorded)
statement ok
CREATE VIEW tabs AS SELECT name FROM jed_tables

query T nosort
SELECT name FROM tabs ORDER BY name
----
t

# a view over a catalog relation is not updatable (its FROM item is not a table or view)
statement error 55000
DELETE FROM tabs

statement error 55000
WITH d AS (DELETE FROM tabs RETURNING name) SELECT count(*) FROM d

statement ok
DROP VIEW tabs

# --- deferred forms are recognized and refused with 0A000 -------------------------------------------

statement error 0A000
CREATE TEMP VIEW tv AS SELECT a FROM t

statement error 0A000
CREATE TEMPORARY VIEW tv AS SELECT a FROM t

statement error 0A000
CREATE RECURSIVE VIEW rv (n) AS SELECT 1

statement error 0A000
CREATE MATERIALIZED VIEW mv AS SELECT a FROM t

statement error 0A000
CREATE VIEW ov WITH (security_barrier) AS SELECT a FROM t

statement error 0A000
CREATE OR REPLACE TEMP VIEW tv AS SELECT a FROM t

# ALTER VIEW actions other than RENAME
statement error 0A000
ALTER VIEW v ALTER COLUMN a SET DEFAULT 1

statement error 0A000
ALTER VIEW v ALTER a DROP DEFAULT

statement error 0A000
ALTER VIEW v OWNER TO someone

statement error 0A000
ALTER VIEW v SET SCHEMA public

statement error 0A000
ALTER VIEW v SET (security_barrier = true)

statement error 0A000
ALTER VIEW v RESET (security_barrier)

statement error 42P01
SELECT * FROM cv

# OR REPLACE and IF NOT EXISTS disagree about a taken name: a syntax error
statement error 42601
CREATE OR REPLACE VIEW IF NOT EXISTS v AS SELECT a FROM t

# ALTER VIEW names views only: a table's column is not renamed through it (PostgreSQL renames it)
statement error 42809
ALTER VIEW t RENAME COLUMN a TO a9

statement error 42809
ALTER VIEW IF EXISTS t RENAME COLUMN a TO a9

# the jed_ reservation applies to a view rename
statement error 42939
ALTER VIEW v RENAME TO jed_v

# a qualifier other than main
statement error 0A000
ALTER VIEW temp.v RENAME TO v9

statement error 42P01
ALTER VIEW nosuchdb.v RENAME TO v9

statement error 0A000
CREATE OR REPLACE VIEW temp.v AS SELECT a, b FROM t

statement ok
ALTER VIEW main.v RENAME TO v9

statement ok
ALTER VIEW v9 RENAME TO v

# a qualifier other than main
statement ok
CREATE VIEW main.mv AS SELECT b FROM main.t WHERE a = 1

query T nosort
SELECT * FROM main.mv
----
x

statement error 0A000
CREATE VIEW temp.tv AS SELECT a FROM t

# a repeated name is deduplicated only after its qualifier is validated
statement error 42P01
DROP VIEW main.mv, temp.mv

statement error 42P01
DROP VIEW mv, nosuchdb.mv

# --- sequence statements look up sequences only (as for a table) ------------------------------------

statement error 42P01
DROP SEQUENCE v

# --- a persistent view may not read a temporary relation --------------------------------------------

statement ok
CREATE TEMP TABLE tt (z i32)

statement error 0A000
CREATE VIEW tv AS SELECT z FROM tt

statement error 0A000
CREATE VIEW tv AS SELECT z FROM temp.tt

statement error 0A000
CREATE VIEW tv AS SELECT a FROM t WHERE a IN (SELECT z FROM tt)

statement ok
DROP TABLE tt

# --- a rolled-back CASCADE restores every view it dropped -------------------------------------------

statement ok
CREATE VIEW vv AS SELECT a FROM v

statement ok
BEGIN

statement ok
DROP TABLE t CASCADE

statement error 42P01
SELECT * FROM vv

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
ALTER TABLE t DROP COLUMN b CASCADE

statement error 42P01
SELECT * FROM v

statement ok
ROLLBACK

query I rowsort
SELECT a FROM vv
----
1
2

statement ok
DROP VIEW vv

# a FOREIGN KEY dependent is still dropped by CASCADE when no view depends on the table
statement ok
CREATE TABLE parent (k i32 PRIMARY KEY)

statement ok
CREATE TABLE child (r i32 REFERENCES parent (k))

statement ok
DROP TABLE parent CASCADE

# --- untracked dependencies: a dropped sequence fails the view when it is used ----------------------

statement ok
CREATE SEQUENCE s

statement ok
CREATE VIEW vs AS SELECT nextval('s') AS n

# reading a view that calls nextval is a write
statement ok
BEGIN READ ONLY

statement error 25006
SELECT * FROM vs

statement ok
ROLLBACK

# a database-qualified name never resolves to a CTE, so a same-named CTE cannot hide the view
statement ok
BEGIN READ ONLY

statement error 25006
WITH vs AS (SELECT 7 AS n) SELECT * FROM main.vs

statement ok
ROLLBACK

# a temp. qualifier never names a view: the missing relation is 42P01, not a write refused as 25006
statement ok
BEGIN READ ONLY

statement error 42P01
SELECT * FROM temp.vs

statement ok
ROLLBACK

query I nosort
SELECT * FROM vs
----
1

statement ok
DROP SEQUENCE s

statement error 42P01
SELECT * FROM vs

statement ok
DROP VIEW vs

# --- `*` that cannot be expanded by name -------------------------------------------------------------

# without a column list the duplicate output name is 42701 (as in PostgreSQL)
statement error 42701
CREATE VIEW sx AS SELECT * FROM (SELECT 1 AS a, 2 AS a) d

# with one, the frozen expansion "d"."a", "d"."a" is ambiguous: 0A000 (PostgreSQL accepts)
statement error 0A000
CREATE VIEW sx (p, q) AS SELECT * FROM (SELECT 1 AS a, 2 AS a) d

# --- re-validation after ALTER TABLE (§8) -----------------------------------------------------------

statement ok
CREATE TABLE p (k i32 PRIMARY KEY, x i32)

statement ok
CREATE TABLE q (k i32 PRIMARY KEY)

statement ok
INSERT INTO p VALUES (1, 1), (2, 5)

statement ok
INSERT INTO q VALUES (1), (2), (3)

# `x` inside the subquery is p.x (q has no x)
statement ok
CREATE VIEW cap AS SELECT k, (SELECT count(*) FROM q WHERE q.k <= x) AS n FROM p

query II nosort
SELECT * FROM cap ORDER BY k
----
1
1
2
3

# a new q.x would capture it: the ALTER is refused and nothing changes
statement error 0A000
ALTER TABLE q ADD COLUMN x i32

query II nosort
SELECT * FROM cap ORDER BY k
----
1
1
2
3

# a bare `x` read beside q would become ambiguous
statement ok
CREATE VIEW amb AS SELECT x FROM p JOIN q ON p.k = q.k

statement error 0A000
ALTER TABLE q ADD COLUMN x i32

# a column that captures nothing is fine, and dropping it again is fine
statement ok
ALTER TABLE q ADD COLUMN y i32

statement ok
ALTER TABLE q DROP COLUMN y

statement ok
DROP VIEW cap, amb

statement ok
ALTER TABLE q ADD COLUMN x i32

# --- re-validation after CREATE OR REPLACE VIEW (§8): an appended column may not capture ------------

statement ok
CREATE TABLE p2 (k i32 PRIMARY KEY, x i32)

statement ok
CREATE TABLE q2 (k i32 PRIMARY KEY)

statement ok
INSERT INTO p2 VALUES (1, 1), (2, 5)

statement ok
INSERT INTO q2 VALUES (1), (2), (3)

statement ok
CREATE VIEW rv AS SELECT k FROM q2

# `x` inside the subquery is p2.x (rv has no x). The body also reads p2.x directly, so a capture
# leaves the dependency list unchanged and only the appended-column check can catch it.
statement ok
CREATE VIEW rcap AS SELECT k, x AS px, (SELECT count(*) FROM rv WHERE rv.k <= x) AS n FROM p2

query III nosort
SELECT * FROM rcap ORDER BY k
----
1
1
1
2
5
3

# appending rv.x would capture it: refused, and nothing changes (PostgreSQL accepts; its rcap stays
# bound to p2.x)
statement error 0A000
CREATE OR REPLACE VIEW rv AS SELECT k, k AS x FROM q2

query III nosort
SELECT * FROM rcap ORDER BY k
----
1
1
1
2
5
3

# a bare `x` read beside rv would become ambiguous
statement ok
CREATE VIEW ramb AS SELECT x FROM p2 JOIN rv ON p2.k = rv.k

statement error 0A000
CREATE OR REPLACE VIEW rv AS SELECT k, k AS x FROM q2

# a column that captures nothing is fine
statement ok
CREATE OR REPLACE VIEW rv AS SELECT k, 1 AS y FROM q2

query III nosort
SELECT * FROM rcap ORDER BY k
----
1
1
1
2
5
3

# --- a view that would read itself is 42P17 at definition (PostgreSQL fails each use instead) ------

statement error 42P17
CREATE OR REPLACE VIEW rv AS SELECT k, y FROM rv

statement ok
CREATE VIEW rv2 AS SELECT k FROM rv

statement error 42P17
CREATE OR REPLACE VIEW rv AS SELECT k, 1 AS y FROM rv2

query II nosort
SELECT * FROM rv ORDER BY k
----
1
1
2
1
3
1

# --- a view rename that a dependent's CTE would capture is refused ---------------------------------

statement ok
CREATE VIEW rcte AS WITH rv9 AS (SELECT 1 AS k) SELECT rv.k FROM rv, rv9 WHERE rv.k = rv9.k

statement error 0A000
ALTER VIEW rv RENAME TO rv9

statement ok
ALTER VIEW rv RENAME TO rv8

query I nosort
SELECT * FROM rcte
----
1

statement ok
DROP VIEW rcte, rv2, ramb, rcap, rv8

statement ok
DROP TABLE p2, q2

# --- a view column's type includes its typmod (views_replace.test), but jed's varchar is text with a
# length typmod, so an unbounded varchar replaces a text column (PostgreSQL refuses: they are two
# types there) ---------------------------------------------------------------------------------------

statement ok
CREATE TABLE tm (k i32 PRIMARY KEY, d text, n decimal(5,2))

statement ok
CREATE VIEW vtm AS SELECT d, n FROM tm

statement ok
CREATE OR REPLACE VIEW vtm AS SELECT d::varchar AS d, n FROM tm

statement error 42P16
CREATE OR REPLACE VIEW vtm AS SELECT d, n::i64 AS n FROM tm

# a projected bare integer literal is i64 (types.md §6), so it cannot replace an i32 column
# (PostgreSQL types it int4 and accepts)
statement ok
CREATE VIEW vlit AS SELECT k FROM tm

statement error 42P16
CREATE OR REPLACE VIEW vlit AS SELECT 0 AS k FROM tm

statement ok
CREATE OR REPLACE VIEW vlit AS SELECT 0::i32 AS k FROM tm

statement ok
DROP VIEW vlit

statement ok
DROP VIEW vtm

statement ok
DROP TABLE tm

# --- a broken view (an untracked dependency was dropped) can be repaired by replacing it -----------

statement ok
CREATE TYPE pair AS (x i32, y i32)

statement ok
CREATE VIEW vbroken AS SELECT ('(1,2)'::pair).x AS n

statement ok
DROP TYPE pair

statement error 42704
SELECT * FROM vbroken

# only the names and the count are compared: the type may differ from the broken body's
statement ok
CREATE OR REPLACE VIEW vbroken AS SELECT 'fixed' AS n

query T nosort
SELECT * FROM vbroken
----
fixed

statement error 42P16
CREATE OR REPLACE VIEW vbroken AS SELECT 'x' AS m

statement ok
DROP VIEW vbroken

# --- transactions: CREATE / DROP VIEW roll back --------------------------------------------------

statement ok
BEGIN

statement ok
CREATE VIEW txv AS SELECT a FROM t

query I nosort
SELECT count(*) FROM txv
----
2

statement ok
ROLLBACK

statement error 42P01
SELECT * FROM txv

statement ok
BEGIN

statement ok
DROP VIEW vn

statement ok
ROLLBACK

query I nosort
SELECT * FROM vn
----
2

statement ok
BEGIN READ ONLY

statement error 25006
CREATE VIEW rov AS SELECT a FROM t

statement ok
ROLLBACK

# CREATE OR REPLACE and ALTER VIEW roll back too
statement ok
BEGIN

statement ok
CREATE OR REPLACE VIEW vn AS SELECT a, 'extra' AS e FROM t WHERE a = 2

statement ok
ALTER VIEW vn RENAME TO vn2

statement ok
ALTER VIEW vn2 RENAME COLUMN a TO aa

query IT nosort
SELECT * FROM vn2
----
2
extra

statement ok
ROLLBACK

statement error 42P01
SELECT * FROM vn2

query I nosort
SELECT * FROM vn
----
2

statement ok
BEGIN READ ONLY

statement error 25006
CREATE OR REPLACE VIEW vn AS SELECT a FROM t

statement ok
ROLLBACK

statement ok
BEGIN READ ONLY

statement error 25006
ALTER VIEW vn RENAME TO vn2

statement ok
ROLLBACK

# --- privileges (§9): CREATE needs allow_ddl + SELECT on what the body reads; reading needs only
# SELECT on the view ---------------------------------------------------------------------------------

# allow_ddl: off
statement error 42501
CREATE VIEW pv AS SELECT a FROM t

# allow_ddl: off
statement error 42501
DROP VIEW vn

# allow_ddl: off
statement error 42501
CREATE OR REPLACE VIEW vn AS SELECT a FROM t WHERE a = 2

# allow_ddl: off
statement error 42501
ALTER VIEW vn RENAME TO vn2

# OR REPLACE checks SELECT on what the new body reads
# default_privileges: NONE
statement error 42501
CREATE OR REPLACE VIEW vn AS SELECT a FROM t WHERE a = 2

# default_privileges: NONE
statement error 42501
CREATE VIEW pv AS SELECT a FROM t

# default_privileges: NONE
# grant: SELECT ON t
statement ok
CREATE VIEW pv AS SELECT a FROM t WHERE a = 1

# the view alone is enough to read through it
# default_privileges: NONE
# grant: SELECT ON pv
query I nosort
SELECT * FROM pv
----
1

# default_privileges: NONE
statement error 42501
SELECT * FROM pv

# default_privileges: NONE
# grant: SELECT ON pv
statement error 42501
SELECT * FROM t

# a view over a view: the outer view is enough
statement ok
CREATE VIEW pv2 AS SELECT a FROM pv

# default_privileges: NONE
# grant: SELECT ON pv2
query I nosort
SELECT * FROM pv2
----
1

# a same-named CTE cannot hide a database-qualified view from the privilege check
# default_privileges: NONE
statement error 42501
WITH pv AS (SELECT 1 AS a) SELECT * FROM main.pv

# a recursive CTE's self-reference is the CTE, so it needs no SELECT on the same-named table
# default_privileges: NONE
query I nosort
WITH RECURSIVE t (n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM t WHERE n < 2) SELECT n FROM t ORDER BY n
----
1
2

statement ok
DROP VIEW pv2, pv, vn, v, mv

statement ok
DROP TABLE t, p, q, child
