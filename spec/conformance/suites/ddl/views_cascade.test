# a column no view uses drops like RESTRICT
statement ok
ALTER TABLE t ADD COLUMN e i32

statement ok
ALTER TABLE t DROP COLUMN e CASCADE

query II nosort
SELECT * FROM t ORDER BY a
----
1
100
2
200

# --- several actions in one ALTER TABLE -----------------------------------------------------------

statement ok
ALTER TABLE t ADD COLUMN f i32

statement ok
ALTER TABLE t ADD COLUMN g i32

statement ok
CREATE VIEW vfg AS SELECT f, g FROM t

# a later RESTRICT drop is no longer blocked by a view an earlier CASCADE drop took
statement ok
ALTER TABLE t DROP COLUMN f CASCADE, DROP COLUMN g

statement error 42P01
SELECT * FROM vfg

statement ok
ALTER TABLE t ADD COLUMN f i32

statement ok
ALTER TABLE t ADD COLUMN g i32

statement ok
CREATE VIEW vfg AS SELECT f, g FROM t

# an earlier RESTRICT drop is still blocked
statement error 2BP01
ALTER TABLE t DROP COLUMN g, DROP COLUMN f CASCADE

# a type change runs after the drops, in either order
statement ok
ALTER TABLE t ALTER COLUMN g TYPE i64, DROP COLUMN f CASCADE

statement error 42P01
SELECT * FROM vfg

statement ok
ALTER TABLE t ADD COLUMN f i32

statement ok
CREATE VIEW vfg AS SELECT f, g FROM t

statement ok
ALTER TABLE t DROP COLUMN f CASCADE, ALTER COLUMN g TYPE i32

statement error 42P01
SELECT * FROM vfg

statement ok
ALTER TABLE t ADD COLUMN f i32

statement ok
CREATE VIEW vfg AS SELECT f, g FROM t

# a type change of a column a surviving view uses is still refused
statement ok
CREATE VIEW vd AS SELECT d FROM t

statement error 0A000
ALTER TABLE t ALTER COLUMN d TYPE i64, DROP COLUMN f CASCADE

query I nosort
SELECT count(*) FROM vfg
----
2

statement ok
DROP TABLE t, other CASCADE

statement error 42P01
SELECT * FROM vfg

statement error 42P01
SELECT * FROM vd

statement error 42P01
SELECT * FROM vt

statement error 42P01
SELECT * FROM vother
