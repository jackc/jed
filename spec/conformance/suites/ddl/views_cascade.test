SELECT * FROM t ORDER BY a
----
1
10
100
2
20
200

# a column reached only through a correlated subquery is a dependency too
statement ok
ALTER TABLE t DROP COLUMN c CASCADE

statement error 42P01
SELECT * FROM vc

