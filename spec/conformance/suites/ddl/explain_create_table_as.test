keys=1; output=[#0]
buffered
1
Scan src
Full scan; touched=2
buffered

statement error 42P01
SELECT * FROM c

# --- the checks before creation, in PostgreSQL's order ----------------------------------------------

# the query's analysis comes before the name
statement error 42P01
EXPLAIN CREATE TABLE src AS SELECT * FROM nosuch

statement error 42P07
EXPLAIN CREATE TABLE src AS SELECT 1 AS a

statement error 42P07
EXPLAIN SELECT 1 AS a INTO src

# an IF NOT EXISTS skip renders no plan
query ITTII nosort
EXPLAIN CREATE TABLE IF NOT EXISTS src AS SELECT 1 AS a
----

query ITTIII nosort
EXPLAIN ANALYZE CREATE TABLE IF NOT EXISTS src AS SELECT 1 AS a
----

statement error 42939
EXPLAIN CREATE TABLE jed_x AS SELECT 1 AS a

# plain EXPLAIN stops before the column checks; ANALYZE makes them
query ITTII nosort
EXPLAIN CREATE TABLE d AS SELECT 1 AS a, 2 AS a
----
0
Result
-
1
1

statement error 42701
EXPLAIN ANALYZE CREATE TABLE d AS SELECT 1 AS a, 2 AS a

query ITTII nosort
EXPLAIN CREATE TABLE d (x, y) AS SELECT 1 AS a
----
0
Result
-
1
1

statement error 42601
EXPLAIN ANALYZE CREATE TABLE d (x, y) AS SELECT 1 AS a

# the column-definition form has no plan to render
statement error 42601
EXPLAIN CREATE TABLE d (a i32)

statement error 42601
EXPLAIN CREATE VIEW d AS SELECT 1 AS a

