# EXPLAIN [ANALYZE] CREATE TABLE … AS and EXPLAIN SELECT … INTO (spec/design/create-table-as.md §7,
# explain.md §1): the rendered plan is the plan of the query the statement runs, exactly as EXPLAIN of
# that query renders it. The checks CREATE TABLE … AS makes before creating anything come first, in
# PostgreSQL's order — the query's analysis, then the name (42P07; an IF NOT EXISTS skip renders no
# plan rows). Plain EXPLAIN creates nothing and stops there, so the column checks (42701, …) do not
# run, as in PostgreSQL. ANALYZE runs the statement: it creates and fills the table, its Analyze root
# reports the statement's cost and inserted rows, and under WITH NO DATA nothing of the query runs.
# A plain EXPLAIN is a read, an ANALYZE a write (25006 in a read-only transaction, where PostgreSQL
# 18 runs it — ddl/select_into_jed.test). The rendering is jed's own, so CROSS-CORE-checked, NOT PostgreSQL-oracle-checked.
# Format: ../../../design/conformance.md.
# requires: ddl.explain_create_table_as, ddl.select_into, ddl.create_table_as, ddl.create_table_as_writable_with, ddl.create_table, ddl.create_table_if_not_exists, ddl.primary_key, dml.insert, dml.insert_multi_row, dml.delete, dml.returning, query.select, query.where_eq, query.comparison_order, query.order_by, query.cte, query.cte_data_modifying, query.explain, query.explain_analyze, dml.explain, dml.explain_analyze, session.allow_ddl, resource.cost_metering, types.i32

statement ok
CREATE TABLE src (id i32 PRIMARY KEY, v i32)

statement ok
INSERT INTO src VALUES (1, 10), (2, 20), (3, 30)

# --- plain EXPLAIN renders the query's plan and creates nothing ------------------------------------

query ITTII nosort
EXPLAIN CREATE TABLE c AS SELECT id, v FROM src WHERE v > 10
----
