statement ok
ROLLBACK TO SAVEPOINT b

statement ok
SAVEPOINT c

statement ok
ALTER TABLE alter_sp_identity ALTER id DROP IDENTITY

statement ok
ROLLBACK TO SAVEPOINT c

statement ok
