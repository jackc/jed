# ROLLBACK TO SAVEPOINT undoes identity DDL and its sequence edits, keeping earlier work.
statement ok
CREATE TABLE alter_sp_identity (id i32 NOT NULL)

statement ok
BEGIN

statement ok
SAVEPOINT a

statement ok
ALTER TABLE alter_sp_identity ALTER id ADD GENERATED BY DEFAULT AS IDENTITY (START 10)

statement ok
ROLLBACK TO SAVEPOINT a

statement error 23502
INSERT INTO alter_sp_identity VALUES (DEFAULT)

statement ok
ROLLBACK

statement ok
ALTER TABLE alter_sp_identity ALTER id ADD GENERATED BY DEFAULT AS IDENTITY (START 10)

statement ok
BEGIN

statement ok
INSERT INTO alter_sp_identity VALUES (DEFAULT)

statement ok
SAVEPOINT b

statement ok
ALTER TABLE alter_sp_identity ALTER id SET INCREMENT 100 RESTART WITH 500

statement ok
