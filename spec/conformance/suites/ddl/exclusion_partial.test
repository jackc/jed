# The partial EXCLUDE form (spec/design/gist.md §7.1): EXCLUDE … WHERE (predicate).
#
# Only rows whose predicate is TRUE participate: a row whose predicate is FALSE or NULL is exempt —
# it never conflicts and is never conflicted with, exactly as a partial index leaves it out. The
# predicate is validated as a partial index's (indexes.md §9) and stored as canonical text on the
# backing index. Every record here is the single-column range form `EXCLUDE USING gist (span WITH &&)`
# (pure PostgreSQL) or a btree `=` form, so the file is oracle-checked; introspection of the stored
# predicate lives in the introspection suites. Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.exclusion_constraint, ddl.exclusion_partial, ddl.exclusion_btree, ddl.alter_table, dml.insert, dml.insert_multi_row, dml.update, dml.delete, query.select, query.order_by, query.where_eq, types.i32, types.text, types.range, types.boolean, types.boolean_storable

# --- a partial range exclusion: only active reservations may not overlap ---------------------------
statement ok
CREATE TABLE rsv (id i32 PRIMARY KEY, room i32, during int4range, active boolean, EXCLUDE USING gist (during WITH &&) WHERE (active))

statement ok
INSERT INTO rsv VALUES (1, 1, '[1,5)', true)

# an overlapping ACTIVE row conflicts
statement error 23P01
INSERT INTO rsv VALUES (2, 1, '[3,8)', true)

# an overlapping row whose predicate is FALSE or NULL is exempt
statement ok
INSERT INTO rsv VALUES (2, 1, '[3,8)', false), (3, 1, '[2,4)', NULL)

# exempt rows are never conflicted with either: an active row overlapping only them is fine
statement ok
INSERT INTO rsv VALUES (4, 1, '[6,9)', true)

query IT nosort
SELECT id, during FROM rsv ORDER BY id
----
1
[1,5)
2
[3,8)
3
[2,4)
4
[6,9)

# --- in-batch: two new rows conflict only when both participate ------------------------------------
statement error 23P01
INSERT INTO rsv VALUES (10, 2, '[20,30)', true), (11, 2, '[25,35)', true)

statement ok
INSERT INTO rsv VALUES (10, 2, '[20,30)', true), (11, 2, '[25,35)', false)

# --- UPDATE: a row entering the predicate is checked; a row leaving it no longer conflicts ----------
# row 2 ([3,8), inactive) becoming active would overlap rows 1 and 4
statement error 23P01
UPDATE rsv SET active = true WHERE id = 2

# deactivate rows 1 and 4, then row 2 may become active
statement ok
UPDATE rsv SET active = false WHERE id IN (1, 4)

statement ok
UPDATE rsv SET active = true WHERE id = 2

query IB nosort
SELECT id, active FROM rsv ORDER BY id
----
1
false
2
true
3
NULL
4
false
10
true
11
false

# a row moving within the predicate is checked against the others
statement error 23P01
UPDATE rsv SET during = '[4,6)' WHERE id = 10

statement ok
DELETE FROM rsv WHERE id = 2

statement ok
UPDATE rsv SET active = true WHERE id = 1

# --- a predicate over a column that is not excluded, with a comparison -------------------------------
statement ok
CREATE TABLE lease (id i32 PRIMARY KEY, unit text, span int4range, status text, EXCLUDE USING gist (span WITH &&) WHERE (status <> 'cancelled' AND unit = 'a'))

statement ok
INSERT INTO lease VALUES (1, 'a', '[1,10)', 'open'), (2, 'a', '[5,15)', 'cancelled'), (3, 'b', '[5,15)', 'open')

statement error 23P01
INSERT INTO lease VALUES (4, 'a', '[9,12)', 'open')

statement ok
INSERT INTO lease VALUES (4, 'a', '[10,12)', 'open')

# --- predicate validation (as a partial index's) -------------------------------------------------
statement error 42804
CREATE TABLE bad1 (id i32 PRIMARY KEY, span int4range, n i32, EXCLUDE USING gist (span WITH &&) WHERE (n))

statement error 42703
CREATE TABLE bad2 (id i32 PRIMARY KEY, span int4range, EXCLUDE USING gist (span WITH &&) WHERE (missing > 0))

statement error 42803
CREATE TABLE bad3 (id i32 PRIMARY KEY, span int4range, n i32, EXCLUDE USING gist (span WITH &&) WHERE (count(*) > 0))

statement error 0A000
CREATE TABLE bad4 (id i32 PRIMARY KEY, span int4range, n i32, EXCLUDE USING gist (span WITH &&) WHERE (n IN (SELECT 1)))

statement error 42P17
CREATE TABLE bad5 (id i32 PRIMARY KEY, span int4range, EXCLUDE USING gist (span WITH &&) WHERE (clock_timestamp() IS NOT NULL))

# the parentheses around the predicate are required
statement error 42601
CREATE TABLE bad6 (id i32 PRIMARY KEY, span int4range, n i32, EXCLUDE USING gist (span WITH &&) WHERE n > 0)

# --- ALTER TABLE … ADD … WHERE validates only the participating existing rows -------------------------
statement ok
CREATE TABLE ev (id i32 PRIMARY KEY, span int4range, kind text)

statement ok
INSERT INTO ev VALUES (1, '[1,5)', 'x'), (2, '[2,6)', 'y'), (3, '[3,7)', 'x')

# rows 1 and 3 overlap and both satisfy kind = 'x'
statement error 23P01
ALTER TABLE ev ADD CONSTRAINT ev_x EXCLUDE USING gist (span WITH &&) WHERE (kind = 'x')

statement ok
ALTER TABLE ev ADD CONSTRAINT ev_y EXCLUDE USING gist (span WITH &&) WHERE (kind = 'y')

statement error 23P01
INSERT INTO ev VALUES (4, '[5,9)', 'y')

statement ok
INSERT INTO ev VALUES (4, '[6,9)', 'y')

# --- RENAME COLUMN rewrites the stored predicate ---------------------------------------------------
statement ok
ALTER TABLE ev RENAME COLUMN kind TO category

statement error 23P01
INSERT INTO ev VALUES (5, '[7,8)', 'y')

# A column only the predicate reads is a NORMAL dependency of the constraint (an excluded column is an
# internal one): RESTRICT refuses the drop, CASCADE drops the constraint with it.
statement error 2BP01
ALTER TABLE ev DROP COLUMN category

statement ok
ALTER TABLE ev DROP COLUMN category CASCADE

statement ok
INSERT INTO ev VALUES (5, '[7,8)')

query IT nosort
SELECT id, span FROM ev ORDER BY id
----
1
[1,5)
2
[2,6)
3
[3,7)
4
[6,9)
5
[7,8)

# --- a partial btree exclusion: one primary contact per customer ------------------------------------
statement ok
CREATE TABLE contact (id i32 PRIMARY KEY, customer i32, is_primary boolean, EXCLUDE (customer WITH =) WHERE (is_primary))

statement ok
INSERT INTO contact VALUES (1, 7, true), (2, 7, false), (3, 7, false), (4, 8, true)

statement error 23P01
INSERT INTO contact VALUES (5, 7, true)

statement error 23P01
UPDATE contact SET is_primary = true WHERE id = 2

statement ok
UPDATE contact SET is_primary = true WHERE id = 5

# the backing ordered index serves reads, and returns every matching row
query IB nosort
SELECT id, is_primary FROM contact WHERE customer = 7 ORDER BY id
----
1
true
2
false
3
false
