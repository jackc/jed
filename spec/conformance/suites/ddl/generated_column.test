# Stored generated columns — GENERATED ALWAYS AS (expr) STORED (spec/design/generated-columns.md):
# the CREATE TABLE surface and its admission errors, and the ALTER TABLE forms (ADD COLUMN backfill,
# DROP EXPRESSION, SET/DROP DEFAULT, RENAME / ALTER TYPE / DROP of a referenced column). Write
# behavior is dml/generated_column.test. PostgreSQL-oracle-checked.
# requires: ddl.generated_column, ddl.create_table, ddl.alter_table, ddl.check, ddl.not_null, ddl.primary_key, ddl.unique, ddl.foreign_key, ddl.foreign_key, dml.insert, dml.insert_column_list, dml.update, query.select, query.order_by, types.i32, types.i64, types.text, types.decimal, types.varchar_length

# --- the basic shape: computed on INSERT ----------------------------------------------------------

statement ok
CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED, c text)

statement ok
INSERT INTO t (a, c) VALUES (1, 'x'), (NULL, 'y')

statement ok
INSERT INTO t VALUES (5, DEFAULT, 'z')

query IIT nosort
SELECT a, b, c FROM t ORDER BY c
----
1
2
x
NULL
NULL
y
5
10
z

# a generated column may sit among other constraints, in any order, and reference a later column
statement ok
CREATE TABLE fwd (g text NOT NULL GENERATED ALWAYS AS (upper(s)) STORED UNIQUE, s text)

statement ok
INSERT INTO fwd (s) VALUES ('ab')

query TT nosort
SELECT g, s FROM fwd
----
AB
ab

# --- parse-level errors (42601) -------------------------------------------------------------------

statement error 42601
CREATE TABLE e (a int, b int GENERATED BY DEFAULT AS (a) STORED)

statement error 42601
CREATE TABLE e (a int, b int GENERATED ALWAYS AS (a) STORED GENERATED ALWAYS AS (a) STORED)

statement error 42601
CREATE TABLE e (a int, b int DEFAULT 1 GENERATED ALWAYS AS (a) STORED)

statement error 42601
CREATE TABLE e (a int, b int GENERATED ALWAYS AS (a) STORED DEFAULT 1)

statement error 42601
CREATE TABLE e (a int, b int GENERATED ALWAYS AS IDENTITY GENERATED ALWAYS AS (a) STORED)

# --- admission of the expression ------------------------------------------------------------------

# a subquery is 0A000
statement error 0A000
CREATE TABLE e (a int, b int GENERATED ALWAYS AS ((SELECT 1)) STORED)

# an aggregate is 42803
statement error 42803
CREATE TABLE e (a int, b int GENERATED ALWAYS AS (sum(a)) STORED)

# a window function is 42P20
statement error 42P20
CREATE TABLE e (a int, b int GENERATED ALWAYS AS (row_number() OVER ()) STORED)

# a set-returning function is 0A000
statement error 0A000
CREATE TABLE e (a int, b int GENERATED ALWAYS AS (generate_series(1, a)) STORED)

# an unknown column is 42703
statement error 42703
CREATE TABLE e (a int, b int GENERATED ALWAYS AS (x) STORED)

# a reference to itself or to another generated column is 42P17
statement error 42P17
CREATE TABLE e (a int, b int GENERATED ALWAYS AS (b * 2) STORED)

statement error 42P17
CREATE TABLE e (a int, b int GENERATED ALWAYS AS (a) STORED, c int GENERATED ALWAYS AS (b) STORED)

# a non-immutable function is 42P17
statement error 42P17
CREATE TABLE e (a int, b timestamptz GENERATED ALWAYS AS (now()) STORED)

# a result that does not assignment-coerce is 42804
statement error 42804
CREATE TABLE e (a int, b int GENERATED ALWAYS AS ('x'::text) STORED)

# nothing above created e
statement ok
CREATE TABLE e (a int)

statement ok
DROP TABLE e

# --- foreign keys: an action that writes a generated referencing column is 42601 -----------------

statement ok
CREATE TABLE p (k int PRIMARY KEY)

statement error 42601
CREATE TABLE fk1 (a int, b int GENERATED ALWAYS AS (a) STORED REFERENCES p ON UPDATE CASCADE)

statement error 42601
CREATE TABLE fk1 (a int, b int GENERATED ALWAYS AS (a) STORED REFERENCES p ON UPDATE SET NULL)

statement error 42601
CREATE TABLE fk1 (a int, b int GENERATED ALWAYS AS (a) STORED REFERENCES p ON DELETE SET NULL)

statement error 42601
CREATE TABLE fk1 (a int, b int GENERATED ALWAYS AS (a) STORED REFERENCES p ON DELETE SET DEFAULT)

# NO ACTION / RESTRICT / ON DELETE CASCADE are fine
statement ok
CREATE TABLE fk1 (a int, b int GENERATED ALWAYS AS (a + 1) STORED REFERENCES p ON DELETE CASCADE)

statement ok
INSERT INTO p VALUES (2), (3)

statement ok
INSERT INTO fk1 (a) VALUES (1), (2)

# the computed referencing value is checked: a = 5 gives b = 6, which p lacks
statement error 23503
INSERT INTO fk1 (a) VALUES (5)

statement ok
DELETE FROM p WHERE k = 2

query II nosort
SELECT a, b FROM fk1
----
2
3

statement ok
CREATE TABLE fk2 (a int, b int GENERATED ALWAYS AS (a) STORED)

statement error 42601
ALTER TABLE fk2 ADD FOREIGN KEY (b) REFERENCES p ON UPDATE CASCADE

statement ok
ALTER TABLE fk2 ADD FOREIGN KEY (b) REFERENCES p

# --- keys and typmods -----------------------------------------------------------------------------

statement ok
CREATE TABLE k (a int, b int GENERATED ALWAYS AS (a * 10) STORED PRIMARY KEY)

statement ok
INSERT INTO k (a) VALUES (3)

statement error 23505
INSERT INTO k (a) VALUES (3)

query II nosort
SELECT a, b FROM k
----
3
30

# the result is coerced to the column's typmod: numeric(4,1) rounds, varchar(2) is 22001
statement ok
CREATE TABLE tm (a numeric(5,2), b numeric(4,1) GENERATED ALWAYS AS (a * 3) STORED, v varchar(2) GENERATED ALWAYS AS (a::text) STORED)

statement error 22001
INSERT INTO tm (a) VALUES (1.25)

statement ok
ALTER TABLE tm DROP COLUMN v

statement ok
INSERT INTO tm (a) VALUES (1.25)

query DD nosort
SELECT a, b FROM tm
----
1.25
3.8

# --- ALTER TABLE … ADD COLUMN … GENERATED: existing rows are backfilled ---------------------------

statement ok
CREATE TABLE ac (id int PRIMARY KEY, s text)

statement ok
INSERT INTO ac VALUES (1, 'a'), (2, NULL)

statement ok
ALTER TABLE ac ADD COLUMN g text GENERATED ALWAYS AS (s || '!') STORED

statement ok
INSERT INTO ac (id, s) VALUES (3, 'c')

query ITT nosort
SELECT id, s, g FROM ac ORDER BY id
----
1
a
a!
2
NULL
NULL
3
c
c!

# the backfill is validated like any ADD COLUMN: a NULL into NOT NULL is 23502
statement error 23502
ALTER TABLE ac ADD COLUMN n int NOT NULL GENERATED ALWAYS AS (length(s)) STORED

# ... and a CHECK over the computed values is 23514
statement error 23514
ALTER TABLE ac ADD COLUMN n int GENERATED ALWAYS AS (id) STORED CHECK (n < 3)

# --- SET DEFAULT / DROP DEFAULT on a generated column are 42601 -----------------------------------

statement error 42601
ALTER TABLE t ALTER COLUMN b SET DEFAULT 1

statement error 42601
ALTER TABLE t ALTER COLUMN b DROP DEFAULT

# --- columns a generated column references --------------------------------------------------------

# ALTER TYPE of a referenced column is 0A000
statement error 0A000
ALTER TABLE t ALTER COLUMN a TYPE bigint

# ALTER TYPE … USING of the generated column itself is 42611
statement error 42611
ALTER TABLE t ALTER COLUMN b TYPE bigint USING b

# RENAME rewrites the stored expression
statement ok
ALTER TABLE t RENAME COLUMN a TO z

statement ok
INSERT INTO t (z, c) VALUES (7, 'w')

query IIT nosort
SELECT z, b, c FROM t WHERE c = 'w'
----
7
14
w

# DROP COLUMN of a referenced column is 2BP01 without CASCADE ...
statement error 2BP01
ALTER TABLE t DROP COLUMN z

# ... and drops the generated column too with CASCADE
statement ok
ALTER TABLE t DROP COLUMN z CASCADE

query T nosort
SELECT c FROM t ORDER BY c
----
w
x
y
z

statement error 42703
SELECT b FROM t

# dropping the generated column itself needs nothing extra
statement ok
CREATE TABLE dg (a int, b int GENERATED ALWAYS AS (a) STORED)

statement ok
ALTER TABLE dg DROP COLUMN b

statement ok
INSERT INTO dg VALUES (1)

# --- DROP EXPRESSION: the column becomes ordinary and keeps its values -----------------------------

statement ok
CREATE TABLE de (a int, b int GENERATED ALWAYS AS (a + 100) STORED)

statement ok
INSERT INTO de (a) VALUES (1)

statement ok
ALTER TABLE de ALTER COLUMN b DROP EXPRESSION

statement ok
INSERT INTO de VALUES (2, 5)

statement ok
UPDATE de SET a = 50 WHERE a = 1

query II nosort
SELECT a, b FROM de ORDER BY a
----
2
5
50
101

# DROP EXPRESSION on a column that is not generated is 55000 ...
statement error 55000
ALTER TABLE de ALTER COLUMN a DROP EXPRESSION

# ... and IF EXISTS makes it a no-op
statement ok
ALTER TABLE de ALTER COLUMN a DROP EXPRESSION IF EXISTS

# --- NOT NULL can be set and dropped; an index on a generated column ------------------------------

statement ok
CREATE TABLE nn (a int, b int GENERATED ALWAYS AS (a) STORED)

statement ok
INSERT INTO nn (a) VALUES (1)

statement ok
ALTER TABLE nn ALTER COLUMN b SET NOT NULL

statement error 23502
INSERT INTO nn (a) VALUES (NULL)

statement ok
ALTER TABLE nn ALTER COLUMN b DROP NOT NULL

statement ok
CREATE INDEX nn_b ON nn (b)

statement ok
INSERT INTO nn (a) VALUES (NULL), (4)

query I nosort
SELECT a FROM nn WHERE b = 4
----
4
