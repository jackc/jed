# Reverse FK probes over inline-compressed, external-plain, and external-compressed child values.
# Sixteen copies of each 600-byte key force the child's first text column through these forms
# at the default page size. Each parent row fits without spilling; storage is row-dependent.
# requires: ddl.create_table, ddl.primary_key, ddl.unique, ddl.foreign_key, dml.insert, dml.insert_multi_row, dml.insert_select, dml.delete, dml.update, query.select, query.order_by, types.i32, types.text

statement ok
CREATE TABLE large_parents (id i32 PRIMARY KEY, k text UNIQUE)

statement ok
CREATE TABLE large_children (id i32 PRIMARY KEY, k text REFERENCES large_parents(k), pad1 text, pad2 text, pad3 text, pad4 text, pad5 text, pad6 text, pad7 text, pad8 text, pad9 text, pad10 text, pad11 text, pad12 text, pad13 text, pad14 text, pad15 text)

