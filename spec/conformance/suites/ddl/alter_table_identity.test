# ALTER TABLE identity management (spec/design/alter.md §2.8): ALTER [COLUMN] c ADD GENERATED
# { ALWAYS | BY DEFAULT } AS IDENTITY [( sequence_options )], SET GENERATED { ALWAYS | BY DEFAULT },
# SET <sequence_option> / RESTART [[WITH] n], and DROP IDENTITY [IF EXISTS]. ADD needs a NOT NULL,
# default-less integer column and creates the owned sequence; SET edits it as ALTER SEQUENCE does,
# bounded by the column type; DROP removes it and the identity default, keeping NOT NULL.
# Oracle-checked. The introspection (jed_columns.identity_generation, jed_sequences) lives in
# introspection/jed_columns.test and introspection/jed_sequences.test.
# requires: ddl.alter_identity, ddl.alter_table, ddl.identity, ddl.serial, ddl.sequence, ddl.check, func.sequence, ddl.create_table, ddl.drop_table, ddl.primary_key, ddl.not_null, ddl.column_default, dml.insert, dml.insert_column_list, dml.update, query.select, query.order_by, types.i16, types.i32, types.i64, types.text

statement ok
CREATE TABLE ai (id int NOT NULL, v text)

statement ok
INSERT INTO ai VALUES (100, 'old')

# Existing rows keep their values; new rows draw from the new owned sequence <table>_<column>_seq.
statement ok
ALTER TABLE ai ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY

statement ok
INSERT INTO ai (v) VALUES ('a'), ('b')

query IT rowsort
SELECT id, v FROM ai
----
1
a
100
old
2
b

statement error 428C9
INSERT INTO ai (id, v) VALUES (7, 'x')

statement error 428C9
UPDATE ai SET id = 7 WHERE v = 'a'

statement ok
INSERT INTO ai (id, v) OVERRIDING SYSTEM VALUE VALUES (7, 'sys')

query I nosort
SELECT nextval('ai_id_seq')
----
3

# --- SET GENERATED flips ALWAYS / BY DEFAULT -----------------------------------------------------

statement ok
ALTER TABLE ai ALTER id SET GENERATED BY DEFAULT

statement ok
INSERT INTO ai (id, v) VALUES (8, 'explicit')

statement ok
UPDATE ai SET id = 9 WHERE v = 'explicit'

statement ok
ALTER TABLE ai ALTER id SET GENERATED ALWAYS

statement error 428C9
INSERT INTO ai (id, v) VALUES (10, 'x')

# --- SET <sequence_option> and RESTART edit the owned sequence -----------------------------------

statement ok
ALTER TABLE ai ALTER id RESTART WITH 50

statement ok
INSERT INTO ai (v) VALUES ('r50')

statement ok
ALTER TABLE ai ALTER id SET INCREMENT BY 10 SET START WITH 1000

statement ok
INSERT INTO ai (v) VALUES ('r60')

# A bare RESTART goes back to the (new) START.
statement ok
ALTER TABLE ai ALTER COLUMN id RESTART

statement ok
INSERT INTO ai (v) VALUES ('r1000')

# Options, RESTART, and SET GENERATED combine order-free in one action.
statement ok
ALTER TABLE ai ALTER id RESTART 5 SET GENERATED BY DEFAULT SET INCREMENT 1

statement ok
INSERT INTO ai (v) VALUES ('r5')

statement ok
INSERT INTO ai (id, v) VALUES (6, 'by default again')

query IT nosort
SELECT id, v FROM ai ORDER BY id
----
1
a
2
b
5
r5
6
by default again
7
sys
9
explicit
50
r50
60
r60
100
old
1000
r1000

# The identity sequence's type is the column's: an explicit bound outside integer is 22023, and
# NO MAXVALUE restores the integer maximum.
statement error 22023
ALTER TABLE ai ALTER id SET MAXVALUE 3000000000

statement ok
ALTER TABLE ai ALTER id SET MAXVALUE 2000 SET MINVALUE 0

statement error 22023
ALTER TABLE ai ALTER id SET MAXVALUE 4

statement ok
ALTER TABLE ai ALTER id SET NO MAXVALUE

statement ok
SELECT setval('ai_id_seq', 2147483647)

statement error 2200H
INSERT INTO ai (v) VALUES ('past the end')

statement error 22023
ALTER TABLE ai ALTER id SET INCREMENT 0

statement error 22023
ALTER TABLE ai ALTER id SET CACHE 0

statement error 22023
ALTER TABLE ai ALTER id SET START 0 RESTART 0 SET MINVALUE 5

# Repeated or unsupported identity options are 42601.
statement error 42601
ALTER TABLE ai ALTER id SET GENERATED ALWAYS SET GENERATED BY DEFAULT

statement error 42601
ALTER TABLE ai ALTER id SET INCREMENT 2 SET INCREMENT 3

statement error 42601
ALTER TABLE ai ALTER id RESTART 1 RESTART 2

statement error 42601
ALTER TABLE ai ALTER id SET AS bigint

statement error 42601
ALTER TABLE ai ALTER id SET RESTART

statement error 42601
ALTER TABLE ai ALTER id SET SEQUENCE NAME other_seq

# --- ADD GENERATED prerequisites ----------------------------------------------------------------

statement ok
CREATE TABLE ap (a int, b text NOT NULL, c int NOT NULL DEFAULT 5, d serial, e int NOT NULL)

statement error 42703
ALTER TABLE ap ALTER COLUMN missing ADD GENERATED ALWAYS AS IDENTITY

# The sequence is defined first, so the type gate wins over the missing NOT NULL.
statement error 22023
ALTER TABLE ap ALTER b ADD GENERATED ALWAYS AS IDENTITY

statement error 55000
ALTER TABLE ap ALTER a ADD GENERATED ALWAYS AS IDENTITY

statement error 55000
ALTER TABLE ap ALTER c ADD GENERATED BY DEFAULT AS IDENTITY

# A serial column already has its nextval default.
statement error 55000
ALTER TABLE ap ALTER d ADD GENERATED BY DEFAULT AS IDENTITY

statement error 42601
ALTER TABLE ap ALTER e ADD GENERATED ALWAYS AS IDENTITY (AS bigint)

statement error 22023
ALTER TABLE ap ALTER e ADD GENERATED ALWAYS AS IDENTITY (INCREMENT 0)

statement ok
ALTER TABLE ap ALTER e ADD GENERATED BY DEFAULT AS IDENTITY (START WITH 10 INCREMENT BY 5)

statement error 55000
ALTER TABLE ap ALTER e ADD GENERATED ALWAYS AS IDENTITY

# An option error still precedes "already an identity column".
statement error 42601
ALTER TABLE ap ALTER e ADD GENERATED ALWAYS AS IDENTITY (AS bigint)

statement ok
INSERT INTO ap (b) VALUES ('first'), ('second')

query TII rowsort
SELECT b, d, e FROM ap
----
first
1
10
second
2
15

# Dropping the default first makes the column eligible, left to right in one statement.
statement ok
ALTER TABLE ap ALTER c DROP DEFAULT, ALTER c ADD GENERATED ALWAYS AS IDENTITY

statement ok
INSERT INTO ap (b) VALUES ('third')

query TI nosort
SELECT b, c FROM ap ORDER BY b
----
first
5
second
5
third
1

# --- SET / DROP on a column that is not an identity column ---------------------------------------

statement error 55000
ALTER TABLE ap ALTER a SET GENERATED ALWAYS

statement error 55000
ALTER TABLE ap ALTER a RESTART

statement error 55000
ALTER TABLE ap ALTER a DROP IDENTITY

statement error 42703
ALTER TABLE ap ALTER missing DROP IDENTITY IF EXISTS

statement ok
ALTER TABLE ap ALTER a DROP IDENTITY IF EXISTS

# --- DROP IDENTITY ------------------------------------------------------------------------------

# The owned sequence and the identity default go; NOT NULL stays.
statement ok
ALTER TABLE ap ALTER COLUMN e DROP IDENTITY

statement error 42P01
SELECT nextval('ap_e_seq')

statement error 23502
INSERT INTO ap (b) VALUES ('no e')

statement ok
INSERT INTO ap (b, e) VALUES ('explicit e', 99)

statement ok
ALTER TABLE ap ALTER e SET DEFAULT 42

statement ok
INSERT INTO ap (b) VALUES ('default e')

query TI nosort
SELECT b, e FROM ap WHERE e > 20 ORDER BY b
----
default e
42
explicit e
99

# DROP then ADD in one statement replaces the sequence; the released name is reused.
statement ok
ALTER TABLE ap ALTER c DROP IDENTITY, ALTER c ADD GENERATED BY DEFAULT AS IDENTITY (START 500)

query I nosort
SELECT nextval('ap_c_seq')
----
500

# ADD then SET in one statement sees the new identity.
statement ok
CREATE TABLE am (id bigint NOT NULL)

statement ok
ALTER TABLE am ALTER id ADD GENERATED ALWAYS AS IDENTITY, ALTER id SET GENERATED BY DEFAULT RESTART 7

statement ok
INSERT INTO am VALUES (DEFAULT), (1)

query I nosort
SELECT id FROM am ORDER BY id
----
1
7

statement ok
CREATE TABLE ad (id int NOT NULL)

statement ok
ALTER TABLE ad ADD COLUMN n smallint NOT NULL

statement ok
ALTER TABLE ad ALTER n ADD GENERATED ALWAYS AS IDENTITY (MAXVALUE 100)

statement ok
INSERT INTO ad (id) VALUES (1)

query II nosort
SELECT id, n FROM ad
----
1
1

statement error 22023
ALTER TABLE ad ALTER n SET MAXVALUE 40000

# --- all-or-nothing -----------------------------------------------------------------------------

statement ok
CREATE TABLE aa (id int NOT NULL)

statement ok
INSERT INTO aa VALUES (1)

statement error 23514
ALTER TABLE aa ALTER id ADD GENERATED ALWAYS AS IDENTITY, ADD CHECK (id > 5)

statement error 42P01
SELECT nextval('aa_id_seq')

statement ok
INSERT INTO aa VALUES (2)

# --- SEQUENCE NAME ------------------------------------------------------------------------------

statement ok
ALTER TABLE aa ALTER id ADD GENERATED BY DEFAULT AS IDENTITY (SEQUENCE NAME aa_custom_seq START 30)

query I nosort
SELECT nextval('aa_custom_seq')
----
30

statement ok
CREATE TABLE an (id int NOT NULL, k int GENERATED ALWAYS AS IDENTITY (SEQUENCE NAME an_k_custom))

statement error 42P07
ALTER TABLE an ALTER id ADD GENERATED ALWAYS AS IDENTITY (SEQUENCE NAME aa_custom_seq)

statement error 42P07
ALTER TABLE an ALTER id ADD GENERATED ALWAYS AS IDENTITY (SEQUENCE NAME an)

statement error 42601
ALTER TABLE an ALTER id ADD GENERATED ALWAYS AS IDENTITY (SEQUENCE NAME x SEQUENCE NAME y)

statement error 42601
CREATE SEQUENCE plain_seq SEQUENCE NAME other

query I nosort
SELECT nextval('an_k_custom')
----
1

# --- dependency handling ------------------------------------------------------------------------

statement error 2BP01
DROP SEQUENCE aa_custom_seq

statement ok
DROP TABLE aa

statement error 42P01
SELECT nextval('aa_custom_seq')

# A primary key column is NOT NULL, so it can become an identity column.
statement ok
CREATE TABLE pk (id int PRIMARY KEY, v text)

statement ok
INSERT INTO pk VALUES (1, 'one'), (2, 'two')

statement ok
ALTER TABLE pk ALTER id ADD GENERATED BY DEFAULT AS IDENTITY

statement error 23505
INSERT INTO pk (v) VALUES ('collides')

statement ok
ALTER TABLE pk ALTER id RESTART WITH 3

statement ok
INSERT INTO pk (v) VALUES ('three')

query IT nosort
SELECT id, v FROM pk ORDER BY id
----
1
one
2
two
3
three

# A retype after ADD in one statement retypes the pending sequence.
statement ok
CREATE TABLE rt (id smallint NOT NULL)

statement ok
ALTER TABLE rt ALTER id ADD GENERATED ALWAYS AS IDENTITY, ALTER id TYPE bigint

statement ok
SELECT setval('rt_id_seq', 40000)

query I nosort
SELECT nextval('rt_id_seq')
----
40001
