# REINDEX INDEX / REINDEX TABLE — rebuild secondary indexes in place from their stored definitions
# (spec/design/indexes.md §10, grammar.md §59). A rebuild is observably a no-op on rows: every query
# answers exactly as before, through the rebuilt index. Its cost is exactly the CREATE INDEX build scan
# of each rebuilt index (page_read per table node + storage_row_read per row over the touched set),
# summed in catalog order. Every index kind rebuilds: B-tree, UNIQUE (the UNIQUE constraint's backing
# index too), expression, partial, GIN, GiST, and the GiST index backing an EXCLUDE constraint.
# The DATABASE / SYSTEM / CONCURRENTLY forms, which PostgreSQL refuses inside a transaction block (the
# oracle probes every record inside one), and the transactional / privilege / temp / attachment cases
# are in reindex_jed.test.
# requires: ddl.reindex, ddl.create_table, ddl.primary_key, ddl.secondary_index, ddl.unique, ddl.index_expr, ddl.index_partial, ddl.gin_index, ddl.gist_index, ddl.exclusion_constraint, ddl.sequence, ddl.view, dml.insert, dml.insert_multi_row, query.select, query.where_eq, query.order_by, query.gin_scan, query.gist_scan, func.array_containment, func.range_operators, types.i32, types.text, types.array, types.range, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a i32, email text, tags i32[], span int4range)

statement ok
INSERT INTO t VALUES (1, 10, 'A@x', ARRAY[1, 2], '[1,5)'), (2, 20, 'b@x', ARRAY[3], '[6,8)'), (3, 10, NULL, NULL, NULL)

statement ok
CREATE INDEX t_a ON t (a)

statement ok
CREATE UNIQUE INDEX t_email ON t (lower(email))

statement ok
CREATE INDEX t_part ON t (a) WHERE a > 15

statement ok
CREATE INDEX t_tags ON t USING gin (tags)

statement ok
CREATE INDEX t_span ON t USING gist (span)

# --- REINDEX INDEX: one index, charged its build scan -------------------------------------------

# page_read(1) + 3 storage_row_read = 4, exactly CREATE INDEX t_a's build
# cost: 4
statement ok
REINDEX INDEX t_a

query I rowsort
SELECT id FROM t WHERE a = 10
----
1
3

# cost: 4
statement ok
REINDEX INDEX t_email

query I nosort
SELECT id FROM t WHERE lower(email) = 'a@x'
----
1

# the rebuilt UNIQUE index still enforces uniqueness
statement error 23505
INSERT INTO t VALUES (4, 30, 'a@X', NULL, NULL)

# cost: 4
statement ok
REINDEX INDEX t_part

query I nosort
SELECT id FROM t WHERE a > 15
----
2

# cost: 4
statement ok
REINDEX INDEX t_tags

query I nosort
SELECT id FROM t WHERE tags @> ARRAY[3]
----
2

# cost: 4
statement ok
REINDEX INDEX t_span

query I nosort
SELECT id FROM t WHERE span && '[2,3)'::int4range
----
1

# --- REINDEX TABLE: every index of the table, in catalog order -----------------------------------

# five indexes, each page_read(1) + 3 rows: 5 * 4 = 20
# cost: 20
statement ok
REINDEX TABLE t

query I nosort
SELECT id FROM t WHERE a = 20
----
2

query I nosort
SELECT id FROM t ORDER BY id
----
1
2
3

# a table with no secondary index is a zero-cost success (PostgreSQL's notice has no jed channel)
statement ok
CREATE TABLE bare (id i32 PRIMARY KEY, v i32)

statement ok
INSERT INTO bare VALUES (1, 1)

# cost: 0
statement ok
REINDEX TABLE bare

# the options list: VERBOSE has no observable effect; a repeated option is accepted (last wins)
statement ok
REINDEX (VERBOSE) TABLE t

statement ok
REINDEX (VERBOSE false, VERBOSE on) INDEX t_a

statement ok
REINDEX (VERBOSE 1) INDEX t_a

# --- UNIQUE and EXCLUDE constraints keep their backing index -----------------------------------

statement ok
CREATE TABLE u (id i32 PRIMARY KEY, code i32 UNIQUE, span int4range, EXCLUDE USING gist (span WITH &&))

statement ok
INSERT INTO u VALUES (1, 100, '[1,3)'), (2, 200, '[5,9)')

statement ok
REINDEX TABLE u

statement error 23505
INSERT INTO u VALUES (3, 100, '[20,30)')

statement error 23P01
INSERT INTO u VALUES (3, 300, '[2,4)')

statement ok
INSERT INTO u VALUES (3, 300, '[10,12)')

query II nosort
SELECT id, code FROM u ORDER BY id
----
1
100
2
200
3
300

# --- errors ---------------------------------------------------------------------------------------

statement error 42P01
REINDEX INDEX nosuch

statement error 42P01
REINDEX TABLE nosuch

# a table, view, or sequence is not an index
statement error 42809
REINDEX INDEX t

statement ok
CREATE VIEW v AS SELECT id FROM t

statement ok
CREATE SEQUENCE s

statement error 42809
REINDEX INDEX v

statement error 42809
REINDEX INDEX s

# an index, view, or sequence is not a table
statement error 42809
REINDEX TABLE t_a

statement error 42809
REINDEX TABLE v

statement error 42809
REINDEX TABLE s

# an unknown option, or a non-boolean option value, is a syntax error
statement error 42601
REINDEX (bogus) TABLE t

statement error 42601
REINDEX (VERBOSE maybe) TABLE t

statement error 42601
REINDEX TABLE

statement error 42601
REINDEX t
