# GROUPS mode for contrast: offsets count peer groups, so the NULL peer group is the group after k=3 and
# id3 sees {4,5}=9 under 1 FOLLOWING .. 2 FOLLOWING; the NULL rows have no following group.
# names: id, s
# cost: 23
query II nosort
SELECT id, sum(id) OVER (ORDER BY k GROUPS BETWEEN 1 FOLLOWING AND 2 FOLLOWING) AS s FROM w ORDER BY id
----
1
5
2
12
3
9
4
NULL
5
NULL

# EXCLUDE TIES drops the NULL row's peer (id4 keeps itself), EXCLUDE GROUP empties the NULL rows' frame.
# names: id, t, g
# cost: 29
query III nosort
SELECT id, sum(id) OVER (ORDER BY k RANGE BETWEEN 1 FOLLOWING AND 2 FOLLOWING EXCLUDE TIES) AS t, sum(id) OVER (ORDER BY k RANGE BETWEEN 2 PRECEDING AND 1 PRECEDING EXCLUDE GROUP) AS g FROM w ORDER BY id
----
1
5
NULL
2
3
1
3
NULL
3
4
4
NULL
5
5
NULL

# EXCLUDE CURRENT ROW over the overshooting frame: id3's frame (the NULLs) never held it, the NULL rows lose
# themselves.
# names: id, s
# cost: 27
query II nosort
SELECT id, sum(id) OVER (ORDER BY k RANGE BETWEEN 1 FOLLOWING AND UNBOUNDED FOLLOWING EXCLUDE CURRENT ROW) AS s FROM w ORDER BY id
----
1
14
2
12
3
9
4
5
5
4

# FILTER over the overshooting frame.
# names: id, s
# cost: 42
query II nosort
SELECT id, sum(id) FILTER (WHERE id <> 2) OVER (ORDER BY k RANGE BETWEEN 1 FOLLOWING AND UNBOUNDED FOLLOWING) AS s FROM w ORDER BY id
----
1
12
2
12
3
9
4
9
5
9

# A decimal key: the NULL placement rule is type-independent (id3 at 3.5 overshoots to the NULLs).
# names: id, s
# cost: 31
query ID nosort
SELECT id, sum(d) OVER (ORDER BY d RANGE BETWEEN 0.5 FOLLOWING AND UNBOUNDED FOLLOWING) AS s FROM wd ORDER BY id
----
1
5.5
2
3.5
3
NULL
4
NULL

# Partitions: each partition's NULLs sit at its own edge (NULLS LAST here), so an overshot start stops at the
# partition's first NULL row and never crosses into the next partition.
# names: id, s
# cost: 25
query II nosort
SELECT id, sum(id) OVER (PARTITION BY p ORDER BY k RANGE BETWEEN 1 FOLLOWING AND UNBOUNDED FOLLOWING) AS s FROM wp ORDER BY id
----
1
5
2
3
3
3
4
11
5
5
6
5

# Partitions, NULLS FIRST, expanding frame with an offset end.
# names: id, s
# cost: 25
query II nosort
SELECT id, sum(id) OVER (PARTITION BY p ORDER BY k NULLS FIRST RANGE BETWEEN UNBOUNDED PRECEDING AND 1 FOLLOWING) AS s FROM wp ORDER BY id
----
1
6
2
6
3
3
4
15
5
5
6
15
