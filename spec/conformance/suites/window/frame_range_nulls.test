# NULLS FIRST, both bounds PRECEDING: the start skips the NULLs, the end stops before the current key.
# names: id, mn, mx
# cost: 29
query III nosort
SELECT id, min(id) OVER (ORDER BY k NULLS FIRST RANGE BETWEEN 2 PRECEDING AND 1 PRECEDING) AS mn, max(id) OVER (ORDER BY k NULLS FIRST RANGE BETWEEN 2 PRECEDING AND 1 PRECEDING) AS mx FROM w ORDER BY id
----
1
NULL
NULL
2
1
1
3
1
2
