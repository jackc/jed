# DESC (NULLS FIRST by default): the leading NULLs are inside every UNBOUNDED PRECEDING frame — id1 (k=1)
# sees {4,5,3,2}=14 under 1 PRECEDING, i.e. keys >= 2.
# names: id, s
# cost: 20
query II nosort
SELECT id, sum(id) OVER (ORDER BY k DESC RANGE BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS s FROM w ORDER BY id
----
1
14
2
12
3
9
4
9
5
9

# DESC NULLS LAST with an UNBOUNDED FOLLOWING end: every non-NULL row reaches the trailing NULLs.
# names: id, s
# cost: 27
query II nosort
SELECT id, sum(id) OVER (ORDER BY k DESC NULLS LAST RANGE BETWEEN 1 PRECEDING AND UNBOUNDED FOLLOWING) AS s FROM w ORDER BY id
----
1
12
2
15
3
15
4
9
5
9

# DESC NULLS LAST, FOLLOWING .. FOLLOWING (keys below the current one): id1's start overshoots to the NULLs.
# names: id, a
# cost: 44
query IT nosort
SELECT id, array_agg(id) OVER (ORDER BY k DESC NULLS LAST RANGE BETWEEN 1 FOLLOWING AND 2 FOLLOWING)::text AS a FROM w ORDER BY id
----
1
NULL
2
{1}
3
{2,1}
4
{4,5}
5
{4,5}

# ASC NULLS LAST, both bounds PRECEDING and PRECEDING .. FOLLOWING: the trailing NULLs are never reached by
# an offset end.
# names: id, a, b
# cost: 32
query III nosort
SELECT id, sum(id) OVER (ORDER BY k RANGE BETWEEN 2 PRECEDING AND 1 PRECEDING) AS a, sum(id) OVER (ORDER BY k RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS b FROM w ORDER BY id
----
1
NULL
3
2
1
6
