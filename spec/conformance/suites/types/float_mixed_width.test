# Mixed-width float comparisons and arithmetic: f32 meets f64 (spec/design/float.md §2,
# spec/design/cost.md "Mixed-width floats"). The values follow PostgreSQL: the f32 operand widens
# EXACTLY to f64 (float4 → float8), then the pair compares under the total order (-0 = +0,
# NaN = NaN, NaN the largest) or computes at f64. So 0.1::f32 (0.100000001490116…) is NOT equal to
# 0.1::f64, and 16777217 stored as f32 rounds to 16777216 first.
#
# The widening is metered and planned identically in every core:
#   - A comparison operator (= <> < <= > >=, IS [NOT] DISTINCT FROM, and the IN-list / BETWEEN /
#     simple-CASE comparisons that desugar to them), an arithmetic operator, and a float function
#     that computes at f64 wrap the f32 operand in an implicit f32 → f64 CAST node, which charges
#     one operator_eval each time it is evaluated. Two f32 operands need no cast.
#   - A comparison inside one node against values it did not resolve as operands — NULLIF, a row
#     or record comparison, = ANY / ALL over an array or a subquery, IN (subquery) — widens the
#     values inside that node and charges nothing extra (as the set-operation unification does).
#   - A cast operand is not a key source, so `f32col = f64value` (or the reverse) never bounds an
#     index or an index-nested-loop inner: it scans, and the comparison is the residual filter.
# Oracle-checked against PostgreSQL 18 (rows only — cost is jed's). Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.secondary_index, dml.insert, dml.insert_multi_row, query.select, query.select_no_from, query.where_eq, query.comparison_order, query.order_by, query.qualified_column, query.join_inner, query.join_left, query.join_using, query.hash_join, query.index_nested_loop, query.subquery_scalar, query.subquery_in, query.subquery_exists, query.subquery_correlated, query.subquery_quantified, query.aggregates, query.aggregate_filter, query.group_by, query.group_by_expr, query.union, query.is_distinct_from, types.composite_bare_row, expr.in_list, expr.between, expr.case, expr.nullif, expr.arithmetic, expr.unary_minus, cast.operator, cast.string_literal, types.i32, types.f32, types.f64, types.array, null.three_valued, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a f32, b f64)

statement ok
INSERT INTO t VALUES (1, 1.5, 1.5), (2, 0.1, 0.1), (3, 'NaN', 'NaN'), (4, '-0', '0'), (5, 'Infinity', 'Infinity'), (6, '-Infinity', 1e300), (7, NULL, 1)

statement ok
CREATE TABLE u (id i32 PRIMARY KEY, a f32, b f64)

statement ok
INSERT INTO u VALUES (1, 1.5, 1.5), (2, 0.1, 0.1), (3, 'NaN', 'NaN'), (4, '0', '-0'), (5, 16777217, 16777217)

statement ok
CREATE INDEX u_a ON u (a)

statement ok
CREATE INDEX u_b ON u (b)

