# --- access paths: a cast operand never bounds a key ----------------------------------------------

# u_a holds f32 keys; the f64 probe is compared after widening, so it scans (16777217 as f32 is
# 16777216, which equals no f64 16777217).
# cost: 22
query I nosort
SELECT id FROM u WHERE a = 1.5::f64 ORDER BY id
----
1

# cost: 21
query I nosort
SELECT id FROM u WHERE a = 16777217::f64 ORDER BY id
----

# cost: 22
query I nosort
SELECT id FROM u WHERE b = 1.5::f32 ORDER BY id
----
1

# cost: 25
query I nosort
SELECT id FROM u WHERE a > 0.1::f64 ORDER BY id
----
1
2
3
5

# cost: 23
query I nosort
SELECT id FROM u WHERE b < 0.1::f32 ORDER BY id
----
2
4

# cost: 56
query I nosort
SELECT id FROM u WHERE a IN (1.5::f64, 0.1::f64, 16777217::f64) ORDER BY id
----
1

# A same-width f32 equality does bound the f32 index.
# cost: 5
query I nosort
SELECT id FROM u WHERE a = 1.5 ORDER BY id
----
1

