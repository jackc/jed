# Array comparison across element types (spec/design/array.md §5). Two arrays are comparable iff they
# share the SAME element type, or their element types differ only in integer width — the one
# difference that leaves every element value untouched, which is what lets a bare `ARRAY[1,2]` (an
# i64[]: a bare integer literal defaults to i64, types.md §6) compare with an i32[] column the way
# PostgreSQL's int4-typed literal does. Every other pair is 42804 at resolve time — even where the
# scalar pair is comparable (`f32 = f64` widens, `i32 = decimal` promotes): PostgreSQL has no
# cross-element-type array operator (`real[] = double precision[]` is its 42883), so jed does not
# invent an element-wise widening. Rejection applies to every comparison form: = <> < IS DISTINCT FROM.
# PostgreSQL rejects these pairs too, as 42883; the code difference is ledgered
# (oracle_overrides.toml), as is the typed integer-width pair PostgreSQL rejects and jed compares.
# Format: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.where_eq, query.comparison_order, query.is_distinct_from, expr.not_equal, expr.comparison_value, cast.operator, types.array, types.f32, types.f64, types.i32, types.i64, types.decimal

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a f32[], b f64[], d i32[], e i64[], g decimal[])

statement ok
INSERT INTO t VALUES (1, '{0.1,1.5}', '{0.1,1.5}', '{1,2}', '{1,2}', '{1,2}')

# --- f32[] × f64[]: no array operator across float widths ----------------------------------------
statement error 42804
SELECT id FROM t WHERE a = b

statement error 42804
SELECT id FROM t WHERE b <> a

statement error 42804
SELECT id FROM t WHERE a < b

statement error 42804
SELECT id FROM t WHERE a IS DISTINCT FROM b

statement error 42804
SELECT '{1.5}'::f32[] = '{1.5}'::f64[]

# --- i32[] × decimal[]: no array operator across numeric families ---------------------------------
statement error 42804
SELECT id FROM t WHERE d = g

statement error 42804
SELECT '{1}'::i32[] = '{1}'::decimal[]

# --- the same element type compares element-wise ----------------------------------------------------
query B nosort
SELECT a = '{0.1,1.5}'::f32[] FROM t
----
true

query B nosort
SELECT b = '{0.1,1.5}'::f64[] FROM t
----
true

# --- integer widths compare by value: a bare ARRAY[…] of integer literals against an i32[] column ---
query I nosort
SELECT id FROM t WHERE d = ARRAY[1, 2]
----
1

query B nosort
SELECT d < ARRAY[1, 3] FROM t
----
true

# Two typed integer-width arrays also compare by value (PostgreSQL: no integer[] = bigint[] operator).
query B nosort
SELECT d = e FROM t
----
true
