# A column-definition list on unnest(record[]) (spec/design/composite.md §13): unnest over an array of
# anonymous records is a function returning `record`, so in FROM it takes PostgreSQL's
# column-definition list — `unnest(arr) AS u(a i32, b text)` — which names and types the relation's
# columns; each element's fields spread over them, and a NULL element is a row of NULLs. Without the
# list it is 42601; a list on any other unnest is 42601. A field count or field type that does not
# match the list is 42804; a duplicate column name is 42701. The alias-less form `AS (a i32, …)` keeps
# the function's name as the relation label (json_to_record takes it too). String fields are cast to
# text: PostgreSQL leaves a bare literal inside ROW(…) `unknown`, which matches no declared type.
# Results verified against PostgreSQL 18.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_star, query.where_eq, query.order_by, query.qualified_column, query.table_alias, query.aggregates, query.group_by, query.join_inner, query.lateral, query.subquery_scalar, query.cte, query.derived_table, func.unnest, func.array, func.array_agg, func.coldeflist, func.json_record, func.unnest_record, types.record_column, types.composite, types.array, types.i16, types.i32, types.i64, types.text, types.decimal, types.jsonb, resource.cost_metering

# Each element charges one generated_row at the source, like unnest (cost.md §3).
# cost: 7
query IT nosort
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text), ROW(2, 'b'::text)]) AS u(a i32, b text) ORDER BY a
----
1
a
2
b

# The declared columns are qualified by the alias and usable anywhere a column is.
query TI nosort
SELECT u.b, u.a * 10 FROM unnest(ARRAY[ROW(1, 'a'::text), ROW(2, 'b'::text)]) AS u(a i32, b text) WHERE u.a > 1
----
b
20

# Without AS, and with AS but no alias name.
query IT nosort
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text)]) u(a i32, b text)
----
1
a

query IT nosort
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text)]) AS (a i32, b text)
----
1
a

query IT nosort
SELECT unnest.a, unnest.b FROM unnest(ARRAY[ROW(1, 'a'::text)]) AS (a i32, b text)
----
1
a

# A NULL element is a row of NULLs.
query IT nosort
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text), NULL]) AS u(a i32, b text) ORDER BY a
----
1
a
NULL
NULL

# A NULL field.
query IT nosort
SELECT * FROM unnest(ARRAY[ROW(1, NULL::text)]) AS u(a i32, b text)
----
1
NULL

# Array, numeric, and jsonb fields; a type modifier is accepted.
query ITDT nosort
SELECT * FROM unnest(ARRAY[ROW(1, ARRAY[1, 2], 1.25, '{"k": 1}'::jsonb)]) AS u(a i32, b i32[], c decimal(6,2), d jsonb)
----
1
{1,2}
1.25
{"k": 1}

# The relation over table data: an array of records built per group, expanded again.
statement ok
CREATE TABLE t (id i32 PRIMARY KEY, g i32, name text)

statement ok
INSERT INTO t VALUES (1, 1, 'x'), (2, 1, 'y'), (3, 2, 'z')

query IIT nosort
SELECT s.g, u.id, u.name FROM (SELECT g, array_agg(ROW(id, name) ORDER BY id) AS rs FROM t GROUP BY g) s, unnest(s.rs) AS u(id i32, name text) ORDER BY u.id
----
1
1
x
1
2
y
2
3
z

query IT nosort
WITH c AS (SELECT array_agg(ROW(id, name) ORDER BY id) AS rs FROM t)
SELECT u.id, u.name FROM c, unnest(c.rs) AS u(id i32, name text) WHERE u.id <> 2 ORDER BY u.id
----
1
x
3
z

# A NULL array (array_agg over no rows) yields no rows.
query I nosort
SELECT count(*) FROM unnest((SELECT array_agg(ROW(id, name)) FROM t WHERE id > 5)) AS u(id i32, name text)
----
0

# Correlated: one expansion per outer row.
query II nosort
SELECT t.id, (SELECT count(*) FROM unnest(ARRAY[ROW(t.id, t.name), ROW(t.g, t.name)]) AS u(a i32, b text) WHERE u.a = 1) FROM t ORDER BY t.id
----
1
2
2
1
3
0

# A named composite element as a field.
statement ok
CREATE TYPE pt AS (x i32, y i32)

query IT nosort
SELECT u.n, u.p FROM unnest(ARRAY[ROW(1, '(2,3)'::pt)]) AS u(n i32, p pt)
----
1
(2,3)

# --- Errors ------------------------------------------------------------------------------------

# A record-returning unnest requires the list; any other unnest rejects it.
statement error 42601
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text)])

statement error 42601
SELECT * FROM unnest(ARRAY[1, 2]) AS u(a i32)

# A named composite array returns the composite type, so the list is redundant.
statement error 42601
SELECT * FROM unnest(ARRAY['(1,2)'::pt]) AS u(x i32, y i32)

# The declared shape must match the records.
statement error 42804
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text)]) AS u(a i32)

statement error 42804
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text)]) AS u(a i32, b text, c i32)

statement error 42804
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text)]) AS u(a i32, b i32)

statement error 42804
SELECT * FROM unnest(ARRAY[ROW(1.5, 'a'::text)]) AS u(a i32, b text)

# A duplicate column name.
statement error 42701
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text)]) AS u(a i32, a text)

statement error 42701
SELECT * FROM json_to_record('{"a": 1}') AS t(a i32, a text)

# An unknown declared type.
statement error 42704
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text)]) AS u(a i32, b nosuchtype)

# The alias-less list on json_to_record.
query I nosort
SELECT * FROM json_to_record('{"a": 5}') AS (a i32)
----
5

# --- Deliberate divergences (oracle_overrides.toml) --------------------------------------------

# jed's record type is static, so the declared shape is checked at plan time — even when the array
# turns out empty or NULL, where PostgreSQL (which checks at the first non-NULL element) returns no
# rows.
statement error 42804
SELECT * FROM unnest((SELECT array_agg(ROW(id, name)) FROM t WHERE id > 5)) AS u(id i32)

# Integer widths are interchangeable: jed's unconstrained integer literal is i64 where PostgreSQL's
# is int4, so a record field of either width fills any integer column. PostgreSQL requires the exact
# type (42804).
query IT nosort
SELECT * FROM unnest(ARRAY[ROW(1, 'a'::text)]) AS u(a i64, b text)
----
1
a

query IT nosort
SELECT * FROM unnest(ARRAY[ROW(1::i16, 'a'::text)]) AS u(a i32, b text)
----
1
a

# A value outside a narrower declared integer type is 22003 (PostgreSQL: 42804, the type mismatch).
statement error 22003
SELECT * FROM unnest(ARRAY[ROW(3000000000, 'a'::text)]) AS u(a i32, b text)

statement error 22003
SELECT * FROM unnest(ARRAY[ROW(ARRAY[1, 70000], 'a'::text)]) AS u(a i16[], b text)

# A bare string literal inside ROW(…) is text in jed, so it fills a text column; PostgreSQL leaves it
# `unknown`, which matches no declared type (42804).
query IT nosort
SELECT * FROM unnest(ARRAY[ROW(1, 'a')]) AS u(a i32, b text)
----
1
a
