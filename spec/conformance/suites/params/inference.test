# How a bare parameter adopts a type from its context (spec/design/api.md §5): the unified type of
# a CASE / COALESCE / GREATEST / LEAST, the text operand of LIKE / ILIKE / a regex match / `||`, and
# the family a scalar function declares for the argument slot (functions.md §9.1). Each `# params:`
# record binds host values (conformance.md §1.2).
# Format + the `requires` directive: ../../../design/conformance.md.
# requires: harness.params, ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.select_no_from, query.where_eq, query.order_by, expr.case, expr.coalesce, expr.greatest_least, expr.nullif, expr.like, expr.ilike, expr.like_escape, expr.regex_match, expr.text_concat, func.unknown_args, func.abs, func.round, func.date_part, func.to_jsonb, expr.numeric_transcendental, types.i32, types.i64, types.text, types.bytea, types.json, types.jsonb, null.three_valued, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, s text)

statement ok
INSERT INTO t VALUES (1, 'xyz')

# A bare parameter in COALESCE, CASE, or LEAST takes the expression's unified type.
# params: 7
query I nosort
SELECT COALESCE($1, 10)
----
7

# params: 7
query I nosort
SELECT COALESCE(NULL, $1, 10)
----
7

# params: 7
query I nosort
SELECT CASE WHEN true THEN $1 ELSE 10 END
----
7

# params: 7
query I nosort
SELECT CASE WHEN false THEN 10 ELSE $1 END
----
7

# params: 7
query I nosort
SELECT LEAST($1, 10)
----
7

# A bare parameter in NULLIF takes its sibling's type, on either side (an `=` operand pair).
# params: 7
query I nosort
SELECT NULLIF($1, 10)
----
7

# params: 'xyz'
query T nosort
SELECT NULLIF(s, $1) FROM t
----
NULL

# params: 'abc'
query T nosort
SELECT NULLIF($1, s) FROM t
----
abc

# A LIKE / ILIKE / regex operand is text whatever its sibling.
# params: 'x\%'
query B nosort
SELECT 'x%' LIKE $1
----
true

# params: 'abc', 'a%'
query B nosort
SELECT $1 LIKE $2
----
true

# params: 'abc'
query B nosort
SELECT $1 ILIKE 'A%'
----
true

# params: '^a.c$'
query B nosort
SELECT 'abc' ~ $1
----
true

# params: 'abc', 'z'
query B nosort
SELECT $1 !~ $2
----
true

# params: NULL
query B nosort
SELECT 'x' LIKE $1
----
NULL

# params: 1
statement error 42804
SELECT 'x' LIKE $1

# A non-text sibling is still a LIKE type error.
statement ok
CREATE TABLE l (id i32 PRIMARY KEY, s text)

statement ok
INSERT INTO l VALUES (1, 'a%'), (2, 'ab'), (3, NULL)

# params: '5'
statement error 42804
SELECT 5 LIKE $1

# A LIKE pattern or ESCAPE may be bound (both are like_escape arguments, typed text), and a bound
# pattern costs exactly what the literal does.
# cost: 11
query I nosort
SELECT id FROM l WHERE s LIKE 'a#%' ESCAPE '#' ORDER BY id
----
1

# params: 'a#%'
# cost: 11
query I nosort
SELECT id FROM l WHERE s LIKE $1 ESCAPE '#' ORDER BY id
----
1

# params: 'a%'
query I nosort
SELECT id FROM l WHERE s LIKE $1 ESCAPE '#' ORDER BY id
----
1
2

# params: '#'
# cost: 11
query I nosort
SELECT id FROM l WHERE s LIKE 'a#%' ESCAPE $1 ORDER BY id
----
1

# params: NULL
query I nosort
SELECT id FROM l WHERE s LIKE 'a#%' ESCAPE $1 ORDER BY id
----

# params: 'xy'
statement error 22025
SELECT id FROM l WHERE s LIKE 'a#%' ESCAPE $1 ORDER BY id

# A bare operand of `||` with no array operand is text.
# params: 'a'
query T nosort
SELECT $1 || 'b' FROM t
----
ab

# params: 'a'
query T nosort
SELECT s || $1 FROM t
----
xyza

# params: 'a'
query T nosort
SELECT $1 || id FROM t
----
a1

# params: 'a', 'b'
query T nosort
SELECT $1 || $2 FROM t
----
ab

# params: NULL
query T nosort
SELECT $1 || s FROM t
----
NULL

# The parameter is declared text, so an integer value does not coerce.
# params: 5
statement error 42804
SELECT $1 || id FROM t

# A function argument adopts the family its slot declares.
# params: 'banana'
query T nosort
SELECT translate($1, 'a', 'b')
----
bbnbnb

# params: 'abc', 'b', 'x'
query T nosort
SELECT translate($1, $2, $3)
----
axc

# An integer slot types the parameter i64.
# params: 'abcd', 2
query T nosort
SELECT left($1, $2)
----
ab

# params: 65
query T nosort
SELECT chr($1)
----
A

# length and substr have text and bytea overloads: an unknown argument takes text.
# params: 'héllo'
query I nosort
SELECT length($1)
----
5

# params: 'abc'
query T nosort
SELECT substr($1, 2)
----
bc

# A typed argument narrows the candidates first: bytea picks the bytea overload.
# params: 2
query T nosort
SELECT substr('\x010203'::bytea, $1)
----
\x0203

# encode(bytea, text): a text value adapts to the bytea slot by bytea's input form.
# params: '\xab'
query T nosort
SELECT encode($1, 'hex')
----
ab

# params: '[1]'
query T nosort
SELECT json_typeof($1)
----
array

# params: NULL
query T nosort
SELECT translate($1, 'a', 'b')
----
NULL

# The adopted type unifies with the parameter's other uses.
# params: 'xyz'
query T nosort
SELECT left($1, 1) FROM t WHERE s = $1
----
x

# A cast chooses among ambiguous overloads.
# params: -3
query I nosort
SELECT abs($1::i32)
----
3

# A value of the wrong family for an adopted slot is a binding error.
# params: 'abcd', '2'
statement error 42804
SELECT left($1, $2)

# params: 'x'
statement error 42804
SELECT left($1, 1) FROM t WHERE id = $1

# Overloads the rule cannot decide among are ambiguous.
# params: 1
statement error 42725
SELECT abs($1)

# params: 1
statement error 42725
SELECT round($1, 2)

# params: 1
statement error 42725
SELECT sqrt($1)

# params: 1, 1
statement error 42725
SELECT pow($1, $2)

# params: 1
statement error 42725
SELECT date_part('year', $1)

# An `any` slot fixes no type.
# params: 'x'
statement error 42P18
SELECT to_jsonb($1)

# No candidate at all stays undefined.
# params: 'abc'
statement error 42883
SELECT left($1, 'x')
