# --- a bound list of keys ------------------------------------------------------------------------

# `id = ANY($1)` reads the array's elements, so the bound list is planned as its literal twin: a PK
# interval set of one point per element (cost.md §3 "OR / IN-list"), estimated as the IN-list of
# those elements.
# params: ARRAY[70, 80]
query ITTII nosort
EXPLAIN SELECT cat FROM items WHERE id = ANY($1)
----
0
Filter
conjuncts=1
2
12
1
Scan items
PK interval set: id; intervals=1; arrays=1; touched=2
2
4

query ITTII nosort
EXPLAIN SELECT cat FROM items WHERE id = ANY('{70,80}'::i32[])
----
0
Filter
conjuncts=1
2
12
1
Scan items
PK interval set: id; intervals=1; arrays=1; touched=2
2
4

# params: ARRAY[70, 80]
# cost: 13
query I nosort
SELECT cat FROM items WHERE id = ANY($1) ORDER BY cat
----
70
80

# cost: 13
query I nosort
SELECT cat FROM items WHERE id = ANY('{70,80}'::i32[]) ORDER BY cat
----
70
80

