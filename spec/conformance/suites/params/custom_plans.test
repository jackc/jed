# Custom plans (spec/design/estimator.md §6.1): every execution is planned with its bound values as
# plan-time literals, so statistics reach a parameterized statement exactly as they reach the literal
# one. Each bound record below is paired with its literal twin, whose plan, estimates, actual cost,
# and rows it must equal; only EXPLAIN's detail differs, where a $N still renders symbolically. The
# plan cache's memo and value-blind classification are per-core host-API tests (custom_plans). The
# plans and estimates are jed-owned, so this file is cross-core checked, not oracle-checked.
# Format + the `requires` directive: ../../../design/conformance.md.
# requires: harness.params, maintenance.analyze, maintenance.analyze_gin_terms, query.any_array_point_lookup, ddl.create_table, ddl.primary_key, ddl.secondary_index, ddl.gin_index, query.gin_scan, query.gin_any_eq, dml.insert, dml.insert_select, dml.insert_on_conflict, dml.update, dml.delete, dml.explain, dml.explain_analyze, query.select, query.where_eq, query.comparison_order, query.set_returning, query.aggregates, query.explain, query.explain_analyze, query.subquery_in, expr.text_concat, expr.arithmetic, expr.case, cast.explicit, func.array_quantified, types.i32, types.i64, types.text, types.array, null.three_valued, resource.cost_metering

# cat is 1 for nine rows in ten (a most-common value) and unique otherwise; tags holds the common tag
# 'a' on every row and a rare tag 'r<id>' on one.
statement ok
CREATE TABLE items (id i32 PRIMARY KEY, cat i32, tags text[])

statement ok
INSERT INTO items SELECT CAST(g AS i32), CAST(CASE WHEN g % 10 = 0 THEN g ELSE 1 END AS i32), ARRAY['a', 'r' || CAST(g AS text)] FROM generate_series(1, 1000) AS g

statement ok
CREATE INDEX items_cat ON items (cat)

statement ok
CREATE INDEX items_tags ON items USING gin (tags)

statement ok
ANALYZE items

