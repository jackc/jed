# The jsonpath query functions (P2, spec/design/jsonpath.md §5) over the P1b structural-accessor
# evaluator: jsonb_path_exists / jsonb_path_query (SRF) / jsonb_path_query_first / jsonb_path_query_array.
# The path evaluates to an ordered jsonb sequence; lax (default) auto-unwraps arrays + suppresses
# navigation failures, strict raises (2203A missing member, 22033 subscript). STRICT in the args.
# Output matches the postgres:18 oracle. Format: ../../../design/conformance.md.
# requires: query.select, query.aggregates, types.jsonpath, func.jsonb_path, expr.jsonpath_filter, expr.jsonpath_match

# jsonb_path_exists: the sequence is non-empty (a missing member → false in lax).
query BB nosort
SELECT jsonb_path_exists('{"a": 1}', '$.a'), jsonb_path_exists('{"a": 1}', '$.b')
----
true
false

# Lax auto-unwraps an array for a member accessor: $.a over [{"a":1},{"a":2}] → 1, 2 (non-empty).
query B nosort
SELECT jsonb_path_exists('[{"a": 1}, {"a": 2}]', '$.a')
----
true

# jsonb_path_query_first → the first item; an empty sequence → SQL NULL.
query TT nosort
SELECT jsonb_path_query_first('{"a": [10, 20, 30]}', '$.a[*]'), jsonb_path_query_first('{"a": 1}', '$.b')
----
10
NULL

# jsonb_path_query_array wraps the sequence in a JSON array.
query TT nosort
SELECT jsonb_path_query_array('{"a": [1, 2, 3]}', '$.a[*]'), jsonb_path_query_array('{"a": 1}', '$.b')
----
[1, 2, 3]
[]

# A NULL context → SQL NULL.
query TB nosort
SELECT jsonb_path_query_first(NULL::jsonb, '$.a'), jsonb_path_exists(NULL::jsonb, '$.a')
----
NULL
NULL

# Strict mode raises on a missing member (2203A) and an out-of-range subscript (22033).
statement error 2203A
SELECT jsonb_path_query_array('{"a": 1}', 'strict $.b')

statement error 22033
SELECT jsonb_path_query_array('[1, 2]', 'strict $[5]')

# jsonb_path_query as a FROM-clause SRF — one row per sequence item, in order.
query T nosort
SELECT * FROM jsonb_path_query('{"a": [1, 2, 3]}', '$.a[*]')
----
1
2
3

# Nested navigation + a slice yields the selected elements as jsonb rows, in order.
query T nosort
SELECT * FROM jsonb_path_query('{"xs": [10, 20, 30, 40]}', '$.xs[1 to 2]')
----
20
30

# A NULL document → zero rows.
query I nosort
SELECT count(*)::i32 FROM jsonb_path_query(NULL::jsonb, '$.a[*]')
----
0

# A filter ?(comparison) keeps only the items for which the predicate is true.
query T nosort
SELECT * FROM jsonb_path_query('[1, 2, 3, 4]', '$[*] ? (@ > 2)')
----
3
4

# A filter over object members, with a nested member comparison.
query T nosort
SELECT * FROM jsonb_path_query('[{"a": 1}, {"a": 5}]', '$[*] ? (@.a >= 5)')
----
{"a": 5}

# Boolean connectives && / || / ! and a string comparison.
query TTT nosort
SELECT jsonb_path_query_array('[1,2,3]', '$[*] ? (@ > 1 && @ < 3)'), jsonb_path_query_array('[1,2,3]', '$[*] ? (@ == 1 || @ == 3)'), jsonb_path_query_array('["x","y"]', '$[*] ? (@ == "y")')
----
[2]
[1, 3]
["y"]

# The @? operator is jsonb_path_exists.
query BBB nosort
SELECT '{"a": 1}'::jsonb @? '$.a', '{"a": 1}'::jsonb @? '$.b', '[1,2,3]'::jsonb @? '$[*] ? (@ > 2)'
----
true
false
true

# A filter renders canonically (lax omitted; the comparison spaced).
query TT nosort
SELECT '$[*] ? (@ > 2)'::jsonpath, '$ ? (@.a == 1 || @.b == 2)'::jsonpath
----
$[*]?(@ > 2)
$?(@."a" == 1 || @."b" == 2)

# A TOP-LEVEL predicate ($.a == 1) is a boolean-valued path: jsonb_path_match returns the boolean.
query BB nosort
SELECT jsonb_path_match('{"a": 1}', '$.a == 1'), jsonb_path_match('{"a": 1}', '$.a == 2')
----
true
false

# A missing member makes the comparison unknown → jsonb_path_match returns false.
query B nosort
SELECT jsonb_path_match('{}', '$.a == 1')
----
false

# A non-predicate path produces a JSON item, not the required single boolean item. The scalar
# function reports PostgreSQL's dedicated cardinality/type error; this is distinct from @@, whose
# PostgreSQL-compatible silent form yields NULL for the same input.
statement error 22038
SELECT jsonb_path_match('{"a": 1}', '$.a')

query B nosort
SELECT '{"a": 1}'::jsonb @@ '$.a'
----
NULL

# The @@ operator is jsonb_path_match, with && / || and an existential element comparison.
query BBB nosort
SELECT '{"a": 1}'::jsonb @@ '$.a == 1', '{"a": 1}'::jsonb @@ '$.a > 5', '{"a": [1, 2, 3]}'::jsonb @@ '$.a[*] == 2'
----
true
false
true

# A top-level predicate, queried, yields the boolean as a single jsonb item.
query T nosort
SELECT * FROM jsonb_path_query('{"a": 1}', '$.a == 1')
----
true

# A top-level predicate renders parenthesized (PG jsonpath_out); it round-trips through compile.
query TT nosort
SELECT '$.a == 1'::jsonpath, '$.a > 1 && $.b < 2'::jsonpath
----
($."a" == 1)
($."a" > 1 && $."b" < 2)

# Lax auto-unwraps an array one level before a FILTER step (jsonpath.md §4.1 rule 1), exactly as
# it does before a member accessor: `$ ? (…)` over an array context tests each element, not the
# array. Strict does not unwrap — the filter's @ is the whole array, and comparing an array to a
# scalar is unknown, so nothing passes.
query BBBB nosort
SELECT jsonb_path_exists('[1]', '$ ? (@ == 1)'), jsonb_path_exists('[1]', 'strict $ ? (@ == 1)'), '[1]'::jsonb @? '$ ? (@ == 1)', '[1]'::jsonb @? 'strict $ ? (@ == 1)'
----
true
false
true
false

query T nosort
SELECT * FROM jsonb_path_query('[1, 2, 3]', '$ ? (@ >= 2)')
----
2
3

query TT nosort
SELECT jsonb_path_query_first('[3, 1, 2]', '$ ? (@ < 3)'), jsonb_path_query_first('[3, 1, 2]', 'strict $ ? (@ < 3)')
----
1
NULL

# The strict filter sees the whole array: @[0] is its first element. In lax each element is the
# filter's @, and [0] on a scalar is that scalar (§4.1 rule 2).
query TT nosort
SELECT jsonb_path_query_array('[1, 2]', '$ ? (@[0] == 1)'), jsonb_path_query_array('[1, 2]', 'strict $ ? (@[0] == 1)')
----
[1]
[[1, 2]]

# The filter unwrap is ONE level: a nested array element becomes the filter's @ as-is. A comparison
# operand is unwrapped one level too (lax), so [1] satisfies @ == 1 but [[1]] does not.
query T nosort
SELECT * FROM jsonb_path_query('[1, 2, [1], [[1]]]', '$ ? (@ == 1)')
----
1
[1]

# Strict compares an array operand as an array (unknown), so only the scalar 1 passes the [*] form.
query TT nosort
SELECT jsonb_path_query_array('[1, 2, [1]]', 'strict $ ? (@ == 1)'), jsonb_path_query_array('[1, 2, [1]]', 'strict $[*] ? (@ == 1)')
----
[]
[1]

# A filter after other steps unwraps the array the steps produce.
query TTT nosort
SELECT jsonb_path_query_array('{"a": [1, 2, 3]}', '$.a ? (@ > 1)'), jsonb_path_query_array('{"a": [1, 2, 3]}', 'strict $.a ? (@ > 1)'), jsonb_path_query_array('{"a": [[1, 2], 3]}', '$.a ? (@ > 1)')
----
[2, 3]
[]
[[1, 2], 3]

query TT nosort
SELECT jsonb_path_query_array('[{"b": [1, 2]}, {"b": [3]}]', '$.b ? (@ > 1)'), jsonb_path_query_array('[[1, 2], [3, 4]]', '$[0] ? (@ > 1)')
----
[2, 3]
[2]

# Chained filters, and accessor steps after a filter.
query TT nosort
SELECT jsonb_path_query_array('[1, 2, 3]', '$ ? (@ > 1) ? (@ < 3)'), jsonb_path_query_array('[{"a": 1}, {"a": 2}]', '$ ? (@.a > 1).a')
----
[2]
[2]

# An empty array: lax has no element to test; strict tests the empty array itself, which is not 1.
query TT nosort
SELECT jsonb_path_query_array('[]', '$ ? (@ == 1)'), jsonb_path_query_array('[]', 'strict $ ? (@ == 1)')
----
[]
[]

# A comparison operand that evaluates to an array is unwrapped one level in lax (existential over
# its elements); strict compares the array itself (unknown). A `$`-rooted operand unwraps too.
query TTT nosort
SELECT jsonb_path_query_array('[{"a": [1, 2]}, {"a": [3]}]', '$ ? (@.a == 2)'), jsonb_path_query_array('[{"a": [1, 2]}, {"a": [3]}]', 'strict $[*] ? (@.a == 2)'), jsonb_path_query_array('[1, [2]]', '$ ? (@ == $[1])')
----
[{"a": [1, 2]}]
[]
[[2]]

# The same operand unwrap applies to a top-level predicate.
query BB nosort
SELECT jsonb_path_match('[1, 2]', '$ == 2'), '{"a": [1, 2]}'::jsonb @@ '$.a == 2'
----
true
true
