# Every text-valued expression carries its inputs' collation (spec/design/collation.md §1 "Every
# other text-valued expression", PostgreSQL's assign_collations_walker):
#   - a cast to text keeps its operand's collation; CASE / COALESCE / GREATEST / LEAST combine
#     their result inputs (never a simple-CASE operand or a WHEN condition);
#   - min/max (plain or OVER), lag/lead/first_value/…, and mode/percentile_disc carry their
#     argument's collation, and min/max compare under it;
#   - a scalar subquery carries its output column's collation (implicit); IN / ANY / ALL over a
#     subquery compare under the left operand combined with the body column; the array form
#     compares under the left operand's;
#   - a sort / grouping target that combines two different implicit collations is 42P21 at plan
#     time; a key that only reads a conflicted UNION ALL column stays 42P22, and such a column
#     yields to its neighbours inside these nodes.
#
# The vendored `unicode` collation is the CLDR-DUCET root: a < A < b < B (lowercase before its
# uppercase). Built-in C is byte / code-point order: A(0x41) < B < a(0x61) < b.
# Format + the `requires` gate: ../../../design/conformance.md.
# requires: ddl.create_table, ddl.primary_key, ddl.secondary_index, ddl.index_expr, dml.insert, dml.insert_multi_row, query.select, query.select_no_from, query.order_by, query.order_by_expr, query.order_by_window, query.where_eq, query.cross_join, query.derived_table, query.values, query.union, query.distinct, query.aggregates, query.group_by, query.group_by_expr, query.window, query.window_ranking, query.window_offset, query.window_aggregate, query.ordered_set_aggregate, query.ordered_set_collation, query.within_group_expr, query.subquery_scalar, query.subquery_in, query.subquery_quantified, query.subquery_correlated, func.array_quantified, types.array, expr.case, expr.coalesce, expr.greatest_least, expr.collate, ddl.collate_column, cast.explicit, cast.operator, types.varchar_length, types.i32, types.text

# load-collation: unicode = collation/17.0.0/root.allkeys

statement ok
CREATE TABLE ct (id i32 PRIMARY KEY, s text COLLATE "unicode")

statement ok
CREATE TABLE cc (id i32 PRIMARY KEY, c text COLLATE "C")

statement ok
INSERT INTO ct VALUES (1, 'b'), (2, 'A'), (3, 'a'), (4, 'B')

statement ok
INSERT INTO cc VALUES (1, 'B'), (2, 'a')

# ============================================================================================
# Casts.
# ============================================================================================

query T nosort
SELECT s FROM ct ORDER BY s::text
----
a
A
b
B

query T nosort
SELECT s FROM ct ORDER BY CAST(s AS varchar(5)) DESC
----
B
b
A
a

# ============================================================================================
# CASE / COALESCE / GREATEST / LEAST.
# ============================================================================================

query T nosort
SELECT s FROM ct ORDER BY CASE WHEN id > 0 THEN s ELSE 'z' END
----
a
A
b
B

# The simple-CASE operand and a WHEN condition do not contribute (c is "C").
query T nosort
SELECT s FROM ct, cc WHERE cc.id = 1 ORDER BY CASE c WHEN 'B' THEN s END
----
a
A
b
B

query T nosort
SELECT s FROM ct, cc WHERE cc.id = 1 ORDER BY CASE WHEN c < 'z' THEN s END DESC
----
B
b
A
a

query T nosort
SELECT s FROM ct ORDER BY coalesce(s, 'z') DESC
----
B
b
A
a

query T nosort
SELECT s FROM ct ORDER BY greatest(s, 'A'), id
----
A
a
b
B

query T nosort
SELECT s FROM ct ORDER BY least(s, 'b') DESC, id
----
b
B
A
a

# ============================================================================================
# Aggregates and window functions — min/max also compare under the collation.
# ============================================================================================

query TT
SELECT min(s), max(s) FROM ct
----
a
B

query TT
SELECT max(s COLLATE "C"), min(s::text) FROM ct
----
b
a

query ITT nosort
SELECT id % 2 AS g, min(s), max(s) FROM ct GROUP BY id % 2 ORDER BY g
----
0
A
B
1
a
b

query I nosort
SELECT id % 2 AS g FROM ct GROUP BY id % 2 ORDER BY max(s)
----
1
0

query TT nosort
SELECT s, max(s) OVER () FROM ct ORDER BY s
----
a
B
A
B
b
B
B
B

query TT nosort
SELECT s, min(s) OVER (ORDER BY id) FROM ct ORDER BY id
----
b
b
A
A
a
a
B
a

query T nosort
SELECT s FROM ct ORDER BY lag(s) OVER (ORDER BY id), id
----
B
a
A
b

query T nosort
SELECT l FROM (SELECT lag(s) OVER (ORDER BY id) AS l FROM ct) d ORDER BY l
----
a
A
b
NULL

query T
SELECT mode() WITHIN GROUP (ORDER BY lpad(s, 2, '*')) FROM ct
----
*a

query T nosort
SELECT p FROM (SELECT id % 2 AS g, percentile_disc(0.5) WITHIN GROUP (ORDER BY s) AS p FROM ct GROUP BY id % 2) d ORDER BY p
----
a
A

# ============================================================================================
# Subqueries.
# ============================================================================================

query T nosort
SELECT s FROM ct WHERE (SELECT ct.s) < 'b' ORDER BY s
----
a
A

query T nosort
SELECT s FROM ct ORDER BY (SELECT ct.s)
----
a
A
b
B

query T nosort
SELECT s FROM ct WHERE s < ANY (SELECT 'b') ORDER BY s
----
a
A

query T nosort
SELECT s FROM ct WHERE s >= ALL (SELECT s FROM ct WHERE id IN (2, 3)) ORDER BY s
----
A
b
B

query T nosort
SELECT s FROM ct WHERE s < ANY (SELECT x FROM (VALUES ('b')) AS v(x) WHERE ct.id > 0) ORDER BY s
----
a
A

query T nosort
SELECT s FROM ct WHERE s < ANY (ARRAY['b']) ORDER BY s
----
a
A

query T nosort
SELECT s FROM ct WHERE s >= ALL (ARRAY['A', 'a']) ORDER BY s
----
A
b
B

statement error 42P22
SELECT s FROM ct WHERE s < (SELECT c FROM cc WHERE id = 2)

statement error 42P22
SELECT s FROM ct WHERE s IN (SELECT c FROM cc)

statement error 42P22
SELECT s FROM ct WHERE s < ANY (SELECT c FROM cc)

# ============================================================================================
# Conflicts: a comparison is 42P22; a sort / grouping target is 42P21 at plan time.
# ============================================================================================

statement error 42P22
SELECT s FROM ct, cc WHERE coalesce(s, c) < 'x'

statement error 42P22
SELECT s FROM ct, cc WHERE greatest(s, c) IS NULL

statement error 42P22
SELECT max(lpad(s, 2, c)) FROM ct, cc

statement error 42P21
SELECT s FROM ct, cc ORDER BY coalesce(s, c)

statement error 42P21
SELECT s FROM ct, cc ORDER BY CASE WHEN ct.id > 0 THEN s ELSE c END

statement error 42P21
SELECT s FROM ct, cc ORDER BY lpad(s, 2, c)

statement error 42P21
SELECT lpad(s, 2, c) AS x FROM ct, cc ORDER BY x

statement error 42P21
SELECT lpad(s, 2, c) FROM ct, cc GROUP BY lpad(s, 2, c)

statement error 42P21
SELECT DISTINCT lpad(s, 2, c) FROM ct, cc

statement error 42P21
SELECT row_number() OVER (PARTITION BY lpad(s, 2, c)) FROM ct, cc

statement error 42P21
SELECT row_number() OVER (ORDER BY lpad(s, 2, c)) FROM ct, cc

statement error 42P21
SELECT mode() WITHIN GROUP (ORDER BY lpad(s, 2, c)) FROM ct, cc

statement error 42P21
SELECT s FROM ct ORDER BY lpad(s, 2, (SELECT c FROM cc LIMIT 1))

# An explicit COLLATE settles the conflict.
query T nosort
SELECT lpad(s, 2, c) FROM ct, cc ORDER BY lpad(s, 2, c COLLATE "C")
----
BA
BB
Ba
Bb
aA
aB
aa
ab

# ============================================================================================
# A conflicted (UNION ALL) column yields inside an expression node, except a plain ::text cast
# and min/max's own comparison.
# ============================================================================================

query T nosort
SELECT x FROM (SELECT s AS x FROM ct UNION ALL SELECT c FROM cc) u ORDER BY coalesce(x, '')
----
A
B
B
a
a
b

query T nosort
SELECT x FROM (SELECT s AS x FROM ct UNION ALL SELECT c FROM cc) u ORDER BY x::varchar(5)
----
A
B
B
a
a
b

statement error 42P22
SELECT x FROM (SELECT s AS x FROM ct UNION ALL SELECT c FROM cc) u ORDER BY x::text

statement error 42P22
SELECT max(x) FROM (SELECT s AS x FROM ct UNION ALL SELECT c FROM cc) u

# ============================================================================================
# A persisted index expression keeps the storage rule: an index over (s::text) is C-keyed, so a
# query ordering by s::text (now unicode) sorts rather than walking it; an equality still seeks.
# ============================================================================================

statement ok
CREATE INDEX ct_cast_idx ON ct ((s::text))

query T nosort
SELECT s FROM ct ORDER BY s::text
----
a
A
b
B

query T
SELECT s FROM ct WHERE s::text = 'a'
----
a
