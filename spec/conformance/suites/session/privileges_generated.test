# EXECUTE preflight over stored generation expressions (spec/design/session.md §5.3,
# generated-columns.md): a function in a write target's generation expression needs EXECUTE, as one
# in its CHECK does — for every INSERT / UPDATE / upsert of the table, even an UPDATE that recomputes
# nothing and a write that touches no row. A read needs nothing. jed's session envelope has no
# PostgreSQL counterpart, so this is cross-core-checked, not oracle-checked.
# requires: ddl.generated_column, ddl.create_table, ddl.primary_key, dml.insert, dml.insert_column_list, dml.update, dml.insert_on_conflict, query.select, func.abs, types.i32, session.privileges

statement ok
CREATE TABLE gp (id i32 PRIMARY KEY, a i32, g i32 GENERATED ALWAYS AS (abs(a)) STORED, c i32)

statement ok
INSERT INTO gp (id, a) VALUES (1, -3)

# revoke: EXECUTE ON abs
statement error 42501
INSERT INTO gp (id, a) VALUES (2, -4)

# revoke: EXECUTE ON abs
statement error 42501
UPDATE gp SET c = 1 WHERE false

# revoke: EXECUTE ON abs
statement error 42501
INSERT INTO gp (id, a) VALUES (1, 9) ON CONFLICT (id) DO UPDATE SET a = excluded.a

# revoke: EXECUTE ON abs
query II nosort
SELECT id, g FROM gp
----
1
3
