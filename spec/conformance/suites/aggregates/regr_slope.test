# Aggregate regr_slope(Y, X) (spec/design/aggregates.md §23): the slope of the least-squares line through the pairs whose arguments are both non-NULL, NULL when X is constant. Over two float arguments it is
# PostgreSQL's float8 algorithm with an f64 result; over two integer/decimal arguments it is exact, a
# decimal result — a jed divergence (PostgreSQL defines it only over float8), ledgered in
# oracle_overrides.toml, whose expected values are PostgreSQL's numeric evaluation of the formula in
# aggregates.md §23. A pair with a NULL is skipped. Output name `regr_slope`.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.aggregates, query.group_by, query.aggregate_distinct, query.aggregate_filter, query.window_aggregate, types.i32, types.decimal, types.f32, types.f64, resource.cost_metering, func.regr_slope, func.covar_pop

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, g i32, y i32, x i32, dy numeric(6,2), dx numeric(6,1), fy f64, fx f64, ry f32, rx f32)

statement ok
INSERT INTO t VALUES (1, 1, 1, 2, 1.50, 2.0, 1, 2, 1, 2), (2, 1, 3, 5, 2.25, 5.5, 3, 5, 3, 5), (3, 1, 4, 4, NULL, 4.5, 4, 4, 4, 4), (4, 1, 8, 9, 8.00, 9.0, 8, 9, 8, 9), (5, 2, NULL, 1, 1.00, NULL, NULL, 1, NULL, 1), (6, 2, 2, 3, 2.00, 3.0, 2, 3, 2, 3)

# The arguments travel as one row: 6 rows read + 1 leaf page read + 6 row packs + 6 accumulated + 1
# produced.
# names: regr_slope
# cost: 20
query R nosort
SELECT regr_slope(fy, fx) FROM t
----
0.9657534246575342

# f32 arguments widen to f64.
# names: regr_slope
query R nosort
SELECT regr_slope(ry, rx) FROM t
----
0.9657534246575342

# names: g, regr_slope
query IR rowsort
SELECT g, regr_slope(fy, fx) FROM t GROUP BY g
----
1
0.9615384615384616
2
NULL

# One pair, and none (a pair with a NULL is skipped).
# names: regr_slope
query R nosort
SELECT regr_slope(fy, fx) FROM t WHERE id = 6
----
NULL

# names: regr_slope
query R nosort
SELECT regr_slope(fy, fx) FROM t WHERE id = 5
----
NULL

# names: regr_slope
query R nosort
SELECT regr_slope(fy, fx * 2) FILTER (WHERE id > 1) FROM t
----
0.4759036144578313

# names: id, regr_slope
query IR nosort
SELECT id, regr_slope(fy, fx) OVER (ORDER BY id) FROM t ORDER BY id
----
1
NULL
2
0.6666666666666666
3
0.7857142857142856
4
0.9615384615384616
5
0.9615384615384616
6
0.9657534246575342

# names: regr_slope
query R nosort
SELECT regr_slope(y, x) FROM (VALUES (1.0::f64, 'Infinity'::f64), (2.0::f64, 3.0::f64)) v(y, x)
----
NaN

statement error 22003
SELECT regr_slope(y, x) FROM (VALUES (1e308::f64, 1.0::f64), (-1e308::f64, 2.0::f64)) v(y, x)

# Over integer and decimal arguments: exact.
# names: regr_slope
# cost: 20
query D nosort
SELECT regr_slope(y, x) FROM t
----
0.96575342465753424658

# names: regr_slope, regr_slope
query DD nosort
SELECT regr_slope(dy, dx), regr_slope(y, dx) FROM t
----
0.90256959314775160600
0.95904436860068259386

# names: g, regr_slope
query ID rowsort
SELECT g, regr_slope(dy, x) FROM t GROUP BY g
----
1
0.95608108108108108108
2
0.50000000000000000000

# names: regr_slope
query D nosort
SELECT regr_slope(DISTINCT y, y) FROM t
----
1.00000000000000000000

# Wide decimals charge decimal_work for each pair's three products and five sums.
statement ok
CREATE TABLE big (id i32 PRIMARY KEY, y numeric, x numeric)

statement ok
INSERT INTO big VALUES (1, 123456789012.123456789, 5), (2, -987654321098.987654321, 6.25), (3, 5, 31415926535.8979)

# names: regr_slope
# cost: 180
query D nosort
SELECT regr_slope(y, x) FROM big
----
13.7541309055105343

# A float argument beside an exact one has no overload.
statement error 42883
SELECT regr_slope(fy, x) FROM t

statement error 42883
SELECT regr_slope(y) FROM t
