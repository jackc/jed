# Shared semantic workload for ordinary and forced-spill file execution (spill.md §7).
# A tiny host work_mem exercises skewed JOIN buckets, many groups, aggregate DISTINCT,
# grouping sets, canonical decimal/NULL equality, and stable downstream ordering.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.aggregates, query.group_by, query.aggregate_distinct, query.aggregate_filter, query.having, query.grouping_sets, query.order_by_grouping, query.distinct, query.join_inner, query.join_left, query.order_by, query.order_by_keys, query.limit, query.hash_join, types.i32, types.decimal, types.text, resource.cost_metering

statement ok
CREATE TABLE spill_left (id integer PRIMARY KEY, k integer, n decimal, s text)

statement ok
CREATE TABLE spill_right (id integer PRIMARY KEY, k integer, v integer)

statement ok
INSERT INTO spill_left VALUES (1, 2, 1.00, 'é'), (2, 1, 1.0, 'a'), (3, 2, 2.00, 'é'), (4, NULL, NULL, NULL), (5, 1, 2.0, 'a'), (6, 3, 3.00, 'z'), (7, 2, 1.000, 'é'), (8, 4, 4.0, 'b'), (9, 1, NULL, 'a'), (10, NULL, 1.0, NULL), (11, 5, 5.0, 'q'), (12, 6, 6.0, 'p')

statement ok
INSERT INTO spill_right VALUES (1, 2, 30), (2, 2, 20), (3, 2, 10), (4, 1, 40), (5, 1, 50), (6, NULL, 60), (7, 7, 70), (8, 3, 80), (9, 4, 90), (10, 5, 100), (11, 6, 110), (12, 2, 120)

# Streaming DISTINCT still stops at its ordered window; spill cannot turn it into
# an eager full scan. The seen set has its own bounded backing in this lane.
# cost: 3
query I nosort
SELECT DISTINCT id FROM spill_left ORDER BY id LIMIT 1
----
1

