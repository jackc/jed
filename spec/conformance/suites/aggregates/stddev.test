# Aggregate stddev(x) (spec/design/aggregates.md §23): PostgreSQL's historical alias for stddev_samp —
# exact over integer or decimal input (a decimal result), f64 over float input. Output name
# `stddev`.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.aggregates, query.group_by, query.window_aggregate, types.i32, types.decimal, types.f64, resource.cost_metering, func.stddev, func.stddev_samp

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, g i32, a i32, d numeric(6,1), f f64)

statement ok
INSERT INTO t VALUES (1, 1, 2, 0.5, 2.0), (2, 1, 4, 1.5, 4.0), (3, 1, 9, NULL, 9.0), (4, 2, 5, 2.5, 5.0)

# names: stddev
# cost: 10
query D nosort
SELECT stddev(a) FROM t
----
2.9439202887759490

# names: g, stddev, stddev_samp
query IDD rowsort
SELECT g, stddev(d), stddev_samp(d) FROM t GROUP BY g
----
1
0.70710678118654752440
0.70710678118654752440
2
NULL
NULL

# names: stddev
query R nosort
SELECT stddev(f) FROM t
----
2.943920288775949

# names: id, stddev
query IR nosort
SELECT id, stddev(f) OVER (ORDER BY id) FROM t ORDER BY id
----
1
NULL
2
1.4142135623730951
3
3.605551275463989
4
2.943920288775949

statement error 42883
SELECT stddev(id::text) FROM t
