# The columnar aggregate lane over an integer grouping EXPRESSION and a HAVING (memory.md §5.4,
# cost.md §6.1). Each lane query is paired with a form that keeps the row path — a no-op
# `FILTER (WHERE TRUE)` on one aggregate — and both must give the same rows and the same cost. In
# disk mode the grouped lane is the bounded form (§6.6.1), whose HAVING and ORDER BY are the
# bounded-spill lane's own stages.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.where_eq, query.aggregates, query.group_by, query.group_by_expr, query.having, query.order_by, query.limit, query.aggregate_filter, expr.arithmetic, expr.case, error.overflow_trap, types.i32, resource.cost_metering, resource.cost_limit

statement ok
CREATE TABLE lk (id i32 PRIMARY KEY, a i32, v i32)

statement ok
INSERT INTO lk VALUES (1, 15, 1), (2, 3, 2), (3, 27, 3), (4, NULL, 4), (5, 11, 5), (6, 21, 6), (7, 8, 7), (8, NULL, 8), (9, 19, 9), (10, 5, 10), (11, -4, 11), (12, 14, 12)

# An expression key: a / 10 buckets a, its NULLs one group (a NULL result groups like any key).
# cost: 65
query IIII nosort
SELECT a / 10 AS b, count(*), sum(v), max(a) FROM lk GROUP BY a / 10 ORDER BY b
----
0
4
30
8
1
4
27
19
2
2
9
27
NULL
2
12
NULL

# cost: 65
query IIII nosort
SELECT a / 10 AS b, count(*) FILTER (WHERE TRUE), sum(v), max(a) FROM lk GROUP BY a / 10 ORDER BY b
----
0
4
30
8
1
4
27
19
2
2
9
27
NULL
2
12
NULL

# With a WHERE, and the groups left in creation order (scan order of first appearance).
# cost: 69
query III rowsort
SELECT (a + v) % 4, count(*), min(v) FROM lk WHERE v > 2 GROUP BY ((a + v) % 4)
----
0
2
5
2
2
3
3
4
6
NULL
2
4

# cost: 69
query III rowsort
SELECT (a + v) % 4, count(*) FILTER (WHERE TRUE), min(v) FROM lk WHERE v > 2 GROUP BY ((a + v) % 4)
----
0
2
5
2
2
3
3
4
6
NULL
2
4

# HAVING over a bare-column key and over the aggregates, then ORDER BY and LIMIT.
# cost: 67
query III nosort
SELECT a / 10, count(*), sum(v) FROM lk GROUP BY a / 10 HAVING count(*) >= 3 ORDER BY 1 DESC
----
1
4
27
0
4
30

# cost: 67
query III nosort
SELECT a / 10, count(*) FILTER (WHERE TRUE), sum(v) FROM lk GROUP BY a / 10 HAVING count(*) >= 3 ORDER BY 1 DESC
----
1
4
27
0
4
30

# cost: 58
query II nosort
SELECT v % 3, sum(a) FROM lk GROUP BY v % 3 HAVING v % 3 > 0 AND sum(a) > 20 ORDER BY 1 LIMIT 1
----
1
28

# cost: 58
query II nosort
SELECT v % 3, sum(a) FILTER (WHERE TRUE) FROM lk GROUP BY v % 3 HAVING v % 3 > 0 AND sum(a) > 20 ORDER BY 1 LIMIT 1
----
1
28

# HAVING over a bare integer column key, with an aggregate only HAVING reads.
# cost: 53
query II nosort
SELECT v, count(*) FROM lk GROUP BY v HAVING sum(a) > 14 ORDER BY v
----
1
1
3
1
6
1
9
1

# cost: 53
query II nosort
SELECT v, count(*) FILTER (WHERE TRUE) FROM lk GROUP BY v HAVING sum(a) > 14 ORDER BY v
----
1
1
3
1
6
1
9
1

# A whole-table HAVING keeps or drops the one group.
# cost: 38
query I nosort
SELECT count(*) FROM lk HAVING count(*) > 100
----

# cost: 38
query I nosort
SELECT count(*) FILTER (WHERE TRUE) FROM lk HAVING count(*) > 100
----

# A key that traps is reported only if no filter error comes first: the row path filters every row
# before it evaluates any key. id 1's key overflows (22003); id 5's filter divides by zero (22012).
statement error 22012
SELECT a * 1000000000, count(*) FROM lk WHERE 10 / (id - 5) > -100 GROUP BY a * 1000000000

statement error 22003
SELECT a * 1000000000, count(*) FROM lk GROUP BY a * 1000000000

# An error inside HAVING is the first group's in creation order, whatever the ORDER BY: the group
# a / 10 = 1 (first seen at id 1) overflows before the group 0 (first seen at id 2) divides by zero.
statement error 22003
SELECT a / 10, count(*) FROM lk GROUP BY a / 10 HAVING CASE WHEN a / 10 = 1 THEN 9223372036854775807 + count(*) > 0 WHEN a / 10 = 0 THEN 1 / (count(*) - count(*)) > 0 ELSE TRUE END ORDER BY 1

statement error 22012
SELECT a / 10, count(*) FROM lk GROUP BY a / 10 HAVING CASE WHEN a / 10 = 0 THEN 1 / (count(*) - count(*)) > 0 ELSE TRUE END ORDER BY 1 DESC

# Under a cost ceiling the lane is an attempt, accepted only below every ceiling (cost.md §6.1):
# the ceiling one unit above the statement's cost completes, and the cost itself aborts.
# max_cost: 68
query III nosort
SELECT a / 10, count(*), sum(v) FROM lk GROUP BY a / 10 HAVING count(*) >= 3 ORDER BY 1 DESC
----
1
4
27
0
4
30

# max_cost: 67
statement error 54P01
SELECT a / 10, count(*), sum(v) FROM lk GROUP BY a / 10 HAVING count(*) >= 3 ORDER BY 1 DESC
