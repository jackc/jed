# Aggregate covar_pop(Y, X) (spec/design/aggregates.md §23): the population covariance of the (Y, X)
# pairs whose arguments are both non-NULL. Over two float arguments it is PostgreSQL's float8
# algorithm with an f64 result; over two integer/decimal arguments it is exact, a decimal result —
# a jed divergence (PostgreSQL defines it only over float8), ledgered in oracle_overrides.toml, whose
# expected values equal PostgreSQL's numeric (N·Σxy − Σx·Σy) / (N·N). NULL over no pair. Output name
# `covar_pop`.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.aggregates, query.group_by, query.aggregate_distinct, query.aggregate_filter, query.window_aggregate, types.i32, types.decimal, types.f32, types.f64, resource.cost_metering, func.covar_pop

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, g i32, y i32, x i32, dy numeric(6,2), dx numeric(6,1), fy f64, fx f64, ry f32, rx f32)

statement ok
INSERT INTO t VALUES (1, 1, 1, 2, 1.50, 2.0, 1, 2, 1, 2), (2, 1, 3, 5, 2.25, 5.5, 3, 5, 3, 5), (3, 1, 4, 4, NULL, 4.5, 4, 4, 4, 4), (4, 1, 8, 9, 8.00, 9.0, 8, 9, 8, 9), (5, 2, NULL, 1, 1.00, NULL, NULL, 1, NULL, 1), (6, 2, 2, 3, 2.00, 3.0, 2, 3, 2, 3)

# The arguments travel as one row: 6 rows read + 1 leaf page read + 6 row packs + 6 accumulated + 1
# produced.
# names: covar_pop
# cost: 20
query R nosort
SELECT covar_pop(fy, fx) FROM t
----
5.64

# f32 arguments widen to f64.
# names: covar_pop
query R nosort
SELECT covar_pop(ry, rx) FROM t
----
5.64

# names: g, covar_pop
query IR rowsort
SELECT g, covar_pop(fy, fx) FROM t GROUP BY g
----
1
6.25
2
0

# A pair with a NULL is skipped; no pair: NULL.
# names: covar_pop
query R nosort
SELECT covar_pop(fy, fx) FROM t WHERE id = 5
----
NULL

# names: covar_pop
query R nosort
SELECT covar_pop(fy, fx * 2) FILTER (WHERE id > 1) FROM t
----
9.875

# names: id, covar_pop
query IR nosort
SELECT id, covar_pop(fy, fx) OVER (ORDER BY id) FROM t ORDER BY id
----
1
0
2
1.5
3
1.222222222222222
4
6.25
5
6.25
6
5.64

# names: covar_pop
query R nosort
SELECT covar_pop(y, x) FROM (VALUES (1.0::f64, 'Infinity'::f64), (2.0::f64, 3.0::f64)) v(y, x)
----
NaN

statement error 22003
SELECT covar_pop(y, x) FROM (VALUES (1e308::f64, 1.0::f64), (-1e308::f64, 2.0::f64)) v(y, x)

# Over integer and decimal arguments: exact.
# names: covar_pop
# cost: 20
query D nosort
SELECT covar_pop(y, x) FROM t
----
5.6400000000000000

# names: covar_pop, covar_pop
query DD nosort
SELECT covar_pop(dy, dx), covar_pop(y, dx) FROM t
----
6.5859375000000000
5.6200000000000000

# names: g, covar_pop
query ID rowsort
SELECT g, covar_pop(dy, x) FROM t GROUP BY g
----
1
7.8611111111111111
2
0.50000000000000000000

# names: covar_pop
query D nosort
SELECT covar_pop(DISTINCT y, y) FROM t
----
5.8400000000000000

# Wide decimals charge decimal_work for each pair's three products and five sums.
statement ok
CREATE TABLE big (id i32 PRIMARY KEY, y numeric, x numeric)

statement ok
INSERT INTO big VALUES (1, 123456789012.123456789, 5), (2, -987654321098.987654321, 6.25), (3, 5, 31415926535.8979)

# names: covar_pop
# cost: 180
query D nosort
SELECT covar_pop(y, x) FROM big
----
3016618463768323183122.6244700150259

# A float argument beside an exact one has no overload.
statement error 42883
SELECT covar_pop(fy, x) FROM t

statement error 42883
SELECT covar_pop(y) FROM t
