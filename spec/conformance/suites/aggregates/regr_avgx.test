# Aggregate regr_avgx(Y, X) (spec/design/aggregates.md §23): the mean of the X arguments over the pairs whose arguments are both non-NULL. Over two float arguments it is
# PostgreSQL's float8 algorithm with an f64 result; over two integer/decimal arguments it is exact, a
# decimal result — a jed divergence (PostgreSQL defines it only over float8), ledgered in
# oracle_overrides.toml, whose expected values are PostgreSQL's numeric evaluation of the formula in
# aggregates.md §23. A pair with a NULL is skipped. Output name `regr_avgx`.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.aggregates, query.group_by, query.aggregate_distinct, query.aggregate_filter, query.window_aggregate, types.i32, types.decimal, types.f32, types.f64, resource.cost_metering, func.regr_avgx, func.covar_pop

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, g i32, y i32, x i32, dy numeric(6,2), dx numeric(6,1), fy f64, fx f64, ry f32, rx f32)

statement ok
INSERT INTO t VALUES (1, 1, 1, 2, 1.50, 2.0, 1, 2, 1, 2), (2, 1, 3, 5, 2.25, 5.5, 3, 5, 3, 5), (3, 1, 4, 4, NULL, 4.5, 4, 4, 4, 4), (4, 1, 8, 9, 8.00, 9.0, 8, 9, 8, 9), (5, 2, NULL, 1, 1.00, NULL, NULL, 1, NULL, 1), (6, 2, 2, 3, 2.00, 3.0, 2, 3, 2, 3)

# The arguments travel as one row: 6 rows read + 1 leaf page read + 6 row packs + 6 accumulated + 1
# produced.
# names: regr_avgx
# cost: 20
query R nosort
SELECT regr_avgx(fy, fx) FROM t
----
4.6

# f32 arguments widen to f64.
# names: regr_avgx
query R nosort
SELECT regr_avgx(ry, rx) FROM t
----
4.6

# names: g, regr_avgx
query IR rowsort
SELECT g, regr_avgx(fy, fx) FROM t GROUP BY g
----
1
5
2
3

# One pair, and none (a pair with a NULL is skipped).
# names: regr_avgx
query R nosort
SELECT regr_avgx(fy, fx) FROM t WHERE id = 6
----
3

# names: regr_avgx
query R nosort
SELECT regr_avgx(fy, fx) FROM t WHERE id = 5
----
NULL

# names: regr_avgx
query R nosort
SELECT regr_avgx(fy, fx * 2) FILTER (WHERE id > 1) FROM t
----
10.5

# names: id, regr_avgx
query IR nosort
SELECT id, regr_avgx(fy, fx) OVER (ORDER BY id) FROM t ORDER BY id
----
1
2
2
3.5
3
3.6666666666666665
4
5
5
5
6
4.6

# names: regr_avgx
query R nosort
SELECT regr_avgx(y, x) FROM (VALUES (1.0::f64, 'Infinity'::f64), (2.0::f64, 3.0::f64)) v(y, x)
----
Infinity

statement error 22003
SELECT regr_avgx(y, x) FROM (VALUES (1e308::f64, 1.0::f64), (-1e308::f64, 2.0::f64)) v(y, x)

# Over integer and decimal arguments: exact.
# names: regr_avgx
# cost: 20
query D nosort
SELECT regr_avgx(y, x) FROM t
----
4.6000000000000000

# names: regr_avgx, regr_avgx
query DD nosort
SELECT regr_avgx(dy, dx), regr_avgx(y, dx) FROM t
----
4.8750000000000000
4.8000000000000000

# names: g, regr_avgx
query ID rowsort
SELECT g, regr_avgx(dy, x) FROM t GROUP BY g
----
1
5.3333333333333333
2
2.0000000000000000

# names: regr_avgx
query D nosort
SELECT regr_avgx(DISTINCT y, y) FROM t
----
3.6000000000000000

# Wide decimals charge decimal_work for each pair's three products and five sums.
statement ok
CREATE TABLE big (id i32 PRIMARY KEY, y numeric, x numeric)

statement ok
INSERT INTO big VALUES (1, 123456789012.123456789, 5), (2, -987654321098.987654321, 6.25), (3, 5, 31415926535.8979)

# names: regr_avgx
# cost: 180
query D nosort
SELECT regr_avgx(y, x) FROM big
----
10471975515.71596667

# A float argument beside an exact one has no overload.
statement error 42883
SELECT regr_avgx(fy, x) FROM t

statement error 42883
SELECT regr_avgx(y) FROM t
