# Aggregate bit_or(integer) -> the input type (spec/design/aggregates.md §23): the bitwise OR of
# the non-NULL inputs. NULL inputs are skipped; an empty or all-NULL group -> NULL. Output name
# `bit_or`.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.aggregates, query.group_by, query.aggregate_distinct, query.aggregate_filter, query.window_aggregate, types.i16, types.i32, types.i64, resource.cost_metering, func.bit_or, func.bit_and

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, g i32, a i32, s i16, l i64)

statement ok
