# XOR is not idempotent: a repeated value cancels, unless DISTINCT drops it first.
statement ok
CREATE TABLE r (id i32 PRIMARY KEY, a i32)

statement ok
INSERT INTO r VALUES (1, 6), (2, 6), (3, 3)

# names: bit_xor, bit_xor
query II nosort
SELECT bit_xor(a), bit_xor(DISTINCT a) FROM r
----
3
5
