# Percentile array results preserve the fraction array's dimensions and lower bounds.
# requires: ddl.create_table, dml.insert, query.select, query.aggregates, query.ordered_set_aggregate, query.ordered_set_array_fraction, query.ordered_set_interval, types.i32, types.f64, types.array, types.interval

statement ok
CREATE TABLE t (v i32, duration interval)

statement ok
INSERT INTO t VALUES (10, INTERVAL '10 hours'), (20, INTERVAL '20 hours')

query T nosort
SELECT percentile_disc('[0:1]={0,1}'::float8[]) WITHIN GROUP (ORDER BY v) FROM t
----
[0:1]={10,20}

query T nosort
SELECT percentile_disc('[0:1][3:4]={{0,1},{0.5,NULL}}'::float8[]) WITHIN GROUP (ORDER BY v) FROM t
----
[0:1][3:4]={{10,20},{10,NULL}}

query T nosort
SELECT percentile_cont('[0:1][3:4]={{0,1},{0.5,NULL}}'::float8[]) WITHIN GROUP (ORDER BY v) FROM t
----
[0:1][3:4]={{10,20},{15,NULL}}

query T nosort
SELECT percentile_cont('[0:1][3:4]={{0,1},{0.5,NULL}}'::float8[]) WITHIN GROUP (ORDER BY duration) FROM t
----
[0:1][3:4]={{10:00:00,20:00:00},{15:00:00,NULL}}

query T nosort
SELECT percentile_disc('{}'::float8[]) WITHIN GROUP (ORDER BY v) FROM t
----
{}

query I nosort
SELECT array_ndims(percentile_disc('{}'::float8[]) WITHIN GROUP (ORDER BY v)) FROM t
----
NULL

query T nosort
SELECT percentile_disc('[0:1]={0,1}'::float8[]) WITHIN GROUP (ORDER BY v) FROM t WHERE v < 0
----
NULL
