# Aggregate bool_and(boolean) -> boolean (spec/design/aggregates.md §23): TRUE iff every non-NULL
# input is TRUE. NULL inputs are skipped; an empty or all-NULL group -> NULL. Output name `bool_and`.
# requires: ddl.create_table, ddl.primary_key, dml.insert, query.select, query.aggregates, query.group_by, query.aggregate_distinct, query.aggregate_filter, query.window_aggregate, types.i32, types.boolean_storable, resource.cost_metering, func.bool_and

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, g i32, b boolean)

statement ok
INSERT INTO t VALUES (1, 1, true), (2, 1, NULL), (3, 1, true), (4, 2, true), (5, 2, false), (6, 3, NULL)

# 6 rows read + 1 leaf page read + 6 accumulated + 1 produced.
# names: bool_and
# cost: 14
query B nosort
SELECT bool_and(b) FROM t
----
false

# names: bool_and
query B nosort
SELECT bool_and(b) FROM t WHERE g = 1
----
true

# All-NULL and empty groups are NULL.
# names: bool_and
query B nosort
SELECT bool_and(b) FROM t WHERE g = 3
----
NULL

# names: bool_and
query B nosort
SELECT bool_and(b) FROM t WHERE g = 4
----
NULL

# names: g, bool_and
query IB rowsort
SELECT g, bool_and(b) FROM t GROUP BY g
----
1
true
2
false
3
NULL

# An expression argument.
# names: bool_and
query B nosort
SELECT bool_and(id > 0) FROM t
----
true

# names: bool_and
query B nosort
SELECT bool_and(DISTINCT b) FROM t WHERE g = 2
----
false

# names: bool_and
query B nosort
SELECT bool_and(b) FILTER (WHERE id <> 5) FROM t
----
true

# As a window function: a running conjunction over id order.
# names: id, bool_and
query IB nosort
SELECT id, bool_and(b) OVER (ORDER BY id) FROM t ORDER BY id
----
1
true
2
true
3
true
4
true
5
false
6
false

# Only boolean has an overload.
statement error 42883
SELECT bool_and(id) FROM t
