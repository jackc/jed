# `*` and `t.*` in a grouped query (spec/design/aggregates.md §10, grammar.md §15). A star expands
# into one select item per column, and each expanded column obeys the grouping rule exactly as a
# written reference would: it must be a grouping column — or functionally dependent on a grouped
# primary key (aggregates.md §10, query.group_by_functional_dependency) — else 42803, and it reads
# the group's value, whatever the order the keys were written in. A HAVING-only query, GROUP BY ()
# and the grouping-set forms group too. Results verified against PostgreSQL 18.
# requires: ddl.create_table, ddl.primary_key, dml.insert, dml.insert_multi_row, query.select, query.order_by, query.qualified_column, query.qualified_star, query.table_alias, query.join_inner, query.aggregates, query.group_by, query.group_by_functional_dependency, query.grouping_sets, query.having, query.window, query.window_named, query.window_grouped, types.i32, resource.cost_metering

statement ok
CREATE TABLE t (id i32 PRIMARY KEY, a i32, b i32)

statement ok
INSERT INTO t VALUES (1, 10, 100), (2, 10, 200), (3, 20, 300)

# An ungrouped column under `*` is the grouping error, not a row of garbage.
statement error 42803
SELECT * FROM t GROUP BY a

statement error 42803
SELECT * FROM t HAVING count(*) > 0

statement error 42803
SELECT * FROM t GROUP BY ()

statement error 42803
SELECT * FROM t GROUP BY CUBE(a, b)

# Every column grouped, in an order unlike the table's: each output column reads ITS key.
# cost: 7
query III nosort
SELECT * FROM t GROUP BY b, a, id ORDER BY id
----
1
10
100
2
10
200
3
20
300

# Grouping by the primary key makes every column of the table functionally dependent on it.
# cost: 7
query III nosort
SELECT * FROM t GROUP BY id ORDER BY id
----
1
10
100
2
10
200
3
20
300

# cost: 7
query III nosort
SELECT t.* FROM t GROUP BY id ORDER BY id
----
1
10
100
2
10
200
3
20
300

# The qualified star mixes with other items.
# cost: 10
query IIII nosort
SELECT t.*, count(*) FROM t GROUP BY id, a, b ORDER BY id
----
1
10
100
1
2
10
200
1
3
20
300
1

# cost: 9
query III nosort
SELECT * FROM t GROUP BY a, b, id HAVING a = 10 ORDER BY id
----
1
10
100
2
10
200

# cost: 7
query III nosort
SELECT * FROM t GROUP BY id, a, b ORDER BY b DESC
----
3
20
300
2
10
200
1
10
100

# A ROLLUP over every column: a column grouped away in a row's set projects as NULL.
# cost: 14
query III nosort
SELECT * FROM t GROUP BY ROLLUP(id, a, b) ORDER BY id, a, b
----
1
10
100
1
10
NULL
1
NULL
NULL
2
10
200
2
10
NULL
2
NULL
NULL
3
20
300
3
20
NULL
3
NULL
NULL
NULL
NULL
NULL

# The functional dependency does not extend to a grouping set that drops the key.
statement error 42803
SELECT * FROM t GROUP BY ROLLUP(id) ORDER BY id

# A grouped query that also windows evaluates `*` over the grouped row.
# cost: 7
query III nosort
SELECT * FROM t GROUP BY id WINDOW w AS (ORDER BY sum(b)) ORDER BY id
----
1
10
100
2
10
200
3
20
300

# cost: 16
query IIII nosort
SELECT t.*, sum(b) OVER w FROM t GROUP BY id WINDOW w AS (ORDER BY sum(b)) ORDER BY id
----
1
10
100
100
2
10
200
300
3
20
300
600

# A join: the qualified star of one relation under the other's grouping.
# cost: 16
query III nosort
SELECT l.* FROM t l JOIN t r ON l.id = r.id GROUP BY l.id, r.id ORDER BY l.id
----
1
10
100
2
10
200
3
20
300

# cost: 16
query III nosort
SELECT l.* FROM t l JOIN t r ON l.id = r.id GROUP BY l.id ORDER BY l.id
----
1
10
100
2
10
200
3
20
300

statement error 42803
SELECT l.*, r.b FROM t l JOIN t r ON l.id = r.id GROUP BY l.a

statement error 42803
SELECT l.* FROM t l JOIN t r ON l.id = r.id GROUP BY l.a
